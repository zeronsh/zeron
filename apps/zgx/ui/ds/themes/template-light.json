{
	// A template's own theme file for the light scheme: where Zeron lays a
	// template's ds/themes/zeron-light.json, renamed and set over the palette it
	// wears (palette-light, ds/palettes.luau), so a token it names wins over
	// what the palette makes of it and over Zeron's file, and any it doesn't
	// name stays theirs. With no template, this: nothing.
	"name": "template-light",
	"type": "light",
	"extends": "palette-light",
	"tokens": {}
}
