                website: a["website"].as_str().map(str::to_owned),
                repository: a["repository"].as_str().map(str::to_owned),
            })
            .collect();
        let found: Vec<(String, Option<Logo>, Option<String>, Option<String>)> = std::thread::scope(|scope| {
            let handles: Vec<_> = wants
