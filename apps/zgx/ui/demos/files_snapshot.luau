local FadeText = require("@self/fade_text")
local control = require("@self/control")
local SelectionMenu = require("@self/selection_menu")
local locale = require("@self/locale")
-- (By the alias the shell mounts the menus' host by: one instance per path.)
local Links = require("@ds/links")

local M = {}

-- A hairline: across, or down (a bar's groups apart). `strong` for the
-- one rule that divides a whole page. With a label, the word sits in a
-- gap in it.
-- (Each piece's words may be messages, `ui.t`, drawn as they are; a
-- KeyValue's value stays a string or a node: it is copied as text.)
export type DividerProps = { vertical: boolean?, label: (string | Message)?, strong: boolean? }

function M.Divider(props: DividerProps?): Node
	local p: DividerProps = props or {}
	local ink = if p.strong then "$border" else "$border.subtle"
	if p.vertical then
		return ui.div { w = 1, h = 16, shrink = 0, self = "center", bg = ink, aria_hidden = true }
	end
	if p.label then
		return ui.row {
			w_full = true,
			gap = "$space.3",
			items = "center",
			ui.div { h = 1, grow = 1, bg = ink },
			ui.text { p.label, shrink = 0, text_size = "$font.size.xs", weight = "$font.weight.medium", color = "$text.tertiary" },
			ui.div { h = 1, grow = 1, bg = ink },
		}
	end
	return ui.div { h = 1, w_full = true, shrink = 0, bg = ink, aria_hidden = true }
end

-- A link: text that goes somewhere, in the accent's ink, underlined under
-- the pointer. `external` adds the arrow out (it opens in the browser);
-- `tone = "quiet"` for a link among quiet text (a hint's), in its ink
-- until touched. Where it goes is its `on_click`'s to say (the host
-- opens URLs).
export type LinkProps = {
	[number]: string | Message,
	on_click: (() -> ())?,
	external: boolean?,
	-- Where it goes, a web address its click opens outside: its context
	-- menu is a link's (ds/links: Open, Copy link).
	href: string?,
	tone: ("accent" | "quiet")?,
	size: ("sm" | "md")?,
}

function M.Link(props: LinkProps): Node
	local quiet = props.tone == "quiet"
	local href = props.href
	return ui.row {
		role = "link",
		label = props[1],
		focusable = true,
		cursor = "pointer",
		gap = "$zeron.space.hair",
		items = "center",
		shrink = 0,
		rounded = "$radius.sm",
		color = if quiet then "$text.secondary" else "$zeron.tone.accent.ink",
		hover = { underline = true, color = if quiet then "$text.primary" else "$zeron.tone.accent.ink" },
		underline_offset = 3,
		focus = control.ring,
		on_click = props.on_click,
		context_menu = if href
			then Links.outside_menu(function(): string?
				return href
			end, props.on_click)
			else nil,
		ui.text { props[1], text_size = if props.size == "sm" then "$font.size.sm" else "$font.size.md" },
		if props.external then ui.div { y = -0.5, Icon { name = "arrow-up-right", size = 12 } } else nil,
	}
end

-- Breadcrumbs: where something is, its parents before it, each a link
-- but the last (where you are), a quiet chevron between. A long middle
-- fades, never cut to "…".
export type Crumb = { label: string | Message, icon: Icon.Name?, on_click: (() -> ())? }
export type BreadcrumbsProps = { items: { Crumb }, size: ("sm" | "md")? }

function M.Breadcrumbs(props: BreadcrumbsProps): Node
	local size = if props.size == "sm" then "$font.size.sm" else "$font.size.md"
	local out: { Node } = {}
	for i, c in props.items do
		local last = i == #props.items
		if i > 1 then
			table.insert(out, ui.div { shrink = 0, color = "$text.tertiary", aria_hidden = true, Icon { name = "alt-arrow-right", size = 12 } })
		end
		local crumb = ui.row {
			role = if last then nil else "link",
			label = c.label,
			focusable = not last and c.on_click ~= nil,
			cursor = if last or not c.on_click then nil else "pointer",
			gap = "$space.1",
			items = "center",
			min_w = 0,
			shrink = if last then 0 else 1,
			px = "$space.1",
			h = 22,
			rounded = "$radius.sm",
			color = if last then "$text.primary" else "$text.secondary",
			hover = if last then nil else { bg = "$hover", color = "$text.primary" },
			focus = if last then nil else control.ring,
			on_click = c.on_click,
			if c.icon then ui.div { shrink = 0, y = -0.5, Icon { name = c.icon, size = 14 } } else nil,
			FadeText { c.label, text_size = size, weight = if last then "$font.weight.medium" else nil },
		}
		table.insert(out, crumb)
	end
	return ui.row { role = "group", label = locale.t("ds.layout.breadcrumbs"), gap = "$zeron.space.hair", items = "center", min_w = 0, table.unpack(out) }
end

-- A key–value list: what something is, a fact a line (a commit's author,
-- a branch's upstream, a device's address). Keys in a column of their own
-- in the tertiary ink, values beside them; a value may be a node (a badge,
-- a person). `copy` puts a copy button at a value's end, shown under the
-- pointer.
export type Pair = { key: string | Message, value: string | Node, mono: boolean?, copy: boolean? }
export type KeyValueProps = { items: { Pair }, key_width: number?, dense: boolean? }

local Pair = ui.component(function(props: { pair: Pair, key_width: number, dense: boolean? }): Node
	local pair = props.pair
	local over = ui.use_state(false)
	local copied = ui.use_state(false)
	local value: Node
	if type(pair.value) == "string" then
		value = SelectionMenu { grow = 1, min_w = 0, FadeText {
			pair.value,
			w_full = true,
			text_size = if pair.mono then "$font.size.sm" else "$font.size.md",
			font = if pair.mono then "$font.mono" else nil,
			color = "$text.primary",
		} }
	else
		value = ui.row { grow = 1, min_w = 0, items = "center", pair.value :: Node }
	end
	return ui.row {
		w_full = true,
		min_h = if props.dense then 28 else 32,
		gap = "$space.3",
		items = "center",
		on_hover = function(inside: boolean)
			over:set(inside)
		end,
		ui.text { pair.key, w = props.key_width, shrink = 0, text_size = "$font.size.md", color = "$text.tertiary" },
		value,
		if pair.copy and type(pair.value) == "string"
			then ui.div {
				shrink = 0,
				opacity = ui.tween(over, { duration = 120 }),
				ui.button {
					label = locale.t("common.copy"),
					w = 22,
					h = 22,
					px = 0,
					py = 0,
					justify = "center",
					rounded = "$radius.md",
					bg = "#00000000",
					color = "$text.tertiary",
					cursor = "pointer",
					hover = { bg = "$hover", color = "$text.primary" },
					focus = control.ring,
					on_click = function()
						ui.clipboard.write(pair.value :: string)
						copied:set(true)
						ui.after(1600, function()
							copied:set(false)
						end)
					end,
					Icon {
						name = function()
							return if copied:get() then "check" else "copy"
						end,
						size = 14,
					},
				},
			}
			else nil,
	}
end)

function M.KeyValue(props: KeyValueProps): Node
	local rows: { Node } = {}
	for _, pair in props.items do
		table.insert(rows, Pair { pair = pair, key_width = props.key_width or 96, dense = props.dense })
	end
	return ui.column { w_full = true, role = "list", table.unpack(rows) }
end

return M
]],
		["apps/zgx/ui/ds/look.luau"] = [[
-- The accent Zeron is drawn in: the theme's own, or one of Zeron's presets
-- (crates/theme AccentPreset), each the theme's (`zeron.accents`, lighter
-- on dark, deeper on light, as AccentPreset::color has them). One setting
-- for the whole app, kept across launches, as the material is
-- (ds/material); a window takes it through `theme` (`look.theme()`).

local palettes = require("@self/palettes")
local locale = require("@self/locale")

local M = {}

export type Accent = { value: string, label: string, preset: boolean? }

-- An accent, its name read as a string in the locale shown (`a.label`,
-- through its message as it's asked for: read in a function, it follows).
-- Zeron's own is its name in every language.
local function accent(value: string, preset: boolean?): Accent
	return setmetatable({ value = value, preset = preset }, {
		__index = function(_, field: string): string?
			if field == "label" then
				return if value == "zeron" then "Zeron" else locale.s(`ds.look.accent.{value}`)
			end
			return nil
		end,
	}) :: any
end

-- In Zeron's order: the theme's own, then the presets.
M.ACCENTS = {
	accent("default"),
	accent("zeron", true),
	accent("orange", true),
	accent("amber", true),
	accent("green", true),
	accent("cyan", true),
	accent("blue", true),
	accent("pink", true),
} :: { Accent }

M.accent = ui.persist("accent", "default")

function M.find(value: string): Accent
	for _, a in M.ACCENTS do
		if a.value == value then
			return a
		end
	end
	return M.ACCENTS[1]
end

-- An accent's ink, in whichever scheme draws it. The theme's own is its
-- own token (`zeron.accents.default`, the theme's `accent` as written), so
-- it keeps its colour inside a window that wears another.
function M.ink(a: Accent): string
	return `$zeron.accents.{a.value}`
end

-- The tokens a window overrides to wear `value` (the chosen accent by
-- default): its `accent`, and what's derived from it follows. Nothing for
-- the theme's own.
function M.theme(value: string?): { [string]: any }?
	local a = M.find(value or M.accent:get())
	if not a.preset then
		return nil
	end
	return { accent = `$zeron.accents.{a.value}` }
end

-- The interface's text size: its body size in points (the theme's
-- `font.size.md`, 13, by default), every other text size and line height
-- scaled with it, the conversation's too (`zeron.prose.*`). Code has its
-- own (Settings → Appearance). Kept across launches, for the main window.
M.TEXT_SIZES = { 12, 13, 14, 15, 16 }
M.text_size = ui.persist("text_size", 13)

-- The tokens text is sized by, each with its line height beside it.
local SIZED = {
	"font.size.xs", "font.size.sm", "font.size.md", "font.size.lg", "font.size.xl", "font.size.xxl",
	"font.line.xs", "font.line.sm", "font.line.md", "font.line.lg", "font.line.xl", "font.line.xxl",
	"zeron.prose.size", "zeron.prose.line",
	"zeron.prose.h1.size", "zeron.prose.h1.line",
	"zeron.prose.h2.size", "zeron.prose.h2.line",
	"zeron.prose.h3.size", "zeron.prose.h3.line",
	"zeron.prose.small.size", "zeron.prose.small.line",
}

-- The text tokens a window overrides for `size` (the chosen one by
-- default): each scaled from the theme's own by size / 13, sizes to half
-- a point, line heights to whole points. Nothing at the theme's own size.
function M.text_theme(size: number?): { [string]: any }?
	local body = size or M.text_size:get()
	local base = (ui.theme.get("font.size.md") :: number?) or 13
	if body == base then
		return nil
	end
	local scale = body / base
	local out: { [string]: any } = {}
	for _, token in SIZED do
		local v = ui.theme.get(token) :: number?
		if type(v) == "number" then
			local line = string.find(token, "line", 1, true) ~= nil
			out[token] = if line then math.floor(v * scale + 0.5) else math.floor(v * scale * 2 + 0.5) / 2
		end
	end
	return out
end

-- The palette each scheme wears (ds/palettes; Zeron's own by default):
-- one for light, one for dark, as the shipping app keeps them.
M.palette = {
	light = ui.persist("palette_light", "zeron-light"),
	dark = ui.persist("palette_dark", "zeron-dark"),
}

-- The palette's tokens for the scheme showing.
function M.palette_theme(): { [string]: any }?
	local kind = ui.theme.kind()
	local light = kind == "light" or kind == "high-contrast-light"
	local p = palettes.find((if light then M.palette.light else M.palette.dark):get())
	return if p then palettes.tokens(p) else nil
end

-- What the main window wears over its template's theme: the text size, and
-- an accent chosen over the theme's own.
function M.window_theme(): { [string]: any }?
	-- (No palette over the theme: a template brings its own, so a palette
	-- chosen before the pickers went never applies.)
	local palette = nil
	local out: { [string]: any }? = nil
	for _, part in { palette, M.text_theme(), M.theme() } do
		if part then
			out = out or {}
			for k, v in part do
				(out :: any)[k] = v
			end
		end
	end
	return out
end

return M
