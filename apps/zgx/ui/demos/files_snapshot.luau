		["apps/zgx/ui/screens/onboarding/org.luau"] = [[
-- Naming your organization, for someone signed in and in none: one field,
-- the address the name makes on the line under it, and the way on, which
-- makes it (Zeron's `POST /auth/orgs`, you its first member), works in it
-- from now on and goes on to inviting to it. An account makes one of its
-- own; one already in an organization works in that one and passes over
-- this step and inviting (asked at sign-in, and again here in case the
-- answer came late). The gallery's Name your organization is the design. Zeron has no address to check yet, so
-- the line says the address and nothing of whether it's free. Gone wrong,
-- the line under the title says so in the danger's ink and the button
-- offers another go; nothing else moves.

local ds = require("@ds")
local Onboarding = ds.Onboarding
local api = require("@account/api")
local state = require("./state")
local actions = require("./actions")

export type Props = { step: number?, count: number?, on_back: () -> () }

local function slug(s: string): string
	local out = string.gsub(string.lower(s), "[^%w]+", "-")
	return (string.gsub(out, "^%-*(.-)%-*$", "%1"))
end

-- The edge's limit on a name.
local MAX = 80

return function(props: Props): Node
	local name = ui.use_state("")
	local saving = ui.use_state(false)
	local failed = ui.use_state(nil :: string?)

	-- Already in one (the answer at sign-in came late, or never came): work
	-- in it, and on. The field stays hidden until that's known, so an
	-- account in one never sees it.
	-- (Asked once a visit: a hot reload doesn't ask again, the answer kept.)
	local known = {
		get = function(_): boolean
			return state.answered("orgs")
		end,
	}
	-- (Its answer heard only while the step is here: Back while it's asked
	-- leaves it unanswered.)
	local here = true
	ui.on_cleanup(function()
		here = false
	end)
	state.ask_until_answered("orgs", function()
	api.orgs():after(function(orgs: { api.Org })
		if not here then
			return
		end
		local org = actions.existing_org(orgs)
		if org and not saving:peek() and state.step:peek() == "org" then
			actions.work_in(org)
			actions.next()
		else
			state.answer("orgs")
		end
	end, function(err: any)
		if not here then
			return
		end
		if err.message == "signed_out" then
			actions.signed_out()
		else
			state.answer("orgs")
		end
	end)
	end)

	local function trimmed(): string
		return (string.gsub(name:get(), "^%s*(.-)%s*$", "%1"))
	end

	local function create()
		local n = trimmed()
		if saving:peek() or n == "" then
			return
		end
		saving:set(true)
		failed:set(nil)
		api.create_org(n):after(function(made: { organization_id: string, existing: boolean? })
			-- Already made (an account makes one of its own): work in that
			-- one, past inviting, as an account already in one does.
			if made.existing then
				saving:set(false)
				actions.work_in({ id = made.organization_id, organization_id = made.organization_id, name = n, role = "admin" })
				actions.next()
				return
			end
			-- Made: work in it (a refused scope still leaves the account in
			-- it; on as well), then invite to it.
			api.choose_org(made.organization_id):after(function()
				saving:set(false)
				actions.org_made(made.organization_id, n)
			end, function()
				saving:set(false)
				actions.org_made(made.organization_id, n)
			end)
		end, function(err: any)
			saving:set(false)
			if err.message == "signed_out" then
				actions.signed_out()
			else
				failed:set(err.message)
			end
		end)
	end

	return Onboarding.Step {
		step = props.step,
		count = props.count,
		back = Onboarding.Back { on_click = props.on_back },
		continue = {
			label = function()
				return if saving:get()
					then ui.t("onboarding.org.creating"):get()
					elseif failed:get() then ui.t("onboarding.try_again"):get()
					else ui.t("common.continue"):get()
			end,
			disabled = function()
				local n = trimmed()
				return saving:get() or n == "" or #n > MAX
			end,
			on_click = create,
		},
		ui.show(function()
			return known:get()
		end, Onboarding.Form {
			title = ui.t("onboarding.org.title") :: any,
			body = function()
				return if failed:get()
					then ui.t("onboarding.org.failed", { name = trimmed() }):get()
					else ui.t("onboarding.org.body"):get()
			end,
			tone = function()
				return if failed:get() then "$zeron.tone.danger.ink" else "$text.secondary"
			end,
			ui.column {
				w_full = true,
				gap = "$space.2",
				ds.TextField {
					value = name,
					name = ui.t("onboarding.org.field") :: any,
					placeholder = ui.t("onboarding.org.placeholder") :: any,
					size = "lg",
					w_full = true,
					autofocus = true,
				},
				ds.AddressLine {
					prefix = "zeron.sh/",
					value = function()
						return slug(name:get())
					end,
					status = function()
						return ""
					end,
				},
			},
		}),
	}
end
]],
		["apps/zgx/ui/screens/onboarding/username.luau"] = [[
-- Right after sign-in, for an account with no username yet: choosing one.
-- It's the card's address (zeron.sh/c/mara), so there's no card without
-- one, and it's chosen once. The gallery's Claim your username
-- (demos/example_username) is the design; this asks Zeron for real.
--
-- One field; under it the address it makes, then, a beat after the typing
-- stops, what Zeron says of it (free, taken, reserved) or what keeps it
-- from being a username yet, said before anyone is asked. The way on opens
-- only once it's free; it claims the name and goes on to the card. Gone
-- wrong, the line under the title says so and the button offers another
-- go; nothing else moves. Signed into the wrong account: Sign out is on
-- the look (Make it yours), one step back.

local ds = require("@ds")
local Onboarding = ds.Onboarding
local api = require("@account/api")
local Icon = require("@ds/icon")
local state = require("./state")

export type Props = {
	-- Its place among setup's numbered steps, and the way back.
	step: number?,
	count: number?,
	on_back: () -> (),
	-- Claimed: on to the card, with it.
	on_claimed: (card: api.Card) -> (),
	-- Signed out from here (or the session went): back to the start.
	on_signed_out: () -> (),
	-- Already has one (claimed elsewhere a moment ago): past this step.
	on_has_one: () -> (),
}

-- How long the typing has to rest before Zeron is asked.
local REST = 400

return function(props: Props): Node
	local typed = ui.use_state("")
	-- What the address line says: a problem (empty, invalid, start, short,
	-- long), or "checking", "available", "taken", "reserved", "unknown"
	-- (Zeron couldn't be asked).
	local check = ui.use_state("empty")
	-- Claiming, and what the last claim ended in (an api word), if not a card.
	local saving = ui.use_state(false)
	local failed = ui.use_state(nil :: string?)
	-- Whether the account has one is asked at sign-in, but the answer can
	-- come after this step opens (or not at all): asked again here, and the
	-- field stays hidden until it's known, so an account with a username
	-- never sees it.
	-- (Asked once a visit: a hot reload doesn't ask again, the answer kept.)
	local known = {
		get = function(_): boolean
			return state.answered("username")
		end,
	}
	-- (Answers heard only while the step is here: Back while one is asked
	-- leaves it unanswered.)
	local here = true
	ui.on_cleanup(function()
		here = false
	end)
	state.ask_until_answered("username", function()
		api.username():after(function(name: string?)
			if not here then
				return
			end
			state.answer("username")
			if name then
				props.on_has_one()
			end
		end, function(err: any)
			if not here then
				return
			end
			if err.message == "signed_out" then
				props.on_signed_out()
			else
				state.answer("username")
			end
		end)
	end)

	local function handle(): string
		return api.normalise(typed:get())
	end

	-- Asked a beat after the typing stops; only the last question asked
	-- is answered.
	local asked = 0
	ui.effect(function()
		local u = api.normalise(typed:get())
		asked += 1
		local mine = asked
		local why = api.problem(u)
		if why then
			check:set(why)
			return
		end
		check:set("checking")
		ui.after(REST, function()
			if mine ~= asked or not here then
				return
			end
			api.check(u):after(function(answer: api.Check)
				if mine == asked and here then
					check:set(if answer.available then "available" else answer.reason or "taken")
				end
			end, function(err: any)
				if mine ~= asked or not here then
					return
				end
				if err.message == "signed_out" then
					props.on_signed_out()
				else
					check:set("unknown")
				end
			end)
		end)
	end)

	local function claim()
		if saving:peek() then
			return
		end
		local u = handle()
		saving:set(true)
		failed:set(nil)
		api.claim(u):after(function(card: api.Card)
			saving:set(false)
			props.on_claimed(card)
		end, function(err: any)
			saving:set(false)
			local word = err.message
			if word == "taken" or word == "reserved" or word == "invalid" then
				-- Said where it's said for a name: on the address line.
				check:set(if word == "invalid" then "invalid" else word)
			elseif word == "already_claimed" then
				props.on_has_one()
			elseif word == "signed_out" then
				props.on_signed_out()
			else
				failed:set(word)
			end
		end)
	end

	local function free(): boolean
		return check:get() == "available"
	end

	-- What the address line says at its end: a glyph and a word in the ink
	-- of the news, one at a time, in a slot that keeps one line's height
	-- whatever it says.
	local function status(kind: string, glyph: Node?, label: Label, ink: string): Node
		return ui.show(function()
			return check:get() == kind
		end, ui.row {
			gap = "$space.1",
			items = "center",
			shrink = 0,
			color = ink,
			glyph,
			ui.text { label, text_size = "$font.size.sm", line_height = "$font.line.sm" },
		})
	end
	local function mark(name: Icon.Name): Node
		return ui.div { y = -0.5, ds.Icon { name = name, size = 12 } }
	end

	local address = ui.row {
		w_full = true,
		items = "center",
		justify = "between",
		gap = "$space.3",
		ui.row {
			items = "center",
			min_w = 0,
			ui.text { "zeron.sh/c/", text_size = "$font.size.sm", line_height = "$font.line.sm", color = "$text.tertiary" },
			ds.FadeText {
				handle,
				text_size = "$font.size.sm",
				line_height = "$font.line.sm",
				color = function()
					local c = check:get()
					return if c == "taken" or c == "reserved" or c == "invalid" or c == "start" then "$zeron.tone.danger.ink" else "$text.secondary"
				end,
			},
		},
		ui.row {
			items = "center",
			-- (The ring's name is a string, read as it's built: it says it with
			-- its progress.)
			-- zgx-lint: allow(untracked-get)
			status("checking", ds.ProgressRing { size = 12, tone = "neutral", label = ui.t("onboarding.username.checking_label"):get() }, ui.t("onboarding.username.checking"), "$text.tertiary"),
			status("available", mark("check-circle"), ui.t("onboarding.username.available"), "$zeron.tone.success.ink"),
			status("taken", mark("close-circle"), ui.t("onboarding.username.taken"), "$zeron.tone.danger.ink"),
			status("reserved", mark("close-circle"), ui.t("onboarding.username.reserved"), "$zeron.tone.danger.ink"),
			status("invalid", mark("info-circle"), ui.t("onboarding.username.invalid"), "$zeron.tone.danger.ink"),
			status("start", mark("info-circle"), ui.t("onboarding.username.start"), "$zeron.tone.danger.ink"),
			status("short", nil, ui.t("onboarding.username.short", { n = api.MIN }), "$text.tertiary"),
			status("long", nil, ui.t("onboarding.username.long", { n = api.MAX }), "$text.tertiary"),
			status("unknown", mark("info-circle"), ui.t("onboarding.username.unknown"), "$text.tertiary"),
		},
	}

	return Onboarding.Step {
		step = props.step,
		count = props.count,
		-- Back to the look, and no skipping (a username is the card;
		-- skipping was at sign-in). Signed into the wrong account: Sign out
		-- is on the look, one step back.
		back = Onboarding.Back { on_click = props.on_back },
		continue = {
			label = function()
				return if saving:get()
					then ui.t("onboarding.username.saving"):get()
					elseif failed:get() then ui.t("onboarding.try_again"):get()
					else ui.t("common.continue"):get()
			end,
			disabled = function()
				return saving:get() or not known:get() or not free()
			end,
			on_click = claim,
		},
		ui.show(function()
			return known:get()
		end, Onboarding.Form {
			title = ui.t("onboarding.username.title") :: any,
			body = function()
				local word = failed:get()
				return if word
					then ui.t("onboarding.username.failed", { name = handle(), says = api.says(word) }):get()
					else ui.t("onboarding.username.body"):get()
			end,
			tone = function()
				return if failed:get() then "$zeron.tone.danger.ink" else "$text.secondary"
			end,
			ui.column {
				w_full = true,
				gap = "$space.2",
				ds.TextField {
					value = typed,
					name = ui.t("onboarding.username.field") :: any,
					placeholder = ui.t("onboarding.username.placeholder") :: any,
					size = "lg",
					w_full = true,
					autofocus = true,
					-- Enter claims it, once it's free (as the way on would).
					on_key = function(e)
						if e.key == "Enter" and check:peek() == "available" and not saving:peek() then
							claim()
							return true
						end
						return nil
					end,
				},
				address,
			},
		}),
	}
end
]],
		["apps/zgx/ui/screens/panel/home_api.luau"] = [[
-- The panel home's host calls (src/session_home.rs), one place, so a
-- fixture stands in for them. Each a promise; a refusal's message is the
-- engine's words, or "unsupported" from an engine before run actions.
--
--   api.actions(space, device?)                 { actions, importable, issue? }
--   api.save_action(space, device?, draft)      the same, after: `draft` is
--                                               { id?, name, command, icon, setup }
--   api.delete_action(space, device?, id)       the same, after
--   api.run_action(space, chat, device?, id)    its terminal's id

local M = {}

-- A host without the call (one from before them, a fixture's) refuses it
-- as an engine from before run actions does: "unsupported".
local function call(name: string, arg: any): any
	local ok, promise = pcall(ui.call, name, arg)
	if ok then
		return promise
	end
	return {
		after = function(_self: any, _done: any, failed: ((any) -> ())?)
			if failed then
				failed({ message = "unsupported" })
			end
		end,
	}
end

function M.actions(space: string, device: string?): any
	return call("home.actions", { space = space, device = device })
end

function M.save_action(space: string, device: string?, draft: { [string]: any }): any
	local arg = table.clone(draft)
	arg.space, arg.device = space, device
	return call("home.save_action", arg)
end

function M.delete_action(space: string, device: string?, id: string): any
	return call("home.delete_action", { space = space, device = device, id = id })
end

function M.run_action(space: string, chat: string, device: string?, id: string): any
	return call("home.run_action", { space = space, chat = chat, device = device, id = id })
end

return M
]],
		["apps/zgx/ui/screens/panel/terminal.luau"] = [[
-- A terminal tab: a shell on the session's device, in its folder, through
-- the engine's terminal calls (src/terminal.rs), drawn by zgx's terminal.
--
-- The tab opens its engine terminal once and keeps its id (and the
-- command zgx runs for it) with the tab (screens/panel/state), and zgx
-- keeps its session by the tab's id: switching tabs, sessions or reloading
-- shows the same shell, running, at once. Closing the tab asks first if a
-- program is running in it (the host says), then ends both.
--
--   Terminal.Terminal { key, tab, project, session }
--   Terminal.title(tab)            what the shell calls itself, if anything
--   Terminal.closing(tab, done)    done(busy): whether closing ends a program
--   Terminal.close(tab)            the tab's terminal ended

local ds = require("@ds")
local state = require("@app/screens/panel/state")
local api = require("@app/screens/panel/terminal_api")
local files_paths = require("@app/screens/files/paths")

type Tab = state.Tab

local M = {}

-- Where the terminal runs (as the files pane works): the session's chat on
-- its device, or a project's folder with none open.
local target_of = files_paths.target_of

-- zgx's session for a tab (looked up, not started).
local function session_of(tab_id: string): any?
	local ok, t = pcall(api.term, tab_id)
	return if ok then t else nil
end

function M.title(tab: Tab): string?
	local t = session_of(tab.id)
	if not t then
		return nil
	end
	local ok, title = pcall(function()
		return t.title
	end)
	return if ok and type(title) == "string" and title ~= "" then title else nil
end

function M.closing(tab: Tab, done: (boolean) -> ())
	if not tab.terminal then
		-- (Still opening: nothing running in it yet.)
		done(false)
		return
	end
	api.status(tab.terminal, tab.device):after(function(s: any)
		done(s ~= nil and s.busy == true)
	end, function()
		-- (Not known: ask, rather than end something by surprise.)
		done(true)
	end)
end

function M.close(tab: Tab)
	local t = session_of(tab.id)
	if t then
		pcall(function()
			t:close()
		end)
	end
	if tab.terminal then
		api.close(tab.terminal, tab.device):after(function() end, function() end)
	end
end

export type Props = { key: string, tab: string, project: any?, session: any?, [any]: any }

M.Terminal = ui.component(function(props: Props): Node
	local key, id = props.key, props.tab
	local function tab(): Tab?
		state.of(key)
		return state.find(key, id)
	end
	-- Why it didn't open: one of ours (a message key), or the engine's own
	-- words. (Plain strings: state holds no messages.)
	local failed = ui.use_state(nil :: { key: string?, text: string? }?)
	-- Opened once: its engine terminal and command kept with the tab. (A
	-- beat after it's made: nothing is written while it's built.)
	local t0 = tab()
	ui.after(0, function()
	if t0 and not t0.command then
		local target = target_of(props.project, props.session)
		-- A page's panel (a plugin's board) has no session: its terminal is
		-- this Mac's, opening where a new terminal opens (the engine's
		-- home folder for a terminal of no chat it knows).
		if not target and string.sub(key, 1, 5) == "page:" then
			target = { chat = key }
		end
		if not target then
			failed:set({ key = "panel.terminal.no_session" })
		else
			local function fail(err: any)
				local m = if type(err) == "table" and err.message then tostring(err.message) else tostring(err)
				if m == "offline" then
					failed:set({ key = "panel.terminal.offline" })
				elseif string.find(string.lower(m), "unknown method", 1, true) then
					-- (An engine from before terminals: what to do, not why.)
					failed:set({ key = "panel.terminal.update" })
				else
					failed:set({ text = m })
				end
			end
			local known = t0.terminal
			local run = t0.run
			if not known and run then
				-- A run action (the panel home's): the engine opens its
				-- terminal, then the bridge attaches to it. (Its id kept with
				-- the tab first: a reload attaches, never runs it again.)
				local home_api = require("@app/screens/panel/home_api")
				home_api.run_action(run.space, run.chat, run.device, run.action):after(function(terminal: string)
					if not state.find(key, id) then
						api.close(terminal, run.device):after(function() end, function() end)
						return
					end
					state.set_terminal(key, id, terminal, run.device, nil)
					api.command(terminal, run.device):after(function(command: string)
						if state.find(key, id) then
							state.set_terminal(key, id, terminal, run.device, command)
						end
					end, fail)
				end, fail)
			elseif known then
				-- (Its engine terminal known, its bridge not running: one
				-- that attaches.)
				api.command(known, target.device):after(function(command: string)
					state.set_terminal(key, id, known, target.device, command)
				end, fail)
			else
				-- A new one: its bridge opens it at the size zgx gives it
				-- (a shell started at another size draws its first prompt
				-- for that width), and leaves its id to be claimed.
				api.start(target):after(function(r: any)
					state.set_terminal(key, id, nil, target.device, r.command, r.claim)
					api.claimed(r.claim):after(function(terminal: string)
						local now = state.find(key, id)
						if now then
							state.set_terminal(key, id, terminal, now.device, now.command)
							-- (From now on, a bridge started for it attaches to
							-- this one rather than opening another.)
							api.command(terminal, target.device):after(function(command: string)
								local still = state.find(key, id)
								if still then
									state.set_terminal(key, id, terminal, still.device, command)
								end
							end, function() end)
						else
							-- (Closed before it was claimed: ended now.)
							api.close(terminal, target.device):after(function() end, function() end)
						end
					end, function() end)
				end, fail)
			end
		end
	end
	end)
	-- Which shows: the terminal, once there's one to show (a real swap).
	local function kind(): string
		if failed:get() then
			return "failed"
		end
		local t = tab()
		return if t and t.command then "ready" else "opening"
	end
	return ui.column {
		id = `panel-terminal-{id}`,
		w_full = true,
		grow = 1,
		min_h = 0,
		ui.presence(kind, function(which: string): Node
			if which == "failed" then
				local why = failed:peek()
				return ds.EmptyState {
					icon = "terminal",
					size = "sm",
					fill = true,
					title = ui.t("panel.terminal.failed") :: any,
					body = (if why and why.key then ui.t(why.key) else (if why then why.text else nil) or "") :: any,
				}
			elseif which == "opening" then
				return ui.column { w_full = true, grow = 1 }
			end
			local t = tab() :: Tab
			local term = api.term(id, {
				command = t.command,
				cwd = "~",
			})
			-- The keyboard, when a person opened or turned to this tab.
			ui.on_cleanup(state.focuser(props.key, id, function()
				if term and term.focus then
					term:focus()
				end
			end))
			-- (The room round it on a box of its own: zgx's terminal fits its
			-- grid to its node and lays its rows out from that node's corner,
			-- so it takes no padding itself. And `relative`: its rows are
			-- placed absolutely, and would otherwise hang from the nearest
			-- placed box above it, the window's top, under the tab strip.)
			return ui.column {
				w_full = true,
				grow = 1,
				min_h = 0,
				px = "$space.2",
				pt = "$space.2",
				api.view {
					term = term,
					label = ui.t("panel.terminal.label"),
					relative = true,
					w_full = true,
					grow = 1,
					min_h = 0,
				},
			}
		end, { w_full = true, grow = 1, min_h = 0 }),
	}
end)

return M
]],
		["apps/zgx/ui/screens/plugins/menus.luau"] = [[
--!strict
-- What plugins add to Zeron's menus. A menu built when it opens asks for
-- its kind's items and puts them at its end, after a separator:
--
--   local menus = require("@app/screens/plugins/menus")
--   local entries = { …the menu's own… }
--   menus.extend(entries, "session", { id = session_id })
--
-- Kinds: "session" (a session's row; context { id }) and "file" (a file
-- or folder's row in the tree, or the open file; context { path, session? }).
-- A plugin adds an item with its SDK's `zeron.menu { kind, id, label, run }`
-- (it needs "ui.add"); choosing it runs `run(context)` in the plugin.
-- Items show under their plugin's name, so you can tell whose they are.

local M = {}

export type Item = { plugin: string, plugin_name: string, kind: string, id: string, label: string }

-- Published by the host from each plugin's items (src/plugins).
M.items = ui.shared("plugins.menus", {} :: { Item })

-- `kind`'s items as menu entries (ds.ContextMenu's), for `context`.
function M.entries(kind: string, context: { [string]: any }): { any }
	local out: { any } = {}
	local heading: string? = nil
	for _, item in M.items:peek() do
		if item.kind == kind then
			-- Under its plugin's name (the host lists them by plugin).
			if heading ~= item.plugin then
				heading = item.plugin
				table.insert(out, { heading = item.plugin_name })
			end
			table.insert(out, {
				label = item.label,
				on_select = function()
					ui.invoke("plugins.menu", { plugin = item.plugin, id = item.id, context = context })
				end,
			})
		end
	end
	return out
end

-- `entries` with `kind`'s items added at its end, after a separator.
function M.extend(entries: { any }, kind: string, context: { [string]: any }): { any }
	local extra = M.entries(kind, context)
	if #extra > 0 then
		table.insert(entries, { separator = true })
		for _, e in extra do
			table.insert(entries, e)
		end
	end
	return entries
end

return M
]],
		["apps/zgx/ui/screens/plugins/state.luau"] = [[
--!strict
-- The plugins on this Mac and your templates, as the host publishes them
-- (src/plugins), and what the Plugins page asks of it. Every list's items
-- carry an `id`, so rows key by it and change in place.
--
--   state.now:get()   { state = "loading" | "ready" | "offline",
--                       dirs = { plugins, templates },
--                       list = { PluginItem }      (see the contract: id, name,
--                         version, description, author { kind, username? },
--                         status "on" | "off" | "pending" | "tampered" | "broken",
--                         permissions, allowed, ask, ui, tools, mcp, error?, own)
--                       replaced = { module }  what plugins and the template
--                         in use stand in for (where a failing screen is ours) }
--
--   state.review(id, device?, device_name?)  the consent window for it
--   state.set_off(id, off, device?)  a promise; turns an allowed plugin off or on
--   state.remove(id, device?)  a promise
--   state.new_plugin(name)    a promise of its id: a new plugin of yours
--   state.open_folder(id?)    its folder (or the plugins folder) in Finder
--   state.install({ path? , url?, device? })  a promise of `{ plugin, update,
--                             added, removed, waiting }`: someone else's plugin
--                             from a .zeron-plugin file (this device only) or a
--                             link; it waits for the consent window unless it's
--                             signed as yours
--   state.update(id, device?)  a promise of the same: the update found for it
--   state.check_updates(device?)  a promise: every installed plugin's source
--                             checked
--
-- Plugins are per device. Settings → Plugins can show another of your
-- devices' (src/plugins/remote.rs), never loaded here:
--
--   state.remote:get()   { device = id?, state = "idle" | "loading" |
--                          "ready" | "offline", list = { PluginItem } }
--   state.target(id?)    show that device's (nil: this one's); the same one
--                        again looks again
--   state.device()       the device shown (nil: this one)
--   state.shown          its list
--
-- Each `device?` above is that device's id (nil: this one).
--
-- Someone else's plugin carries `source` ({ kind = "file" | "link" |
-- "release" | "git", url?, ref? }) and, when a newer version was found
-- there, `update` ({ version, added, removed, refused? }).

local M = {}

export type Author = { kind: string, username: string? }
export type Item = {
	id: string,
	name: string,
	version: string,
	description: string?,
	author: Author,
	status: string,
	permissions: { string },
	allowed: { string },
	ask: { string },
	ui: { change: { string }?, replace: { string }? }?,
	tools: { any }?,
	mcp: boolean?,
	error: string?,
	own: boolean?,
	-- What exactly it is (the engine's content hash): a decision names it.
	hash: string?,
	-- Why it stopped working here, when it did (the app withdrew it).
	failed: string?,
	-- Where someone else's came from, and a newer version found there.
	source: { kind: string, url: string?, ref: string? }?,
	update: { version: string, added: { string }, removed: { string }, refused: string? }?,
}
export type Now = {
	state: string,
	-- The modules a plugin or template stands in for now.
	replaced: { string }?,
	dirs: { plugins: string?, templates: string? }?,
	list: { Item },
}

M.now = ui.shared("plugins", { state = "loading", list = {} } :: Now)

-- The list as it shows, in the host's order (by name).
M.list = ui.computed(function(): { Item }
	return M.now:get().list or {}
end)

M.waiting = ui.computed(function(): number
	local n = 0
	for _, p in M.now:get().list or {} do
		if p.status == "pending" or p.status == "tampered" then
			n += 1
		end
	end
	return n
end)

-- Another device's, as the host watches it.
M.remote = ui.shared("plugins.remote", { state = "idle", list = {} } :: { device: string?, state: string, list: { Item } })

function M.device(): string?
	local d = M.remote:get().device
	return if type(d) == "string" and d ~= "" then d else nil
end

function M.target(device: string?)
	ui.invoke("plugins.target", device or ui.null)
end

-- The list the page shows: the device shown's.
M.shown = ui.computed(function(): { Item }
	if M.device() then
		return M.remote:get().list or {}
	end
	return M.list:get()
end)

function M.review(id: string, device: string?, device_name: string?)
	if device then
		ui.invoke("plugins.review", { id = id, device = device, device_name = device_name or "" })
	else
		ui.invoke("plugins.review", id)
	end
end

function M.set_off(id: string, off: boolean, device: string?): any
	return ui.call("plugins.set_off", { id = id, off = off, device = device })
end

function M.remove(id: string, device: string?): any
	return ui.call("plugins.remove", if device then { id = id, device = device } else id)
end

function M.new_plugin(name: string): any
	return ui.call("plugins.new", name)
end

function M.install(from: { path: string?, url: string?, device: string? }): any
	return ui.call("plugins.install", from)
end

function M.update(id: string, device: string?): any
	return ui.call("plugins.update", if device then { id = id, device = device } else id)
end

function M.check_updates(device: string?): any
	return ui.call("plugins.check_updates", if device then { device = device } else nil)
end

function M.open_folder(id: string?)
	ui.invoke("plugins.open_folder", id or ui.null)
end

return M
]],
		["apps/zgx/ui/screens/settings/appearance.luau"] = [[
-- Settings → Appearance: how Zeron looks on this Mac, the shell's own
-- look (screens/shell/appearance: the scheme, which setup chose too; a new
-- chat's wallpaper and its effect) and the window's glass (ds.material).

local ds = require("@ds")
local material = require("@ds/material")
local math_ = require("@ds/math")
local appearance = require("@app/screens/shell/appearance")
local search = require("@app/screens/settings/search")
local prefs = require("@app/screens/settings/prefs")
local wallpaper = require("@app/screens/settings/wallpaper")
local plugin_settings = require("@app/screens/plugins/settings")
