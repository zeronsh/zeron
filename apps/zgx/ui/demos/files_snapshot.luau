		["apps/zgx/ui/ds/activity.luau"] = [[
-- What an agent did on its way to a reply, as Zeron's transcript draws its
-- tools (transcript.rs, `activity_rail`): a quiet summary ("Ran 3 commands ·
-- read 2 files"), the working loader before it while it works, and under it,
-- open (a click on the summary), a
-- row a tool: a hairline trunk down the gutter, a rounded elbow off it to
-- each tool's glyph, then what it did. The sidebar's groups draw the same
-- tree (`$zeron.tree`, 1 point, 6-point elbows).
--
-- While the agent works the tree is open and its rows arrive one by one,
-- each sliding in under the last as the trunk reaches down to it; the
-- summary rolls as it grows. Settled, it folds to its summary unless opened.
--
-- A thought is a row with no glyph, no branch and no line of its own: its
-- words themselves sit in the tree, rendered as the reply's markdown is,
-- folded past four lines under "Show all N lines" (`thought_row`). The
-- trunk runs past a thought only to a tool below it: the tree ends at the
-- last tool call.
--
-- `Activity { tools = function() return tools end, live = function() … end }`.

local tree_line = require("@self/tree_line")
local control = require("@self/control")
local Icon = require("@self/icon")
local FadeText = require("@self/fade_text")
local status = require("@self/status")
local ToolDetail = require("@self/tool_detail")
local Markdown = require("@self/markdown")
local locale = require("@self/locale")

export type Kind = "exec" | "read" | "edit" | "write" | "search" | "glob" | "web" | "todo" | "agent" | "thought"
-- One tool: what kind, what it did ("Read", "transcript.rs"), and for an
-- edit the lines it added and removed; `failed` tints its glyph.
export type Tool = {
	id: string,
	kind: Kind,
	verb: string,
	-- A subagent's spawn: the doc it runs in, how it stands, its title.
	subagent: { ref: string, title: string?, status: string? }?,
	target: string?,
	-- The whole call, when the line says less (a command of many lines, a
	-- tool's input): the row opens to it.
	call: string?,
	-- Its call is prose (a thought's words), not code.
	prose: boolean?,
	-- Being written now (a thought's words still coming): its fold shows
	-- the latest lines, as Zeron's streaming thought keeps its tail.
	live: boolean?,
	added: number?,
	removed: number?,
	failed: boolean?,
	-- What its row opens to beyond its call (ds/tool_detail): its output's
	-- summary, its files' counts, an older doc's diff, and the refs of its
	-- whole output and diff.
	output: string?,
	output_ref: string?,
	output_bytes: number?,
	diff_ref: string?,
	stats: { ToolDetail.Stat }?,
	diff: ToolDetail.Diff?,
}

export type Props = {
	tools: () -> { Tool },
	live: (() -> boolean)?,
	-- How long it worked, in seconds, once it is done ("Worked for 42s").
	worked: (() -> number?)?,
	-- Its line, as the caller words it (Zeron's grouping, the host's); by
	-- default, counted from its tools here.
	summary: (() -> string?)?,
	-- A name to keep whether the reader opened or folded it under, across
	-- it being made again (a reload, a list row scrolled back).
	key: string?,
	-- What it folds, made only while open or folding, in place of its
	-- tools' rows: a compact transcript's work (its words and groups).
	body: (() -> Node)?,
	-- A subagent's spawn row (its tool's `subagent`): what opens it (its
	-- lane). Without it, the row opens its call as any does.
	open_subagent: ((sub: any) -> ())?,
}

local GLYPH: { [Kind]: Icon.Name } = {
	exec = "terminal",
	read = "document",
	edit = "pen",
	write = "document-add",
	search = "search",
	glob = "folder-with-files",
	web = "global",
	todo = "checklist",
	agent = "bot",
	thought = "chat-round-line",
}

-- The tree, in points: the trunk's x (under the working loader's middle, so
-- the trunk runs down from it), the elbow's radius (Zeron's), where the
-- branch ends, the glyph's place and size, and the gutter they take before
-- the words. Zeron hangs its tree off a chevron 12 points in; with no
-- chevron the tree starts at the reply's own left edge. Rows are a little
-- tighter than Zeron's 32: a long run of tools reads as one list, not a
-- column of chips.
local LOADER = 16
local TRUNK, BEND, BRANCH_END = LOADER / 2 + 0.5, 6, 20
local GLYPH_LEFT, GLYPH_SIZE = 24, 16
local GUTTER = 48
local ROW, HEADER = 28, 26
-- How long the tree takes to open and fold.
local FOLD = 200

-- The summary: each kind counted, in the order an agent tends to work.
-- (Each kind's phrase a message, `{n, plural, …}`: its key.)
local PHRASES: { { kind: Kind, key: string } } = {
	{ kind = "thought", key = "ds.activity.phrase.thought" },
	{ kind = "search", key = "ds.activity.phrase.search" },
	{ kind = "glob", key = "ds.activity.phrase.glob" },
	{ kind = "read", key = "ds.activity.phrase.read" },
	{ kind = "exec", key = "ds.activity.phrase.exec" },
	{ kind = "edit", key = "ds.activity.phrase.edit" },
	{ kind = "write", key = "ds.activity.phrase.write" },
	{ kind = "web", key = "ds.activity.phrase.web" },
	{ kind = "todo", key = "ds.activity.phrase.todo" },
	{ kind = "agent", key = "ds.activity.phrase.agent" },
}

local function summary(tools: { Tool }): string
	local counts: { [string]: number } = {}
	local failed = 0
	for _, t in tools do
		counts[t.kind] = (counts[t.kind] or 0) + 1
		if t.failed then
			failed += 1
		end
	end
	local parts: { string } = {}
	for _, p in PHRASES do
		local n = counts[p.kind]
		if n then
			table.insert(parts, locale.s(p.key, { n = n }))
		end
	end
	if failed > 0 then
		table.insert(parts, locale.s("ds.activity.failed", { n = tostring(failed) }))
	end
	local s = table.concat(parts, " · ")
	return string.upper(string.sub(s, 1, 1)) .. string.sub(s, 2)
end

-- What a row's line says of its tool, on one line whatever it was given
-- (a command's newlines, a pattern's tabs, as single spaces).
local function line_of(t: Tool): string
	return (string.gsub(t.target or "", "%s+", " "))
end

-- A row opened: the whole call, in its own block under the line, wrapping,
-- as tall as it is.
local function call_block(now: () -> Tool): Node
	return ui.div {
		ml = ui.raw(GUTTER, "under the line's words, past the tree's gutter"),
		mb = "$space.1",
		px = "$space.3",
		py = "$space.2",
		rounded = "$radius.md",
		bg = "$zeron.code.wash",
		ui.text {
			function(): string
				return now().call or ""
			end,
			literal = true,
			wrap = true,
			font = if now().prose then nil else "$font.mono",
			text_size = if now().prose then "$font.size.sm" else "$font.size.xs",
			line_height = if now().prose then "$font.line.sm" else "$font.line.xs",
			color = "$text.secondary",
		},
	}
end

-- One tool's row: its branch off the trunk (the trunk going on below unless
-- it is the last), its glyph, what it did, on one line that clips whatever
-- is in it, so no tool's words draw over the next. It follows its tool
-- (`now`) as it goes on: finished, failed, its lines counted. A tool whose
-- line says less than its call opens to it (a press on the line), kept open
-- by its id.
-- (`running`: it is the one in flight, its glyph the working loader.)
-- What the reader opened, kept apart from the rows (a reload, a row
-- scrolled back): each tool's call by its id, each group by its key. One
-- map each, holding only what's open (or, for a group, chosen), not a
-- state per tool.
local CALLS_OPEN = ui.state("activity_calls_open", {} :: { [string]: boolean })
local GROUPS_CHOSEN = ui.state("activity_groups_chosen", {} :: { [string]: boolean })

-- A thought's row: no glyph, no branch, no header, its words themselves
-- where a tool's line sits, rendered as the reply's markdown is
-- (ds/markdown, a step smaller, in the secondary ink); the trunk passes it
-- only on its way to a tool below (`below`). Past four lines it folds: the
-- words fade out over the last line and a half, and under them, once they
-- have faded away, a small quiet "Show all N lines"; opened, the whole
-- thought, "Show fewer lines" under it to fold it back.
-- Open is kept by the thought's id, as a call's is. A thought that fits
-- shows no button. Whether it folds is measured, as a long message's is
-- (ds/user_message): the words are laid out whole behind the clip, so
-- nothing rewraps as it opens.
--
-- Being written or settled, the fold is the same: its first lines, fading
-- out at the foot, "Show all N lines" under them. (Zeron's streaming thought
-- keeps its tail, the fade at the top; the user wanted one fold, faded at
-- the foot, Nov 2 2026.)
local THOUGHT_LINES = 4
local THOUGHT_FADE = 1.5
-- The button, and the room it takes under the words (folded, under their
-- faded foot; open, under their last line).
local THOUGHT_BUTTON = 20
local THOUGHT_ROOM = THOUGHT_BUTTON + 6
-- The gap ds/markdown leaves between a small text's blocks (`$space.3`):
-- taken off the words' height to count their lines.
local THOUGHT_GAP = 12

local function thought_row(now: () -> Tool, below: () -> boolean): Node
	local id = now().id
	local line = ui.theme.get("zeron.prose.small.line") :: number
	local folded_h = THOUGHT_LINES * line
	local body = ui.ref()
	local function is_open(): boolean
		return CALLS_OPEN:get()[id] == true
	end
	local function set_open(on: boolean)
		local all = table.clone(CALLS_OPEN:peek())
		all[id] = on
		CALLS_OPEN:set(all)
	end
	local function live(): boolean
		return now().live == true
	end
	-- (A thought named only, without its words: its name.)
	local function words(): string
		return now().call or now().verb
	end
	-- Folds once the words run past four lines (half a point over for
	-- rounding); a ref reads 0 before its first layout, so a thought stands
	-- open until measured, which for one that fits changes nothing.
	local long = ui.computed(function(): boolean
		return (body.height or 0) > folded_h + 0.5
	end)
	local function folded(): boolean
		return long:get() and not is_open()
	end
	-- About how many lines the words run to: their height in lines of the
	-- prose, less the gaps between their blocks.
	local function lines(): number
		local gaps = 0
		for _ in string.gmatch(words(), "\n%s*\n") do
			gaps += 1
		end
		return math.max(1, math.floor(((body.height or 0) - gaps * THOUGHT_GAP) / line + 0.5))
	end
	-- The clip: four lines while folded; open, as tall as the words. Not
	-- measured yet (just mounted: a tool group opening), four lines too, a
	-- ceiling a short thought never meets: a long one starts folded rather
	-- than standing whole for a frame and shrinking back, which made a group
	-- opening overshoot and settle.
	local function window(): number
		if (body.height or 0) <= 0 and not is_open() then
			return folded_h
		end
		return if folded() then folded_h else 1e6
	end
	-- Written and folded: the words shifted up so their latest line sits
	-- at the window's foot.
	local function rise(): number
		return 0
	end
	local function fade(): { number }
		if not folded() then
			return { 0, 0 }
		end
		local px = line * THOUGHT_FADE
		return { 0, px }
	end
	local function label(): string
		return if is_open() then locale.s("ds.activity.show_fewer_lines") else locale.s("ds.activity.show_all_lines", { n = tostring(lines()) })
	end
	return ui.column {
		w_full = true,
		relative = true,
		class = "thought",
		-- No branch: the trunk alone, past the words to a tool below, when
		-- one follows; nothing when the thought ends the group.
		ui.canvas {
			absolute = true,
			left = 0,
			top = 0,
			bottom = 0,
			w = TRUNK + 1,
			pointer_events = "none",
			draw = function(c, _, h)
				if below() then
					c:rect(TRUNK - 0.5, 0, 1, h, "$zeron.tree")
				end
			end,
		},
		ui.div {
			w_full = true,
			min_w = 0,
			pl = ui.raw(GUTTER, "where a tool's words start, past the tree's gutter"),
			py = ui.raw((ROW - line) / 2, "the first line's middle on the branch, as a tool's line is"),
			ui.column {
				relative = true,
				w_full = true,
				min_w = 0,
				ui.column {
					class = "thought-words",
					w_full = true,
					min_w = 0,
					overflow = "hidden",
					max_h = window,
					layout = "height",
					layout_clip = true,
					layout_duration = 260,
					layout_ease = "outQuart",
					fade = fade,
					ui.column {
						ref = body,
						class = "thought-body",
						w_full = true,
						min_w = 0,
						shrink = 0,
						y = rise,
						Markdown {
							text = words,
							-- (Parsed incrementally while it can grow.)
							key = if now().live then `thought:{id}` else nil,
							small = true,
							ink = "$text.secondary",
						},
					},
				},
				-- The button's room under the clip, once there is a button:
				-- the words have faded away before it shows.
				ui.div {
					w_full = true,
					shrink = 0,
					h = function(): number
						return if long:get() then THOUGHT_ROOM else 0
					end,
				},
				-- The way to open and fold it: a small, quiet button on the
				-- fill, at the words' left edge, in the room under them.
				ui.show(
					long,
					ui.button {
						label = label,
						expanded = is_open,
						absolute = true,
						left = 0,
						bottom = 0,
						h = THOUGHT_BUTTON,
						px = "$zeron.space.tight",
						items = "center",
						rounded = "$radius.sm",
						bg = "$zeron.secondary.bg",
						color = "$text.secondary",
						hover = { bg = "$zeron.secondary.hover", color = "$text.primary" },
						active = { bg = "$zeron.secondary.active", color = "$text.primary" },
						focus = control.ring,
						cursor = "pointer",
						selectable = false,
						on_click = function()
							set_open(not is_open())
						end,
						ui.text {
							label,
							text_size = "$font.size.xs",
							weight = "$font.weight.medium",
						},
					}
				),
			},
		},
	}
end

-- (`below`: a tool with a branch follows, so the trunk runs on under this
-- one; `running`: it is the one in flight, its glyph the working loader.)
local function row(now: () -> Tool, below: () -> boolean, running: () -> boolean, open_subagent: ((sub: any) -> ())?): Node
	if now().kind == "thought" then
		return thought_row(now, below)
	end
	local function tint(): string
		return if now().failed then "$danger" else "$text.secondary"
	end
	local id = now().id
	local function has_call(): boolean
		return now().call ~= nil
	end
	-- Opens to what it did, too: an edit's diff, a command's output, a
	-- read's or a search's result (ds/tool_detail), once it has some.
	local function has_detail(): boolean
		return ToolDetail.has(now() :: any)
	end
	-- Open as the reader left it (opened or closed), else closed.
	local function showing(): boolean
		if not (has_call() or has_detail()) then
			return false
		end
		return CALLS_OPEN:get()[id] == true
	end
	-- A subagent's spawn, with somewhere to open it: the row opens its lane.
	local function lane(): any
		return if open_subagent then (now() :: any).subagent else nil
	end
	-- (A tool that may come to have a result opens: whether it has one
	-- isn't known as its row is made.)
	local OPENS: { [string]: boolean } = { exec = true, read = true, edit = true, write = true, search = true, glob = true, web = true }
	local opens = has_call() or lane() ~= nil or OPENS[now().kind] == true
	return ui.column {
		w_full = true,
		relative = true,
		-- The branch, and the trunk on down past an opened call.
		ui.canvas {
			absolute = true,
			left = 0,
			top = 0,
			bottom = 0,
			w = BRANCH_END + 1,
			pointer_events = "none",
			draw = function(c, _, h)
				local mid = ROW / 2
				c:fill(tree_line.branch { x = TRUNK, mid = mid, tip = BRANCH_END, h = h, bend = BEND, on = below() }, "$zeron.tree")
			end,
		},
		ui.button {
			w_full = true,
			h = ROW,
			p = 0,
			items = "center",
			relative = true,
			overflow = "hidden",
			bg = "#00000000",
			hover = { bg = "#00000000" },
			active = { bg = "#00000000" },
			-- Only a row that opens is a stop for the keys (a long run of
			-- tools isn't a long run of stops), its ring showing there.
			focusable = opens,
			focus = if opens then control.ring else { border = 0 },
			selectable = false,
			label = function(): string
				local t = now()
				local sub = lane()
				if sub then
					return locale.s("ds.activity.open_subagent", { title = sub.title or locale.s("ds.activity.subagent") })
				end
				return if t.target then `{t.verb} {line_of(t)}` else t.verb
			end,
			-- (A tool's call comes with it: whether it opens is known as its
			-- row is made.)
			expanded = if opens then showing else nil,
			cursor = if opens then "pointer" else nil,
			on_click = function()
				local sub = lane()
				if sub and open_subagent then
					open_subagent(sub)
					return
				end
				if has_call() or has_detail() then
					local all = table.clone(CALLS_OPEN:peek())
					all[id] = not showing()
					CALLS_OPEN:set(all)
				end
			end,
			ui.div {
				absolute = true,
				left = GLYPH_LEFT,
				top = (ROW - GLYPH_SIZE) / 2,
				color = tint,
				ui.show(running, status.StatusIcon { kind = "working", size = GLYPH_SIZE }, Icon {
					name = function(): Icon.Name
						return GLYPH[now().kind]
					end,
					size = GLYPH_SIZE,
				}),
			},
			ui.row {
				pl = ui.raw(GUTTER, "past the tree's gutter"),
				grow = 1,
				min_w = 0,
				gap = "$space.1",
				items = "center",
				ui.text {
					function(): string
						return now().verb
					end,
					literal = true,
					shrink = 0,
					text_size = "$font.size.sm",
					color = "$text.secondary",
				},
				ui.show(
					function(): boolean
						return now().target ~= nil
					end,
					FadeText {
						function(): string
							return line_of(now())
						end,
						literal = true,
						shrink = 1,
						font = "$font.mono",
						text_size = "$font.size.sm",
						color = "$text.primary",
					}
				),
				-- An edit's lines, added and removed, in their hues.
				ui.show(
					function(): boolean
						return now().added ~= nil
					end,
					ui.text {
						function(): string
							return `+{now().added or 0}`
						end,
						shrink = 0,
						tabular = true,
						font = "$font.mono",
						text_size = "$font.size.xs",
						color = "$success",
					}
				),
				ui.show(
					function(): boolean
						local r = now().removed
						return r ~= nil and r > 0
					end,
					ui.text {
						function(): string
							return `−{now().removed or 0}`
						end,
						shrink = 0,
						tabular = true,
						font = "$font.mono",
						text_size = "$font.size.xs",
						color = "$danger",
					}
				),
			},
		},
		ui.show(
			showing,
			ui.column {
				w_full = true,
				ui.show(has_call, call_block(now)),
				ui.show(
					has_detail,
					ui.div {
						ml = ui.raw(GUTTER, "under the line's words, past the tree's gutter"),
						mb = "$space.1",
						ToolDetail.ToolDetail { tool = now :: any },
					}
				),
			}
		),
	}
end

return ui.component(function(props: Props): Node
	local live = props.live or function()
		return false
	end
	-- What the reader chose (nil until they do): open while it works, folded
	-- once it's done, unless they said otherwise.
	-- Kept under `key` when given, so one opened stays open as it is made
	-- again (a reload, its row scrolled back).
	local own = ui.use_state(nil :: boolean?)
	local key = props.key
	local function choice(): boolean?
		return if key then GROUPS_CHOSEN:get()[key] else own:get()
	end
	local function choose(on: boolean)
		if key then
			local all = table.clone(GROUPS_CHOSEN:peek())
			all[key] = on
			GROUPS_CHOSEN:set(all)
		else
			own:set(on)
		end
	end
	local function open(): boolean
		local c = choice()
		if c ~= nil then
			return c
		end
		return live()
	end
	local opened = ui.computed(open)
	local tools = ui.computed(props.tools)
	-- Each tool by its id: a row finds its own at once, not by a walk of
	-- the group.
	local by_id = ui.computed(function(): { [string]: Tool }
		local out: { [string]: Tool } = {}
		for _, x in tools:get() do
			out[x.id] = x
		end
		return out
	end)
	local count = ui.computed(function(): number
		return #tools:get()
	end)
	local title = ui.computed(function(): string
		local given = if props.summary then props.summary() else nil
		local s = given or summary(tools:get())
		local secs = if props.worked then props.worked() else nil
		if secs and not live() then
			return locale.s("ds.activity.worked_for", { secs = tostring(secs), summary = s })
		end
		return s
	end)
	-- Each tool's place in the list, to know the last (the one in flight
	-- while the group works).
	local function last_of(t: Tool): () -> boolean
		return function(): boolean
			local list = tools:get()
			return list[#list] ~= nil and list[#list].id == t.id
		end
	end
	-- Whether the trunk runs on below a tool: one with a branch (any but a
	-- thought) comes after it. (A thought draws no branch, so the tree ends
	-- at the last tool call.)
	local function below_of(t: Tool): () -> boolean
		return function(): boolean
			local seen = false
			for _, x in tools:get() do
				if seen and x.kind ~= "thought" then
					return true
				end
				if x.id == t.id then
					seen = true
				end
			end
			return false
		end
	end
	-- The rows exist while the tree is open or folding: folded away, they'd
	-- be built for nothing as a list scrolls, and a selection across the
	-- reply would take text no one can see.
	local mounted = ui.use_state(opened:peek())
	local folding: (() -> ())? = nil
	ui.effect(function()
		local on = opened:get()
		if folding then
			folding()
			folding = nil
		end
		if on then
			mounted:set(true)
		elseif mounted:peek() then
			folding = ui.after(FOLD, function()
				folding = nil
				mounted:set(false)
			end)
		end
	end)
	return ui.column {
		w_full = true,
		ui.show(
			function()
				return count:get() > 0
			end,
			ui.button {
				label = title,
				expanded = opened,
				-- (A control, not what was said: out of a selection across the reply.)
				selectable = false,
				h = HEADER,
				p = 0,
				bg = "#00000000",
				active = { bg = "#00000000" },
				w_full = true,
				items = "center",
				gap = "$space.2",
				cursor = "pointer",
				color = "$text.secondary",
				hover = { color = "$text.primary", bg = "#00000000" },
				focus = { border = 0 },
				on_click = function()
					choose(not open())
				end,
				-- The press is the toggle's from press to release (zgx keeps
				-- the pointer for a node with both), so the reply's
				-- selection around it never starts, extends or picks a word
				-- from it, however the fold moves the words under the
				-- pointer.
				on_press = function() end,
				on_release = function() end,
				-- While it works, the working loader before the summary, its
				-- ring over the trunk below; done, the summary alone, on the
				-- reply's left edge.
				ui.show(live, status.StatusIcon { kind = "working", size = LOADER }),
				FadeText { title, roll = true, grow = 1, text_size = "$font.size.sm" },
			}
		),
		-- The tree: its rows, each arriving under the last.
		ui.column {
			w_full = true,
			overflow = "hidden",
			layout = "height",
			layout_clip = true,
			layout_duration = FOLD,
			layout_ease = "outQuart",
			max_h = function(): number
				return if opened:get() then 1e6 else 0
			end,
			if props.body
				then ui.presence(function(): string?
					return if mounted:get() then "body" else nil
				end, function(): Node
					return (props.body :: () -> Node)()
				end, { w_full = true })
				else ui.show(
				mounted,
				ui.each(tools, function(t: Tool)
					local last = last_of(t)
					-- (An animated list's rows have no row state: the tool as
					-- it is now, found by its id.)
					local now = ui.computed(function(): Tool
						return by_id:get()[t.id] or t
					end)
					return row(function(): Tool
						return now:get()
					end, below_of(t), function(): boolean
						return live() and last()
					end, props.open_subagent)
				end, {
					key = function(t: Tool): string
						return t.id
					end,
					enter = { opacity = { 0, 1 }, y = { -6, 0 }, duration = 360, ease = "outExpo" },
				})
			),
		},
	}
end)
]],
		["apps/zgx/ui/ds/appearance_picker.luau"] = [[
-- Make it yours: how Zeron looks, chosen in three rows, each seen as it's
-- made. The colour scheme (System, Light, Dark), each a small window drawn
-- in that scheme; the window's material (Frosted, the desktop showing
-- through it softly, or Opaque); and the accent, Zeron's presets after the
-- theme's own (ds/look). Setup's first step after sign-in is this, and the
-- gallery's Make it yours draws it too.
--
--   AppearancePicker { scheme = state, frosted = state, accent = state }
--
-- It only sets the states: the window round it takes each choice (the app
-- applies its scheme, material and accent; the gallery previews them in its
-- stage), so the step is its own preview, the accent showing in the ring of
-- the chosen card and in each small window's send button.

local Settings = require("@self/settings")
local Segmented = require("@self/segmented")
local control = require("@self/control")
local look = require("@self/look")
local locale = require("@self/locale")
local palettes = require("@self/palettes")

export type Props = {
	-- "system", "light" or "dark".
	scheme: State<string>,
	frosted: State<boolean>,
	-- An accent's value (ds/look's ACCENTS).
	accent: State<string>,
}

-- The scheme cards' geometry: three across the list's measure (480) with a
-- gap of 12; the small window inside each at the card's even inset.
local CARD_W = 152
local INSET = 4
local PREVIEW_W = CARD_W - 2 * (1 + INSET)
-- Near a window's own proportions (the user found 56 squished).
local PREVIEW_H = 72
-- The small window's own parts: its sidebar, a row of it, the composer.
local SIDE_W = 44
local SIDE_ROW = 10
local COMPOSER = 14

-- A small window in one scheme: its sidebar with the chosen chat in the
-- sidebar's wash, two lines of a chat, and the composer with the accent's
-- send button at its end. Drawn in the scheme's own tokens, whatever the
-- window around it shows.
local function miniature(on_dark: boolean, chosen_ink: () -> string): Node
	local function line(w: string): Node
		return ui.div { h = 4, w = w, shrink = 0, rounded = "$radius.full", bg = "$border.strong" }
	end
	local function side_row(selected: boolean, w: string): Node
		return ui.row {
			w_full = true,
			h = SIDE_ROW,
			shrink = 0,
			px = "$zeron.space.hair",
			items = "center",
			rounded = "$radius.sm",
			bg = if selected then "$zeron.selected.flat.bg" else nil,
			line(w),
		}
	end
	return ui.row {
		-- (The scheme as worn now: a template's colours, or Zeron's.)
		theme = if on_dark then palettes.scheme.dark else palettes.scheme.light,
		w = PREVIEW_W,
		h = PREVIEW_H,
		shrink = 0,
		bg = "$zeron.window",
		ui.column {
			w = SIDE_W,
			h_full = true,
			shrink = 0,
			p = "$space.1",
			gap = "$zeron.space.hair",
			bg = "$hover",
			side_row(true, "70%"),
			side_row(false, "55%"),
			side_row(false, "80%"),
		},
		ui.column {
			grow = 1,
			min_w = 0,
			h_full = true,
			p = "$space.2",
			gap = "$space.1",
			line("75%"),
			line("50%"),
			ui.div { grow = 1 },
			ui.row {
				w_full = true,
				h = COMPOSER,
				shrink = 0,
				p = "$zeron.space.hair",
				justify = "end",
				rounded = "$radius.full",
				border = 1,
				border_color = "$border",
				-- (A pill's contents are pills.)
				ui.div {
					w = COMPOSER - 2 * 3,
					h_full = true,
					rounded = "$radius.full",
					bg = chosen_ink,
				},
			},
		},
	}
end

-- System: the two schemes side by side, dark at the left, light at the
-- right, one window cut down the middle.
local function halves(chosen_ink: () -> string): Node
	local half = PREVIEW_W / 2
	return ui.row {
		w = PREVIEW_W,
		h = PREVIEW_H,
		shrink = 0,
		ui.div { w = half, h_full = true, shrink = 0, relative = true, overflow = "hidden", ui.div { absolute = true, left = 0, top = 0, miniature(true, chosen_ink) } },
		ui.div { w = half, h_full = true, shrink = 0, relative = true, overflow = "hidden", ui.div { absolute = true, left = -half, top = 0, miniature(false, chosen_ink) } },
	}
end

-- A scheme as an option card: the small window, its name under it. Chosen,
-- the accent's ring over its edge (onboarding's option cards: a ring,
-- never a fill or a shadow), easing in.
local function scheme_card(scheme: State<string>, chosen_ink: () -> string, value: string, label: string | Message): Node
	local function on(): boolean
		return scheme:get() == value
	end
	local function pick()
		scheme:set(value)
	end
	local preview = if value == "system" then halves(chosen_ink) else miniature(value == "dark", chosen_ink)
	return ui.column {
		role = "radio",
		checked = on,
		label = label,
		focusable = true,
		cursor = "pointer",
		relative = true,
		w = CARD_W,
		shrink = 0,
		p = ui.raw(INSET, "the card's even inset round its window"),
		gap = "$space.1",
		rounded = "$radius.xl",
		border = 1,
		bg = "$zeron.option.bg",
		border_color = "$zeron.option.edge",
		hover = { bg = "$hover" },
		focus = control.ring,
		on_click = pick,
		on_key = function(e)
			if e.key == " " or e.key == "Enter" then
				pick()
				return true
			end
			return false
		end,
		-- The small window follows the card's corner, its inset in.
		ui.div {
			w_full = true,
			shrink = 0,
			rounded = ui.raw(control.nest("$radius.xl", 1, INSET), "the card's corner, its edge and inset in"),
			overflow = "hidden",
			preview,
		},
		ui.text {
			label,
			w_full = true,
			-- Room under the name to the card's edge, as much as over it.
			py = "$space.1",
			align = "center",
			text_size = "$font.size.sm",
			line_height = "$font.line.sm",
			weight = "$font.weight.medium",
			color = function()
				return if on() then "$text.primary" else "$text.secondary"
			end,
		},
		ui.div {
			absolute = true,
			left = -1,
			top = -1,
			right = -1,
			bottom = -1,
			rounded = "$radius.xl",
			border = 2,
			border_color = chosen_ink,
			pointer_events = "none",
			opacity = ui.tween(ui.computed(function(): number
				return if on() then 1 else 0
			end), { duration = 140 }),
		},
	}
end

-- An accent as a swatch, its ring (the text's ink, round the dot with a
-- gap) easing in when it's chosen. Each preset's swatch shows the ink it
-- would take in the scheme shown.
local SWATCH = 16
local RING = 24
local function swatch(accent: State<string>, a: look.Accent): Node
	local function on(): boolean
		return accent:get() == a.value
	end
	local function pick()
		accent:set(a.value)
	end
	return ui.row {
		role = "radio",
		checked = on,
		-- (Read in a function: its name follows the locale.)
		label = function(): string
			return a.label
		end,
		focusable = true,
		cursor = "pointer",
		relative = true,
		w = RING,
		h = RING,
		shrink = 0,
		items = "center",
		justify = "center",
		rounded = "$radius.full",
		focus = control.ring,
		on_click = pick,
		on_key = function(e)
			if e.key == " " or e.key == "Enter" then
				pick()
				return true
			end
			return false
		end,
		ui.div {
			w = SWATCH,
			h = SWATCH,
			rounded = "$radius.full",
			bg = look.ink(a),
		},
		ui.div {
			absolute = true,
			left = 0,
			top = 0,
			right = 0,
			bottom = 0,
			rounded = "$radius.full",
			border = 2,
			border_color = "$text.secondary",
			pointer_events = "none",
			opacity = ui.tween(ui.computed(function(): number
				return if on() then 1 else 0
			end), { duration = 140 }),
		},
	}
end

-- The accents as a row of swatches, one chosen (Settings → Appearance's
-- Accent row; this picker's own).
local function accents(accent: State<string>): Node
	local swatches: { Node } = {}
	for _, a in look.ACCENTS do
		table.insert(swatches, swatch(accent, a))
	end
	return ui.row {
		role = "radiogroup",
		label = locale.t("ds.appearance_picker.accent"),
		items = "center",
		table.unpack(swatches),
	}
end

local function picker(props: Props): Node
	local scheme, frosted, accent = props.scheme, props.frosted, props.accent
	local function chosen_ink(): string
		return look.ink(look.find(accent:get()))
	end
	-- The cards and the rows under them a step closer than a form's own
	-- gap: one set of choices, and the window's room.
	return ui.column {
		w_full = true,
		gap = "$space.3",
		ui.row {
			w_full = true,
			gap = "$space.3",
			role = "radiogroup",
			label = locale.t("ds.appearance_picker.color_scheme"),
			scheme_card(scheme, chosen_ink, "system", locale.t("ds.appearance_picker.scheme.system")),
			scheme_card(scheme, chosen_ink, "light", locale.t("ds.appearance_picker.scheme.light")),
			scheme_card(scheme, chosen_ink, "dark", locale.t("ds.appearance_picker.scheme.dark")),
		},
		Settings.Group {
			Settings.Row {
				label = locale.t("ds.appearance_picker.window"),
				description = function()
					return if frosted:get() then locale.s("ds.appearance_picker.frosted_hint") else locale.s("ds.appearance_picker.opaque_hint")
				end,
				control = Segmented {
					value = frosted,
					label = locale.t("ds.appearance_picker.window"),
					segment = 64,
					options = {
						{ value = true, label = locale.t("ds.appearance_picker.frosted") },
						{ value = false, label = locale.t("ds.appearance_picker.opaque") },
					},
				},
			},
			Settings.Row {
				label = locale.t("ds.appearance_picker.accent"),
				description = function()
					return look.find(accent:get()).label
				end,
				control = accents(accent),
			},
		},
	}
end

-- `AppearancePicker { scheme, frosted, accent }`, and its accents alone
-- (`AppearancePicker.Accents { value = state }`).
return setmetatable({
	Accents = function(p: { value: State<string> }): Node
		return accents(p.value)
	end,
}, {
	__call = function(_: any, props: Props): Node
		return picker(props)
	end,
})
]],
		["apps/zgx/ui/ds/button.luau"] = [[
-- Buttons, as Zeron's are: 8-point corners (6 small) unless `shape =
-- "pill"`. `Button { "Continue", on_click = … }` is the primary; `tone`
-- picks its weight (`danger` for a confirm that can't be taken back),
-- `size` its height (`xs`, a header's or a bar's, the panel controls' 24). An icon goes beside the text as a
-- child (`ds.Icon`); `icon = true` makes a square button of an icon alone
-- (give it a `label`). Every tone says its own hover and press: zgx's button
-- would otherwise lay its own pressed wash over the fill.

local recipe = ui.variants {
	base = {
		items = "center",
		justify = "center",
		gap = "$space.2",
		font = "$font.sans",
		weight = "$font.weight.medium",
		cursor = "pointer",
		disabled = { opacity = 0.4 },
	},
	variants = {
		tone = {
			-- The way on: one per screen.
			primary = {
				bg = "$zeron.primary.bg",
				color = "$zeron.primary.text",
				hover = { bg = "$zeron.primary.hover" },
				active = { bg = "$zeron.primary.active" },
			},
			-- Beside it: a fill, firmer as it is touched.
			secondary = {
				bg = "$zeron.secondary.bg",
				color = "$text.primary",
				hover = { bg = "$zeron.secondary.hover" },
				active = { bg = "$zeron.secondary.active" },
			},
			-- Back, Skip: text until touched.
			ghost = {
				bg = "#00000000",
				color = "$text.secondary",
				hover = { bg = "$zeron.secondary.bg", color = "$text.primary" },
				active = { bg = "$zeron.secondary.hover", color = "$text.primary" },
			},
			accent = {
				bg = "$accent",
				color = "$accent.text",
				hover = { bg = "$accent.hover" },
				active = { bg = "$zeron.accent.active" },
			},
			-- Delete, Discard: a confirm that can't be taken back.
			danger = {
				bg = "$zeron.destructive.bg",
				color = "$zeron.destructive.text",
				hover = { bg = "$zeron.destructive.hover" },
				active = { bg = "$zeron.destructive.active" },
			},
		},
		size = {
			-- A header's or a bar's: the panel's controls' height (its icon
			-- buttons', its chips'), their padding and corner.
			xs = { h = 24, px = "$zeron.space.tight", rounded = "$radius.lg", text_size = "$font.size.sm" },
			sm = { h = 28, px = "$zeron.space.snug", rounded = "$radius.md", text_size = "$font.size.sm" },
			md = { h = "$control.height", px = "$space.3", rounded = "$radius.lg", text_size = "$font.size.md" },
			lg = { h = 40, px = "$space.5", rounded = "$radius.lg", text_size = "$font.size.lg" },
		},
		shape = { rounded = {}, pill = {} },
		icon = { [true] = {}, [false] = {} },
	},
	-- Shape and icon decide over the sizes' corners and padding.
	compound = {
		{ shape = "pill", rounded = "$radius.full" },
		{ icon = true, size = "xs", w = 24, px = 0 },
		{ icon = true, size = "sm", w = 28, px = 0 },
		{ icon = true, size = "md", w = "$control.height", px = 0 },
		{ icon = true, size = "lg", w = 40, px = 0 },
	},
	defaults = { tone = "primary", size = "md", shape = "rounded", icon = false },
}

export type Tone = "primary" | "secondary" | "ghost" | "accent" | "danger"
export type Size = "xs" | "sm" | "md" | "lg"
export type Shape = "rounded" | "pill"
export type Props = Merge<ContainerProps, {
	tone: Tone?,
	size: Size?,
	shape: Shape?,
	icon: boolean?,
	-- Working (a state or a function): a spinner in the label's place, the
	-- label kept (unseen) so the button holds its width, and clicks ignored.
	-- Never "Saving…".
	busy: (State<boolean> | () -> boolean)?,
	[number]: Child,
}>

-- The spinner in each tone's text colour, and at each size.
local INK: { [string]: string } = {
	primary = "$zeron.primary.text",
	secondary = "$text.primary",
	ghost = "$text.secondary",
	accent = "$accent.text",
	danger = "$zeron.destructive.text",
}
local SPIN: { [string]: number } = { sm = 12, md = 14, lg = 16 }

local status = require("@self/status")

return function(props: Props): Node
	local p = table.clone(props) :: any
	p.variants = recipe { tone = props.tone, size = props.size, shape = props.shape, icon = props.icon }
	p.tone, p.size, p.shape, p.icon, p.busy = nil, nil, nil, nil, nil
	local given = props.busy
	if given == nil then
		return ui.button(p)
	end
	local function busy(): boolean
		return if type(given) == "function" then given() == true else (given :: any):get() == true
	end
	-- The label, unseen while busy: it keeps the button's width.
	local label: { [any]: any } = {
		items = "center",
		gap = "$space.2",
		opacity = function(): number
			return if busy() then 0 else 1
		end,
	}
	for i, child in ipairs(props :: any) do
		label[i] = child
		p[i] = nil
	end
	p.relative = true
	p[1] = ui.row(label)
	p[2] = ui.show(
		busy,
		ui.row {
			absolute = true,
			left = 0,
			right = 0,
			top = 0,
			bottom = 0,
			items = "center",
			justify = "center",
			pointer_events = "none",
			status.Spinner { size = SPIN[props.size or "md"], ink = INK[props.tone or "primary"] },
		}
	)
	local click = props.on_click
	if click then
		p.on_click = function(...)
			if not busy() then
				click(...)
			end
		end
	end
	return ui.button(p)
end
]],
		["apps/zgx/ui/ds/card_wall.luau"] = [[
-- A wall of member cards beside a screen's words: columns of cards drifting
-- up, each at its own pace, held still under the pointer. The wall runs the
-- window's full height, under the title bar's strip, and ends above the
-- footer's buttons, dissolving into the window as it goes, so it is cut by
-- nothing. Each card stands under a scrim of the window's colour
-- (`zeron.wall.scrim`: in the dark, a printed card is dimmed to the room's
-- light and no brighter than the way on; in light the paper is near the
-- window's own white and the scrim is clear), lifted from the one card under
-- the pointer, which then tilts and shows its foil as a card does.
--
--   CardWall {
--   	z = 0.78, over = 36,
--   	columns = { { members = { … }, cycle = 104000, start = 40 } },
--   }
--
-- It lays itself over its nearest positioned box (setup's Frame, the
-- gallery's stage), taking no room in the column it is put in. Its last
-- column runs past that box's right edge by `over`, cropped as a wall that
-- goes on would be. `CardWall.width(z, columns)` is how wide it is.
--
-- Reduce motion: nothing drifts, nothing rises in; the wall stands.

local motion = require("@self/motion")
local MemberCard = require("@self/member_card")
local prefers = require("@self/prefers")

export type Member = {
	number: number,
	name: string,
	since: string,
	layers: { MemberCard.Layer },
	holo: MemberCard.Holo,
	badges: { MemberCard.Badge }?,
}

-- A column: its cards (shown twice over, so its loop never shows a join),
-- the ms it takes to rise by one set of them, and where it starts (points
-- from the wall's top; negative, up into the window's edge, so no two
-- columns line up).
export type Column = { members: { Member }, cycle: number, start: number }

export type Props = {
	columns: { Column },
	-- The cards' size, of their own.
	z: number,
	-- How far the wall runs past its box's right edge.
	over: number,
	-- The cards' art holds still (a wall of many small cards).
	still: boolean?,
	-- Wallpaper: each card under a thicker veil, kept whole down the card
	-- (the words stand on it).
	veiled: boolean?,
	-- A wall that must show the same frame as another copy of it (the
	-- intro's stand-in for setup's window, and that window): its columns
	-- stand at their starts until this gives a time (`ui.now()`'s), then
	-- drift as reckoned from it, so every copy given the same time stands
	-- where the others do, whenever each mounted, with nothing held or
	-- started later. It doesn't rise in.
	epoch: (() -> number?)?,
	-- The first column's first card catches the light as this turns true.
	glint: (() -> boolean)?,
}

-- A card's own size (member_card's), and the gap between cards in a column
-- (space.3, in points for the loop's sum).
local W, H = 300, 420
local GAP = 12

local function reduced(): boolean
	return motion.reduced()
end

-- A card in the wall, at `z` of its size, under its scrim (or the thicker
-- veil of a wall that is wallpaper). The scrim lies on the art and thins out
-- down the card (its own clip fades it over the card's lower part), so the
-- sky steps back into the room's light while the paper keeps near its own
-- cream: dimmed paper read as grey, and the name on it as mud. It lifts
-- while the pointer is on the card (the card's own tilt and foil follow
-- it), and settles back a little more slowly than it lifted.
--
-- The wall holds still only while the pointer is on a card (`anims`, the
-- columns' drifts): over a gap, between the columns or between two cards of
-- one, it drifts on, and a card that drifts under a resting pointer stops
-- there, under it, as a card met by the hand does; off the card, it goes on
-- at once. (Nothing can flutter: a held card doesn't move, so it can't leave
-- the pointer by itself, and a moving one stops within a frame of meeting
-- it.)
local ART_FADE = 260
-- How the scrim goes as the pointer comes (ms), and comes back as it goes.
local LIFT, SETTLE = 160, 360
type CardProps = {
	m: Member,
	z: number,
	still: boolean,
	veiled: boolean?,
	anims: { any },
	standing: () -> boolean,
	glint: (() -> boolean)?,
}
local Card = ui.component(function(p: CardProps): Node
	-- The scrim's fade, a tween each way: a tween has one duration, so the
	-- scrim nests two, `lift` (inside) and `settle` (outside), their
	-- opacities multiplying. Lifted, the pair re-arm out of sight (`settle`
	-- down, then `lift` back up), so a leave is `settle`'s alone. (A leave
	-- within half a second eases both back at once.) Per hover, not an
	-- animation started on each: a pointer crossing a card again and again
	-- had each one replace the last before it finished.
	local lift = ui.use_state(1)
	local settle = ui.use_state(1)
	-- Which hover the timers belong to: a later one disowns them.
	local turn = 0
	-- The card's own hover (the one that tilts it): the scrim lifts and the
	-- wall holds; off it, the scrim settles and the wall goes on.
	local function hover(inside: boolean)
		turn += 1
		local mine = turn
		if inside then
			lift:set(0)
			ui.after(LIFT, function()
				if turn == mine then
					settle:set(0)
				end
			end)
			ui.after(LIFT + SETTLE, function()
				if turn == mine then
					lift:set(1)
				end
			end)
		else
			lift:set(1)
			settle:set(1)
		end
		for _, a in p.anims do
			if inside then
				a:pause()
			elseif not p.standing() then
				a:play()
			end
		end
	end
	return ui.div {
		zoom = p.z,
		relative = true,
		shrink = 0,
		MemberCard {
			number = p.m.number,
			name = p.m.name,
			since = p.m.since,
			layers = p.m.layers,
			holo = p.m.holo,
			badges = p.m.badges,
			still = p.still,
			shadow = "$zeron.wall.shadow",
			on_hover = hover,
			glint = p.glint,
		},
		ui.div {
			absolute = true,
			left = 0,
			right = 0,
			top = 0,
			bottom = 0,
			rounded = "$zeron.card.radius",
			overflow = "hidden",
			-- (Wallpaper keeps its veil whole: the words stand on it.)
			fade = if p.veiled then nil else { 0, ART_FADE },
			pointer_events = "none",
			opacity = ui.tween(settle, { duration = SETTLE, ease = "outQuad" }),
			ui.div {
				w_full = true,
				h_full = true,
				bg = if p.veiled then "$zeron.wall.veil" else "$zeron.wall.scrim",
				opacity = ui.tween(lift, { duration = LIFT, ease = "outQuad" }),
			},
		},
	}
end)

-- One column of cards, drifting up for ever: the cards twice over, moved by
-- one set's height each cycle so the join never shows. Given an epoch, it
-- stands at its start until there is one, then drifts as reckoned from it
-- (its time into the cycle, `(now - epoch) % cycle`, the engine's from
-- there). Its start is a margin, not a move: standing, it is no layer.
type ColumnProps = {
	c: Column,
	z: number,
	still: boolean,
	veiled: boolean?,
	anims: { any },
	epoch: (() -> number?)?,
	standing: () -> boolean,
	glint: (() -> boolean)?,
}
local ColumnOf = ui.component(function(p: ColumnProps): Node
	local start = p.c.start
	local step = H * p.z + GAP
	local loop = #p.c.members * step
	local kids: { Node } = {}
	for _ = 1, 2 do
		for i, m in p.c.members do
			table.insert(kids, Card {
				m = m,
				z = p.z,
				still = p.still,
				veiled = p.veiled,
				anims = p.anims,
				standing = p.standing,
				glint = if i == 1 and #kids == 0 then p.glint else nil,
			})
		end
	end
	local drift: any = nil
	-- Given an epoch, the drift goes where it reckons and on from there.
	local function reckon(epoch: number?)
		if epoch and drift then
			drift.currentTime = (ui.now() - epoch) % p.c.cycle
			drift:play()
		end
	end
	ui.effect(function()
		reckon(if p.epoch then p.epoch() else nil)
	end)
	return ui.column {
		gap = "$space.3",
		items = "center",
		shrink = 0,
		w = W * p.z,
		mt = ui.raw(start, "where the column starts: its drift's origin"),
		on_mount = function(el)
			if reduced() then
				return
			end
			drift = anime.animate(el, {
				y = { 0, -loop },
				duration = p.c.cycle,
				ease = "linear",
				loop = true,
				autoplay = p.epoch == nil,
			})
			table.insert(p.anims, drift)
			reckon(if p.epoch then p.epoch() else nil)
		end,
		table.unpack(kids),
	}
end)

-- The light across the wall: from above. The cards run to the window's top
-- edge (a long, gradual fade over the top, so a card rising out of the
-- window melts away rather than meeting an edge),
-- stand in full light through the window's upper half, and darken on the
-- way down into the footer, gone before its buttons, so the way on sits on
-- the window itself. A card drifting up rises out of the dark into the
-- light. (One long fall-off, not a band at each end: a short band dissolves
-- a card's paper into grey mid-card; this reads as a room lit from above.)
-- The fade is the clip's own, so it is the window's colour in either theme.
-- (The fall-off is short on purpose: a cream card over a dark window must
-- pass through grey as it goes, so a card is in that grey for as little of
-- its drift as the eased edge allows, and the two cards above it stand in
-- full light.)
local BREATH, FALL = 44, 130
-- Where the wall ends: above the footer's buttons (the footer's 72 less its
-- buttons' 32, halved, is where they begin: 52 up from the window's foot;
-- the wall stops a little above, so nothing of it stands under them).
local BUTTONS = 56

local M = {}

-- How wide a wall of `columns` columns of cards at `z` is.
function M.width(z: number, columns: number): number
	return W * z * columns + GAP * (columns - 1)
end

-- The wall: its columns, laid over its box's full height, clipped to it and
-- lit from above (each card holds it while the pointer is on it). It rises
-- into place as it opens, unless it's a copy given an epoch. (The fade is
-- the clip's; the rise is the box around it, so it doesn't fade.)
function M.Wall(props: Props): Node
	local anims: { any } = {}
	ui.on_cleanup(function()
		for _, a in anims do
			a:cancel()
		end
	end)
	local epoch = props.epoch
	-- Standing at its start: a copy given an epoch, with none yet.
	local function standing(): boolean
		return epoch ~= nil and epoch() == nil
	end
	local still = props.still == true
	local columns: { Node } = {}
	for i, c in props.columns do
		table.insert(columns, ColumnOf {
			c = c,
			z = props.z,
			still = still,
			veiled = props.veiled,
			anims = anims,
			epoch = epoch,
			standing = standing,
			glint = if i == 1 then props.glint else nil,
		})
	end
	local rises = not reduced() and epoch == nil
	return ui.div {
		id = "wall",
		absolute = true,
		left = 0,
		right = 0,
		top = 0,
		bottom = 0,
		opacity = if rises then 0 else 1,
		on_mount = function(el)
			if rises then
				anime.animate(el, { opacity = { 0, 1 }, y = { 28, 0 }, duration = 900, ease = "out(3)" })
			end
		end,
		ui.div {
			absolute = true,
			left = 0,
			right = 0,
			top = 0,
			bottom = BUTTONS,
			overflow = "hidden",
			fade = { BREATH, FALL },
			ui.row {
				absolute = true,
				top = 0,
				right = -props.over,
				gap = "$space.3",
				items = "start",
				table.unpack(columns),
			},
		},
	}
end

return M
]],
		["apps/zgx/ui/ds/code_view.luau"] = [[
-- What a code editor shows of its file. zgx's textarea has no way to hide a
-- line or leave room between two, and its scrolling is its own; so the editor
-- gives it text to show rather than the file: a window of a few screens of
-- lines, the folded ones left out, a run of empty rows where a block stands
-- between two lines, and a long line broken into rows if it wraps. Those are
-- all this module's. It knows where each row of the window comes from, so a
-- caret, a selection or an edit in the window is a place in the file, and
-- back.
--
-- Three numbers place everything: a file offset is in bytes from 0, as the
-- textarea's selection counts; a line is from 1; a row is a row of what
-- shows, from 0, a fixed height each. `top[line]` is the rows above a line
-- (a hidden line has none of its own, so it has the same `top` as the next),
-- one number a line: made again when lines or folds change, a few hundred
-- nanoseconds a line, and read by a binary search everywhere else.
--
-- Nothing here touches the interface: `ds/code_editor` drives it.

local M = {}
M.__index = M

-- The folded line's summary, drawn after its text: ` ⋯ }  12 lines`.
M.ELLIPSIS = " ⋯ "

export type Region = { first: number, last: number, closer: string? }
export type Row = {
	line: number,
	-- The file's bytes it shows: `from` to `to`, then `extra` bytes that
	-- aren't the file's (a fold's summary).
	from: number,
	to: number,
	extra: number,
	-- Empty, under a block.
	spacer: boolean?,
	-- A wrapped line's second row or later.
	more: boolean?,
}
export type Window = {
	first_row: number,
	rows: { Row },
	-- Where each row starts in `text`.
	at: { number },
	text: string,
	-- The first and last lines in it.
	first_line: number,
	last_line: number,
	-- What the folded lines read, by their text: the highlighter colours
	-- the summary.
	summaries: { [string]: number },
	-- A wrapped line's rows, by their text: `{ line, from, to, last }`.
	wrapped: { [string]: { any } },
}

type Block = { line: number, rows: number, given: number }
type Fields = {
	text: string,
	starts: { number },
	n: number,
	-- The rows above each line (see above).
	top: { number },
	regions: { Region },
	by_first: { [number]: Region },
	folded: { [number]: Region },
	blocks: { [string]: Block },
	cols: number?,
	tab: number,
	breaks: { [number]: { number } },
	win: Window?,
}
export type CodeView = setmetatable<Fields, typeof(M)>

function M.new(text: string): CodeView
	local self: CodeView = setmetatable({
		text = "",
		starts = {} :: { number },
		n = 0,
		top = {} :: { number },
		regions = {} :: { Region },
		by_first = {} :: { [number]: Region },
		folded = {} :: { [number]: Region },
		-- Blocks standing under lines, by key: their line, their rows, and the
		-- line they were last given or told of.
		blocks = {} :: { [string]: Block },
		-- Wrapping at this many columns (nil: not at all), and where the
		-- wrapped lines break: bytes from the line's start.
		cols = nil :: number?,
		tab = 8,
		breaks = {} :: { [number]: { number } },
		win = nil :: Window?,
	}, M)
	self:reset(text)
	return self
end

---------------------------------------------------------------------------
-- The file.

-- A new text: no folds, no history of the old one.
function M.reset(self: CodeView, text: string)
	self.text = text
	local starts = table.create(64) :: { number }
	starts[1] = 0
	local n, at = 1, 0
	while true do
		local nl = string.find(text, "\n", at + 1, true)
		if not nl then
			break
		end
		n += 1
		starts[n] = nl
		at = nl
	end
	self.starts, self.n = starts, n
	self.regions, self.by_first, self.folded = {}, {}, {}
	self.breaks = {}
	self:layout()
end

function M.line_start(self: CodeView, line: number): number
	return self.starts[line]
end

-- Where a line ends, before its newline.
function M.line_end(self: CodeView, line: number): number
	local nxt = self.starts[line + 1]
	return if nxt then nxt - 1 else #self.text
end

function M.line_text(self: CodeView, line: number): string
	return string.sub(self.text, self.starts[line] + 1, self:line_end(line))
end

-- The line holding offset `p`.
function M.line_of(self: CodeView, p: number): number
	local starts = self.starts
	local lo, hi = 1, self.n
	while lo < hi do
		local mid = (lo + hi + 1) // 2
		if starts[mid] <= p then
			lo = mid
		else
			hi = mid - 1
		end
	end
	return lo
end

-- Bytes `from` to `to` become `ins`: the text and the lines' starts, and
-- what stands on lines moved along. Returns whether the lines changed.
function M.splice(self: CodeView, from: number, to: number, ins: string): boolean
	local text = self.text
	local a, b = self:line_of(from), self:line_of(to)
	self.text = string.sub(text, 1, from) .. ins .. string.sub(text, to + 1)
	local d = #ins - (to - from)
	local added: { number } = {}
	if #ins > 0 then
		local at = 0
		while true do
			local nl = string.find(ins, "\n", at + 1, true)
			if not nl then
				break
			end
			table.insert(added, from + nl)
			at = nl
		end
	end
	local starts = self.starts
	local n = self.n
	local gone, got = b - a, #added
	if got ~= gone then
		-- The lines after, moved to their new places.
		table.move(starts, b + 1, n, a + got + 1)
		if got < gone then
			for i = n - (gone - got) + 1, n do
				starts[i] = nil
			end
		end
	end
	for i = 1, got do
		starts[a + i] = added[i]
	end
	n += got - gone
	self.n = n
	if d ~= 0 then
		for i = a + got + 1, n do
			starts[i] += d
		end
	end
	if got ~= gone then
		self:shift(a, b, got - gone)
	end
	return got ~= gone
end

-- Lines `a` to `b` are now `delta` more: what stands on them keeps its line.
-- A fold whose head went is open again; nothing hides by surprise.
function M.shift(self: CodeView, a: number, b: number, delta: number)
	local function moved(line: number): number
		if line > b then
			return line + delta
		end
		return math.min(line, a + math.max(0, b - a + delta))
	end
	local folded: { [number]: Region } = {}
	for first, r in self.folded do
		if first <= a or first > b then
			local nf = if first > b then first + delta else first
			local nl = moved(r.last)
			if nl > nf then
				folded[nf] = { first = nf, last = nl, closer = r.closer }
			end
		end
	end
	self.folded = folded
	for _, r in self.regions do
		r.first = moved(r.first)
		r.last = moved(r.last)
	end
	self:index_regions()
	for _, block in self.blocks do
		block.line = moved(block.line)
	end
end

---------------------------------------------------------------------------
-- Folds.

function M.index_regions(self: CodeView)
	local by: { [number]: Region } = {}
	for _, r in self.regions do
		if r.last > r.first then
			by[r.first] = r
		end
	end
	self.by_first = by
end

-- The regions found again: what was folded stays so where its head still
-- opens a region, keeping the region's new extent.
function M.set_regions(self: CodeView, regions: { Region }): boolean
	self.regions = regions
	self:index_regions()
	local folded: { [number]: Region } = {}
	local changed = false
	for first, old in self.folded do
		local r = self.by_first[first]
		if r then
			folded[first] = { first = first, last = r.last, closer = r.closer }
			changed = changed or r.last ~= old.last
		else
			-- Its head stopped opening one: it opens, all of it showing.
			changed = true
		end
	end
	self.folded = folded
	return changed
end

function M.is_folded(self: CodeView, line: number): boolean
	return self.folded[line] ~= nil
end

function M.fold(self: CodeView, line: number): boolean
	local r = self.by_first[line]
	if not r or self.folded[line] then
		return false
	end
	self.folded[line] = { first = r.first, last = r.last, closer = r.closer }
	return true
end

function M.unfold(self: CodeView, line: number): boolean
	if not self.folded[line] then
		return false
	end
	self.folded[line] = nil
	return true
end

function M.fold_all(self: CodeView)
	for first in self.by_first do
		self:fold(first)
	end
end

function M.unfold_all(self: CodeView): boolean
	local any = next(self.folded) ~= nil
	self.folded = {}
	return any
end

-- The region to act on for a caret on `line`: the innermost that holds it.
function M.region_at(self: CodeView, line: number): Region?
	local best: Region? = nil
	if self.by_first[line] then
		return self.by_first[line]
	end
	for _, r in self.regions do
		if r.first > line then
			break
		end
		if r.last >= line and (not best or r.first > best.first) then
			best = r
		end
	end
	return best
end

-- Every fold hiding `line` (or lines `line` to `to`) opened: true if any.
function M.open_around(self: CodeView, line: number, to: number?): boolean
	local last = to or line
	local any = false
	for first, r in self.folded do
		if first < last and r.last >= line then
			self.folded[first] = nil
			any = true
		end
	end
	return any
end

---------------------------------------------------------------------------
-- Rows.

-- Where a long line breaks into rows of `cols`: after a space where one is
-- in reach, else mid-word, never inside a character. A tab takes `tab`
-- columns and a character of three bytes or more two, near enough what they
-- draw: a row a little long scrolls; it never misplaces the row under it.
local function breaks_of(s: string, cols: number, tab: number): { number }?
	local n = #s
	if n <= cols and not string.find(s, "\t", 1, true) then
		return nil
	end
	local out: { number }? = nil
	local col, i = 0, 1
	local start = 1
	local space = 0
	while i <= n do
		local b = string.byte(s, i)
		local w, len = 1, 1
		if b == 9 then
			w = tab
		elseif b >= 0xF0 then
			w, len = 2, 4
		elseif b >= 0xE0 then
			w, len = 2, 3
		elseif b >= 0xC0 then
			len = 2
		end
		if col + w > cols and i > start then
			local cut = if space > start then space else i
			if not out then
				out = {}
			end
			table.insert(out :: { number }, cut - 1)
			start = cut
			col = 0
			space = 0
			i = cut
		else
			col += w
			i += len
			-- (After a space, or punctuation code breaks well after.)
			if b == 32 or b == 44 or b == 40 or b == 91 or b == 123 or b == 47 then
				space = i
			end
		end
	end
	return out
end

-- The rows again: after lines, folds, blocks or the wrapping width change.
function M.layout(self: CodeView)
	local top = self.top
	local n = self.n
	local cols = self.cols
	local folded = self.folded
	local starts = self.starts
	local spacers: { [number]: number }? = nil
	for _, block in self.blocks do
		spacers = spacers or {}
		local s = spacers :: { [number]: number }
		s[block.line] = (s[block.line] or 0) + block.rows
	end
	local breaks: { [number]: { number } } = {}
	local text = self.text
	local r = 0
	local hide_to = 0
	local tab = self.tab
	for i = 1, n do
		top[i] = r
		if i > hide_to then
			r += 1
			if cols then
				local a = starts[i]
				local e = (starts[i + 1] or (#text + 1)) - 1
				if e - a > cols or (e > a and string.byte(text, a + 1) == 9) then
					local b = breaks_of(string.sub(text, a + 1, e), cols, tab)
					if b then
						breaks[i] = b
						r += #b
					end
				end
			end
			if spacers and spacers[i] then
				r += spacers[i]
			end
			local f = folded[i]
			if f then
				hide_to = f.last
			end
		end
	end
	top[n + 1] = r
	for i = #top, n + 2, -1 do
		top[i] = nil
	end
	self.breaks = breaks
end

function M.total_rows(self: CodeView): number
	return self.top[self.n + 1]
end

function M.is_hidden(self: CodeView, line: number): boolean
	return self.top[line] == self.top[line + 1]
end

-- The first row of a line (hidden: the row of the line after its fold).
function M.row_of(self: CodeView, line: number): number
	return self.top[line]
end

-- The line a row belongs to.
function M.line_at(self: CodeView, row: number): number
	local top = self.top
	local lo, hi = 1, self.n
	while lo < hi do
		local mid = (lo + hi + 1) // 2
		if top[mid] <= row then
			lo = mid
		else
			hi = mid - 1
		end
	end
	return lo
end

-- The line showing for `line`: itself, or the head of the fold hiding it.
function M.shown_line(self: CodeView, line: number): number
	if not self:is_hidden(line) then
		return line
	end
	local top = self.top
	local t = top[line]
	local lo, hi = 1, line
	while lo < hi do
		local mid = (lo + hi) // 2
		if top[mid] >= t then
			hi = mid
		else
			lo = mid + 1
		end
	end
	return math.max(1, lo - 1)
end

-- What follows a folded line's text.
local function summary(r: Region): string
	local count = r.last - r.first
	local words = if count == 1 then "1 line" else `{count} lines`
	if r.closer then
		return `{M.ELLIPSIS}{r.closer}  {words}`
	end
	return `{M.ELLIPSIS} {words}`
end

---------------------------------------------------------------------------
-- The window: rows `from_row` to `to_row` of what shows, rounded out to whole
-- lines, as the text a textarea holds and the map back to the file.

function M.window(self: CodeView, from_row: number, to_row: number): Window
	local top, starts, text = self.top, self.starts, self.text
	local n = self.n
	local line = self:line_at(math.max(0, from_row))
	local total = self:total_rows()
	to_row = math.min(to_row, total)
	local rows: { Row } = {}
	local at: { number } = {}
	local parts: { string } = {}
	local count, used = 0, 0
	local summaries: { [string]: number }, wrapped: { [string]: { any } } = {}, {}
	local spacers: { [number]: number } = {}
	for _, block in self.blocks do
		spacers[block.line] = (spacers[block.line] or 0) + block.rows
	end
	local function push(row: Row, s: string)
		count += 1
		rows[count] = row
		at[count] = used
		parts[count] = s
		used += #s + 1
	end
	local first_line = line
	local last_line = line
	while line <= n and top[line] < to_row do
		last_line = line
		local a = starts[line]
		local e = self:line_end(line)
		local folded = self.folded[line]
		local b = self.breaks[line]
		if b then
			local from = 0
			local whole = string.sub(text, a + 1, e)
			for i = 1, #b + 1 do
				local to = b[i] or (e - a)
				local s = string.sub(whole, from + 1, to)
				push({ line = line, from = a + from, to = a + to, extra = 0, more = i > 1 }, s)
				wrapped[s] = { whole, from, to, i == #b + 1 }
				from = to
			end
		else
			local s = string.sub(text, a + 1, e)
			if folded then
				local tail = summary(folded)
				summaries[s .. tail] = #s
				push({ line = line, from = a, to = e, extra = #tail }, s .. tail)
			else
				push({ line = line, from = a, to = e, extra = 0 }, s)
			end
		end
		for _ = 1, spacers[line] or 0 do
			push({ line = line, from = e, to = e, extra = 0, spacer = true }, "")
		end
		line += 1
		if folded then
			line = folded.last + 1
		end
	end
	local win: Window = {
		first_row = top[first_line],
		rows = rows,
		at = at,
		text = table.concat(parts, "\n"),
		first_line = first_line,
		last_line = last_line,
		summaries = summaries,
		wrapped = wrapped,
	}
	self.win = win
	return win
end

-- The row of the window holding window offset `w`.
local function row_at(win: Window, w: number): number
	local at = win.at
	local lo, hi = 1, #at
	while lo < hi do
		local mid = (lo + hi + 1) // 2
		if at[mid] <= w then
			lo = mid
		else
			hi = mid - 1
		end
	end
	return lo
end
M.row_at = row_at

-- The file offset of window offset `w`. In what isn't the file (a summary,
-- a spacer row) it falls to the file's text before, or with `after`, the
-- text after.
function M.to_file(self: CodeView, w: number, after: boolean?): number
	local win = self.win :: Window
	local k = row_at(win, w)
	local r = win.rows[k]
	if r.spacer then
		if after then
			while k < #win.rows and win.rows[k].spacer do
				k += 1
			end
			local nxt = win.rows[k]
			return if nxt.spacer then #self.text else nxt.from
		end
		while k > 1 and win.rows[k].spacer do
			k -= 1
		end
		return win.rows[k].to
	end
	return r.from + math.min(w - win.at[k], r.to - r.from)
end

-- The window offset of file offset `p`, on the row it shows on; nil if that
-- isn't in the window. A place in a fold is its head's end.
function M.to_window(self: CodeView, p: number): number?
	local win = self.win
	if not win then
		return nil
	end
	local line = self:line_of(p)
	if self:is_hidden(line) then
		line = self:shown_line(line)
		p = self:line_end(line)
	end
	if line < win.first_line or line > win.last_line then
		return nil
	end
	local k = self.top[line] - win.first_row + 1
	local rows = win.rows
	while rows[k + 1] and rows[k + 1].more and rows[k + 1].line == line and rows[k + 1].from <= p do
		k += 1
	end
	return win.at[k] + (p - rows[k].from)
end

-- As `to_window`, but a place outside the window lands on its nearer end.
function M.to_window_clamped(self: CodeView, p: number): number
	local w = self:to_window(p)
	if w then
		return w
	end
	local win = self.win :: Window
	return if self:line_of(p) < win.first_line then 0 else #win.text
end

return M
