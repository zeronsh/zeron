		["apps/zgx/ui/screens/shell/appearance.luau"] = [[
-- How the main window looks, as chosen: the colour scheme (setup's own
-- choice, the same setting), and a new chat's wallpaper and its effect.
-- Kept across launches; changing the scheme restyles every window.
--
--   appearance.scheme      "system" | "light" | "dark" (a state)
--   appearance.wallpaper   Appearance's own choice: "none" or "image" (your
--                          picture, `appearance.image`), kept while a plugin's
--                          wallpaper stands in for it
--   appearance.image       your picture: { path, name, w, h, x, y, zoom }
--                          (a copy the host keeps: screens/settings/wallpaper),
--                          or nil
--   appearance.effect      over your picture: "none" | "dither" | "ascii" |
--                          "halftone" | "scanlines"
--   appearance.plugin      the plugin whose wallpaper is used ("" none), set
--                          on its own settings page; one at a time
--   appearance.plugin_effect  the effect over a plugin's wallpaper
--   appearance.provider()  that plugin, while it's on and offers one ({ id,
--                          name }), else nil: Appearance's choice shows
--   appearance.showing()   what a new chat shows now: "none", "image", or
--                          "plugin:<id>"
--   appearance.effect_now()  the effect over what shows
--   appearance.use_plugin(id, on)  a plugin's wallpaper used (taking over from
--                          any other), or let go
--   appearance.choose(v)   Appearance's "none" or "image", taking it back from
--                          a plugin
--
-- A plugin offers a wallpaper by replacing a new chat's background place
-- (`#new-chat-background`, in its manifest's `ui.change`; the place provides
-- `pointer` = { x, y }, 0 to 1) and declaring a `wallpaper` setting, the
-- row Zeron draws on its settings page to use it. Zeron's effect is drawn
-- over whatever stands there.

local state = require("@app/screens/onboarding/state")
local actions = require("@app/screens/onboarding/actions")
local plugins = require("@app/screens/plugins/state")

local M = {}

M.scheme = state.appearance
-- Applied as it changes (and once now: the look chosen in an earlier run).
ui.effect(function()
	actions.apply_scheme(state.appearance:get())
end)

-- The place plugins draw a new chat's background (an element's id), and
-- its selector as a manifest's `ui.change` names it.
M.SLOT = "new-chat-background"
M.SELECTOR = `#{M.SLOT}`

export type Image = { path: string, name: string, w: number, h: number, x: number, y: number, zoom: number }

local EFFECTS = { none = true, dither = true, ascii = true, halftone = true, scanlines = true }

M.wallpaper = ui.persist("shell_wallpaper", "none")
M.image = ui.persist("shell_wallpaper_image", nil :: Image?)
M.effect = ui.persist("shell_wallpaper_effect", "dither")
M.plugin = ui.persist("shell_wallpaper_plugin", "")
M.plugin_effect = ui.persist("shell_wallpaper_plugin_effect", "dither")
do
	local w = M.wallpaper:peek()
	local id = string.match(w, "^plugin:(.+)$")
	if id then
		-- A plugin chosen here once: it's the plugin's to say now.
		M.plugin:set(id)
		M.wallpaper:set(if M.image:peek() then "image" else "none")
	elseif w ~= "none" and w ~= "image" then
		-- A retired choice (a scene's name, the wallpaper folder).
		M.wallpaper:set("none")
	end
	-- (Blur went: Zeron's effects are these.)
	for _, e in { M.effect, M.plugin_effect } do
		if not EFFECTS[e:peek()] then
			e:set("none")
		end
	end
end

-- The plugins on that can draw a new chat's background, by name.
M.providers = ui.computed(function(): { { id: string, name: string } }
	local out = {}
	for _, p in plugins.list:get() do
		if p.status == "on" and p.ui and p.ui.change then
			for _, at in p.ui.change do
				if at == M.SELECTOR then
					table.insert(out, { id = p.id, name = p.name })
					break
				end
			end
		end
	end
	return out
end)

-- The plugin whose wallpaper is used, while it can be.
M.provider = ui.computed(function(): { id: string, name: string }?
	local id = M.plugin:get()
	if id == "" then
		return nil
	end
	for _, p in M.providers:get() do
		if p.id == id then
			return p
		end
	end
	return nil
end)

-- What a new chat shows now.
M.showing = ui.computed(function(): string
	local p = M.provider:get()
	if p then
		return `plugin:{p.id}`
	end
	if M.wallpaper:get() == "image" and M.image:get() then
		return "image"
	end
	return "none"
end)

function M.effect_now(): string
	return if M.provider:get() then M.plugin_effect:get() else M.effect:get()
end

function M.use_plugin(id: string, on: boolean)
	if on then
		M.plugin:set(id)
	elseif M.plugin:peek() == id then
		M.plugin:set("")
	end
end

function M.choose(value: string)
	ui.batch(function()
		M.wallpaper:set(value)
		M.plugin:set("")
	end)
end

return M
]],
		["apps/zgx/ui/screens/shell/fit_policy.luau"] = [[
-- Zeron's panel fit, the policy alone (no state): its widths and which
-- columns a window has room for. screens/shell/fit holds the window's and
-- reads it; see there. (crates/ui settings.rs, shell/panel_layout.rs
-- `horizontal_panel_fit`, shell.rs `content_split`, `right_pane_max_width`,
-- `right_pane_takeover_width`.)

local M = {}

-- Zeron's widths (crates/ui settings.rs), in points.
M.SIDEBAR_MIN, M.SIDEBAR_MAX, M.SIDEBAR_DEFAULT = 242, 400, 256
M.FILES_PANEL_MIN, M.FILES_PANEL_DEFAULT, M.FILES_PANEL_MAX = 220, 286, 440
M.RIGHT_PANE_MIN, M.RIGHT_PANE_DEFAULT = 360, 520
M.CHAT_PANEL_MIN = 300

export type Column = { open: boolean, at: number }
export type Fit = { sidebar: boolean, right: boolean, files: boolean, sidebar_limit: number }

-- The policy: which of the columns show in a window `viewport` wide, the
-- sidebar preferring `sidebar_width`, the panel expanded or not. (`files_min`:
-- Files' least, Zeron's unless an app's Files column is wider.)
function M.panels(
	viewport: number,
	sidebar_width: number,
	sidebar: Column,
	right: Column,
	files: Column,
	expanded: boolean,
	files_min: number?
): Fit
	local FILES = files_min or M.FILES_PANEL_MIN
	local names = { "sidebar", "right", "files" }
	local open = { sidebar.open, right.open, files.open }
	local at = { sidebar.at, right.at, files.at }
	viewport = math.max(viewport, 0)
	-- Expanded spends only the chat's width on the panel: the other columns
	-- fit as ever. Below the chat's and the panel's least, the panel alone
	-- may still take over.
	local narrow_takeover = expanded and right.open and viewport < M.CHAT_PANEL_MIN + M.RIGHT_PANE_MIN
	if narrow_takeover then
		open[1], open[3] = false, false
	end
	while true do
		local chat_floor = if open[2] and narrow_takeover then 0 else M.CHAT_PANEL_MIN
		local minimum = chat_floor
			+ (if open[1] then M.SIDEBAR_MIN else 0)
			+ (if open[2] then M.RIGHT_PANE_MIN else 0)
			+ (if open[3] then FILES else 0)
		if minimum <= viewport then
			return {
				sidebar = open[1],
				right = open[2],
				files = open[3],
				sidebar_limit = if open[1]
					then math.min(
						viewport
							- chat_floor
							- (if open[2] then M.RIGHT_PANE_MIN else 0)
							- (if open[3] then FILES else 0),
						sidebar_width
					)
					else 0,
			}
		end
		-- The least recently opened goes; an expanded panel after the rest.
		local victim: number? = nil
		local best: { number }? = nil
		for i = 1, 3 do
			if open[i] then
				local key = { if expanded and names[i] == "right" then 1 else 0, at[i] }
				if best == nil or key[1] < best[1] or (key[1] == best[1] and key[2] < best[2]) then
					victim, best = i, key
				end
			end
		end
		if victim == nil then
			return { sidebar = false, right = false, files = false, sidebar_limit = 0 }
		end
		open[victim] = false
	end
end

-- The panel's share of `available` (what the tools leave the chat and the
-- panel): half, the panel keeping its least and the chat as much of its own
-- as fits.
function M.content_split(available: number): number
	return math.min(math.max(available / 2, M.RIGHT_PANE_MIN), math.max(available - M.CHAT_PANEL_MIN, M.RIGHT_PANE_MIN))
end

-- The widest the panel may be dragged: the chat keeps its least.
function M.right_pane_max_width(viewport: number, sidebar: number, chat_floor: number): number
	return math.max(viewport - sidebar - chat_floor, 0)
end

-- The panel expanded: all of the chat's room.
function M.right_pane_takeover_width(viewport: number, sidebar: number): number
	return math.max(viewport - sidebar, 0)
end

return M
]],
		["apps/zgx/ui/screens/shell/project_editor.luau"] = [[
-- Edit project: a project's name and its icon, from its header's right
-- click (the sidebar's "Edit project…"). One dialog for the window.
--
-- Its tile stands large at the head, as it will be everywhere (the sidebar,
-- the panel, the pickers, the palette), following every change; its name
-- beside it. Under them, what the tile wears:
--   Default  its repository's own logo (found as the shipping app finds it)
--            else its initial on a colour;
--   Emoji    one picked (search, recents, kinds, skin tone), on a wash of
--            the colour;
--   Image    a picture of yours (chosen, or dropped on the dialog), placed
--            in the tile's square by dragging and zooming, as Account's
--            photo is, cut here and kept by Zeron's edge.
-- What's chosen is the project's on every device (sessions.set_project_icon).
--
--   editor.open(id, start?)  asks about that project
--   editor.Dialog()   the dialog, placed once in the window

local ds = require("@ds")
local sessions = require("@account/sessions")
local projects = require("@account/projects")
local look = require("@app/screens/shell/project_look")
local locale = require("@ds/locale")

local M = {}

-- What's being edited: the project, its name, which kind of icon, the
-- emoji, the colour (nil: its own), an image already its (an https URL),
-- and a picture chosen now, to place and cut: { path, w, h }.
type Picture = { path: string, w: number, h: number }
local open = ui.state("project_edit_open", false)
local editing = ui.state("project_edit_id", nil :: string?)
local name = ui.state("project_edit_name", "")
local kind = ui.state("project_edit_kind", "default")
local emoji = ui.state("project_edit_emoji", nil :: string?)
local hue = ui.state("project_edit_hue", nil :: string?)
local image = ui.state("project_edit_image", nil :: string?)
local picture = ui.state("project_edit_picture", nil :: Picture?)
-- Where the square is in the picture: its centre (0 to 1 each way) and how
-- far in (1: the picture's short side fills it).
local zoom = ui.state("project_edit_zoom", 1)
local centre = ui.state("project_edit_centre", { x = 0.5, y = 0.5 })
local busy = ui.state("project_edit_busy", false)
-- What went wrong, as an error's key (shell.sidebar.project.edit.error.*),
-- and whether the name is wanted.
local failed = ui.state("project_edit_failed", nil :: string?)
local unnamed = ui.state("project_edit_unnamed", false)
local dropping = ui.state("project_edit_dropping", false)
-- A picture uploaded while the dialog was open and not worn yet (its save
-- refused): let go of if the dialog closes without it.
local uploaded = ui.state("project_edit_uploaded", nil :: string?)
ui.effect(function()
	if open:get() then
		return
	end
	local url = uploaded:peek()
	if url then
		uploaded:set(nil)
		projects.forget_icon(url)
	end
end)
-- The emoji picker's own: what was picked lately, and the skin tone.
local recents = ui.persist("project_edit_emoji_recents", {} :: { string })
local tone = ui.persist("project_edit_emoji_tone", 0)

-- The tile's side at the head, and the square a picture is placed in.
local PREVIEW = 64
local VIEW = 184
-- The stage the square stands in (the panel's width), and how tall.
local STAGE_H = 232
-- A colour's swatch, and the ring round the one chosen.
local SWATCH = 18
local RING = 26

local function project(): sessions.Project?
	local id = editing:get()
	for _, p in sessions.now:get().projects do
		if p.id == id then
			return p
		end
	end
	return nil
end

-- The colour shown: the one chosen, else the project's own.
local function shown_hue(): string
	local h = hue:get()
	if h then
		return h
	end
	local id = editing:get()
	return if id then look.hue(id) else "violet"
end

-- `start` opens it somewhere else than as the project is (a fixture's
-- captures): `{ kind?, emoji?, hue?, picture?, zoom?, centre? }`.
function M.open(id: string, start: { [string]: any }?)
	local p: sessions.Project? = nil
	for _, q in sessions.now:peek().projects do
		if q.id == id then
			p = q
		end
	end
	if not p then
		return
	end
	local icon = p.icon or {}
	ui.batch(function()
		editing:set(id)
		name:set(p.name)
		emoji:set(icon.emoji)
		image:set(icon.image)
		hue:set(icon.hue)
		picture:set(nil)
		zoom:set(1)
		centre:set({ x = 0.5, y = 0.5 })
		kind:set(if icon.image then "image" elseif icon.emoji then "emoji" else "default")
		busy:set(false)
		failed:set(nil)
		unnamed:set(false)
		dropping:set(false)
		if start then
			kind:set(start.kind or kind:peek())
			emoji:set(start.emoji or emoji:peek())
			hue:set(start.hue or hue:peek())
			picture:set(start.picture)
			zoom:set(start.zoom or 1)
			centre:set(start.centre or { x = 0.5, y = 0.5 })
		end
		open:set(true)
	end)
end

-- A picture to place: its size read, then the square starting in its
-- middle, filling it.
local function take(path: string)
	failed:set(nil)
	projects.picture_size(path):after(function(size: any)
		ui.batch(function()
			picture:set({ path = path, w = math.max(1, size.w), h = math.max(1, size.h) })
			zoom:set(1)
			centre:set({ x = 0.5, y = 0.5 })
			kind:set("image")
		end)
	end, function()
		failed:set("open")
	end)
end

local function choose()
	ui.open_files({
		title = ui.t("shell.sidebar.project.edit.choose"):get(),
		filters = { { ui.t("shell.sidebar.project.edit.kind.image"):get(), { "png", "jpg", "jpeg" } } },
	}):after(function(files: { File })
		local f = files[1]
		if f then
			take(f.path)
		end
	end)
end

-- Files carried over the dialog: the first picture among them is taken.
local function dropped(files: { any })
	dropping:set(false)
	for _, f in files do
		local path = if type(f) == "table" then f.path else f
		if type(path) == "string" and (string.match(string.lower(path), "%.png$") or string.match(string.lower(path), "%.jpe?g$")) then
			take(path)
			return
		end
	end
	failed:set("open")
end

-- Points one of the picture's pixels takes in a square `side` wide.
local function scale(side: number): number
	local px = picture:get()
	if not px then
		return 1
	end
	return side * zoom:get() / math.min(px.w, px.h)
end
-- A centre moved back to where the picture still fills the square.
local function placed(x: number, y: number): (number, number)
	local px = picture:peek()
	if not px then
		return 0.5, 0.5
	end
	local k = zoom:peek() / math.min(px.w, px.h)
	local hx = 1 / (2 * px.w * k)
	local hy = 1 / (2 * px.h * k)
	return math.clamp(x, hx, 1 - hx), math.clamp(y, hy, 1 - hy)
end
local function settle()
	local c = centre:peek()
	local x, y = placed(c.x, c.y)
	centre:set({ x = x, y = y })
end
-- The square as the host cuts it: its corner and side, in pixels.
local function crop(): { x: number, y: number, side: number }
	local px = picture:peek() :: Picture
	local c = centre:peek()
	local side = math.min(px.w, px.h) / zoom:peek()
	return { x = c.x * px.w - side / 2, y = c.y * px.h - side / 2, side = side }
end

-- The picture placed in a square `side` wide (the stage's, the preview's):
-- drawn whole at its zoom, the square's part lined up on it.
local function placed_picture(side: number): Node
	return ui.image {
		src = function(): string
			local px = picture:get()
			return if px then px.path else ""
		end,
		absolute = true,
		left = function(): number
			local px = picture:get()
			return if px then side / 2 - centre:get().x * px.w * scale(side) else 0
		end,
		top = function(): number
			local px = picture:get()
			return if px then side / 2 - centre:get().y * px.h * scale(side) else 0
		end,
		w = function(): number
			local px = picture:get()
			return if px then px.w * scale(side) else 0
		end,
		h = function(): number
			local px = picture:get()
			return if px then px.h * scale(side) else 0
		end,
		aria_hidden = true,
	}
end

-- A tile's corner at `side`, in the proportion ds/tile gives its preview
-- (the large radius at 64), so the square a picture is placed in is the
-- tile it will be.
local function corner(side: number): number
	local r = ui.theme.get("radius.xl") :: number
	return math.floor(r * side / PREVIEW + 0.5)
end

-- The head: the tile, large, as it will be, and the name beside it.
local function head(): Node
	local function tile(): Node
		return ui.switch(function(): string
			return if kind:get() == "image" and picture:get() then "placing" else "tile"
		end, {
			-- A picture being placed: the square of it as it's placed.
			placing = ui.div {
				w = PREVIEW,
				h = PREVIEW,
				shrink = 0,
				relative = true,
				overflow = "hidden",
				rounded = "$radius.xl",
				bg = "$zeron.secondary.bg",
				placed_picture(PREVIEW),
			},
			tile = ds.Tile {
				size = PREVIEW,
				label = function(): string?
					return name:get()
				end,
				hue = shown_hue,
				emoji = function(): string?
					return if kind:get() == "emoji" then emoji:get() else nil
				end,
				src = function(): string?
					local k = kind:get()
					if k == "image" then
						return look.file(image:get())
					elseif k == "default" then
						local p = project()
						return if p then look.artwork(p) else nil
					end
					return nil
				end,
			},
		})
	end
	local function where(): string
		local p = project()
		if not p then
			return ""
		end
		local device = ""
		for _, d in sessions.now:get().devices do
			if d.id == p.device then
				device = d.name
			end
		end
		return if device ~= "" then `{device} · {p.path}` else p.path
	end
	return ui.row {
		w_full = true,
		gap = "$space.4",
		items = "center",
		ui.div {
			id = "project-edit-preview",
			role = "img",
			label = ui.t("shell.sidebar.project.edit.preview"),
			shrink = 0,
			rounded = "$radius.xl",
			outline = function(): number
				return if dropping:get() then 2 else 0
			end,
			outline_offset = 3,
			outline_color = "$accent",
			tile(),
		},
		ui.column {
			grow = 1,
			min_w = 0,
			gap = "$space.1",
			ds.TextField {
				value = name,
				label = ui.t("shell.sidebar.project.edit.name"),
				placeholder = function(): string
					return ui.t("shell.sidebar.project.edit.name"):get()
				end,
				error = function(): string?
					return if unnamed:get() then ui.t("shell.sidebar.project.edit.name_empty"):get() else nil
				end,
				select_on_focus = true,
				w_full = true,
			},
			ui.text { where, text_size = "$font.size.xs", color = "$text.tertiary", truncate = true, literal = true, w_full = true },
		},
	}
end

-- The colours: a swatch each, the one shown ringed (its own, until one is
-- chosen; choosing its own again is choosing none).
local function colours(): Node
	local swatches: { Node } = {}
	for _, h in look.HUES do
		local function chosen(): boolean
			return shown_hue() == h
		end
		table.insert(
			swatches,
			-- (A ring round the colour, a gap between: two circles, one
			-- centre.)
			ui.button {
				label = ui.t(`shell.sidebar.project.edit.hue.{h}`),
				tooltip = locale.s(`shell.sidebar.project.edit.hue.{h}`),
				role = "radio",
				checked = chosen,
				w = RING,
				h = RING,
				px = 0,
				py = 0,
				shrink = 0,
				rounded = "$radius.full",
				items = "center",
				justify = "center",
				bg = "#00000000",
				border = 2,
				border_color = function(): string
					return if chosen() then "$text.primary" else "#00000000"
				end,
				cursor = "pointer",
				hover = { border_color = "$border" },
				focus = { outline = 1, outline_offset = 1, outline_color = "$focus.ring" },
				on_click = function()
					local id = editing:peek()
					hue:set(if id and look.hue(id) == h then nil else h)
				end,
				ui.div { w = SWATCH, h = SWATCH, rounded = "$radius.full", bg = `$palette.{h}.500` },
			}
		)
	end
	return ui.row {
		w_full = true,
		h = 28,
		items = "center",
		gap = "$space.3",
		ui.text { ui.t("shell.sidebar.project.edit.color"), text_size = "$font.size.sm", color = "$text.secondary", grow = 1 },
		ui.row { role = "radiogroup", label = ui.t("shell.sidebar.project.edit.color"), gap = "$space.1", items = "center", table.unpack(swatches) },
	}
end

-- Default: what it is (its repository's logo, or its initial), and its
-- colour.
local function default_panel(): Node
	return ui.column {
		w_full = true,
		gap = "$space.3",
		ui.text {
			function(): string
				local p = project()
				local art = if p then look.artwork(p) else nil
				return if art
					then ui.t("shell.sidebar.project.edit.default_artwork"):get()
					else ui.t("shell.sidebar.project.edit.default_initial"):get()
			end,
			text_size = "$font.size.sm",
			color = "$text.tertiary",
			wrap = true,
			w_full = true,
		},
		colours(),
	}
end

local function emoji_panel(): Node
	-- (The picker and its emoji, 180 KB of data, loaded the first time the
	-- panel shows, not with the window.)
	local EmojiPicker = require("@ds/emoji_picker")
	return ui.column {
		w_full = true,
		gap = "$space.3",
		EmojiPicker {
			id = "project-edit-emoji",
			value = emoji,
			recents = recents,
			tone = tone,
