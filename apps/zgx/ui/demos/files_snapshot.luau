local M = {}
for id, spec in specs do
	M[id] = lex.code(spec)
end
return M
]],
		["apps/zgx/ui/ds/text_area.luau"] = [[
-- A multi-line text field: the field's frame round a textarea that grows
-- with what is written, from `rows` lines to `max_rows`, and scrolls past
-- that. The height eases as it grows, measured from the wrapped text (as
-- the composer measures its draft).
--
-- `TextArea { value = state, label = "Description", rows = 3, max_rows = 8 }`.
-- `subject = { soft = 50, max = 72, body = 72 }` holds a commit message to
-- git's rules: the first line, the subject, wants 50 characters and has to
-- stop by 72; every line after it wraps by 72. What runs past a line's limit
-- takes the warning's ink (past a subject's hard limit, the danger's), on
-- whichever line it is, and the count says which line is over.

local locale = require("@self/locale")
local control = require("@self/control")
local field = require("@self/field")

export type Props = {
	value: State<string>,
	-- (Each takes a message, `ui.t`.)
	label: Label?,
	placeholder: (string | Message)?,
	hint: Label?,
	error: Props_error,
	count: field.Count?,
	-- A commit message's subject line: its length counted against these.
	subject: { soft: number, max: number?, body: number? }?,
	rows: number?,
	max_rows: number?,
	size: control.Size?,
	disabled: boolean?,
	name: (string | Message)?,
	autofocus: boolean?,
	-- ⌘Enter (a form's submit from a multi-line field).
	on_submit: ((text: string) -> ())?,
	on_key: ((e: any) -> boolean?)?,
	-- Markdown as it is typed, or a code editor's: a textarea `highlight`.
	highlight: any?,
	mono: boolean?,
	w: number?,
	w_full: boolean?,
	grow: number?,
}

-- Padding above and below the text inside the frame (zeron.space.tight,
-- in points for the height's sum).
local PAD_Y = 6

local function first_line(s: string): string
	return string.match(s, "^[^\n]*") or ""
end

return ui.component(function(props: Props): Node
	local size: control.Size = props.size or "md"
	local value = props.value
	local focused = ui.use_state(false)
	local hovered = ui.use_state(false)
	local measure = ui.ref()
	local input_ref = ui.ref()
	local line = ui.theme.get("zeron.field.line") :: number? or 20
	local rows, max_rows = props.rows or 3, props.max_rows or 10
	local font = if props.mono then "$font.mono" else nil

	local height = ui.computed(function(): number
		local h = measure.height or line
		return math.clamp(h, line * rows, line * max_rows) + PAD_Y * 2 + 2
	end)

	local count: field.Count? = props.count
	local subject = props.subject
	local body_limit = if subject then subject.body or 72 else 0
	-- The first body line past its limit: its number, and its length.
	local function long_line(): (number?, number)
		local n = 0
		for line in string.gmatch(value:get() .. "\n", "([^\n]*)\n") do
			n += 1
			local len = utf8.len(line) or #line
			if n > 1 and len > body_limit then
				return n, len
			end
		end
		return nil, 0
	end
	if subject and not count then
		local subject_count: field.Count = {
			of = function()
				return utf8.len(first_line(value:get())) or 0
			end,
			soft = subject.soft,
			max = subject.max,
			-- A subject over its limit speaks first; a good one gives way to
			-- a long line further down, named, or nothing would explain its ink.
			say = function(n: number): (string?, boolean?)
				local at, len = long_line()
				if at and n <= subject.soft then
					return locale.s("ds.text_area.line_over", { line = tostring(at), length = tostring(len), limit = tostring(body_limit) }), true
				end
				return nil, nil
			end,
		}
		count = subject_count
	end
	-- Past a line's limit: the characters beyond it in amber (past a
	-- subject's hard one, red). Mid steps of the palette, the same in both
	-- themes: a textarea keeps a line's colours until the line changes, so
	-- a theme's own ink would stay the theme it was typed in.
	local highlight = props.highlight
	if subject and not highlight then
		highlight = function(text: string, state: number)
			-- The first line is the subject; every other is held to the body's.
			local is_subject = state == 0
			local soft = if is_subject then subject.soft else body_limit
			local spans = {}
			local n = utf8.len(text) or #text
			if n > soft then
				local soft_at = utf8.offset(text, soft + 1) or (#text + 1)
				local hard = if is_subject then subject.max else nil
				local hard_at = if hard and n > hard then utf8.offset(text, hard + 1) else nil
				table.insert(spans, { soft_at, (hard_at or (#text + 1)) - 1, "$palette.amber.500" })
				if hard_at then
					table.insert(spans, { hard_at, #text, "$palette.red.500" })
				end
			end
			return spans, 1
		end
	end

	local area = ui.textarea(field.input({
		ref = input_ref,
		value = value,
		label = props.label or props.name or props.placeholder or "",
		placeholder = props.placeholder,
		error = props.error,
		wrap = true,
		highlight = highlight,
		font = font,
		line_height = line,
		on_mount = if props.autofocus
			then function(el)
				el:focus()
			end
			else nil,
		on_key = function(e)
			if props.on_key and props.on_key(e) then
				return true
			end
			if e.key == "Enter" and e.cmd and props.on_submit then
				props.on_submit(value:peek())
				return true
			end
			return false
		end,
	}, size, focused))

	local box = field.frame {
		size = size,
		focused = focused,
		hovered = hovered,
		error = props.error,
		h = ui.tween(height, { duration = 160, ease = "out(3)" }),
		py = "$zeron.space.tight",
		items = "stretch",
		relative = true,
		overflow = "hidden",
		w_full = true,
		on_click = function()
			local el = input_ref:peek()
			if el then
				el:focus()
			end
		end,
		area,
		-- The measure: the text wrapped as the field wraps it (a mark after
		-- it, so a last empty line counts), unseen.
		ui.text {
			ref = measure,
			absolute = true,
			left = control.PAD_PT[size],
			right = control.PAD_PT[size],
			top = 0,
			opacity = 0,
			pointer_events = "none",
			aria_hidden = true,
			wrap = true,
			font = font,
			text_size = control.TEXT[size],
			line_height = line,
			function()
				return value:get() .. "\u{200B}"
			end,
		},
	}
	return field.wrap {
		label = props.label,
		hint = props.hint,
		error = props.error,
		count = count,
		size = size,
		box = box,
		disabled = props.disabled,
		w = if props.w_full then nil else (props.w or 320),
		w_full = props.w_full,
		grow = props.grow,
	}
end)
]],
		["apps/zgx/ui/ds/tile.luau"] = [[
-- A project's tile: its initial on its hue (the palette's 500, inked in its
-- 50). One tile wherever a project shows: the sidebar, a dropdown, the
-- composer's project.
--
-- `Tile { label = "Zeron", hue = "violet", size = 18 }`; `inside` puts a
-- glyph where the initial goes (pinned's pin), and `hue` may be nil for a
-- neutral tile (a quiet wash, the glyph in secondary ink). `src` is the
-- project's own artwork (an image its people chose, else its favicon, as
-- Zeron finds it in the checkout): shown whole in the tile's place, clipped
-- to its corner. `emoji` is a picture its people chose: the emoji in the
-- middle, an even inset all round, on a soft wash of its hue (none: the
-- neutral wash). Artwork wins over an emoji, an emoji over the initial.
-- `label`, `hue`, `src` and `emoji` may be functions (the tile of a choice
-- that changes): the tile follows them in place.

export type Props = {
	label: (string | Message | () -> string?)?,
	hue: (string | () -> string?)?,
	size: number?,
	inside: Node?,
	src: (string | () -> string?)?,
	emoji: (string | () -> string?)?,
}

-- Its corner grows a step with it: a sidebar's 18 takes the small radius,
-- a list row's 32 the next, a preview's 64 the large, so a big tile isn't a
-- square with chipped corners.
local control = require("@self/control")

local function corner(size: number): string
	return if size >= 56 then "$radius.xl" elseif size >= 32 then "$radius.md" else "$radius.sm"
end

-- An emoji's share of the tile: an even inset of about a fifth each side
-- on a big tile; a small one's emoji takes more of it (a glyph carries its
-- own side bearing, which at 7 points leaves a speck).
local EMOJI = 0.62
local EMOJI_SMALL = 0.8
-- How strongly an emoji tile's hue washes it: a tint under the emoji, not
-- the initial's solid fill (an emoji is in colour already).
local WASH = 0.22

local function read(v: (string | () -> string?)?): string?
	if type(v) == "function" then
		return v()
	end
	return v :: string?
end

return function(props: Props): Node
	local size = props.size or 18
	local radius = corner(size)
	local function artwork(): Node
		return ui.div {
			w = size,
			h = size,
			shrink = 0,
			rounded = radius,
			overflow = "hidden",
			ui.image {
				src = if type(props.src) == "function"
					then function(): string
						return (props.src :: () -> string?)() or ""
					end
					else props.src :: string,
				w_full = true,
				h_full = true,
				fit = "contain",
			},
		}
	end
	local function emoji(): Node
		local hue = props.hue
		return ui.div {
			w = size,
			h = size,
			shrink = 0,
			rounded = radius,
			overflow = "hidden",
			relative = true,
			items = "center",
			justify = "center",
			bg = "$zeron.secondary.bg",
			-- (The hue's own wash over the neutral one, so either theme's
			-- page shows through the same.)
			ui.div {
				absolute = true,
				left = 0,
				top = 0,
				w = size,
				h = size,
				bg = if type(hue) == "function"
					then function(): string
						local h = hue()
						return if h then `$palette.{h}.500` else "#00000000"
					end
					elseif hue then `$palette.{hue}.500`
					else "#00000000",
				opacity = WASH,
			},
			ui.text {
				if type(props.emoji) == "function"
					then function(): string
						return (props.emoji :: () -> string?)() or ""
					end
					else props.emoji :: string,
				text_size = ui.raw(math.floor(size * (if size < 32 then EMOJI_SMALL else EMOJI) + 0.5), "an emoji's glyph, in proportion to its tile"),
				line_height = size,
				h = size,
				align = "center",
				aria_hidden = true,
			},
		}
	end
	local function hued(): Node
		local hue = props.hue
		local function initial(): string
			-- (Its first character, whole: a name may start past ASCII.)
			local name = control.text(props.label) or ""
			local first = string.match(name, "^" .. utf8.charpattern) or ""
			return string.upper(first)
		end
		return ui.div {
			w = size,
			h = size,
			shrink = 0,
			rounded = radius,
			bg = if type(hue) == "function"
				then function(): string
					local h = hue()
					return if h then `$palette.{h}.500` else "$zeron.secondary.bg"
				end
				elseif hue then `$palette.{hue}.500`
				else "$zeron.secondary.bg",
			color = if type(hue) == "function"
				then function(): string
					local h = hue()
					return if h then `$palette.{h}.50` else "$text.secondary"
				end
				elseif hue then `$palette.{hue}.50`
				else "$text.secondary",
			items = "center",
			justify = "center",
			props.inside or ui.text {
				if type(props.label) == "function" or control.is_message(props.label) then initial else initial(),
				-- (A big tile's initial grows with it: half its side.)
				text_size = if size >= 32
					then ui.raw(math.floor(size * 0.46 + 0.5), "a big tile's initial, in proportion to it")
					else "$font.size.xs",
				weight = "$font.weight.semibold",
			},
		}
	end
	local src, glyph = props.src, props.emoji
	if type(src) == "function" or type(glyph) == "function" then
		-- (Which one shows is a real swap: each kind built once, kept while
		-- it shows, its values followed in place.)
		return ui.switch(function(): string
			local s, e = read(src), read(glyph)
			return if s and s ~= "" then "artwork" elseif e and e ~= "" then "emoji" else "hued"
		end, {
			artwork = if src then artwork() else ui.div {},
			emoji = if glyph then emoji() else ui.div {},
			hued = hued(),
		})
	end
	if src and src ~= "" then
		return artwork()
	end
	if glyph and glyph ~= "" then
		return emoji()
	end
	return hued()
end
]],
		["apps/zgx/ui/ds/token_field.luau"] = [[
-- A token field: a list of short things typed one at a time (emails to
-- invite, labels), each turning into a chip as it is finished: Enter, a
-- comma, a space or leaving the field. Backspace in an empty field takes the
-- last one back to edit. A pasted list splits into chips. `valid` says
-- whether a chip is good; one that isn't reads in the danger's ink, and stays
-- so it can be fixed. The field's frame, label, hint and error are a text
-- field's.
--
-- `TokenField { value = emails, label = "Invite by email", placeholder = "name@company.com",
--   valid = function(s) return string.find(s, "@", 1, true) ~= nil end }`

local Tag = require("@self/badge").Tag
local control = require("@self/control")
local field = require("@self/field")

export type Props = {
	value: State<{ string }>,
	-- (Each takes a message, `ui.t`.)
	label: Label?,
	placeholder: (string | Message)?,
	hint: Label?,
	error: Props_error,
	valid: ((s: string) -> boolean)?,
	size: control.Size?,
	-- Its accessible name when it has no label.
	name: (string | Message)?,
	disabled: boolean?,
	w: number?,
	w_full: boolean?,
	autofocus: boolean?,
}

-- Where a list breaks into chips.
local BREAK = "[,;%s]+"

return ui.component(function(props: Props): Node
	local size: control.Size = props.size or "md"
	local value = props.value
	local draft = ui.use_state("")
	local focused = ui.use_state(false)
	local hovered = ui.use_state(false)
	local input_ref = ui.ref()

	local function take()
		local list = table.clone(value:peek())
		local changed = false
		for part in string.gmatch(draft:peek() .. ",", "(.-)" .. BREAK) do
			if part ~= "" and not table.find(list, part) then
				table.insert(list, part)
				changed = true
			end
		end
		draft:set("")
		if changed then
			value:set(list)
		end
	end
	local function drop(token: string)
		local list = table.clone(value:peek())
		local at = table.find(list, token)
		if at then
			table.remove(list, at)
			value:set(list)
		end
	end

	-- The chips and, last among them, the input, so it wraps with them.
	local items = ui.computed(function(): { string }
		local out = table.clone(value:get())
		table.insert(out, "\0input")
		return out
	end)
	local input = ui.input(field.input({
		ref = input_ref,
		value = draft,
		label = props.label or props.name or props.placeholder or "",
		placeholder = function()
			return if #value:get() == 0 then control.text(props.placeholder) or "" else ""
		end,
		on_mount = if props.autofocus
			then function(el)
				el:focus()
			end
			else nil,
		on_commit = take,
		on_blur = take,
		on_key = function(e)
			if e.key == "Enter" or e.key == "," or e.key == " " or e.key == ";" then
				take()
				return true
			elseif e.key == "Backspace" and draft:peek() == "" then
				local list = value:peek()
				if #list > 0 then
					local last = list[#list]
					drop(last)
					draft:set(last)
					return true
				end
			end
			return false
		end,
	}, size, focused))

	-- One row of chips is a single-line field: the chips' height (a Tag's),
	-- the frame's (a control's) and the inset between them are one sum, the
	-- inset being what is left of the frame's height past its edge and a
	-- chip, halved. A chip's gap from the next is that inset too, so the
	-- chips sit in the frame as evenly as they sit beside each other. The
	-- frame grows only once the chips really wrap.
	local CHIP = if size == "sm" then 20 else 24
	local INSET = ui.raw((control.H[size] - 2 - CHIP) / 2, "the frame's height less its edge and a chip, halved")
	-- The chips and, last among them, the input, which asks for as much
	-- room as what is being typed (a hidden copy of the draft, measured) and
	-- a caret's worth more, a few characters' worth at least, and grows into
	-- whatever its line has left. So the caret stays on the chips' line
	-- until the typing truly runs out of room there, then takes a line of
	-- its own; a bare input would ask for its 240 whatever it held and wrap
	-- at once.
	local AT_LEAST, CARET = 32, 12
	local ghost = ui.ref()
	local box = field.frame {
		size = size,
		focused = focused,
		hovered = hovered,
		error = props.error,
		grows = true,
		w_full = true,
		px = INSET,
		py = INSET,
		gap = INSET,
		flex_wrap = true,
		items = "center",
		on_click = function()
			local el = input_ref:peek()
			if el then
				el:focus()
			end
		end,
		ui.each(items, function(token: string): Node
			if token == "\0input" then
				return ui.div {
					w = AT_LEAST,
					grow = 1,
					min_w = function()
						return math.max(AT_LEAST, (ghost.width or 0) + CARET)
					end,
					h = CHIP,
					justify = "center",
					input,
					ui.text {
						function()
							return draft:get()
						end,
						ref = ghost,
						absolute = true,
						opacity = 0,
						text_size = control.TEXT[size],
						aria_hidden = true,
						pointer_events = "none",
					},
				}
			end
			return Tag {
				token,
				invalid = props.valid ~= nil and not props.valid(token),
				on_remove = function()
					drop(token)
				end,
			}
		end, {
			key = function(token: string)
				return token
			end,
			direction = "row",
			flex_wrap = true,
			items = "center",
			gap = INSET,
			grow = 1,
			min_w = 0,
		}),
	}
	return field.wrap {
		label = props.label,
		hint = props.hint,
		error = props.error,
		size = size,
		box = box,
		disabled = props.disabled,
		w = if props.w_full then nil else (props.w or 320),
		w_full = props.w_full,
	}
end)
]],
		["apps/zgx/ui/ds/tree_line.luau"] = [[
-- A tree's branch: a trunk down a row and an arm curving off it to the row's
-- mark, drawn in one even tone. The lines are the text's ink, faint, so two
-- strokes laid over each other go darker where they cross: a trunk and an
-- arm stroked apart double along the curve, where it leaves the trunk. So
-- the two are one outline, filled once (as Zeron's `activity_rail` unions
-- them), and the tone holds through the joint.
--
-- `c:fill(tree_line.branch { x = 12, mid = 13, tip = 24, h = 28, bend = 6, on = true }, "$zeron.tree")`
-- `on`: the trunk goes on below the arm; `h` is where it stops.

local M = {}

local HALF = 0.5

export type Branch = { x: number, mid: number, tip: number, h: number, bend: number, on: boolean }

function M.branch(b: Branch): any
	local x, mid, tip, h, bend = b.x, b.mid, b.tip, b.h, b.bend
	local path = ui.path():move(x - HALF, 0)
	if b.on then
		-- The arm's foot runs as a curve from the arm into the trunk's left
		-- side; only the part of it outside the trunk is an edge. Where it
		-- crosses the trunk's right side, it stops.
		local t = 1 - math.sqrt(2 * HALF / (bend + HALF))
		local cx, cy = x + bend + (x - HALF - (x + bend)) * t, mid + HALF
		local y2 = mid + HALF + (mid - bend - (mid + HALF)) * t * t
		path = path:line(x - HALF, h):line(x + HALF, h):line(x + HALF, y2):quad(cx, cy, x + bend, mid + HALF)
	else
		path = path:line(x - HALF, mid - bend):quad(x - HALF, mid + HALF, x + bend, mid + HALF)
	end
	return path:line(tip, mid + HALF)
		:line(tip, mid - HALF)
		:line(x + bend, mid - HALF)
		:quad(x + HALF, mid - HALF, x + HALF, mid - bend)
		:line(x + HALF, 0)
		:close()
end

-- A trunk going on down a row without a branch off it (an outer group's,
-- past an inner group's rows): from its top to `h`.
function M.trunk(x: number, h: number): any
	return ui.path():move(x - HALF, 0):line(x - HALF, h):line(x + HALF, h):line(x + HALF, 0):close()
end

return M
]],
		["apps/zgx/ui/ds/working.luau"] = [[
-- That an agent is working on a reply, as Zeron's transcript says it under
-- the turn: the working loader, a word for it ("Noodling…") that rolls to
-- another every seven seconds, and how long it has been at it.
--
-- `Working { since = seconds }`: `since` in `ui.now() / 1000` seconds, when
-- the turn began (or a function of it); `seed` picks where the words start
-- (a chat's own). `sending`: the message is on its way, its turn not yet
-- begun: "Sending…" and no clock, as Zeron's trailer bridges that gap
-- (transcript.rs `sending_bridge`); the word and the clock start with the
-- turn.

local RollText = require("@self/roll_text")
local status = require("@self/status")
local locale = require("@self/locale")

export type Props = { since: number | () -> number, seed: number?, sending: (() -> boolean)? }

-- Zeron's words (transcript.rs, `FLAVOUR_WORDS`, their keys), each held
-- this long.
local WORDS = {
	"ds.working.words.zeroning",
	"ds.working.words.thinking",
	"ds.working.words.pondering",
	"ds.working.words.scheming",
	"ds.working.words.brewing",
	"ds.working.words.weaving",
	"ds.working.words.tinkering",
	"ds.working.words.musing",
	"ds.working.words.composing",
	"ds.working.words.sifting",
	"ds.working.words.untangling",
	"ds.working.words.distilling",
	"ds.working.words.sketching",
	"ds.working.words.plotting",
	"ds.working.words.riffing",
	"ds.working.words.combobulating",
	"ds.working.words.percolating",
	"ds.working.words.marinating",
	"ds.working.words.noodling",
	"ds.working.words.puzzling",
	"ds.working.words.conjuring",
}
local ROTATE = 7

return ui.component(function(props: Props): Node
	local now = ui.use_state(ui.now() / 1000)
	-- Once a second: the clock shows whole seconds, and the word turns on
	-- one of them.
	ui.every(1000, function()
		now:set(ui.now() / 1000)
	end)
	local seed = props.seed or 0
