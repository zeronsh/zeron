            .map(PathBuf::from)
            .unwrap_or_else(|_| std::env::temp_dir().join(format!("agent-logos-{}", std::process::id())));
        std::fs::create_dir_all(&dir).unwrap();
        let wants: Vec<Want> = index["agents"]
            .as_array()
            .unwrap()
            .iter()
            .map(|a| Want {
