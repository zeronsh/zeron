				if narrow
					then ui.column { w_full = true, gap = "$space.2", approve, changes, comment }
					else ui.row { w_full = true, justify = "end", gap = "$space.2", comment, changes, approve },
			}
		end
		-- Summary: what it is and where it stands, and the way to say so. A
		-- failure is said once, by the checks block, which then comes first:
		-- it is what a reviewer needs before the description, and opening it
		-- shows the failing check and its log without a scroll.
		local function summary(state: string, checks: { git.Check }, narrow: boolean): Node
			local failed = state == "failed"
			local block = git.checks_block { list = checks, open = git.checks_open, log = if failed then git.log(FAILED_LOG) else nil }
			local description = ds.Settings.Section {
				title = "Description",
				ui.column { w_full = true, px = "$space.4", py = "$space.3", rounded = "$radius.xl", bg = "$zeron.settings.card", border = 1, border_color = "$zeron.settings.edge", Markdown { text = git.PR.body } },
			}
			return ui.column {
				w_full = true,
				gap = "$space.5",
				if failed then block else description,
				if failed then description else block,
				ds.Settings.Section { title = "Review", verdicts(state), review_box(state, narrow) },
			}
		end
		-- What stands under a line of a file, top to bottom: the thread
		-- already there, one made here, and the comment being written. Each
		-- is the design system's band, built with the diff's gutter as its
		-- inset, joined to the block above it. A comment is keyed by file and
		-- line ("ui/ds/badge.luau|n45").
		local function blocks_under(state: string, path: string, key: string): { git.Block }?
			local out: { git.Block } = {}
			local at = `{path}|{key}`
			local made = extra:get()
			if path == "ui/ds/badge.luau" and key == "n42" then
				table.insert(out, { kind = "thread", build = function(ctx: git.BlockCtx): Node
					return git.thread { inset = ctx.inset, joined = ctx.joined, draft = draft, resolved = resolved, changes = state == "changes" }
				end })
			end
			if made[at] then
				table.insert(out, { kind = "made", build = function(ctx: git.BlockCtx): Node
					local comments: { Comment.Comment } = { { author = git.ME, at = os.time(), body = made[at], mine = true } }
					return ds.InlineThread {
						inset = ctx.inset,
						joined = ctx.joined,
						location = `{path}:{string.sub(key, 2)}`,
						draft = reply_draft,
						me = git.ME,
						comments = comments,
					}
				end })
			end
			if composing:get() == at then
				table.insert(out, { kind = "composer", build = function(ctx: git.BlockCtx): Node
					return ds.InlineComposer {
						inset = ctx.inset,
						joined = ctx.joined,
						reveal = ctx.reveal,
						location = `{path}:{string.sub(key, 2)}`,
						value = new_draft,
						placeholder = "Comment on this line",
						submit = "Comment",
						on_submit = function(text: string)
							extra:set_key(at, text)
							composing:set("")
						end,
						on_cancel = function()
							composing:set("")
						end,
					}
				end })
			end
			return if #out > 0 then out else nil
		end
		-- Code: the changed files as one list (four, or a thousand), in their
		-- folders, with a filter and what there is over it. At the window's
		-- width the diff of the file chosen stands beside the list in a pane
		-- of its own, with the thread on its line 42 and a + on any line to
		-- start one; at a pane's width a file opens its diff in place under
		-- its row, threads and all, and the list is the one scroll surface.
		local function code(state: string, narrow: boolean): Node
			local files = Changes.files(git.many:peek())
			local by_path: { [string]: Changes.File } = {}
			for _, f in files do
				by_path[f.path] = f
			end
			-- The chosen file is one of these; the first, if not.
			if not by_path[chosen:peek()] and files[1] then
				ui.after(0, function()
					chosen:set(files[1].path)
				end)
			end
			if narrow then
				-- The files in their card (what there is and the filter as its
				-- head), each opening its diff in place; a comment opening under
				-- a line brings itself into the list's frame.
				local list_frame: any = nil
				return Changes.panel {
					files = files,
					filter = filter,
					narrow = true,
					folded = folded,
					open = open,
					after = function(path: string, key: string): { git.Block }?
						return blocks_under(state, path, key)
					end,
					on_comment = function(path: string, key: string)
						composing:set(`{path}|{key}`)
					end,
					reveal = {
						offset = list_offset,
						frame = function()
							return list_frame
						end,
					},
					offset = list_offset,
					on_frame = function(el)
						list_frame = el
					end,
				}
			end
			local function diff_now(): Node
				local f = by_path[chosen:get()] or files[1]
				return git.diff(f.path, f.status, f.add, f.del, {
					narrow = false,
					after = function(key: string): { git.Block }?
						return blocks_under(state, f.path, key)
					end,
					on_comment = function(key: string)
						composing:set(`{f.path}|{key}`)
					end,
					reveal = {
						offset = pane_offset,
						frame = function()
							return pane_frame
						end,
					},
				})
			end
			-- Another file, another diff; a comment opened or made under a
			-- line, a block in place under it.
			local diff = ui.presence(function(): string
				return chosen:get()
			end, function(_: string): Node
				return diff_now()
			end, { w_full = true, enter = { opacity = { 0, 1 }, duration = 100 }, exit = { opacity = 0, duration = 50 }, mode = "wait" })
			local pane = ui.div {
				grow = 1,
				min_w = 0,
				min_h = 0,
				h_full = true,
				on_resize = function(_size, el)
					pane_frame = el
				end,
				ui.scroll {
					id = "diff-scroll",
					offset = pane_offset,
					w_full = true,
					h_full = true,
					fade = { 16, 16 },
					fade_overflow = true,
					diff,
				},
			}
			-- The list's card and the diff's start on one line, their heads of
			-- one height, so their first rows share a line.
			local panel = Changes.panel {
				files = files,
				filter = filter,
				folded = folded,
				chosen = chosen,
				on_choose = function(f: Changes.File)
					chosen:set(f.path)
				end,
				offset = list_offset,
			}
			return ui.row {
				w_full = true,
				grow = 1,
				min_h = 0,
				gap = "$space.4",
				items = "stretch",
				ui.column { w = 300, shrink = 0, min_h = 0, panel },
				pane,
			}
		end
		local function page(state: string, narrow: boolean, fixed: boolean): Node
			local checks = checks_for(state)
			local passing = 0
			for _, c in checks do
				passing += if c.state == "passing" then 1 else 0
			end
			local review_state = if state == "changes" then "changes" elseif state == "approved" then "approved" else "pending"
			local checks_state = if state == "running" then "running" elseif state == "failed" then "failing" else "passing"
			local events = git.events { checks = checks, verdicts = verdicts_for(state) }
			-- The Code tab is built in place at the window's height; the
			-- other two come and go under the tabs.
			local content: Node = if fixed
				then code(state, narrow)
				else ui.presence(tab_now, function(t: string): Node
					if t == "activity" then
						return git.activity(events)
					end
					return summary(state, checks, narrow)
				end, { w_full = true, enter = { opacity = { 0, 1 }, duration = 120 }, exit = { opacity = 0, duration = 60 }, mode = "wait" })
			return ui.column {
				w_full = true,
				grow = if fixed then 1 else nil,
				min_h = if fixed then 0 else nil,
				gap = "$space.5",
				git.header("open", narrow),
				git.tabs {
					value = tab,
					narrow = narrow,
					options = {
						{ value = "summary", label = "Summary" },
						{ value = "code", label = "Code", count = #git.FILES },
						{ value = "activity", label = "Activity", count = #events },
					},
					badges = {
						ds.ChecksBadge { state = checks_state :: any, passed = passing, total = #checks, size = "md" },
						ds.ReviewBadge { state = review_state :: any, size = "md" },
					},
				},
				content,
			}
		end
		return git.window {
			states = {
				{ value = "running", label = "Checks running" },
				{ value = "failed", label = "A check failed" },
				{ value = "changes", label = "Changes requested" },
				{ value = "approved", label = "Approved" },
			},
			state = shown,
			fixed = function(): boolean
				return tab_now() == "code"
			end,
			body = function(narrow: boolean, fixed: boolean): Node
				return ui.presence(function(): string
					return shown:get()
				end, function(state: string): Node
					return page(state, narrow, fixed)
				end, { w_full = true, h_full = fixed, enter = { opacity = { 0, 1 }, duration = 120 }, exit = { opacity = 0, duration = 60 }, mode = "wait" })
			end,
		}
	end,
}
]],
		["apps/zgx/ui/demos/example_members.luau"] = [[
-- Settings: members. Who's in the organization, who's been asked, and what
-- each can do, with seats counted and the ways out asked twice.

local ds = require("@ds")
local kit = require("@demos/example_kit")

local query = ui.state("ex_mem_query", "")
local shown = ui.state("ex_mem_state", "ready")
local removing = ui.state("ex_mem_removing", false)
local inviting = ui.state("ex_mem_inviting", false)
local invitees = ui.state("ex_mem_invitees", {} :: { string })

type Member = { id: string, name: string, email: string, role: string, you: boolean?, seen: string }

local MEMBERS: { Member } = {
	{ id = "mara", name = "Mara Okafor", email = "mara@halcyon.dev", role = "owner", you = true, seen = "Active now" },
	{ id = "theo", name = "Theo Lindqvist", email = "theo@halcyon.dev", role = "admin", seen = "Active 2 hours ago" },
	{ id = "priya", name = "Priya Raman", email = "priya@halcyon.dev", role = "member", seen = "Active yesterday" },
	{ id = "jonas", name = "Jonas Weber", email = "jonas@halcyon.dev", role = "member", seen = "Active 3 days ago" },
	{ id = "ines", name = "Ines Duarte", email = "ines@halcyon.dev", role = "viewer", seen = "Active last week" },
}
local INVITES = {
	{ email = "sam@halcyon.dev", when = "Invited 2 days ago · Member" },
	{ email = "lena@northwind.io", when = "Invite expired · Viewer", expired = true },
}
local ROLES = {
	{ value = "admin", label = "Admin" },
	{ value = "member", label = "Member" },
	{ value = "viewer", label = "Viewer" },
}

-- The members the search finds.
local found = ui.computed(function(): { Member }
	local q = string.lower(query:get())
	local out: { Member } = {}
	for _, m in MEMBERS do
		if q == "" or string.find(string.lower(m.name .. " " .. m.email), q, 1, true) then
			table.insert(out, m)
		end
	end
	return out
end)

local function row(m: Member): Node
	local control: Node
	if m.role == "owner" then
		control = ds.Badge { "Owner", size = "md" }
	else
		control = ui.row {
			gap = "$space.1",
			items = "center",
			ds.Select { value = ui.state(`ex_mem_role_{m.id}`, m.role), name = `{m.name}'s role`, size = "sm", w = 108, options = ROLES },
			ds.IconButton { icon = "more-horizontal", label = `More for {m.name}`, size = "md", tone = "quiet", on_click = function() removing:set(true) end },
		}
	end
	return ds.Settings.Row {
		label = m.name,
		description = `{m.email} · {m.seen}`,
		lead = ds.Avatar { seed = m.id, size = 32 },
		badge = if m.you then ds.Badge { "You" } else nil,
		control = control,
	}
end

-- A pending invitation: who, and the ways to send it again or take it back.
local function invitation(i: any): Node
	return ds.Settings.Row {
		label = i.email,
		description = i.when,
		lead = ds.Avatar { seed = i.email, size = 32 },
		badge = if i.expired then ds.Badge { "Expired", tone = "warning" } else nil,
		control = ui.row {
			gap = "$space.1",
			ds.Button { "Resend", tone = "ghost", size = "sm" },
			ds.Button { "Revoke", tone = "ghost", size = "sm" },
		},
	}
end

return {
	id = "ex_members",
	title = "Members",
	about = "Settings → Members: everyone in the organization, found by name, each with a role to change and a way out; the invitations still open, with the seats they hold. And what shows while they load, when they fail, and when a search finds no one.",
	demo = function()
		local function body(key: string): Node
			if key == "loading" then
				return ds.Settings.Group { ds.SkeletonRow { trail = 108 }, ds.SkeletonRow { title = 110, line = 200, trail = 108 }, ds.SkeletonRow { title = 130, line = 220, trail = 108 }, ds.SkeletonRow { title = 100, line = 180, trail = 108 } }
			elseif key == "failed" then
				return ds.Callout { tone = "danger", title = "Couldn't load members", body = "Something went wrong on our side. Your team's access hasn't changed.", action = { label = "Try again", on_click = function() shown:set("ready") end } }
			end
			if key == "nobody" then
				return ds.EmptyState { icon = "search", title = "No one by that name", body = "Check the spelling, or invite them.", size = "sm", action = { label = "Invite someone", on_click = function() inviting:set(true) end } }
			end
			-- Those the search finds, each row its member's as the search
			-- narrows and widens.
			return ds.Settings.Each(found, row, {
				key = function(m: any): string
					return m.id
				end,
			})
		end
		return kit.stage {
			states = {
				{ value = "ready", label = "Ready" },
				{ value = "loading", label = "Loading" },
				{ value = "failed", label = "Failed" },
			},
			state = shown,
			w = 900,
			h = 640,
			overlays = {
				ds.Dialog {
					open = removing,
					title = "Remove Priya Raman?",
					body = "They lose access to Halcyon Labs at once. Chats they started stay with the team.",
					tone = "danger",
					confirm = { label = "Remove" },
				},
				ds.Dialog {
					open = inviting,
					title = "Invite to Halcyon Labs",
					body = "3 seats left. Each invitation holds one for 7 days.",
					size = "md",
					confirm = { label = "Send invites" },
					ds.TokenField { value = invitees, name = "Email addresses", placeholder = "name@company.com", w_full = true, autofocus = true },
				},
			},
			kit.settings {
				page = "members",
				ds.Settings.Page {
					title = "Members",
					description = "Everyone in Halcyon Labs, and what they can do here.",
					-- The search beside the one action, over the list it filters.
					trail = ui.row {
						gap = "$space.2",
						items = "center",
						ds.SearchField { value = query, placeholder = "Find someone", size = "sm", w = 180 },
						ds.Button { "Invite", size = "sm", on_click = function() inviting:set(true) end },
					},
					ds.Settings.Section {
						ui.presence(function(): string
							local s = shown:get()
							if s ~= "ready" then
								return s
							end
							return if #found:get() > 0 then "found" else "nobody"
						end, body, { w_full = true, enter = { opacity = { 0, 1 }, duration = 120 }, exit = { opacity = 0, duration = 60 }, mode = "wait" }),
					},
					-- Invitations hold seats, so the seats stand at the head of them.
					ds.Settings.Section {
						title = "Invitations",
						ds.Settings.Group {
							ds.Settings.Row {
								label = "7 of 10 seats used",
								description = "Pending invitations hold a seat until they expire.",
								control = ui.row { gap = "$space.3", items = "center", ds.ProgressBar { value = function() return 0.7 end, w = 120, label = "Seats used" }, ds.Button { "Add seats", tone = "secondary", size = "sm" } },
							},
							invitation(INVITES[1]),
							invitation(INVITES[2]),
						},
					},
				},
			},
		}
	end,
}
]],
		["apps/zgx/ui/demos/example_profile.luau"] = [[
-- Settings: a profile. Who you are to your team, with your member card
-- beside the fields as the live preview of it: the fields at the left, and
-- at the right the card as it will be, your name on it changing as you
-- type it (one composed object: the card, and the ways to share it in a
-- quiet pill of glyphs under it, as wide as the card; no name or number
-- beside it that the card already says). Live: it tilts and shines under
-- the pointer. Where the
-- window is too narrow for two columns, the card stands centred over the
-- fields instead. Someone with no card yet sees the card's outline in the
-- same place, and the way to one.
--
-- The groups that aren't about how you appear (your preferences, where
-- you're signed in, the way out) stay in the fields' column under the
-- identity group: one column of groups keeps the page's rhythm, and the
-- card's column stays the object's own.

local ds = require("@ds")
local kit = require("@demos/example_kit")

local name = ui.state("ex_pr_name", "Mara Okafor")
local title = ui.state("ex_pr_title", "Staff engineer")
local zone = ui.state("ex_pr_zone", "lisbon")
local digest = ui.state("ex_pr_digest", true)
local shown = ui.state("ex_pr_state", "ready")
local deleting = ui.state("ex_pr_deleting", false)
-- The card's own state: shared, copied, or neither (the control sets it).
local card_state = ui.state("ex_pr_card", "ready")
-- The window's width (the demo's switch): settings' own, or one too narrow
-- for the list of pages, which goes, and for two columns.
local width = ui.state("ex_pr_width", "full")
local function narrow(): boolean
	return width:get() == "narrow"
end
local FULL, NARROW = 900, 560

-- Your card, as the directory has it: the next number on the day the
-- account was made (there were 1,373 members on Oct 28, 2026), and the
-- badges given since (none yet). Its name is the display name's, as typed.
local YOU = {
	number = 1378,
	-- The username: the card's address (zeron.sh/c/mara), chosen once.
	username = "mara",
	since = "Oct 30, 2026",
	layers = {
		{ src = "assets/cards/blossom/sky.webp", depth = 0 },
		{ src = "assets/cards/blossom/far.webp", depth = 1 },
		{ src = "assets/cards/blossom/near.webp", depth = 2 },
		{ src = "assets/cards/blossom/detail.webp", depth = 3 },
	},
	holo = "glyph",
	badges = {} :: { ds.CardBadge },
}

-- The card beside the fields: a card's 300 by 420 at this, the column it
-- stands in as wide as it.
local ZOOM = 0.6
local W, H = 300, 420
local CARD_W = W * ZOOM

-- A card's outline where a card would be, for someone without one yet: a
-- dashed hairline on the card's own shape, the mark faint in its corner.
local function outline(): Node
	return ui.div {
		w = CARD_W,
		h = H * ZOOM,
		shrink = 0,
		p = "$space.3",
		rounded = "$zeron.card.radius",
		border = 1,
		border_dash = { 4, 4 },
		border_color = "$border.strong",
		ui.text { "zeron", font = "$font.sans", weight = "$font.weight.bold", text_size = "$font.size.xs", color = "$text.disabled" },
	}
end

return {
	id = "ex_profile",
	title = "Profile",
	about = "Settings → Profile: your photo, name and title as your team sees them, with your member card beside the fields as the live preview (your name on it as you type), the ways to share it under it, your preferences, the devices you're signed in on, and an account deletion that makes you type your email. A save that says how it went; a profile with no card yet.",
	demo = function()
		local function name_error(): string?
			return if string.match(name:get(), "%S") then nil else "Your teammates need something to call you."
		end
		local function has_card(): boolean
			return shown:get() ~= "nocard"
		end
		-- The card as it will be, your name on it as you type it; under it,
		-- the ways to share it, glyphs alone, the card's width.
		local function preview(): Node
			return ui.column {
				w = CARD_W,
				shrink = 0,
				gap = "$space.3",
				items = "center",
				ui.div {
					zoom = ZOOM,
					shrink = 0,
					ds.MemberCard {
						number = YOU.number,
						name = function(): string
							local n = name:get()
							return if string.match(n, "%S") then n else "—"
						end,
						since = YOU.since,
						layers = YOU.layers,
						holo = YOU.holo,
						badges = if #YOU.badges > 0 then YOU.badges else nil,
					},
				},
				-- Its address, the username: where the card lives, what the
				-- ways under it share.
				ui.text { `zeron.sh/c/{YOU.username}`, text_size = "$font.size.sm", line_height = "$font.line.sm", color = "$text.tertiary" },
				ds.CardActions { state = card_state, form = "glyphs", w = CARD_W },
			}
		end
		-- No card yet (no username chosen, or no account): its outline in the
		-- same place, and the way to one, which is a username.
		local function missing(): Node
			return ui.column {
				w = CARD_W,
				shrink = 0,
				gap = "$space.3",
				items = "center",
				outline(),
				ui.text { "No card yet", text_size = "$font.size.sm", line_height = "$font.line.sm", color = "$text.tertiary" },
				ds.Button { "Claim a username", tone = "secondary", size = "sm" },
			}
		end
		local function aside(): Node
			return ui.presence(has_card, function(with_card: boolean): Node
				return if with_card then preview() else missing()
			end, { enter = { opacity = { 0, 1 }, duration = 160 }, exit = { opacity = 0, duration = 80 }, mode = "wait" })
		end
		return kit.stage {
			states = {
				{ value = "ready", label = "Ready" },
				{ value = "saving", label = "Saving" },
				{ value = "failed", label = "Failed" },
				{ value = "nocard", label = "No card" },
			},
			state = shown,
			also = ds.Segmented {
				value = width,
				options = { { value = "full", label = "Full window" }, { value = "narrow", label = "Narrow" } },
				label = "Width",
			},
			w = function(): number
				return if narrow() then NARROW else FULL
			end,
			h = 640,
			overlays = {
				ds.Dialog {
					open = deleting,
					title = "Delete your account?",
					body = "You'll leave Halcyon Labs and be signed out everywhere. This can't be undone.",
					tone = "danger",
					size = "md",
					confirm_text = "mara@halcyon.dev",
					confirm = { label = "Delete account" },
				},
			},
			kit.settings {
				page = "profile",
				-- (Built again as the width switches: the aside moves.)
				ui.presence(narrow, function(is_narrow: boolean): Node
					return ds.Settings.Page {
						title = "Profile",
						description = "How you appear to everyone in Halcyon Labs.",
						aside = aside(),
						aside_w = CARD_W,
						aside_top = is_narrow,
