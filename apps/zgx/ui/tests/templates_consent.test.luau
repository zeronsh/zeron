-- The template consent sheet says plainly that a template is Zeron's own
-- code with all its powers, who signed it, that its signature checks out,
-- and which files it may not replace; Install and Not now answer with
-- exactly what was shown (its hash); an unknown signer says so, and the
-- sheet follows once Zeron has looked them up. On the sheet in
-- ui/template_consent_fixture.luau.

local function open(): any
	local app = mount("template_consent_fixture.luau")
	app:resize(460, 540)
	app:frames(20)
	return app
end

test("it says what a template can do, who signed it, and what's left out", function()
	local app = open()
	local tree = app:tree("#template-consent")
	expect(tree).to_contain("Install Ledger?")
	expect(tree).to_contain("Made by @ada")
	expect(tree).to_contain("Install it only if you trust @ada")
	expect(tree).to_contain("A template runs as part of Zeron")
	expect(tree).to_contain("Its signature checks out")
	expect(tree).to_contain("by key AbCdEfGh")
	expect(tree).to_contain("42 files")
	expect(tree).to_contain("2 files left out")
	expect(tree).to_contain("Templates can't replace these")
	expect(tree).never.to_contain("Unknown author")
end)

local function armed(app: any)
	app:wait("#never-there", { timeout_ms = 900 })
	app:frames(4)
end

test("Install and Not now answer with what was shown", function()
	local app = open()
	-- (Not at once: a click meant for the main window, as this one comes up.)
	expect(app:tree("#template-consent-allow")).to_contain("disabled")
	app:click("#template-consent-allow")
	app:frames(4)
	expect(app:state("calls")).to_be("")
	armed(app)
	app:click("#template-consent-allow")
	app:frames(20)
	expect(app:state("calls")).to_contain("decide:ledger-1700000000:true:ledger-hash-1")
	expect(app:tree("#template-consent")).to_contain("Nothing waiting")
	app:command("mystery")
	app:frames(20)
	app:click("#template-consent-decline")
	app:frames(20)
	expect(app:state("calls")).to_contain("decide:mystery-1700000001:false:mystery-hash-1")
end)

test("an unknown signer is named so, and the sheet follows once they're found", function()
	local app = open()
	app:command("mystery")
	app:frames(20)
	local tree = app:tree("#template-consent")
	expect(tree).to_contain("Unknown author")
	expect(tree).to_contain("Checking who made it")
	expect(tree).to_contain("Install it only if you trust whoever sent it")
	expect(tree).to_contain("1 file")
	expect(tree).never.to_contain("left out")
	app:command("found")
	app:frames(20)
	tree = app:tree("#template-consent")
	expect(tree).to_contain("Made by @grace")
	expect(tree).to_contain("trust @grace")
	expect(tree).never.to_contain("Unknown author")
end)

test("while it's being fetched, nothing can be answered", function()
	local app = open()
	app:command("loading")
	app:frames(20)
	expect(app:tree("#template-consent")).to_contain("Checking the template")
	expect(app:has("#template-consent-allow")).to_be(false)
end)

test("keeping a template in preview says what keeping gives it, and answers with what was shown", function()
	local app = open()
	app:command("sleek")
	app:frames(20)
	local tree = app:tree("#template-consent")
	expect(tree).to_contain("Keep Sleek?")
	expect(tree).to_contain("Keep it only if you trust what made it")
	expect(tree).to_contain("An agent made, changed or switched to this template")
	expect(tree).to_contain("7 files of its own")
	expect(tree).to_contain("Zeron asks again")
	expect(tree).never.to_contain("Install")
	expect(tree).never.to_contain("signature checks out")
	armed(app)
	app:click("#template-consent-allow")
	app:frames(20)
	expect(app:state("calls")).to_contain("keep:sleek:true:sleek-digest-1")
end)

test("one from the store says whose it is, that it's verified, and that it runs as Zeron", function()
	local app = open()
	app:command("store")
	app:frames(20)
	local tree = app:tree("#template-consent")
	expect(tree).to_contain("Install Midnight?")
	expect(tree).to_contain("Made by @ada")
	expect(app:tree(".template-consent-verified")).to_contain("Verified")
	-- (What it can do is the red callout's, said once.)
	expect(tree).to_contain("A template runs as part of Zeron")
	expect(tree).never.to_contain("Runs as Zeron itself")
	expect(tree).to_contain("From the store")
	expect(tree).to_contain("Its signature checks out")
	expect(tree).never.to_contain("Unknown author")
	expect(app:has("#template-consent-unverified")).to_be(false)
end)

test("one a deploy token published never says a signature checks out, and offers the verified version", function()
	local app = open()
	app:command("token")
	app:frames(20)
	local tree = app:tree("#template-consent")
	expect(tree).to_contain("Update Midnight?")
	expect(tree).never.to_contain("signature checks out")
	expect(tree).to_contain("It's exactly what the store has")
	expect(app:tree(".template-consent-verified")).to_contain("Not verified yet")
	expect(tree).never.to_contain("Unknown author")
	expect(app:tree("#template-consent-edits")).to_contain("You changed this template on this device")
	expect(tree).to_contain("You already have a template with this id")
	app:click('#template-consent-unverified >> role:button "Install 1.2.0 instead"')
	app:frames(4)
	expect(app:state("calls")).to_be("")
	armed(app)
	app:click('#template-consent-unverified >> role:button "Install 1.2.0 instead"')
	app:frames(4)
	expect(app:state("calls")).to_be("install_verified")
end)

test("an update has two boxes, and what changed of it and goes is read without scrolling", function()
	local app = open()
	app:command("changed")
	app:frames(20)
	expect(app:count("role:alert")).to_be(2)
	local function box(line: string): { y: number, h: number }
		local _, y, _, h = line:match("(%-?[%d.]+),(%-?[%d.]+) ([%d.]+)x([%d.]+)")
		return { y = tonumber(y) or 0, h = tonumber(h) or 0 }
	end
	for _, show in { "changed", "long", "locale_zh-Hans" } do
		app:command(show)
		app:frames(20)
		local pane = box(app:tree("#template-consent-scroll"))
		if show == "long" then
			-- (Cut, it says so; whole in the red box.)
			expect(app:tree(".template-consent-maker")).to_contain("w…")
			local mx, mw = app:tree(".template-consent-maker"):match("(%-?[%d.]+),%-?[%d.]+ ([%d.]+)x")
			expect((tonumber(mx) :: number) + (tonumber(mw) :: number) <= 428).to_be(true)
			expect(app:tree("role:alert[1]")).to_contain("trust @" .. string.rep("w", 25))
		end
		local x, w = app:tree(".template-consent-verified"):match("(%-?[%d.]+),%-?[%d.]+ ([%d.]+)x")
		expect((tonumber(x) :: number) + (tonumber(w) :: number) <= 428).to_be(true)
		for _, id in { "#template-consent-changed", "#template-consent-owner", "#template-consent-edits" } do
			local b = box(app:tree(id))
			expect(b.y >= pane.y and b.y + b.h <= pane.y + pane.h - 12).to_be(true)
		end
	end
	app:command("locale_en")
	-- None verified to take instead: its badge says it, and one box.
	app:command("plain_update")
	app:frames(20)
	expect(app:count("role:alert")).to_be(1)
	expect(app:tree(".template-consent-verified")).to_contain("Not verified yet")
	expect(app:tree("#template-consent-unverified")).to_contain("Zeron hasn't verified 1.3.0 yet.")
	expect(box(app:tree("#template-consent-unverified")).y < box(app:tree("role:alert")).y).to_be(true)
end)

test("what the store says of it changed as it showed: said, and Allow armed again", function()
	local app = open()
	app:command("store")
	app:frames(20)
	armed(app)
	app:command("store_said")
	app:frames(20)
	expect(app:tree("#template-consent-changed")).to_contain("Zeron's mark was taken off it just now. Look again.")
	expect(app:tree("#template-consent-owner")).to_contain("it's now @grace's")
	expect(app:tree(".template-consent-verified")).to_contain("Not verified yet")
	expect(app:tree("#template-consent")).to_contain("@grace")
	app:click("#template-consent-allow")
	app:frames(4)
	expect(app:state("calls")).to_be("")
	armed(app)
	app:click("#template-consent-allow")
	app:frames(4)
	expect(app:state("calls")).to_contain("true:store-hash-1")
	app:command("store_verified")
	app:frames(20)
	expect(app:tree("#template-consent-changed")).to_contain("Zeron verified it just now. Look again.")
	expect(app:has("#template-consent-owner")).to_be(false)
end)

test("an Allow the store refuses says why, the sheet staying to try again", function()
	for show, said in
		{
			refused_taken_down = "Zeron took this version down, so it can't be installed.",
			refused_gone = "This version isn't in the template store anymore.",
			refused_offline = "Zeron couldn't check this with the store. Try again.",
		}
	do
		local app = open()
		app:command(show)
		app:frames(20)
		expect(app:tree("#template-consent")).to_contain(said)
		expect(app:tree("#template-consent")).to_contain("Install Midnight?")
		expect(app:has("#template-consent-allow")).to_be(true)
	end
end)

test("a package's own words stand apart from what Zeron says of it", function()
	local app = open()
	expect(app:tree("#template-consent-own-words")).to_contain("In its own words")
	expect(app:tree("#template-consent-own-words")).to_contain("Dense rows, ledger lines.")
	expect(app:tree("#template-consent-facts")).never.to_contain("Dense rows")
	app:command("mystery")
	app:frames(20)
	expect(app:has("#template-consent-own-words")).to_be(false)
end)

test("one from a file or a link says it isn't from the store", function()
	local app = open()
	expect(app:tree("#template-consent")).to_contain("From a file, not from the store")
	app:command("link")
	app:frames(20)
	expect(app:tree("#template-consent")).to_contain("From a link, not from the store")
	expect(app:tree("#template-consent")).never.to_contain("Runs as Zeron itself")
	app:command("sleek")
	app:frames(20)
	expect(app:tree("#template-consent")).never.to_contain("not from the store")
end)

test("whatever it has to say, Install and Not now stay on the sheet, in both languages", function()
	for _, where in { "en", "zh-Hans" } do
		local app = open()
		app:command(`locale_{where}`)
		for _, show in { "store", "token", "link", "ledger" } do
			app:command(show)
			app:frames(20)
			local y, h = app:tree("#template-consent-allow"):match(",(%-?%d+) %d+x(%d+)")
			expect((tonumber(y) :: number) + (tonumber(h) :: number) <= 540).to_be(true)
			-- All of it can be read: it scrolls to its end, over the answer.
			app:scroll("#template-consent-scroll", 5000)
			app:frames(10)
			local sy, sh = app:tree("#template-consent-said"):match(",(%-?%d+) %d+x(%d+)")
			expect((tonumber(sy) :: number) + (tonumber(sh) :: number) <= (tonumber(y) :: number)).to_be(true)
		end
	end
end)
