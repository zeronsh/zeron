-- One running tool of a reply stopped alone (a hung command): its row's
-- stop asks the chat's host for that call only, the row says it's stopping
-- until its result comes and stopped after, and a refusal says why and
-- leaves the row as it was.

test("A running tool's stop asks for that call alone and says stopped once it returns", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("tool_running")
	app:frames(30)
	expect(app:has('role:button "Stop Ran npm run serve"')).to_be(true)
	-- (The read that finished has none.)
	expect(app:has('role:button "Stop Read server.ts"')).to_be(false)
	app:click('role:button "Stop Ran npm run serve"')
	app:frames(10)
	expect(app:state("calls")).to_contain("stop_call:s2:h-cmd")
	expect(app:has('~"Stopping"')).to_be(true)
	expect(app:has('role:button "Stop Ran npm run serve"')).to_be(false)
	app:command("tool_result")
	app:frames(10)
	expect(app:has('~"Stopped"')).to_be(true)
	expect(app:error()).to_be(nil)
end)

test("A stop the agent can't do says so and leaves the row's stop", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("tool_running")
	app:frames(30)
	app:command("stop_unsupported")
	app:click('role:button "Stop Ran npm run serve"')
	app:frames(10)
	expect(app:state("calls")).to_contain("stop_call:s2:h-cmd")
	expect(app:has('~"This agent can\'t stop that on its own"')).to_be(true)
	expect(app:has('role:button "Stop Ran npm run serve"')).to_be(true)
	expect(app:error()).to_be(nil)
end)
