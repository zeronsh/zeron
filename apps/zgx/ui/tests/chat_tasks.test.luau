-- A chat's background processes, as Zeron's tray has them
-- (background_tray.rs): Stop asks the chat's host to stop one, and says so
-- if it couldn't.

test("Stop on a background process asks its host, and says when it couldn't", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("task_running")
	app:frames(30)
	-- The tray stays folded to its header until opened.
	expect(app:has('role:button "Open Running"')).to_be(true)
	expect(app:has('role:tab "Fold Running"')).to_be(false)
	app:click('role:button "Open Running"')
	app:frames(30)
	app:click('role:button "Stop npm run dev"')
	app:frames(10)
	expect(app:state("calls")).to_contain("stop_task:s2:bg1")
	expect(app:has('~"Couldn\'t stop that process"')).to_be(false)
	app:command("stop_fails")
	app:click('role:button "Stop npm run dev"')
	app:frames(10)
	-- Said as an alert of the composer's deck, a tab beside Running.
	expect(app:has('role:tab "Open Alerts"')).to_be(true)
	app:click('role:tab "Open Alerts"')
	app:frames(30)
	expect(app:has('~"Couldn\'t stop that process"')).to_be(true)
	expect(app:error()).to_be(nil)
end)

test("a background process outlives the turn: its tray stays as the turn ends", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("start_reply")
	app:command("task_running")
	app:frames(30)
	expect(app:has('role:button "Open Running"')).to_be(true)
	app:command("end_reply")
	-- Through the turn's end, every frame: the tray is there.
	for _ = 1, 30 do
		app:frames(1)
		expect(app:has('role:button "Open Running"')).to_be(true)
	end
	-- And still stoppable.
	app:click('role:button "Open Running"')
	app:frames(30)
	app:click('role:button "Stop npm run dev"')
	app:frames(10)
	expect(app:state("calls")).to_contain("stop_task:s2:bg1")
	expect(app:error()).to_be(nil)
end)

test("a chat's subagents run in the Running tray, and a row opens its subagent", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	-- None yet: no pill.
	expect(app:has('role:button "Open Subagents"')).to_be(false)
	app:command("subagents_running")
	app:command("task_running")
	app:frames(30)
	-- Two agents and a process run: each its own, in the pill.
	expect(app:has('role:button "Open Subagents"')).to_be(true)
	expect(app:has('role:button "Open Running"')).to_be(true)
	app:click('role:button "Open Subagents"')
	app:frames(30)
	-- A row opens its subagent in the session's panel; an agent has no Stop,
	-- and the process is the other tab's.
	expect(app:has('role:button "Stop scan the repo"')).to_be(false)
	expect(app:has('role:button "Stop npm run dev"')).to_be(false)
	app:click('role:button "Open read the docs"')
	app:frames(5)
	expect(app:state("calls")).to_contain("open_subagent:s2:d2")
	-- The one that finished is folded apart, and opens from there.
	expect(app:has('role:button "Open find the flaky test"')).to_be(false)
	app:click('role:button "Show 1 finished"')
	app:frames(30)
	app:click('role:button "Open find the flaky test"')
	app:frames(5)
	expect(app:state("calls")).to_contain("open_subagent:s2:d3")
	expect(app:error()).to_be(nil)
end)

test("child chats a Zeron chat started run in the Subagents tray, as subagents do; the person's own side chats don't", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	expect(app:has('role:button "Open Subagents"')).to_be(false)
	app:command("child_chats")
	app:frames(30)
	-- The pill, as for subagents.
	expect(app:has('role:button "Open Subagents"')).to_be(true)
	app:click('role:button "Open Subagents"')
	app:frames(30)
	-- The working one is a row of its own, with Stop: it's a chat, which its
	-- host stops wherever it runs (a subagent of the agent's own has none).
	expect(app:has('role:button "Open audit the parser"')).to_be(true)
	expect(app:has('role:button "Stop audit the parser"')).to_be(true)
	expect(app:has('role:button "Stop draft the release notes"')).to_be(false)
	-- The one at rest is folded with the finished.
	expect(app:has('role:button "Open draft the release notes"')).to_be(false)
	app:click('role:button "Show 1 finished"')
	app:frames(30)
	expect(app:has('role:button "Open draft the release notes"')).to_be(true)
	-- The person's own side chat isn't here.
	expect(app:has('~"my own side chat"')).to_be(false)
	-- A row opens its chat in the panel, as a side chat's tab.
	app:click('role:button "Open audit the parser"')
	app:frames(5)
	expect(app:state("calls")).to_contain("open_lane:s2:side_chat:k1")
	app:click('role:button "Open draft the release notes"')
	app:frames(5)
	expect(app:state("calls")).to_contain("open_lane:s2:side_chat:k2")
	expect(app:state("calls")).never.to_contain(":k3")
	expect(app:error()).to_be(nil)
end)

test("child chats a Zeron chat started share the tray with the agent's own subagents", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("subagents_running")
	app:command("child_chats")
	app:frames(30)
	app:click('role:button "Open Subagents"')
	app:frames(30)
	for _, title in { "scan the repo", "read the docs", "audit the parser" } do
		expect(app:has(`role:button "Open {title}"`)).to_be(true)
	end
	-- Both finished fold together.
	expect(app:has('role:button "Show 2 finished"')).to_be(true)
	expect(app:has('~"my own side chat"')).to_be(false)
end)

test("delegated children say what they run on, where, and what they ask; Stop ends one", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("delegated")
	app:frames(30)
	app:click('role:button "Open Subagents"')
	app:frames(30)
	local tree = app:tree()
	expect(tree).to_contain("Codex · ")
	expect(tree).to_contain("Cursor")
	app:click('role:button "Stop Draft the release notes"')
	app:frames(5)
	expect(app:state("calls")).to_contain("stop:k2")
	expect(app:state("calls")).never.to_contain("stop_task:")
	expect(app:error()).to_be(nil)
end)

test("what a child asks is on its row of the Subagents tray, and answered there", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("delegated")
	app:frames(30)
	-- Nothing opens itself, and it's no alert.
	expect(app:state("chat_tray")).to_be(nil)
	expect(app:tree()).never.to_contain("Alerts")
	app:click('role:button "Open Subagents"')
	app:frames(40)
	expect(app:tree()).to_contain("cargo fuzz run parse -- -max_total_time=60")
	app:click('role:button "Deny"')
	app:frames(5)
	expect(app:state("calls")).to_contain("respond_child:k1:r1:deny")
	-- Answered once: the rest are out of reach while its chat hears of it...
	app:click('role:button "Allow once"')
	app:frames(5)
	expect(app:state("calls")).never.to_contain("respond_child:k1:r1:once")
	-- ...and back if it never does.
	app:frames(270)
	app:click('role:button "Allow once"')
	app:frames(5)
	expect(app:state("calls")).to_contain("respond_child:k1:r1:once")
	-- Another ask in its place: a question, answered by one of its options,
	-- or in its chat.
	app:command("delegated_question")
	app:frames(40)
	expect(app:tree()).to_contain("Which branch should I audit?")
	expect(app:has('role:button "Allow once"')).to_be(false)
	app:click('role:button "Something else"')
	app:frames(5)
	expect(app:state("calls")).to_contain("open_lane:s2:side_chat:k1")
	app:click('role:button "release/1.9"')
	app:frames(5)
	expect(app:state("calls")).to_contain("respond_child:k1:r2:release/1.9")
	expect(app:error()).to_be(nil)
end)

test("what needs the person is first in the Subagents tray", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 900)
	app:command("go_s2")
	app:frames(30)
	app:command("delegated_many")
	app:frames(30)
	app:click('role:button "Open Subagents"')
	app:frames(40)
	local tree = app:tree()
	local asks = string.find(tree, 'button "Quarantine it"', 1, true)
	local works = string.find(tree, 'Stop Draft the release notes', 1, true)
	expect(asks ~= nil and works ~= nil and (asks :: number) < (works :: number)).to_be(true)
	expect(app:error()).to_be(nil)
end)

test("a wake is a row to each child's chat with a line of what it said, never the person's bubble", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("delegated")
	app:command("delegated_woke")
	app:frames(60)
	expect(app:tree()).to_contain("3 subagents reported back · 1 still running")
	expect(app:has('role:button "Open Audit the parser"')).to_be(true)
	expect(app:has('role:button "Open Draft the release notes"')).to_be(true)
	expect(app:tree()).to_contain("Time the benchmark")
	expect(app:tree()).to_contain('"Stopped"')
	expect(app:tree()).to_contain("No unsafe paths left")
	-- Its line folds it, and opens it again.
	app:click('role:button "3 subagents reported back · 1 still running"')
	app:frames(40)
	expect(app:tree()).never.to_contain("No unsafe paths left")
	app:click('role:button "3 subagents reported back · 1 still running"')
	app:frames(40)
	expect(app:tree()).to_contain("No unsafe paths left")
	expect(app:tree()).never.to_contain("Zeron delegated")
	app:click('role:button "Open Audit the parser"')
	app:frames(5)
	expect(app:error()).to_be(nil)
end)

test("work handed to subagents is a row each: connecting as it's handed over, then as its chat stands, open on a click", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("delegating")
	app:frames(30)
	expect(app:tree()).to_contain("Delegating to 2 subagents")
	-- Nothing to open yet.
	expect(app:has('#transcript >> role:button "Open Audit the parser"')).to_be(false)
	app:command("delegated")
	app:command("delegating_done")
	app:frames(60)
	expect(app:tree()).to_contain("Delegated to 2 subagents · 1 needs you")
	expect(app:tree()).to_contain("Needs approval")
	expect(app:tree()).never.to_contain("create_chats")
	local tree = app:tree("#transcript")
	expect(tree).to_contain("Draft the release notes")
	app:click('#transcript >> role:button "Open Audit the parser"')
	app:frames(10)
	expect(app:state("calls")).to_contain("k1")
	expect(app:error()).to_be(nil)
end)
