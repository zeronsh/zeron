-- New project, as Zeron adds one: every way in opens the same palette
-- (⌘⇧N, the palette's "New project", the project filter's, the
-- composer's); its pages walk a device's places and folders through the
-- engine; "Add this folder" makes the project on that device and lands in a
-- new chat in it; a folder that's a project already just opens it; a git
-- address typed in a folder clones it there first. On the shell in
-- ui/shell_fixture.luau, whose host answers as the engine would.

local function open(): any
	local app = mount("shell_fixture.luau")
	app:resize(1200, 800)
	app:frames(30)
	return app
end

local LIST = "#palette-list"

local function shown(app: any): boolean
	return app:state("shell_add_project_open") == true
end

-- Its row `label` chosen, and the page it opens settled.
local function choose(app: any, label: string)
	expect(app:wait(`{LIST} >> role:option "{label}"`, { timeout_ms = 2000 })).to_be(true)
	app:click(`{LIST} >> role:option "{label}"`)
	app:frames(20)
end

local function calls(app: any): string
	return app:state("calls") or ""
end

test("⌘⇧N opens New project and closes it again, but not over settings", function()
	local app = open()
	app:command("shell.new_project")
	app:frames(20)
	expect(shown(app)).to_be(true)
	expect(app:has(`{LIST} >> role:option "MacBook Pro"`)).to_be(true)
	expect(app:has(`{LIST} >> role:option "devbox"`)).to_be(true)
	app:command("shell.new_project")
	app:frames(20)
	expect(shown(app)).to_be(false)
	app:command("shell.settings")
	app:frames(20)
	app:command("shell.new_project")
	app:frames(20)
	expect(shown(app)).to_be(false)
end)

test("the palette's New project slides to its steps in the palette, and back comes back", function()
	local app = open()
	app:command("shell.palette")
	app:frames(20)
	app:type('role:textbox "Search"', "New project")
	app:frames(30)
	app:click(`{LIST} >> role:option "New project"`)
	-- A page of the palette's own, as "New chat in…": the same palette open.
	expect(app:wait(`{LIST} >> role:option "MacBook Pro"`, { timeout_ms = 2000 })).to_be(true)
	expect(app:state("shell_palette_open")).to_be(true)
	expect(shown(app)).to_be(false)
	-- Its steps go on in it: a device's places.
	choose(app, "MacBook Pro")
	expect(calls(app)).to_contain("drives:mac")
	-- Back, and back again: the device list, then the palette's own.
	app:key("Escape")
	app:frames(20)
	expect(app:wait(`{LIST} >> role:option "MacBook Pro"`, { timeout_ms = 2000 })).to_be(true)
	app:key("Escape")
	app:frames(20)
	expect(app:has(`{LIST} >> role:option "MacBook Pro"`)).to_be(false)
	expect(app:state("shell_palette_open")).to_be(true)
end)

test("this Mac comes first, then its places, then its folders, hidden ones left out", function()
	local app = open()
	app:command("shell.new_project")
	app:frames(20)
	local tree = app:tree(LIST)
	expect(tree:find("MacBook Pro", 1, true) < tree:find("devbox", 1, true)).to_be(true)
	choose(app, "MacBook Pro")
	expect(calls(app)).to_contain("drives:mac")
	expect(app:wait(`{LIST} >> role:option "Home"`, { timeout_ms = 2000 })).to_be(true)
	expect(app:has(`{LIST} >> role:option "Work"`)).to_be(true)
	choose(app, "Home")
	expect(calls(app)).to_contain("folders:mac:~")
	expect(app:wait(`{LIST} >> role:option ~"Add this folder"`, { timeout_ms = 2000 })).to_be(true)
	expect(app:has(`{LIST} >> role:option "code"`)).to_be(true)
	expect(app:has(`{LIST} >> role:option "notes"`)).to_be(true)
	expect(app:has(`{LIST} >> role:option ".cache"`)).to_be(false)
	expect(app:has(`{LIST} >> role:option "todo.txt"`)).to_be(false)
	-- One inside another, each its own page.
	choose(app, "code")
	expect(calls(app)).to_contain("folders:mac:/Users/me/code")
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
end)

test("Add this folder makes the project on that device and lands in a new chat in it", function()
	local app = open()
	app:command("shell.new_project")
	app:frames(20)
	choose(app, "devbox")
	choose(app, "Home")
	choose(app, "notes")
	choose(app, "Add this folder")
	app:frames(30)
	expect(calls(app)).to_contain("create:box:/home/me/notes:")
	expect(shown(app)).to_be(false)
	expect(app:wait(`#shell-sidebar >> ~"notes"`, { timeout_ms = 2000 })).to_be(true)
	app:frames(20)
	expect(app:state("shell_project")).to_be("new1")
end)

test("a folder that's a project already just opens it", function()
	local app = open()
	app:command("shell.new_project")
	app:frames(20)
	choose(app, "MacBook Pro")
	choose(app, "Work")
	expect(calls(app)).to_contain("folders:mac:/work")
	choose(app, "atlas")
	choose(app, "Add this folder")
	app:frames(30)
	expect(calls(app)).never.to_contain("create:")
	expect(shown(app)).to_be(false)
	expect(app:state("shell_project")).to_be("atlas")
end)

test("a git address typed in a folder is cloned there, then added", function()
	local app = open()
	app:command("shell.new_project")
	app:frames(20)
	choose(app, "MacBook Pro")
	choose(app, "Home")
	app:type('role:textbox "Search"', "https://github.com/acme/rocket.git")
	app:frames(40)
	choose(app, "Clone acme/rocket here")
	app:frames(30)
	expect(calls(app)).to_contain("clone:mac:https://github.com/acme/rocket.git:/Users/me")
	expect(app:wait(`#shell-sidebar >> ~"rocket"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("create:mac:/Users/me/rocket:true")
end)

test("the project filter's New project opens it", function()
	local app = open()
	app:set_state("screens/shell/sidebar.luau::shell_sidebar_show_project_filter", true)
	app:frames(20)
	app:click("#sidebar-project-filter >> role:button")
	app:frames(30)
	expect(app:wait('~"New project"', { timeout_ms = 2000 })).to_be(true)
	app:click('role:button "New project"')
	expect(app:wait(`{LIST} >> role:option "MacBook Pro"`, { timeout_ms = 2000 })).to_be(true)
	expect(shown(app)).to_be(true)
end)

test("Home finds its folders anywhere under it, asking again while it indexes, and lets the index go", function()
	local app = open()
	app:command("shell.new_project")
	app:frames(20)
	choose(app, "MacBook Pro")
	choose(app, "Home")
	app:type('role:textbox "Search"', "zep")
	-- Still indexing at the first answer: asked again, and found then.
	expect(app:wait(`{LIST} >> role:option ~"zephyr"`, { timeout_ms = 3000 })).to_be(true)
	expect(app:tree(LIST)).to_contain("~/code")
	local _, asks = string.gsub(calls(app), "search_home:mac:zep", "")
	expect(asks).to_be(2)
	-- (Entering Home started its index, nothing typed.)
	expect(calls(app)).to_contain("search_home:mac:,")
	-- (One Home lists already isn't found again.)
	local _, codes = string.gsub(app:tree(LIST), 'option "code', "")
	expect(codes <= 1).to_be(true)
	-- Closed: its index let go.
	app:command("shell.new_project")
	app:frames(30)
	expect(shown(app)).to_be(false)
	expect(calls(app)).to_contain("release_home:mac")
end)

test("a drive's folders aren't Home's: nothing searched there", function()
	local app = open()
	app:command("shell.new_project")
	app:frames(20)
	choose(app, "MacBook Pro")
	choose(app, "Work")
	app:type('role:textbox "Search"', "zep")
	app:frames(60)
	expect(calls(app)).never.to_contain("search_home")
end)

-- New project open on `device`'s Home.
local function at_home(app: any, device: string)
	app:command("shell.new_project")
	app:frames(20)
	choose(app, device)
	choose(app, "Home")
	expect(app:wait(`{LIST} >> role:option ~"Add this folder"`, { timeout_ms = 2000 })).to_be(true)
end

test("⌘L types the folder's path to edit, from home as ~", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:key("cmd+l")
	app:frames(10)
	expect(app:text('role:textbox "Search"')).to_be("~/")
	-- (Escape takes it back out.)
	app:key("Escape")
	app:frames(10)
	choose(app, "code")
	app:key("cmd+l")
	app:frames(10)
	expect(app:text('role:textbox "Search"')).to_be("~/code/")
end)

test("a path typed opens that folder, ~ its device's home, wherever the folder is", function()
	local app = open()
	at_home(app, "devbox")
	app:type('role:textbox "Search"', "~/notes")
	choose(app, "~/notes")
	expect(calls(app)).to_contain("folders:box:/home/me/notes")
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
	-- An absolute one, anywhere.
	app:type('role:textbox "Search"', "/work")
	choose(app, "/work")
	expect(calls(app)).to_contain("folders:box:/work")
end)

test("a path typed before home is known asks the device for it first", function()
	local app = open()
	app:command("shell.new_project")
	app:frames(20)
	choose(app, "MacBook Pro")
	choose(app, "Work")
	app:type('role:textbox "Search"', "~/code")
	choose(app, "~/code")
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
	local c = calls(app)
	expect(c).to_contain("folders:mac:~,folders:mac:/Users/me/code")
end)

test("⌘↵ on a path typed adds that folder", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:type('role:textbox "Search"', "~/code/zephyr")
	expect(app:wait(`{LIST} >> role:option "~/code/zephyr"`, { timeout_ms = 2000 })).to_be(true)
	app:key("cmd+Enter")
	expect(app:wait(`#shell-sidebar >> ~"zephyr"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("create:mac:/Users/me/code/zephyr:false")
end)

test("a path that isn't there says so", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:type('role:textbox "Search"', "/gone")
	choose(app, "/gone")
	expect(app:wait('~"NO FOLDER AT /GONE"', { timeout_ms = 2000 })).to_be(true)
end)

test("⌘L as the menu has it (the browser's Open Location) goes to an open palette", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:command("panel.focus_address")
	app:frames(10)
	expect(app:text('role:textbox "Search"')).to_be("~/")
end)

test("a folder's name/ goes into it, in any case or by a unique start, and back leaves nothing typed", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:type('role:textbox "Search"', "CO/")
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/Users/me/code")
	expect(app:text('role:textbox "Search"')).to_be("")
	app:key("Escape")
	app:frames(20)
	expect(app:wait(`{LIST} >> role:option "notes"`, { timeout_ms = 2000 })).to_be(true)
	expect(app:text('role:textbox "Search"')).to_be("")
	-- One it starts alone: that one.
	app:type('role:textbox "Search"', "n/")
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/Users/me/notes")
end)

test("a name that's no folder's stays typed", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:type('role:textbox "Search"', "xyz/")
	app:frames(30)
	expect(app:text('role:textbox "Search"')).to_be("xyz/")
end)

test("a path ending in its separator goes there at once", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:type('role:textbox "Search"', "/work/")
	expect(app:wait(`{LIST} >> role:option "atlas"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/work")
end)

test("Tab completes a folder's name and goes in, a path's too", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:type('role:textbox "Search"', "co")
	app:key("Tab")
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/Users/me/code")
	-- From ⌘L's path.
	app:key("Escape")
	app:frames(20)
	app:key("cmd+l")
	app:frames(10)
	app:type('role:textbox "Search"', "no")
	expect(app:text('role:textbox "Search"')).to_be("~/no")
	app:key("Tab")
	app:frames(10)
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/Users/me/notes")
end)

test("with no project yet, a new chat asks for one in the composer’s place until one is added", function()
	local app = open()
	expect(app:has('role:textbox "Message"')).to_be(true)
	app:command("no_projects")
	app:frames(30)
	expect(app:wait('~"Add a project to get started"', { timeout_ms = 2000 })).to_be(true)
	expect(app:has('role:textbox "Message"')).to_be(false)
	app:click('role:button "Add a project"')
	expect(app:wait(`{LIST} >> role:option "MacBook Pro"`, { timeout_ms = 2000 })).to_be(true)
	-- Its first project added: the composer, in it.
	choose(app, "MacBook Pro")
	choose(app, "Home")
	choose(app, "code")
	choose(app, "Add this folder")
	expect(app:wait('role:textbox "Message"', { timeout_ms = 2000 })).to_be(true)
	expect(app:has('~"Add a project to get started"')).to_be(false)
end)

test("any absolute path on the device is offered, outside Home too, from its places or a folder", function()
	local app = open()
	at_home(app, "MacBook Pro")
	local far = "/private/var/folders/xy/T/zgx-smoke.1/project"
	app:type('role:textbox "Search"', far)
	choose(app, far)
	expect(calls(app)).to_contain(`folders:mac:{far}`)
	-- From the device's places too.
	local app2 = open()
	app2:command("shell.new_project")
	app2:frames(20)
	choose(app2, "MacBook Pro")
	expect(app2:wait(`{LIST} >> role:option "Home"`, { timeout_ms = 2000 })).to_be(true)
	app2:type('role:textbox "Search"', far)
	choose(app2, far)
	expect(calls(app2)).to_contain(`folders:mac:{far}`)
end)

test("a path typed key by key: the root alone waits, then each folder goes in, a link to one too", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:type('role:textbox "Search"', "/")
	app:frames(30)
	expect(app:text('role:textbox "Search"')).to_be("/")
	for _, c in { "v", "a", "r", "/" } do
		app:type('role:textbox "Search"', c)
		app:frames(4)
	end
	expect(app:wait(`{LIST} >> role:option "folders"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/var")
	expect(app:text('role:textbox "Search"')).to_be("")
	-- (`run` lists as no folder, as a link to one does: it still goes in.)
	app:type('role:textbox "Search"', "run/")
	expect(app:wait(`{LIST} >> role:option ~"Add this folder"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/var/run")
end)
