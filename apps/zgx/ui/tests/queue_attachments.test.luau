-- A queued message's files in the composer (ui/chat_fixture.luau, the host
-- stubbed): editing it shows them as chips, saving names them again (by
-- their paths on the host, not sent up a second time), one taken off goes,
-- and the draft's own chips come back as the edit ends. A queued message
-- that doesn't go when it's steered says so.

local function settle(app: any)
	app:frames(30)
end

local function open(app: any, id: string)
	app:command(`go_{id}`)
	settle(app)
end

local FILES = "files=/host/uploads/9e97a72f-shot.png@host,/host/uploads/ea958e1e-note.txt@host"

local function editing(app: any): any
	app:command("queue_with_files")
	settle(app)
	-- (The queue waits in the pill, folded, until opened.)
	app:click('role:button "Open Queued"')
	settle(app)
	app:hover('role:listitem "1. Queued with files"')
	settle(app)
	app:click('role:button "Edit"')
	settle(app)
	return app
end

test("a queued message's files show as chips while it's edited, and saving keeps them", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	open(app, "s1")
	editing(app)
	expect(app:state("calls")).to_contain("queue_edit:s1:q2")
	expect(app:text('role:textbox "Message"')).to_be("Queued with files")
	expect(app:has('role:button "Remove shot.png"')).to_be(true)
	expect(app:has('role:button "Remove note.txt"')).to_be(true)
	app:type('role:textbox "Message"', " too")
	app:click('role:button "Save to queue"')
	settle(app)
	expect(app:state("calls")).to_contain(`queue_finish:s1:q2:commit:Queued with files too:{FILES}`)
	expect(app:has('role:button "Remove shot.png"')).to_be(false)
end)

test("a file taken off while editing goes, and the draft's own chips come back", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	open(app, "s1")
	app:command("drop_pictures")
	settle(app)
	expect(app:has('role:button "Remove zgx.png"')).to_be(true)
	editing(app)
	-- (The draft's chip set aside meanwhile.)
	expect(app:has('role:button "Remove zgx.png"')).to_be(false)
	app:hover('#chat-composer >> ~"note.txt"')
	app:frames(10)
	app:click('role:button "Remove note.txt"')
	settle(app)
	app:click('role:button "Save to queue"')
	settle(app)
	expect(app:state("calls")).to_contain("queue_finish:s1:q2:commit:Queued with files:files=/host/uploads/9e97a72f-shot.png@host")
	expect(app:state("calls")).never.to_contain("ea958e1e-note.txt@host")
	expect(app:has('role:button "Remove zgx.png"')).to_be(true)
	expect(app:has('role:button "Remove shot.png"')).to_be(false)
end)

test("a file added while editing goes with the message, sent up as new", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	open(app, "s1")
	editing(app)
	app:command("drop_pictures")
	settle(app)
	expect(app:has('role:button "Remove zgx.png"')).to_be(true)
	app:click('role:button "Save to queue"')
	settle(app)
	-- (The new ones by their own paths, not marked as on the host yet.)
	expect(app:state("calls")).to_contain(FILES)
	expect(app:state("calls")).to_contain("assets/favicons/zgx.png")
	expect(app:state("calls")).never.to_contain("assets/favicons/zgx.png@host")
	expect(app:has('role:button "Remove zgx.png"')).to_be(false)
end)

test("a cancelled edit leaves its files as they were and the draft's chips back", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	open(app, "s1")
	app:command("drop_pictures")
	settle(app)
	editing(app)
	app:click('role:button "Cancel"')
	settle(app)
	expect(app:state("calls")).to_contain("queue_finish:s1:q2:cancel:")
	expect(app:state("calls")).never.to_contain("queue_finish:s1:q2:cancel::files")
	expect(app:has('role:button "Remove zgx.png"')).to_be(true)
	expect(app:has('role:button "Remove shot.png"')).to_be(false)
end)

test("a queued message that doesn't go when steered says so", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	open(app, "s1")
	app:command("start_reply")
	app:command("queue_one")
	settle(app)
	app:command("steer_fails")
	app:click('role:button "Open Queued"')
	settle(app)
	app:hover('role:listitem "1. Queued words"')
	settle(app)
	app:click('role:button "Steer"')
	settle(app)
	expect(app:state("calls")).to_contain("queue:s1:send:q1")
	-- Said as an alert of the composer's deck, a tab beside the queue, and
	-- the message still waits there.
	expect(app:has('role:tab "Open Alerts"')).to_be(true)
	app:click('role:tab "Open Alerts"')
	settle(app)
	expect(app:has('~"Your message didn\'t send"')).to_be(true)
	expect(app:has('role:tab "Open Queued"')).to_be(true)
	expect(app:error()).to_be(nil)
end)
