-- Projects of repositories from anywhere on a device, and the device's
-- repositories: New project's "Repositories…" (chosen from the device's
-- list, a new one made or a path typed on the way), Edit project's
-- Repositories (one taken out, others added, saved with the project; a
-- project that is one repository combined with others), and Settings →
-- Repositories. On the shell in ui/shell_fixture.luau, whose host answers
-- as the engine would.

local LIST = "#palette-list"
local COMPOSE = `role:dialog "New project"`
local EDIT = `role:dialog "Edit project"`

local function mounted(): any
	local app = mount("shell_fixture.luau")
	app:resize(1200, 900)
	app:frames(30)
	return app
end

local function said(app: any): string
	return (app:state("calls") :: any) or ""
end

-- New project → this Mac → Repositories…
local function compose(app: any)
	app:command("shell.new_project")
	app:frames(20)
	app:click(`{LIST} >> role:option "MacBook Pro"`)
	expect(app:wait(`{LIST} >> role:option "Repositories…"`, { timeout_ms = 2000 })).to_be(true)
	-- (The list grows to its rows as they come.)
	app:frames(30)
	app:click(`{LIST} >> role:option "Repositories…"`)
	expect(app:wait(`{COMPOSE} >> role:checkbox "api"`, { timeout_ms = 2000 })).to_be(true)
	app:frames(10)
end

local function edit(app: any, project: string)
	app:right_click(`#sidebar >> "{project}"`)
	app:frames(20)
	app:click(`role:menuitem "Edit project…"`)
	app:frames(30)
	app:click(`{EDIT} >> role:tab "Repositories"`)
	app:frames(30)
end

test("New project offers a project of repositories, a new repository and a clone on a device", function()
	local app = mounted()
	app:command("shell.new_project")
	app:frames(20)
	app:click(`{LIST} >> role:option "MacBook Pro"`)
	expect(app:wait(`{LIST} >> role:option "Repositories…"`, { timeout_ms = 2000 })).to_be(true)
	expect(app:wait(`{LIST} >> role:option "New repository…"`, { timeout_ms = 1000 })).to_be(true)
	expect(app:wait(`{LIST} >> role:option "Clone repository…"`, { timeout_ms = 1000 })).to_be(true)
	-- (After its places: Home first.)
	local tree = app:tree(LIST)
	expect(tree:find("Home", 1, true) < tree:find("Repositories…", 1, true)).to_be(true)
end)

test("repositories chosen from anywhere become one project, named after their owner, and a chat opens in it", function()
	local app = mounted()
	compose(app)
	expect(said(app)).to_contain("local_repositories:mac")
	-- Newest worked-in first, each where it is (home as ~).
	local tree = app:tree(COMPOSE)
	expect(tree:find("api", 1, true) < tree:find("web-app", 1, true)).to_be(true)
	expect(tree).to_contain("~/work/web-app")
	-- Nothing chosen: nothing to create.
	expect(app:tree(`{COMPOSE} >> role:button "Create project"`)).to_contain("disabled")
	app:click(`{COMPOSE} >> role:checkbox "api"`)
	app:click(`{COMPOSE} >> role:checkbox "web-app"`)
	app:frames(10)
	expect(app:text("#compose-picker-count")).to_be("2 chosen")
	-- Both acme's: the name it gets unless another is typed.
	expect(app:tree(COMPOSE)).to_contain("~/.zeron/projects/acme")
	app:click(`{COMPOSE} >> role:button "Create project with 2 repositories"`)
	app:frames(40)
	expect(said(app)).to_contain("compose:mac:acme:api,web-app")
	expect(said(app)).to_contain("create:mac:/Users/me/.zeron/projects/acme:false:acme")
	expect(app:wait(`#shell-sidebar >> ~"acme"`, { timeout_ms = 2000 })).to_be(true)
	expect(app:state("shell_compose_open")).to_be(false)
end)

test("the search finds by name, path or GitHub repository, and Enter on one match chooses it", function()
	local app = mounted()
	compose(app)
	app:type(`{COMPOSE} >> role:textbox "Search repositories"`, "design")
	app:frames(10)
	expect(app:has(`{COMPOSE} >> role:checkbox "design-system"`)).to_be(true)
	expect(app:has(`{COMPOSE} >> role:checkbox "api"`)).to_be(false)
	app:key("Enter")
	app:frames(10)
	expect(app:text("#compose-picker-count")).to_be("1 chosen")
	app:fill(`{COMPOSE} >> role:textbox "Search repositories"`, "me/dotfiles")
	app:frames(10)
	expect(app:has(`{COMPOSE} >> role:checkbox "dotfiles"`)).to_be(true)
	app:fill(`{COMPOSE} >> role:textbox "Search repositories"`, "nothing-like-it")
	app:frames(10)
	expect(app:tree(COMPOSE)).to_contain("Nothing matches")
end)

test("a path typed uses the repository there, and one that isn't is refused in place", function()
	local app = mounted()
	compose(app)
	app:fill(`{COMPOSE} >> role:textbox "Search repositories"`, "/opt/plain")
	app:frames(10)
	app:click(`{COMPOSE} >> role:button "Use this repository"`)
	app:frames(20)
	expect(app:tree(COMPOSE)).to_contain("Not a git repository: /opt/plain")
	app:fill(`{COMPOSE} >> role:textbox "Search repositories"`, "/opt/vendor-repo")
	app:frames(10)
	app:click(`{COMPOSE} >> role:button "Use this repository"`)
	app:frames(30)
	expect(said(app)).to_contain("add_repository:mac:/opt/vendor-repo")
	expect(app:text("#compose-picker-count")).to_be("1 chosen")
end)

test("a new repository made on the way is chosen for the project", function()
	local app = mounted()
	compose(app)
	app:click("#compose-picker-new")
	expect(app:wait(`role:dialog >> role:textbox "Name"`, { timeout_ms = 1000 })).to_be(true)
	expect(app:tree("role:dialog")).to_contain("Start with a README")
	-- This Mac's GitHub CLI is signed in: GitHub offered.
	expect(app:tree("role:dialog")).to_contain("Also create it on GitHub")
	app:fill(`role:dialog >> role:textbox "Name"`, "billing service")
	app:frames(5)
	expect(app:tree("role:dialog")).to_contain("~/code/billing-service")
	app:click(`role:dialog >> role:button "Create repository"`)
	app:frames(30)
	expect(said(app)).to_contain("new_repository:mac:billing-service:-:false:false")
	expect(app:text("#compose-picker-count")).to_be("1 chosen")
	expect(app:has(`{COMPOSE} >> role:checkbox "billing-service"`)).to_be(true)
end)

test("a repository's name that's taken is said under the name, the form kept", function()
	local app = mounted()
	compose(app)
	app:click("#compose-picker-new")
	app:frames(10)
	app:fill(`role:dialog >> role:textbox "Name"`, "taken")
	app:click(`role:dialog >> role:button "Create repository"`)
	app:frames(30)
	expect(app:tree("role:dialog")).to_contain("Already exists")
	expect(app:has(`role:dialog >> role:textbox "Name"`)).to_be(true)
end)

test("edit project: a project of repositories lists each, where it is, one gone from there", function()
	local app = mounted()
	app:command("fixture.composed_project")
	app:frames(10)
	edit(app, "Acme")
	expect(said(app)).to_contain("repositories:mac:/Users/me/.zeron/projects/Acme")
	expect(app:text("#project-repositories-count")).to_be("3 repositories")
	local tree = app:tree("#project-repositories")
	expect(tree).to_contain("~/code/api")
	expect(tree).to_contain("~/work/web-app")
	expect(tree).to_contain("Not found at ~/code/docs")
end)

test("edit project: one taken out and another added are saved with the project, links only", function()
	local app = mounted()
	app:command("fixture.composed_project")
	app:frames(10)
	edit(app, "Acme")
	app:click(`{EDIT} >> role:button "Take docs out of the project"`)
	app:frames(10)
	expect(app:text("#project-repositories-count")).to_be("2 repositories")
	app:click("#project-repositories-add")
	expect(app:wait(`{EDIT} >> role:checkbox "infra"`, { timeout_ms = 2000 })).to_be(true)
	-- (Those it holds aren't offered again.)
	expect(app:has(`{EDIT} >> role:checkbox "api"`)).to_be(false)
	app:click(`{EDIT} >> role:checkbox "infra"`)
	app:frames(5)
	app:click(`{EDIT} >> role:button "Add 1 repository"`)
	app:frames(20)
	expect(app:tree("#project-repositories")).to_contain("Added on save")
	-- Nothing asked of the host until Save.
	expect(said(app)).never.to_contain("set_repositories")
	app:click(`{EDIT} >> role:button "Save"`)
	app:frames(40)
	expect(said(app)).to_contain("set_repositories:mac:/Users/me/.zeron/projects/Acme:api,web,infra")
	expect(app:state("project_edit_open")).to_be(false)
end)

test("edit project: a project that is one repository leads to combining it with others", function()
	local app = mounted()
	edit(app, "Atlas")
	expect(app:wait(`{EDIT} >> ~"This project is one repository"`, { timeout_ms = 2000 })).to_be(true)
	app:click(`{EDIT} >> role:button "Combine with other repositories…"`)
	app:frames(40)
	expect(app:state("project_edit_open")).to_be(false)
	expect(app:wait(`{COMPOSE} >> role:checkbox "atlas"`, { timeout_ms = 2000 })).to_be(true)
	expect(app:text("#compose-picker-count")).to_be("1 chosen")
end)

test("settings: Repositories lists this computer's, and forgetting one leaves it on disk", function()
	local app = mounted()
	app:command("settings_stub.sign_in")
	app:command("shell.settings")
	app:frames(20)
	app:click(`#settings-nav >> role:tab "Repositories"`)
	expect(app:wait(`#settings-page >> ~"design-system"`, { timeout_ms = 2000 })).to_be(true)
	local tree = app:tree("#settings-page")
	expect(tree).to_contain("~/code/api · main · acme/api")
	expect(tree).to_contain("In Atlas")
	app:click(`#settings-page >> role:button "More for dotfiles"`)
	expect(app:wait('role:menu >> role:button "Forget"', { timeout_ms = 15000 })).to_be(true)
	app:wait('"nothing"', { timeout_ms = 400 })
	app:click('role:menu >> role:button "Forget"')
	app:frames(20)
	expect(said(app)).to_contain("forget_repository:mac:/Users/me/dotfiles")
	expect(app:has(`#settings-page >> ~"dotfiles"`)).to_be(false)
	-- The other computer's, chosen above the list.
	app:click(`#settings-repositories-device >> "devbox"`)
	expect(app:wait(`#settings-page >> ~"borealis"`, { timeout_ms = 2000 })).to_be(true)
end)
