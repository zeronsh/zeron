// A small VS Code colour theme, for the theme library's tests: comments,
// a trailing comma, workbench colours and token colours.
{
  "name": "Harbor Night",
  "type": "dark",
  "colors": {
    "editor.background": "#14181f",
    "editor.foreground": "#d8dee9",
    "sideBar.background": "#10141a",
    "focusBorder": "#7aa2f7",
    "button.background": "#7aa2f7",
    "errorForeground": "#f7768e",
    /* the tones */
    "editorWarning.foreground": "#e0af68",
    "terminal.ansiGreen": "#9ece6a",
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#5c6773", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#c792ea" } },
    { "scope": "string", "settings": { "foreground": "#c3e88d" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#f78c6c" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#ffcb6b" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#82aaff" } },
  ],
}
