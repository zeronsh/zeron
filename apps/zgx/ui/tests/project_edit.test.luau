-- Edit project (a project header's right click): its name and its icon,
-- the default, an emoji (picked, searched, toned) or a picture (chosen,
-- placed, uploaded), each shown wherever the project's tile is. On the
-- shell in ui/shell_fixture.luau, whose host answers as the engine and the
-- edge would.

local DIALOG = `role:dialog "Edit project"`

local function open(): any
	local app = mount("shell_fixture.luau")
	app:resize(1200, 900)
	app:frames(30)
	app:right_click(`#sidebar >> "Borealis"`)
	app:frames(20)
	app:click(`role:menuitem "Edit project…"`)
	app:frames(40)
	return app
end

local function said(app: any): string
	return (app:state("calls") :: any) or ""
end

local function save(app: any)
	app:click(`{DIALOG} >> role:button "Save"`)
	app:frames(30)
end

test("edit project: a project header's menu edits the project: Edit project…, then Remove…", function()
	local app = mount("shell_fixture.luau")
	app:resize(1200, 900)
	app:frames(30)
	app:right_click(`#sidebar >> "Borealis"`)
	app:frames(20)
	expect(app:has(`role:menuitem "Edit project…"`)).to_be(true)
	expect(app:has(`role:menuitem "Remove…"`)).to_be(true)
	expect(app:has(`role:menuitem "Rename…"`)).to_be(false)
	app:click(`role:menuitem "Edit project…"`)
	app:frames(40)
	expect(app:has(DIALOG)).to_be(true)
	expect(app:text(`{DIALOG} >> role:textbox`)).to_be("Borealis")
	expect(app:has("#project-edit-preview")).to_be(true)
end)

test("edit project: renaming alone renames, trimmed, and sets no icon", function()
	local app = open()
	app:fill(`{DIALOG} >> role:textbox`, "  Aurora  ")
	app:frames(5)
	save(app)
	expect(said(app)).to_contain("rename_project:borealis:Aurora")
	expect(said(app)).never.to_contain("set_project_icon")
	expect(app:state("project_edit_open")).to_be(false)
	expect(app:has(`#sidebar >> "Aurora"`)).to_be(true)
end)

test("edit project: an empty name is refused, the dialog kept open saying so", function()
	local app = open()
	app:fill(`{DIALOG} >> role:textbox`, "   ")
	app:frames(5)
	save(app)
	expect(app:has(DIALOG)).to_be(true)
	expect(app:has(`{DIALOG} >> "Give it a name"`)).to_be(true)
	expect(said(app)).never.to_contain("rename_project")
end)

test("edit project: an emoji searched for and picked is the project's, on its colour, in the sidebar too", function()
	local app = open()
	app:click(`{DIALOG} >> role:radio "Emoji"`)
	app:frames(20)
	expect(app:has("#project-edit-emoji")).to_be(true)
	app:fill(`#project-edit-emoji >> role:textbox`, "rocket")
	app:frames(10)
	expect(app:has(`#project-edit-emoji >> "Results"`)).to_be(true)
	app:click(`#project-edit-emoji >> role:button "Rocket"`)
	app:frames(10)
	-- The foot names it; the colour chosen too.
	expect(app:has(`#project-edit-emoji >> "Rocket"`)).to_be(true)
	app:click(`{DIALOG} >> role:radio "Amber"`)
	app:frames(5)
	save(app)
	expect(said(app)).to_contain("set_project_icon:borealis:🚀::amber")
	expect(app:state("project_edit_open")).to_be(false)
	-- The sidebar's header wears it.
	expect(app:has(`#sidebar >> "🚀"`)).to_be(true)
end)

test("edit project: Enter in the emoji search picks the first match; a skin tone tones a hand", function()
	local app = open()
	app:click(`{DIALOG} >> role:radio "Emoji"`)
	app:frames(20)
	app:click(`#project-edit-emoji >> role:button "Skin tone"`)
	app:frames(10)
	app:click(`#project-edit-emoji >> role:button "Medium"`)
	app:frames(10)
	app:fill(`#project-edit-emoji >> role:textbox`, "waving hand")
	app:frames(10)
	app:key("Enter")
	app:frames(10)
	-- (Still open: Enter in the search picks, it doesn't save.)
	expect(app:has(DIALOG)).to_be(true)
	save(app)
	expect(said(app)).to_contain("set_project_icon:borealis:👋🏽::")
end)

test("edit project: a search that finds nothing says so", function()
	local app = open()
	app:click(`{DIALOG} >> role:radio "Emoji"`)
	app:frames(20)
	app:fill(`#project-edit-emoji >> role:textbox`, "zzqqxx")
	app:frames(10)
	expect(app:has(`#project-edit-emoji >> "No emoji found"`)).to_be(true)
end)

test("edit project: a picture chosen is placed, uploaded on Save, and worn", function()
	local app = open()
	app:click(`{DIALOG} >> role:radio "Image"`)
	app:frames(20)
	expect(app:has("#project-edit-drop")).to_be(true)
	app:copy_file("assets/favicons/zeron.png", "logo.png")
	app:pick({ "logo.png" })
	app:click(`#project-edit-drop >> role:button "Choose an image"`)
	app:frames(30)
	expect(app:has("#project-edit-crop")).to_be(true)
	save(app)
	app:frames(20)
	expect(said(app)).to_contain("upload_icon:")
	expect(said(app)).to_contain(`set_project_icon:borealis::https://edge.test/auth/avatars/{string.rep("a", 32)}:`)
	expect(app:state("project_edit_open")).to_be(false)
end)

test("edit project: an upload that fails says why and keeps the dialog", function()
	local app = open()
	app:click(`{DIALOG} >> role:radio "Image"`)
	app:frames(20)
	app:copy_file("assets/favicons/zeron.png", "offline.png")
	app:pick({ "offline.png" })
	app:click(`#project-edit-drop >> role:button "Choose an image"`)
	app:frames(30)
	save(app)
	expect(app:has(DIALOG)).to_be(true)
	expect(app:has(`#project-edit-error >> "You're offline, so the image can't be uploaded."`)).to_be(true)
	expect(said(app)).never.to_contain("set_project_icon")
end)

test("edit project: Default with its own colour clears the icon; the old picture is let go of", function()
	local app = open()
	app:click(`{DIALOG} >> role:radio "Emoji"`)
	app:frames(20)
	app:fill(`#project-edit-emoji >> role:textbox`, "rocket")
	app:frames(10)
	app:key("Enter")
	app:frames(5)
	save(app)
	expect(said(app)).to_contain("set_project_icon:borealis:🚀::")
	-- Back to the default: nothing of its own.
	app:right_click(`#sidebar >> "Borealis"`)
	app:frames(20)
	app:click(`role:menuitem "Edit project…"`)
	app:frames(40)
	expect(app:has(`{DIALOG} >> role:radio "Emoji"`)).to_be(true)
	app:click(`{DIALOG} >> role:radio "Default"`)
	app:frames(10)
	save(app)
	expect(said(app)).to_contain("set_project_icon:borealis:::")
end)

test("edit project: an engine without project icons says Zeron needs an update; a picture never worn is let go of", function()
	local app = open()
	app:command("fixture.icons_outdated")
	app:click(`{DIALOG} >> role:radio "Image"`)
	app:frames(20)
	app:copy_file("assets/favicons/zeron.png", "logo.png")
	app:pick({ "logo.png" })
	app:click(`#project-edit-drop >> role:button "Choose an image"`)
	app:frames(30)
	save(app)
	app:frames(20)
	expect(said(app)).to_contain("upload_icon:")
	expect(said(app)).to_contain("set_project_icon_refused:borealis")
	expect(app:has(`#project-edit-error >> "Zeron on this computer needs an update to save project icons. Update it, then save again."`)).to_be(true)
	expect(app:state("project_edit_open")).to_be(true)
	expect(said(app)).never.to_contain("forget_icon")
	-- Cancelled: the uploaded picture, worn by nothing, goes.
	app:click(`{DIALOG} >> role:button "Cancel"`)
	app:frames(20)
	expect(said(app)).to_contain(`forget_icon:https://edge.test/auth/avatars/{string.rep("a", 32)}`)
end)
