-- The queue behind the composer answers at once: a message sent while a
-- turn runs shows in it, a row steered leaves it for the transcript, a row
-- removed goes, all the frame they're asked, before the engine answers
-- (ui/chat_fixture.luau's `queue_held` holds its answers back, as a chat
-- on another device keeps the page waiting a round trip). Refused, a row
-- comes back and the composer says so.

local function settle(app: any)
	app:frames(30)
end

local function running(app: any, id: string)
	app:command(`go_{id}`)
	settle(app)
	app:command("start_reply")
	settle(app)
end

test("a message sent while a turn runs is in the queue the frame it's sent", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_held")
	app:type("role:textbox", "Then run the tests")
	app:key("Enter")
	app:frames(1)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(true)
	expect(app:state("calls")).to_contain("send:s2:Then run the tests")
	-- The engine's copy takes its place: one row still.
	app:command("engine_answers")
	settle(app)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(true)
	expect(app:has('role:listitem "2. Then run the tests"')).to_be(false)
end)

test("a message the queue refuses leaves it, and its words go back in the composer", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_held")
	app:type("role:textbox", "Then run the tests")
	app:key("Enter")
	app:frames(1)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(true)
	app:command("engine_refuses")
	settle(app)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(false)
	expect(app:has('~"Your message didn\'t send"')).to_be(true)
	expect(app:text("role:textbox")).to_be("Then run the tests")
end)

test("Steer takes a queued row into the transcript the frame it's pressed", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_one")
	settle(app)
	app:command("queue_held")
	app:hover('role:listitem "1. Queued words"')
	settle(app)
	app:click('role:button "Steer"')
	app:frames(1)
	expect(app:state("calls")).to_contain("queue:s2:send:q1")
	expect(app:has('role:listitem "1. Queued words"')).to_be(false)
	expect(app:has('#chat-session >> ~"Queued words"')).to_be(true)
	-- The engine's word: the same row, sent.
	app:command("engine_answers")
	settle(app)
	expect(app:has('role:listitem "1. Queued words"')).to_be(false)
	expect(app:has('#chat-session >> ~"Queued words"')).to_be(true)
end)

test("a steer the engine refuses puts the row back and says so", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_one")
	settle(app)
	app:command("queue_held")
	app:hover('role:listitem "1. Queued words"')
	settle(app)
	app:click('role:button "Steer"')
	app:frames(1)
	expect(app:has('role:listitem "1. Queued words"')).to_be(false)
	app:command("engine_refuses")
	settle(app)
	expect(app:has('role:listitem "1. Queued words"')).to_be(true)
	expect(app:has('#chat-session >> ~"Queued words"')).to_be(false)
	expect(app:has('~"Your message didn\'t send"')).to_be(true)
end)

test("a queued row removed goes at once, and comes back if the engine refuses", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_two")
	settle(app)
	app:command("queue_held")
	app:hover('role:listitem "1. First queued"')
	settle(app)
	app:click('role:listitem "1. First queued" >> role:button "Remove"')
	app:frames(1)
	expect(app:has('role:listitem "1. First queued"')).to_be(false)
	expect(app:has('role:listitem "1. Second queued"')).to_be(true)
	app:command("engine_refuses")
	settle(app)
	expect(app:has('role:listitem "1. First queued"')).to_be(true)
	expect(app:has('~"Couldn\'t remove that message"')).to_be(true)
end)

-- Steer all: every queued row as one message, numbered, steered.

local function last_message(app: any): any
	local all = app:state("chat.messages")
	return all[#all]
end

test("Steer all sends every queued row as one numbered message, at once", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_two")
	settle(app)
	app:command("queue_held")
	app:click('role:button "Steer all"')
	app:frames(1)
	expect(app:state("calls")).to_contain("steer_all:s2:q1,q2")
	expect(app:has('role:listitem "1. First queued"')).to_be(false)
	expect(app:has('role:listitem "1. Second queued"')).to_be(false)
	expect(last_message(app).text).to_be("1. First queued\n\n2. Second queued")
	expect(last_message(app).waiting).to_be("sending")
	app:command("engine_answers")
	settle(app)
	expect(app:has('role:listitem "1. First queued"')).to_be(false)
	expect(last_message(app).text).to_be("1. First queued\n\n2. Second queued")
end)

test("Steer all refused puts the rows back and says so", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_two")
	settle(app)
	app:command("queue_held")
	app:click('role:button "Steer all"')
	app:frames(1)
	app:command("engine_refuses")
	settle(app)
	expect(app:has('role:listitem "1. First queued"')).to_be(true)
	expect(app:has('role:listitem "2. Second queued"')).to_be(true)
	expect(last_message(app).text).never.to_be("1. First queued\n\n2. Second queued")
	expect(app:has('~"Your message didn\'t send"')).to_be(true)
end)

test("Steer all shows with two queued rows or more, while the agent can be steered", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	settle(app)
	app:command("queue_two")
	settle(app)
	-- (No turn running: nothing to steer.)
	expect(app:has('role:button "Steer all"')).to_be(false)
	app:command("start_reply")
	settle(app)
	expect(app:has('role:button "Steer all"')).to_be(true)
	app:command("queue_one")
	settle(app)
	expect(app:has('role:button "Steer all"')).to_be(false)
end)

-- What a queued message carries: a glyph and how many at its row's end,
-- the row no taller; pressed, its picture and file, the picture opening
-- into the lightbox.

local function height(app: any, target: string): number
	local line = app:tree(target):match("[^\n]*") or ""
	return tonumber(line:match("%d+,%d+ %d+x(%d+)")) or -1
end

test("a queued message's files show as a count at its row's end, the row no taller", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_with_files")
	settle(app)
	local with = 'role:listitem "2. Look at these"'
	expect(app:has(`{with} >> role:button "2 attachments: flint.png · notes.txt"`)).to_be(true)
	expect(app:has('role:listitem "1. Plain words" >> role:button "1 attachment"')).to_be(false)
	expect(height(app, with)).to_be(height(app, 'role:listitem "1. Plain words"'))
	-- (Carrying files, it's sent now: the engine won't steer files mid-turn.)
	expect(app:has(`{with} >> role:button "Send now"`)).to_be(true)
	app:click(`{with} >> role:button "2 attachments: flint.png · notes.txt"`)
	settle(app)
	expect(app:has('role:list "Attachments" >> ~"notes.txt"')).to_be(true)
	app:click('role:button "Open flint.png"')
	settle(app)
	local open = app:state("ds/lightbox.luau::open")
	expect(open ~= nil).to_be(true)
	expect(open.items[1].name).to_be("flint.png")
end)
