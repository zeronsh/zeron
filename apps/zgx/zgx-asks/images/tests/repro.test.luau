test("a GIF in ui.image shows, with no runtime error (fails today)", function()
	local app = mount("app.luau")
	app:resize(200, 200)
	app:frames(5)
	expect(app:error()).to_be_nil()
	app:set_state("which", "gif")
	app:frames(5)
	print("GIF: " .. tostring(app:error()))
	expect(app:error()).to_be_nil()
end)
