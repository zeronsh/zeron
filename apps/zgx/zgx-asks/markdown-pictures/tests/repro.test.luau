test("a picture under some words is a picture, not its alt text (fails today)", function()
	local app = mount("app.luau")
	app:frames(2)
	print("under_words: " .. tostring(app:state("under_words")))
	expect(app:state("under_words")).to_be("p,img")
end)

test("two pictures on lines of their own are two pictures (fails today)", function()
	local app = mount("app.luau")
	app:frames(2)
	print("two_lines: " .. tostring(app:state("two_lines")))
	expect(app:state("two_lines")).to_be("img,img")
end)

test("a picture alone leaves no empty paragraph behind it (fails today)", function()
	local app = mount("app.luau")
	app:frames(2)
	print("alone: " .. tostring(app:state("alone")))
	expect(app:state("alone")).to_be("img,p")
end)
