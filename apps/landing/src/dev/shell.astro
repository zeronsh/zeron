---
// The empty shell, for its own look (dev only: astro.config.mjs devPages).
// /_dev/shell as a public page (the script fills in who you are);
// ?staff as an account page of a staff member's.
import App from "../layouts/App.astro";
import type { WebSession } from "../lib/store/types.ts";

export const prerender = false;

const staff: WebSession | undefined = Astro.url.searchParams.has("staff")
  ? { user: { name: "Grace Hopper", email: "grace@example.com" }, username: "grace", roles: ["admin"], csrf: "x", expires_at: 0, fresh_sign_in: false }
  : undefined;
---

<App title="All plugins · Zeron" description="The empty shell." noindex current="all" session={staff}>
  <h1 slot="title" class="t-title">All plugins</h1>
  <div slot="tools" class="segmented" role="group" aria-label="Order">
    <a href="#" aria-current="page">Popular</a>
    <a href="#">Updated</a>
    <a href="#">New</a>
  </div>
</App>
