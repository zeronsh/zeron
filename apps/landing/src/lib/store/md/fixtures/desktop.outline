=== focus-timer.md
h1 "Focus timer"
p "A 25 minute timer in a chat's header. Start it, and it counts down."
p ""
  picture "The timer in a chat's header" <- shots/header.png
p ""
  picture "A picture from the web" <- https://example.com/tracker.png
p "Read the guide for more."
  link "the guide" -> https://example.com/guide
p "See Your chats, your key, Allow and a picture."
  link "Your chats" -> zeron-chat:abc
  link "your key" -> zeron-file:/Users/you/.ssh/id_ed25519
  link "Allow" -> zeron-invoke:allow
  link "a picture" -> zeron-image:1
quote
  p "See Your chats, your key, Allow and a picture."
p "<script>zeron.decide(true)</script>"
h2 "What it does"
list bulleted
  item task=none
    p "Counts down from 25 minutes."
  item task=none
    p "Says when it's done."
h1 "Questions"
h3 "Does it ring?"
p "Once, softly."
