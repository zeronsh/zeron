=== subset.md
p ""
  picture "build" <- https://ci.example.com/badge.svg in https://ci.example.com/runs
  picture "license" <- https://img.example.com/mit.svg in LICENSE
h1 "Cost meter"
p "Shows what each chat costs, as it goes, in the sidebar. No setup, no account; it reads your agents' own usage. A hard break, and a code span with ` in it."
h2 "Install"
list ordered from 1
  item task=none
    p "Open Settings › Plugins."
  item task=none
    p "Find Cost meter."
  item task=none
    p "Install it:"
    code[sh] "zeron plugin install cost-meter"
h2 "Settings"
table ["Setting", "What it does", "Default"] align ["left", "center", "right"]
  row ["limit", "The monthly limit, in dollars.", "50"]
  row ["warn", "When to warn you | a share of the limit.", "0.8"]
  row ["currency", "", "USD"]
h2 "To do"
list bulleted
  item task=done
    p "Per-chat totals"
  item task=open
    p "Per-project totals"
    list bulleted
      item task=none
        p "grouped by week"
      item task=none
        p "grouped by month"
  item task=open
    p "Exports"
quote
  p "Note It never sends your usage anywhere."
  quote
    p "Quoted twice."
p "Loose list:"
list bulleted
  item task=none
    p "one"
  item task=none
    p "two"
    p "indented code inside nothing"
rule
p "See the guide, Settings, and the changelog or a heading. Mail help@example.com or open https://example.com/issues."
  link "the guide" -> https://example.com/guide
  link "Settings" -> https://example.com/settings
  link "the changelog" -> CHANGELOG.md#changes
  link "a heading" -> #install
  link "help@example.com" -> help@example.com
  link "https://example.com/issues" -> https://example.com/issues
p "A picture of its own:"
  picture "The meter" <- shots/meter.png
p "<details><summary>Raw HTML</summary> is its characters &amp; entities &copy; are what they say.</details>"
p "Escapes: *not emphasis*, [not a link], 1. not a list."
