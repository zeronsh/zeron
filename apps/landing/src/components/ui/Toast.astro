---
// What just happened, said once at the foot of the page
// (apps/zgx/ui/ds/toast.luau), then gone. Pure CSS: it shows and leaves on
// its own, and stays put for anyone who asks the page not to move.
import Glyph from "./Glyph.astro";

interface Props {
  message: string | null;
  tone?: "success" | "danger";
}
const { message, tone = "success" } = Astro.props;
---

{
  message && (
    <div class:list={["toast", tone]} role="status">
      <Glyph name={tone === "success" ? "check-circle" : "danger-triangle"} size={16} />
      <span>{message}</span>
    </div>
  )
}

<style>
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 32px);
    min-height: 44px;
    padding: 10px 16px 10px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: var(--menu-solid);
    border-radius: var(--radius-xl);
    box-shadow: inset 0 0 0 1px var(--border), 0 12px 32px 0 #00000066;
    translate: -50% 0;
  }
  .success :global(.glyph) { color: var(--tone-success); }
  .danger :global(.glyph) { color: var(--tone-danger); }
  @media (prefers-reduced-motion: no-preference) {
    .toast { animation: toast-in 0.32s var(--ease-out) both, toast-out 0.4s ease-in 6s forwards; }
    @keyframes toast-in { from { opacity: 0; translate: -50% 12px; } }
    @keyframes toast-out { to { opacity: 0; translate: -50% 8px; visibility: hidden; } }
  }
</style>
