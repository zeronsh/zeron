---
// One of the app's own icons (apps/zgx/ui/ds/icon_svgs.luau; the ones the
// site uses are copied to src/data/icons.json), in the text's colour.
import icons from "../../data/icons.json";

interface Props {
  name: keyof typeof icons;
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

<span class="icon" style={`width:${size}px;height:${size}px`} aria-hidden="true" set:html={icons[name]} />

<style is:global>
  .icon { display: inline-block; flex: none; }
  .icon svg { display: block; width: 100%; height: 100%; }
</style>
