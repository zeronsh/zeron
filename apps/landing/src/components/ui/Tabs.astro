---
// A page's views, as links: each a real address, the one shown marked
// (the app's tab strip, ds/tabs.luau).
interface Props {
  label: string;
  tabs: { href: string; label: string; current: boolean; count?: number }[];
}
const { label, tabs } = Astro.props;
---

<nav class="tabs" aria-label={label}>
  {
    tabs.map((tab) => (
      <a href={tab.href} aria-current={tab.current ? "page" : undefined}>
        {tab.label}
        {tab.count !== undefined && <span class="count num">{tab.count}</span>}
      </a>
    ))
  }
</nav>

<style>
  .tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--line);
  }
  a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    height: 40px;
    padding: 0 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-3);
    transition: color 0.12s;
  }
  a:hover { color: var(--text); }
  a::after { content: ""; position: absolute; inset: auto 12px -1px; height: 2px; border-radius: 1px; background: transparent; transition: background-color 0.12s; }
  a[aria-current="page"] { color: var(--text); }
  a[aria-current="page"]::after { background: var(--text); }
  a:focus-visible { outline-offset: -2px; }
  .count { min-width: 20px; height: 18px; padding: 0 5px; font-size: 11.5px; line-height: 18px; text-align: center; color: var(--text-2); background: var(--secondary-bg); border-radius: 9px; }
</style>
