---
// A labelled field: one line or several, its hint under it.
interface Props {
  name: string;
  label: string;
  hint?: string;
  value?: string;
  multiline?: boolean;
  required?: boolean;
  maxlength?: number;
  placeholder?: string;
  autocomplete?: string;
  id?: string;
}
const { name, label, hint, value = "", multiline = false, required = false, maxlength, placeholder, autocomplete = "off", id = `field-${name}` } = Astro.props;
---

<div class="field">
  <label for={id}>{label}</label>
  {
    multiline ? (
      <textarea id={id} name={name} required={required} maxlength={maxlength} placeholder={placeholder} rows="4" aria-describedby={hint ? `${id}-hint` : undefined}>{value}</textarea>
    ) : (
      <input id={id} name={name} value={value} required={required} maxlength={maxlength} placeholder={placeholder} autocomplete={autocomplete} aria-describedby={hint ? `${id}-hint` : undefined} />
    )
  }
  {hint && <p id={`${id}-hint`} class="hint">{hint}</p>}
</div>

<style>
  .field { display: grid; gap: 6px; }
  label { font-size: 13px; font-weight: 500; color: var(--text); }
  input, textarea {
    width: 100%;
    padding: 0 12px;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: var(--field-bg);
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--field-edge);
    outline: none;
    transition: box-shadow 0.12s, background-color 0.12s;
  }
  input { height: 36px; }
  textarea { min-height: 96px; padding-block: 9px; line-height: 1.5; resize: vertical; }
  input:hover, textarea:hover { background: var(--field-hover); box-shadow: inset 0 0 0 1px var(--field-edge-hover); }
  input:focus-visible, textarea:focus-visible { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 80%, white), 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  input::placeholder, textarea::placeholder { color: var(--text-3); }
  .hint { font-size: 12.5px; line-height: 1.45; color: var(--text-3); }
</style>
