---
// A dialog (apps/zgx/ui/ds/dialog.luau): the menu's charcoal over a deep
// dim, its title, what it says, and its answers. It opens over the page
// from any `[data-dialog="<id>"]` link, which without a script is an
// ordinary link to a page that asks the same thing (`href`), so nothing
// depends on the script. Escape, Cancel and a click outside close it;
// focus starts on the safest answer (`autofocus` in the slot).
interface Props {
  id: string;
  title: string;
  /** "danger": what it asks can't be undone. */
  tone?: "default" | "danger";
}
const { id, title, tone = "default" } = Astro.props;
---

<dialog id={id} class:list={["dialog", tone]} aria-labelledby={`${id}-title`} closedby="any">
  <h2 id={`${id}-title`}>{title}</h2>
  <div class="body"><slot /></div>
</dialog>

<script>
  // Openers: a link that, with this script, opens its dialog instead.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const opener = event.target.closest<HTMLElement>("[data-dialog]");
    if (!opener || event.defaultPrevented || (event instanceof MouseEvent && (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0))) return;
    const dialog = document.getElementById(opener.dataset.dialog ?? "");
    if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== "function") return;
    event.preventDefault();
    dialog.showModal();
  });
  // A click on the dim closes it where `closedby` isn't known yet.
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog.dialog")) {
    if (typeof (dialog as { closedBy?: unknown }).closedBy === "string") continue;
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .dialog {
    width: min(460px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 24px;
    overflow: auto;
    color: var(--text);
    background: var(--menu-solid);
    border: 0;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--border), var(--dialog-shadow);
  }
  .dialog::backdrop { background: rgb(0 0 0 / 0.6); }
  h2 { font-size: 17px; font-weight: 600; line-height: 1.35; letter-spacing: -0.01em; }
  .body { margin-top: 8px; font-size: 14.5px; line-height: 1.55; color: var(--text-2); }
  .body :global(p + p) { margin-top: 8px; }
  .body :global(.answers) { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-top: 24px; }
  @media (prefers-reduced-motion: no-preference) {
    .dialog[open] { animation: dialog-in 0.18s var(--ease-out); }
    .dialog[open]::backdrop { animation: dim-in 0.18s ease-out; }
    @keyframes dialog-in { from { opacity: 0; scale: 0.97; } }
    @keyframes dim-in { from { opacity: 0; } }
  }
</style>
