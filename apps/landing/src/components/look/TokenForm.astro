---
// New deploy token's form (contract a315eef5a; the app's words): its name,
// when it ends, what it can publish (all your plugins, now and later, or
// those and your templates, or the ones you tick), and Create token. Made only with a fresh sign-in: a
// session without one is told it'll sign in again first, and the post
// sends it there and back to this form as it was filled in. In a dialog
// on Deploy tokens (Cancel closes it), or as a page of its own (Cancel goes
// back): the same form, posting to the same place. Nothing it holds is the
// token: that's made by the post and shown once by the page that answers it.
import Thumb from "./Thumb.astro";
import Words from "./Words.astro";
import { KIND_WORDS, kindOfItem, KINDS, type Kind } from "../../lib/store/kind.ts";
import { count } from "../../lib/store/format.ts";
import { chosenHint } from "../../lib/store/chosen.ts";
import { BOTH, ENDS, type Refusal, type TokenFields } from "../../lib/store/tokens.ts";
import type { MyPlugin } from "../../lib/store/types.ts";
import { store } from "../../lib/store/words.ts";

interface Props {
  /** Its element ids start with this: a page may hold the form twice (its dialog, a page). */
  id: string;
  csrf: string;
  fields: TokenFields;
  /** Your plugins and templates, to choose from. */
  items: Pick<MyPlugin, "id" | "kind" | "name" | "icon" | "cover" | "version">[];
  /** Whether this session's sign-in is fresh enough to make one now. */
  fresh: boolean;
  /** Back from signing in again for it. */
  again?: boolean;
  refusal?: Refusal | null;
  /** In a dialog: Cancel closes it. Else Cancel is a link here. */
  dialog?: boolean;
  back: string;
}
const { id, csrf, fields, items, fresh, again = false, refusal = null, dialog = false, back } = Astro.props;
const plugins = items.filter((p) => kindOfItem(p) === "plugin");
/** The list to tick, as the app's: plugins, then templates, each under its name when there are both; the ticked first in each. */
const groups = KINDS.map((kind) => ({ kind, items: items.filter((p) => kindOfItem(p) === kind).sort((a, b) => Number(fields.plugins.includes(b.id)) - Number(fields.plugins.includes(a.id))) })).filter((g) => g.items.length > 0);
/** How many of a kind come back ticked. */
const ticked = (kind: Kind) => items.filter((p) => kindOfItem(p) === kind && fields.plugins.includes(p.id)).length;
const said = (field: Refusal["field"]) => (refusal && refusal.field === field ? `${id}-said` : undefined);
---

<form method="post" action="/account/tokens/new" class="tokform">
  <input type="hidden" name="csrf" value={csrf} />
  <div class="tf">
    <label class="field-label" for={`${id}-name`}>{store("plugins.store.key.name")}</label>
    <input
      id={`${id}-name`}
      class="input"
      type="text"
      name="name"
      value={fields.name}
      placeholder={store("plugins.store.key.name_placeholder")}
      maxlength="64"
      required
      autocomplete="off"
      spellcheck="false"
      aria-invalid={said("name") ? "true" : undefined}
      aria-describedby={said("name")}
    />
    {said("name") && <p class="said" id={said("name")}>{refusal!.message}</p>}
  </div>
  <div class="tf">
    <label class="field-label" for={`${id}-ends`}>{store("plugins.store.key.expiry_label")}</label>
    <div class="field">
      <select id={`${id}-ends`} name="ends">
        {ENDS.map((e) => <option value={e} selected={e === fields.ends}>{store(`plugins.store.key.expiry.${e}`)}</option>)}
      </select>
      <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
  </div>
  <fieldset class="tf scopes" aria-describedby={said("plugins")}>
    <legend class="field-label">{store("plugins.store.key.scope.label")}</legend>
    {/* (Each a card to choose, as the report page's reasons: its words, its radio at the right; the chosen one ringed.) */}
    <label class="rcard">
      <span class="rc-words"><b>{store("plugins.store.key.scope.all")}</b><small>{count(plugins.length)} today, and any you publish later</small></span>
      <input type="radio" name="scope" value="all" checked={fields.scope === "all"} />
    </label>
    <label class="rcard">
      <span class="rc-words"><b>{BOTH}</b><small>A template can do anything Zeron can.</small></span>
      <input type="radio" name="scope" value="both" checked={fields.scope === "both"} />
    </label>
    <label class="rcard">
      <span class="rc-words"><b>Chosen</b><small data-chosen-hint aria-live="polite">{chosenHint(ticked("plugin"), ticked("template"))}</small></span>
      <input type="radio" name="scope" value="chosen" checked={fields.scope === "chosen"} disabled={items.length === 0} />
    </label>
    {
      items.length > 0 && (
        <div class="picks" role="group" aria-label="What it can publish">
          {groups.map((g) => (
            <section aria-labelledby={groups.length > 1 ? `${id}-${g.kind}s` : undefined}>
              {groups.length > 1 && <h3 class="picks-h" id={`${id}-${g.kind}s`}>{KIND_WORDS[g.kind].Many}</h3>}
              <ul>
                {g.items.map((p) => (
                  <li>
                    <label class="pick-pl">
                      <input type="checkbox" name="plugins" value={p.id} data-kind={g.kind} checked={fields.plugins.includes(p.id)} />
                      <Thumb item={p} size="xs" />
                      <span><Words text={p.name} /></span>
                    </label>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
    {said("plugins") && <p class="said" id={said("plugins")}>{refusal!.message}</p>}
  </fieldset>
  {refusal && refusal.field === null && <p class="said" role="alert">{refusal.message}</p>}
  {!fresh ? <p class="note">{store("plugins.store.key.new_body")}</p> : again && <p class="note ok">You signed in again. Create the token to finish.</p>}
  <div class="answers">
    {dialog ? (
      <button class="btn sec" type="submit" formmethod="dialog" formnovalidate>Cancel</button>
    ) : (
      <a class="btn sec" href={back}>Cancel</a>
    )}
    <button class="btn pri" type="submit">{store("plugins.store.key.create")}</button>
  </div>
</form>
