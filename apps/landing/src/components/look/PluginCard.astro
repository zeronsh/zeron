---
// A plugin, as the public sees it in a list (the one card: the store's grid
// and its Featured row): its tile, its name with the check when its newest
// version is verified, its author, what it does, and a foot (what the list is
// ordered by, or that its newest version isn't verified yet, and its
// installs). Always these, in this order. Featured is the same card a size up.
import Seal from "./Seal.astro";
import Tile from "./Tile.astro";
import { count } from "../../lib/store/format.ts";
import { hueClass } from "../../lib/store/hue.ts";
import type { PluginCard } from "../../lib/store/types.ts";
import { pluginUrl } from "../../lib/store/urls.ts";

interface Props {
  plugin: PluginCard;
  /** The foot's first line for a verified plugin: what the list is ordered by ("Updated Nov 3"). */
  when: string;
  size?: "md" | "lg";
}
const { plugin: p, when, size = "md" } = Astro.props;
---

<a class:list={["pcard", size, hueClass(p.id)]} href={pluginUrl(p.id)}>
  <Tile id={p.id} name={p.name} icon={p.icon} version={p.version} size={size === "lg" ? "xl" : "l"} />
  <div class="pc-body">
    <div class="pc-name"><span class="name">{p.name}</span>{p.verified && <Seal size="s" />}</div>
    <div class="pc-by">by {p.author.username ? `@${p.author.username}` : "a former account"}</div>
    <p class="pc-sum">{p.summary}</p>
    <div class="pc-foot">
      {p.verified ? <span>{when}</span> : <span class="state no">{p.version} not verified yet</span>}
      <span class="num">{count(p.installs)} {p.installs === 1 ? "install" : "installs"}</span>
    </div>
  </div>
</a>
