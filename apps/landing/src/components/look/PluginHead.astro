---
// A plugin's head, the same on its Overview, Versions and asks: one block,
// as Raycast's extension page sets it. Its tile; beside it the name (the
// seal when its newest is verified), the summary under it, then one line of
// who made it (their initial before their name), its category and how many
// have it. At the right, getting it (Get.astro), the button level with the
// tile's middle.
import Get from "./Get.astro";
import Icon from "./Icon.astro";
import Seal from "./Seal.astro";
import Tile from "./Tile.astro";
import { catalogHref } from "../../lib/store/catalog.ts";
import { count } from "../../lib/store/format.ts";
import { satisfies } from "../../lib/store/semver.ts";
import type { PluginDetail, VersionInfo } from "../../lib/store/types.ts";
import { memberUrl } from "../../lib/store/urls.ts";
import { initial } from "../../lib/store/tile.ts";
import { lsb } from "../../lib/store/bearing.ts";

interface Props {
  plugin: PluginDetail & { version: string };
  /** The category's name, as the site names it. */
  category: string | null;
  /** The versions known here: for when the newest and the newest verified one were verified and published. */
  versions: VersionInfo[];
  /** The latest Zeron released (its Install is off when no released Zeron can install it). */
  latestZeron: string | null;
}
const { plugin, category, versions, latestZeron } = Astro.props;
const newest = versions.find((v) => v.version === plugin.version);
const verifiedOne = plugin.verified_version ? versions.find((v) => v.version === plugin.verified_version) : undefined;
const off = latestZeron && satisfies(latestZeron, plugin.engines?.zeron) === false ? { needs: plugin.engines?.zeron, latest: latestZeron } : null;
const first = plugin.categories[0] ?? null;
---

<nav class="crumbs" aria-label="Where this is">
  <a href="/plugins">Plugins</a>
  {first && category && <><Icon name="chev" /><a href={catalogHref({ category: first })}>{category}</a></>}
</nav>
<header class="head">
  <Tile id={plugin.id} name={plugin.name} icon={plugin.icon} version={plugin.version} size="xl" />
  <div class="txt">
    <h1 class={lsb(plugin.name)}><span class="name">{plugin.name}</span>{plugin.verified && <Seal size="l" />}</h1>
    <p class="sum">{plugin.summary}</p>
    <p class="by">
      {
        plugin.author.username ? (
          <a class="who" href={memberUrl(plugin.author.username)}><span class="av" aria-hidden="true">{initial(plugin.author.username)}</span><span class="sr-only">by </span>@{plugin.author.username}</a>
        ) : (
          <span class="who"><span class="av" aria-hidden="true">?</span>by a former account</span>
        )
      }
      {category && <><i aria-hidden="true"></i><span>{category}</span></>}
      <i aria-hidden="true"></i><span class="num">{count(plugin.installs)} {plugin.installs === 1 ? "install" : "installs"}</span>
    </p>
  </div>
  <Get
    id={plugin.id}
    name={plugin.name}
    version={plugin.version}
    newest
    verified={plugin.verified}
    verifiedAt={newest?.verified_at ?? null}
    publishedAt={newest?.published_at ?? plugin.updated_at}
    verifiedVersion={plugin.verified_version}
    verifiedVersionAt={verifiedOne?.verified_at ?? null}
    off={off}
  />
</header>
