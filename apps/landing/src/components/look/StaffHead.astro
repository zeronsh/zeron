---
// The head of the staff pages (the prototype's queue head): Review, a line
// on what the list holds, and one row of tabs, the queue's lists and the
// staff pages beside them, each with how many it holds where that's known.
// On a phone the tabs scroll sideways, under one another's edge.
import { lsb } from "../../lib/store/bearing.ts";

interface Tab {
  label: string;
  href: string;
  /** How many it holds, when known. */
  n?: number | null;
  current?: boolean;
}
interface Props {
  title: string;
  lead: string;
  tabs: Tab[];
}
const { title, lead, tabs } = Astro.props;
---

<div class="hd">
  <div>
    <h1 class={lsb(title)}>{title}</h1>
    <p class="lead">{lead}</p>
  </div>
</div>
<nav class="sub staff-tabs" aria-label="Review">
  {tabs.map((t) => <a href={t.href} aria-current={t.current ? "page" : undefined}>{t.label}{t.n != null && <span class="num">{t.n}</span>}</a>)}
</nav>
<slot />
