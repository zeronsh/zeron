---
// A page of your own, signed out: its own plain invitation to sign in,
// never a redirect (a redirect that comes back to a page that redirects is
// a loop when sign-in fails). The sign-in comes back here.
import { signInUrl } from "../../lib/store/urls.ts";

interface Props {
  /** What signing in shows you here. */
  what: string;
}
const { what } = Astro.props;
const here = `${Astro.url.pathname}${Astro.url.search}`;
---

<section class="please">
  <h2>Sign in to see {what}</h2>
  <p>Use the account you publish with. It's the same one you use in Zeron.</p>
  <a class="btn pri" href={signInUrl(here)}>Sign in</a>
</section>
