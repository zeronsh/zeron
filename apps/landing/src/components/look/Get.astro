---
// Getting it (the prototype's .get): Install in Zeron, the one primary
// button (it opens Zeron at this plugin; it never installs by itself); the
// version it offers and whether Zeron verified it; and, when that version
// isn't verified, the amber note: the newest verified one, to install
// instead (the app's sentences, the contract's link that names a version).
// "Nothing happened?" opens how to get Zeron, and opens by itself when the
// page sees the link went nowhere (scripts/store.ts).
import { compatibility, day, since } from "../../lib/store/format.ts";
import { appUrl } from "../../lib/store/urls.ts";
import { store } from "../../lib/store/words.ts";
import Seal from "./Seal.astro";

interface Props {
  id: string;
  name: string;
  /** The version the button installs. */
  version: string;
  /** It's the plugin's newest: the plain link (the app's page decides); else a link that names it. */
  newest: boolean;
  verified: boolean;
  /** When it was verified, or else published. */
  verifiedAt: number | null;
  publishedAt: number;
  /** The plugin's newest verified version (not this one), and when Zeron verified it, if known. */
  verifiedVersion: string | null;
  verifiedVersionAt?: number | null;
  /** No Zeron released can install it: the button stays, off, and says why. */
  off?: { needs: string | undefined; latest: string } | null;
}
const { id, name, version, newest, verified, verifiedAt, publishedAt, verifiedVersion, verifiedVersionAt, off } = Astro.props;
const label = newest ? "Install in Zeron" : store("plugins.store.install_version", { version });
const href = appUrl(id, newest ? undefined : version);
const now = Date.now();
const mark = [[0, 0], [1, 0], [2, 0], [4, 0], [0, 1], [1, 1], [3, 1], [4, 1], [0, 2], [2, 2], [3, 2], [4, 2]];
---

<div class="get" data-get>
  {
    off ? (
      <span class="btn pri lg" aria-disabled="true">{label}</span>
    ) : (
      <a class="btn pri lg" href={href} data-install>
        <svg class="mark" viewBox="0 0 49 29" aria-hidden="true" focusable="false">{mark.map(([x, y]) => <rect x={x! * 10} y={y! * 10} width="9" height="9" rx="2.7" />)}</svg>
        {label}
      </a>
    )
  }
  <div class="ver">
    <b class="mono">{version}</b>
    {verified ? <span class="state ok"><Seal quiet />{store("plugins.store.verified")}</span> : <span class="state no">{store("plugins.store.review.waiting")}</span>}
    {verified && verifiedAt !== null ? <time class="t3" datetime={new Date(verifiedAt).toISOString()}>{day(verifiedAt, now)}</time> : <time class="t3" datetime={new Date(publishedAt).toISOString()}>{since(publishedAt, now, true)}</time>}
  </div>
  {
    off ? (
      <p class="note warn">
        <b>{store("plugins.store.needs_other_zeron")}</b> It needs {compatibility(off.needs)}; the latest Zeron is {off.latest}.
      </p>
    ) : (
      !verified && (
        <p class="note">
          {verifiedVersion ? (
            <>
              <b>{store("plugins.store.not_verified_line", { version, verified: verifiedVersion })}</b>{" "}
              <a href={appUrl(id, verifiedVersion)}>{store("plugins.store.install_instead", { version: verifiedVersion })}</a>
              {verifiedVersionAt ? `, verified ${day(verifiedVersionAt, now)}.` : "."}
            </>
          ) : (
            <>
              <b>{store("plugins.store.none_verified")}</b> Zeron asks before it installs it.
            </>
          )}
        </p>
      )
    )
  }
  {
    !off && (
      <div class="alt">
        Opens Zeron. <button type="button" popovertarget={`get-help-${id}`} data-get-help>Nothing happened?</button>
      </div>
    )
  }
  <div class="menu get-help" id={`get-help-${id}`} popover>
    <p><b>{label} opens Zeron at {name}, ready to install.</b> If nothing opened:</p>
    <ol>
      <li><a href="/#downloads">Download Zeron</a> for your computer, open it, and press {label} again.</li>
      <li>Or, in Zeron, open Settings, then Plugins, then Browse, and search for {name}.</li>
    </ol>
  </div>
</div>
