---
// What stands for an item in a row: a plugin's tile, or a template's
// preview, small (16:10, the tile's height; a template has no icon).
import Tile from "./Tile.astro";
import { kindOfItem, type Kind } from "../../lib/store/kind.ts";
import { pictureUrl } from "../../lib/store/urls.ts";

interface Props {
  item: { id: string; name: string; kind?: Kind; icon: string | null; cover?: string | null; version: string | null };
  /** The version its tile's icon is from, when that isn't the listed one. */
  version?: string | null;
  size: "xs" | "s" | "xl";
}
const { item, version = item.version, size } = Astro.props;
const template = kindOfItem(item) === "template";
const src = template ? pictureUrl(item.id, version, item.cover ?? "preview.png", "template") : null;
---

{template ? <span class:list={["thumb", size]} aria-hidden="true">{src && <img src={src} alt="" loading="lazy" decoding="async" />}</span> : <Tile id={item.id} name={item.name} icon={item.icon} version={version} size={size} />}
