---
// A plugin's pictures, on its own colour (the prototype's gallery): one at
// a time, set as a window would be; the rest by scrolling sideways, which a
// keyboard (the strip takes focus: arrows), a touch and a trackpad all do
// with no script, each picture snapping into place. The dots say how many
// and which; with the script they follow the strip and take you to one.
// Each picture opens on its own. None, and there is no gallery.
import { hueClass } from "../../lib/store/hue.ts";
import { pictureUrl } from "../../lib/store/urls.ts";

interface Props {
  id: string;
  name: string;
  version: string;
  screenshots: string[];
}
const { id, name, version, screenshots } = Astro.props;
const pictures = screenshots.map((s) => pictureUrl(id, version, s)).filter((s): s is string => s !== null);
---

{
  pictures.length > 0 && (
    <section class:list={["stage gallery", hueClass(id), { one: pictures.length === 1 }]} aria-label={`Pictures of ${name}`} data-gallery>
      <div class="track" tabindex="0" role="group" aria-label={pictures.length > 1 ? `${pictures.length} pictures: scroll, or use the arrow keys` : "A picture"} data-track>
        {pictures.map((src, i) => (
          <a class="slide" href={src} target="_blank" rel="noopener" data-slide>
            <img src={src} alt={`${name}, picture ${i + 1} of ${pictures.length}`} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
          </a>
        ))}
      </div>
      {pictures.length > 1 && (
        <div class="dots" data-dots>
          {pictures.map((_, i) => <button type="button" aria-label={`Picture ${i + 1}`} aria-current={i === 0 ? "true" : undefined} data-dot={i} />)}
        </div>
      )}
    </section>
  )
}
