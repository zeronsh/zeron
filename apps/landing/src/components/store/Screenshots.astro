---
// A plugin's screenshots: a row to scroll, each opening large over the
// page (a <dialog>, with arrow keys to move between them). Without the
// script, each is a link to the picture itself.
import Glyph from "../ui/Glyph.astro";

interface Props {
  name: string;
  /** Each picture's address, in order. */
  pictures: string[];
}
import { unbidi } from "../../lib/store/format.ts";
const { pictures } = Astro.props;
const name = unbidi(Astro.props.name);
---

{
  pictures.length > 0 && (
    <div class="shots" data-shots>
      <ul class="strip" role="list" data-count={Math.min(pictures.length, 3)} aria-label={`${name} screenshots`}>
        {pictures.map((src, i) => (
          <li>
            <a class="shot" href={src} data-shot={i} aria-label={`Screenshot ${i + 1} of ${pictures.length}, larger`}>
              <img src={src} alt={`${name}, screenshot ${i + 1}`} width="1280" height="800" loading={i < 2 ? "eager" : "lazy"} decoding="async" />
            </a>
          </li>
        ))}
      </ul>
      <dialog class="lightbox" aria-label={`${name} screenshots`} closedby="any" data-lightbox>
        <figure>
          <img alt="" data-lightbox-image />
          <figcaption class="num" data-lightbox-caption />
        </figure>
        <form method="dialog" class="close">
          <button aria-label="Close">
            <Glyph name="close" size={16} />
          </button>
        </form>
        {pictures.length > 1 && (
          <>
            <button class="step prev" type="button" aria-label="Previous screenshot" data-step="-1">
              <Glyph name="alt-arrow-left" size={18} />
            </button>
            <button class="step next" type="button" aria-label="Next screenshot" data-step="1">
              <Glyph name="alt-arrow-right" size={18} />
            </button>
          </>
        )}
      </dialog>
    </div>
  )
}

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-shots]")) {
    const dialog = root.querySelector<HTMLDialogElement>("[data-lightbox]");
    const image = root.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const caption = root.querySelector<HTMLElement>("[data-lightbox-caption]");
    const shots = [...root.querySelectorAll<HTMLAnchorElement>("[data-shot]")];
    if (!dialog || !image || !caption || typeof dialog.showModal !== "function") continue;
    let index = 0;
    const show = (i: number) => {
      index = (i + shots.length) % shots.length;
      const thumb = shots[index]!.querySelector("img")!;
      image.src = shots[index]!.href;
      image.alt = thumb.alt;
      caption.textContent = `${index + 1} of ${shots.length}`;
    };
    for (const [i, shot] of shots.entries()) {
      shot.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        show(i);
        dialog.showModal();
      });
    }
    for (const button of dialog.querySelectorAll<HTMLButtonElement>("[data-step]")) {
      button.addEventListener("click", () => show(index + Number(button.dataset.step)));
    }
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") show(index + 1);
      else if (event.key === "ArrowLeft") show(index - 1);
    });
    if (typeof (dialog as { closedBy?: unknown }).closedBy !== "string") {
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
    // Back where it was opened from.
    dialog.addEventListener("close", () => shots[index]?.focus());
  }
</script>

<style>
  /* The strip starts on the content's left edge and runs to the window's
     right edge, so it reads as a row to scroll, not a row that stopped
     short. Two pictures fill the content's width; with more, the next one
     peeks in. (Widths are of the content: its container.) */
  .shots { container-type: inline-size; }
  .strip {
    --gap: 12px;
    display: flex;
    gap: var(--gap);
    margin-right: calc(50% - 50vw);
    padding: 2px var(--gutter) 10px 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  .strip li { flex: none; scroll-snap-align: start; }
  .strip[data-count="1"] li { width: min(100cqw, 760px); }
  .strip[data-count="2"] li { width: calc((100cqw - var(--gap)) / 2); }
  .strip[data-count="3"] li { width: calc((100cqw - var(--gap)) / 2.3); }
  @media (max-width: 700px) {
    .strip[data-count] li { width: 86cqw; }
    .strip[data-count="1"] li { width: 100cqw; }
  }
  .shot { display: block; border-radius: 12px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); transition: box-shadow 0.2s; }
  .shot:hover { box-shadow: 0 0 0 1px var(--line-strong); }
  .shot:focus-visible { outline-offset: 2px; border-radius: 12px; }
  .shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: var(--surface); }

  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; background: transparent; border: 0; color: var(--text); }
  .lightbox::backdrop { background: var(--scrim); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  .lightbox[open] { display: grid; place-items: center; }
  figure { display: grid; justify-items: center; gap: 12px; max-width: calc(100vw - 144px); }
  figure img { max-width: 100%; max-height: calc(100dvh - 120px); width: auto; height: auto; border-radius: 12px; }
  figcaption { font-size: 13px; color: var(--text-3); }
  .close { position: fixed; top: 16px; right: 16px; }
  .close button, .step { display: grid; place-items: center; width: 40px; height: 40px; color: var(--text-2); background: var(--secondary-bg); border-radius: 20px; transition: background-color 0.12s, color 0.12s; }
  .close button:hover, .step:hover { color: var(--text); background: var(--secondary-hover); }
  .step { position: fixed; top: 50%; translate: 0 -50%; }
  .prev { left: 20px; }
  .next { right: 20px; }
  @media (max-width: 700px) {
    figure { max-width: calc(100vw - 32px); }
    .step { top: auto; bottom: 20px; translate: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] figure { animation: shot-in 0.22s var(--ease-out); }
    @keyframes shot-in { from { opacity: 0; scale: 0.98; } }
  }
</style>
