---
// What a plugin asks for, in the app's words and order (the consent sheet,
// apps/zgx/ui/screens/plugins/consent.luau): each ask with its glyph, the
// line under it, and what it names exactly as written; the risky ones last
// and in the danger's ink, and said so plainly above them.
import { details, lines, type Line } from "../../lib/store/permissions.ts";
import type { Permissions } from "../../lib/store/types.ts";
import Glyph from "../ui/Glyph.astro";

interface Props {
  permissions: Permissions;
  /** Who made it, to say whom to trust. */
  author?: string;
  /** Lines to show in place of all its asks (a reviewer's "new since"). */
  only?: Line[];
  heading?: string;
}
const { permissions, author, only, heading = "It asks to:" } = Astro.props;
const shown = only ?? lines(permissions);
const risky = shown.filter((l) => l.risky).length;
const more = only ? [] : details(permissions);
---

<div class="asks">
  {
    risky > 0 && (
      <p class="warning">
        <Glyph name="danger-triangle" size={16} />
        <span>
          {risky === 1 ? "One thing it asks for gives it a lot of reach." : "Some of what it asks for gives it a lot of reach."}{" "}
          {author ? `Install it only if you trust @${author}.` : "Allow it only if you trust who made it."}
        </span>
      </p>
    )
  }
  {
    shown.length === 0 ? (
      <p class="nothing">It asks for nothing beyond running in its own space.</p>
    ) : (
      <>
        <p class="heading">{heading}</p>
        <ul class="lines" role="list">
          {shown.map((line) => (
            <li class:list={["line", { risky: line.risky }]}>
              <Glyph name={line.icon} size={16} />
              <div class="words">
                <p class="title">
                  {line.title}
                  {line.risky && <span class="sr-only"> (gives it a lot of reach)</span>}
                </p>
                {line.detail && <p class="detail">{line.detail}</p>}
                {line.literal && (
                  <ul class="literal" role="list">
                    {line.literal.map((v) => <li>{v}</li>)}
                  </ul>
                )}
                {line.items && (
                  <ul class="items" role="list">
                    {line.items.map((item) => (
                      <li>
                        <code>{item.name}</code>
                        {item.description && <p>{item.description}</p>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      </>
    )
  }
  {
    more.length > 0 && (
      <details class="more">
        <summary>
          <span>Details</span>
          <Glyph name="alt-arrow-down" size={12} />
        </summary>
        {more.map((group) => (
          <div class="group">
            <p class="heading">{group.title}</p>
            <ul class="literal" role="list">
              {group.list.map((v) => <li>{v}</li>)}
            </ul>
          </div>
        ))}
      </details>
    )
  }
</div>

<style>
  .asks { display: grid; gap: 14px; }
  .warning { display: flex; gap: 10px; padding: 10px 12px; font-size: 13.5px; line-height: 1.5; color: var(--tone-danger); background: var(--tone-danger-wash); border-radius: var(--radius-lg); }
  .warning :global(.glyph) { margin-top: 2px; }
  .heading { font-size: 13px; font-weight: 500; color: var(--text-2); }
  .nothing { font-size: 14px; line-height: 1.5; color: var(--text-2); }
  .lines { display: grid; gap: 14px; }
  .line { display: flex; gap: 12px; align-items: flex-start; }
  .line > :global(.glyph) { margin-top: 2px; color: var(--text-2); }
  .words { display: grid; gap: 2px; min-width: 0; }
  .title { font-size: 14px; line-height: 20px; color: var(--text); overflow-wrap: anywhere; }
  .risky .title, .risky > :global(.glyph) { color: var(--tone-danger); }
  .detail { font-size: 13px; line-height: 19px; color: var(--text-2); }
  .literal { display: grid; gap: 2px; margin-top: 2px; font-family: var(--mono); font-size: 12.5px; line-height: 18px; color: var(--text-2); overflow-wrap: anywhere; }
  .items { display: grid; gap: 8px; margin-top: 4px; }
  .items code { font-size: 12.5px; color: var(--text); overflow-wrap: anywhere; }
  .items p { font-size: 13px; line-height: 19px; color: var(--text-2); overflow-wrap: anywhere; }
  .more summary { display: inline-flex; align-items: center; gap: 6px; height: 28px; font-size: 13px; font-weight: 500; color: var(--text-2); cursor: pointer; list-style: none; transition: color 0.12s; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:hover { color: var(--text); }
  .more[open] summary :global(.glyph) { rotate: 180deg; }
  .more summary :global(.glyph) { transition: rotate 0.15s; }
  .group { display: grid; gap: 4px; margin-top: 10px; }
</style>
