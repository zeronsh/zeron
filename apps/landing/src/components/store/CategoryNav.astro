---
// The store's categories, as links that keep the search and the sort: a
// rail beside the results on a wide screen, a row to scroll under the
// search on a narrow one. A page draws both; each shows at its own widths
// only, so a screen reader meets one.
import { catalogHref, type CatalogState } from "../../lib/store/catalog.ts";
import type { Category } from "../../lib/store/types.ts";

interface Props {
  state: CatalogState;
  categories: Category[];
  look: "rail" | "row";
}
const { state, categories, look } = Astro.props;
const keep = { q: state.q, keyword: state.keyword, sort: state.sort };
---

<nav class:list={["categories", look]} aria-label="Categories">
  <a href={catalogHref(keep)} aria-current={!state.category ? "page" : undefined}>All</a>
  {
    categories.map((c) => (
      <a href={catalogHref({ ...keep, category: c.id })} aria-current={state.category === c.id ? "page" : undefined}>
        {c.name}
      </a>
    ))
  }
</nav>

<style>
  a { display: flex; align-items: center; flex: none; font-size: 14px; font-weight: 500; color: var(--text-2); transition: background-color 0.12s, color 0.12s, box-shadow 0.12s; }
  a:hover { color: var(--text); }

  /* The rail: the app's menu rows, a wash under the pointer, firmer on the one shown; their words on the page's edge. */
  .rail { position: sticky; top: 24px; display: grid; gap: 2px; margin-left: -12px; }
  .rail a { height: 34px; padding: 0 12px; border-radius: var(--radius-lg); }
  .rail a:hover { background: var(--hover); }
  .rail a[aria-current="page"] { color: var(--text); background: var(--selected); }

  /* The row: pills to scroll, edge to edge, starting on the page's edge. */
  .row { display: none; gap: 6px; margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter); overflow-x: auto; scrollbar-width: none; }
  .row a { height: 32px; padding: 0 14px; background: var(--surface); border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); }
  .row a:hover { background: var(--surface-raised); }
  .row a[aria-current="page"] { color: var(--primary-text); background: var(--primary-bg); box-shadow: none; }

  @media (max-width: 800px) {
    .rail { display: none; }
    .row { display: flex; }
  }
</style>
