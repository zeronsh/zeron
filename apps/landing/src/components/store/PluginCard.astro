---
// A plugin in a list: its tile, its name (the link: the whole card follows
// it), who made it, what it does, and how many use it.
import type { PluginCard } from "../../lib/store/types.ts";
import { installs } from "../../lib/store/format.ts";
import { pluginUrl } from "../../lib/store/urls.ts";
import Glyph from "../ui/Glyph.astro";
import PluginTile from "./PluginTile.astro";

interface Props {
  plugin: PluginCard;
  /** Category names by id, to say the first one. */
  categories: Map<string, string>;
  /** The heading level the list puts its cards at. */
  level?: 2 | 3;
}
const { plugin, categories, level = 3 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const category = plugin.categories.map((id) => categories.get(id)).find(Boolean);
---

<article class="plugin card">
  <div class="head">
    <PluginTile id={plugin.id} name={plugin.name} icon={plugin.icon} version={plugin.version} size={40} />
    <div class="title">
      <Heading class="name"><a class="follow" href={pluginUrl(plugin.id)}>{plugin.name}</a></Heading>
      <p class="by">by @{plugin.author.username}</p>
    </div>
  </div>
  <p class="summary">{plugin.summary}</p>
  <p class="meta">
    <span class="num"><Glyph name="download" size={12} />{installs(plugin.installs)}</span>
    {category && <span>{category}</span>}
  </p>
</article>

<style>
  .plugin { padding: 20px; gap: 14px; transition: background-color 0.2s; }
  .plugin:hover { background: linear-gradient(180deg, #141416 0%, #0e0e10 100%); }
  .plugin:has(.follow:focus-visible)::after { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 80%, white), 0 0 0 3px color-mix(in srgb, var(--accent) 28%, transparent); }
  .head { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .title { min-width: 0; }
  .name { font-size: 15.5px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* The whole card follows the name's link; its ring shows where keys are. */
  .follow::before { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .follow:focus-visible { outline: none; }
  .by { margin-top: 1px; font-size: 13px; line-height: 1.4; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: calc(2 * 1.5em);
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; margin-top: auto; font-size: 12.5px; color: var(--text-3); }
  .meta span { display: inline-flex; align-items: center; gap: 5px; }
</style>
