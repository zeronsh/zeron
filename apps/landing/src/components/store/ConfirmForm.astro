---
// The answer to "are you sure?": a form that posts the action with the
// session's token, and a way back. In a dialog, Cancel closes it; on its
// own page (no script), Cancel is a link back to where you were.
import Action from "../ui/Action.astro";

interface Props {
  action: string;
  csrf: string;
  confirm: string;
  tone?: "primary" | "danger";
  /** "dialog": inside a <dialog>; "page": the page that asks without a script. */
  mode: "dialog" | "page";
  /** Where Cancel goes on a page. */
  back: string;
}
const { action, csrf, confirm, tone = "primary", mode, back } = Astro.props;
---

<form method="post" action={action} class="confirm">
  <input type="hidden" name="csrf" value={csrf} />
  <slot />
  <div class="answers">
    {
      mode === "dialog" ? (
        <Action tone="secondary" type="submit" formmethod="dialog" formnovalidate autofocus>Cancel</Action>
      ) : (
        <a class="cancel" href={back}>Cancel</a>
      )
    }
    <Action tone={tone}>{confirm}</Action>
  </div>
</form>

<style>
  .confirm { display: grid; gap: 16px; }
  .answers { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-top: 8px; }
  .cancel { display: inline-flex; align-items: center; height: 32px; padding: 0 12px; font-size: 14px; font-weight: 500; color: var(--text); background: var(--secondary-bg); border-radius: var(--radius-lg); transition: background-color 0.12s; }
  .cancel:hover { background: var(--secondary-hover); }
</style>
