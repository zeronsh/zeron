---
// A plugin's tile (lib/store/tile.ts). The icon is drawn through the page's
// ink filter (StoreLayout's defs), so an SVG its author drew in any colour
// shows in the text's, as the app tints it.
import { corner, hue, initial } from "../../lib/store/tile.ts";
import { fileUrl } from "../../lib/store/urls.ts";

interface Props {
  id: string;
  name: string;
  /** The icon's path in the package, and the version it's from. */
  icon: string | null;
  version: string;
  size: 32 | 40 | 48 | 64 | 80;
  class?: string;
}
const { id, name, icon, version, size, class: className } = Astro.props;
const src = icon ? fileUrl(id, version, icon) : null;
---

{
  src ? (
    <span class:list={["tile", `s${size}`, corner(size), "glyph-tile", className]} aria-hidden="true">
      <svg viewBox="0 0 100 100" focusable="false">
        <image href={src} x="21" y="21" width="58" height="58" filter="url(#store-ink)" preserveAspectRatio="xMidYMid meet" />
      </svg>
    </span>
  ) : (
    <span class:list={["tile", `s${size}`, corner(size), "hued", `hue-${hue(id)}`, className]} aria-hidden="true">
      {initial(name)}
    </span>
  )
}

<style>
  .tile {
    display: inline-grid;
    place-items: center;
    flex: none;
    overflow: hidden;
    font-weight: 600;
    line-height: 1;
    user-select: none;
  }
  .s32 { width: 32px; height: 32px; font-size: 14px; }
  .s40 { width: 40px; height: 40px; font-size: 17px; }
  .s48 { width: 48px; height: 48px; font-size: 20px; }
  .s64 { width: 64px; height: 64px; font-size: 27px; }
  .s80 { width: 80px; height: 80px; font-size: 33px; }
  .sm { border-radius: var(--radius-sm); }
  .md { border-radius: var(--radius-md); }
  .xl { border-radius: var(--radius-xl); }
  /* The quiet wash, a faint hairline so it holds its shape on any card. */
  .glyph-tile { background: var(--secondary-bg); box-shadow: inset 0 0 0 1px var(--border-subtle); }
  .glyph-tile svg { width: 100%; height: 100%; }
  .hue-indigo { background: var(--hue-indigo); color: var(--hue-indigo-ink); }
  .hue-rose { background: var(--hue-rose); color: var(--hue-rose-ink); }
  .hue-sky { background: var(--hue-sky); color: var(--hue-sky-ink); }
  .hue-emerald { background: var(--hue-emerald); color: var(--hue-emerald-ink); }
  .hue-amber { background: var(--hue-amber); color: var(--hue-amber-ink); }
  .hue-violet { background: var(--hue-violet); color: var(--hue-violet-ink); }
  .hue-orange { background: var(--hue-orange); color: var(--hue-orange-ink); }
  .hue-teal { background: var(--hue-teal); color: var(--hue-teal-ink); }
</style>
