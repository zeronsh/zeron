---
import ChartReply from "../app/ChartReply.astro";
import SessionWindow from "../app/SessionWindow.astro";
---

<section class="section" id="review">
  <div class="wrap">
    <h2 class="statement"><b>Review the work without leaving the conversation.</b> See what an agent changed and what it found, and commit from the same window.</h2>
    <div class="bento">
      <article class="card span-7">
        <div class="card-copy">
          <h3>Review changes as they are made</h3>
          <p>Read the diff of every file an agent touches, stage the changes you want and commit them from the session.</p>
        </div>
        <div class="card-visual"><SessionWindow class="piece diff" crop={[809, 131, 497, 254]} decorative /></div>
      </article>
      <article class="card span-5">
        <div class="card-copy">
          <h3>Get answers as charts and tables</h3>
          <p>Agents can reply with charts, tables and diagrams, which Zeron draws natively in your theme.</p>
        </div>
        <div class="card-visual"><ChartReply class="piece whole reply" /></div>
      </article>
    </div>
  </div>
</section>

<style>
  /* The reply stands on the app's own page colour. */
  :global(.piece.reply) { background: #161618; }
  @media (max-width: 700px) {
    :global(.piece.diff) { --zw: 390 !important; --zh: 330 !important; }
  }
</style>
