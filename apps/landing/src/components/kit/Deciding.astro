---
// On a page that decides something about a plugin (a question without the
// script, or a link followed from elsewhere): what is being decided, so
// nobody decides it blind, and a way to read it first. When the browser
// says the visit came from another site, it says so plainly.
import { unbidi } from "../../lib/store/format.ts";
import PluginTile from "../store/PluginTile.astro";
import Glyph from "../ui/Glyph.astro";

interface Props {
  id: string;
  name: string;
  icon: string | null;
  version: string | null;
  /** Its facts, one line: who sent it, new or an update, what the checks found. */
  facts: string[];
  /** Where to read it all first. */
  read: string;
  /** The visit came from another site (Sec-Fetch-Site). */
  fromElsewhere: boolean;
}
const { id, icon, version, facts, read, fromElsewhere } = Astro.props;
const name = unbidi(Astro.props.name);
---

<div class="deciding">
  {
    fromElsewhere && (
      <p class="elsewhere">
        <Glyph name="danger-triangle" size={16} />
        <span>You followed a link from somewhere else to this question. Read what you're deciding before you answer.</span>
      </p>
    )
  }
  <div class="what">
    <PluginTile id={id} name={name} icon={icon} version={version} size={32} />
    <div class="words">
      <p class="name">{name}{version && <> <span class="t-mono">{version}</span></>}</p>
      <p class="facts-line">{facts.join(" · ")}</p>
    </div>
  </div>
  <a class="read" href={read}>Read it first<Glyph name="alt-arrow-right" size={12} /></a>
</div>
