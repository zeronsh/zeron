---
// Plugins as rows of the table system (styles/app.css .plugins): the plugin
// (tile, name, its line) takes what is left; by 160; category 144; the
// measure the list is ordered by at the right, its head naming it. A row is
// one link. All plugins draws a page of them, with rows to hold their places
// while the next loads; Discover, a short list.
import { CATEGORIES } from "../../lib/store/nav.ts";
import type { PluginCard } from "../../lib/store/types.ts";
import { pluginUrl } from "../../lib/store/urls.ts";
import { store } from "../../lib/store/words.ts";
import PluginTile from "../store/PluginTile.astro";

export interface Measure {
  head: string;
  cell: (p: PluginCard) => string;
  /** The same, said in the phone's folded line ("Published Nov 3"). */
  folded: (p: PluginCard) => string;
}

interface Props {
  items: PluginCard[];
  caption: string;
  measure: Measure;
  /** The edge's names for categories, past the app's fixed list. */
  names?: ReadonlyMap<string, string>;
  /** Rows the same heights that hold their places while the next page loads. */
  skeleton?: boolean;
}
const { items, caption, measure, names, skeleton = false } = Astro.props;
// Categories by the app's names (the fixed list), else the edge's. A row
// shows the one its plugin is filed under first.
const categoryName = (id: string) => CATEGORIES.find((c) => c.id === id)?.label ?? names?.get(id) ?? id;
---

<table class="table comfortable plugins">
  <caption class="sr-only">{caption}</caption>
  <colgroup><col /><col class="by" /><col class="category" /><col class="installs" /></colgroup>
  <thead>
    <tr><th scope="col">Plugin</th><th scope="col">By</th><th scope="col">{store("plugins.store.fact.category")}</th><th scope="col" class="end">{measure.head}</th></tr>
  </thead>
  <tbody class="rows">
    {items.map((p) => (
      <tr>
        <td>
          <span class="cell-main">
            <PluginTile id={p.id} name={p.name} icon={p.icon} version={p.version} size={32} class="plugin-tile" />
            <span class="cell-words">
              <a class="name name-link" href={pluginUrl(p.id)}>{p.name}</a>
              <span class="line">{p.summary}</span>
              <span class="meta">{p.author.username ? `@${p.author.username}` : "Unnamed author"} · {measure.folded(p)}</span>
            </span>
          </span>
        </td>
        <td class="by">{p.author.username ? `@${p.author.username}` : "—"}</td>
        <td class="category">{p.categories[0] ? categoryName(p.categories[0]) : "—"}</td>
        <td class="installs end">{measure.cell(p)}</td>
      </tr>
    ))}
  </tbody>
  {
    skeleton && (
      <tbody class="skeleton-rows" aria-hidden="true">
        {items.map(() => (
          <tr>
            <td><span class="cell-main"><span class="skeleton sk-tile" /><span class="sk-words"><span class="skeleton sk-name" /><span class="skeleton sk-line" /></span></span></td>
            <td class="by"><span class="skeleton sk-short" /></td>
            <td class="category"><span class="skeleton sk-short" /></td>
            <td class="installs end"><span class="skeleton sk-num" /></td>
          </tr>
        ))}
      </tbody>
    )
  }
</table>
