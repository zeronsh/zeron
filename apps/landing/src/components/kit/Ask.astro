---
// A question before something that can't simply be taken back (Withdraw,
// Stop new installs, Revoke): the sheet's dialog (styles/app.css), its
// words the app's (lib/store/actions.ts). Cancel first, and focused. Its
// opener is a link to the same question as a page (Confirm.astro), so
// without the script nothing is lost; with it, the link opens this.
import type { Ask } from "../../lib/store/actions.ts";
import { unbidi } from "../../lib/store/format.ts";

interface Props {
  id: string;
  ask: Ask;
  /** Where the form posts. */
  action: string;
  csrf: string;
}
const { id, ask, action, csrf } = Astro.props;
---

<dialog class="dialog sm" id={id} aria-labelledby={`${id}-title`} closedby="any">
  <form method="post" action={action}>
    <input type="hidden" name="csrf" value={csrf} />
    <div class="head">
      <h2 id={`${id}-title`}>{unbidi(ask.title)}</h2>
      {ask.words.map((w) => <p>{w}</p>)}
    </div>
    <div class="answers">
      <button class="btn secondary" type="submit" formmethod="dialog" formnovalidate autofocus>Cancel</button>
      <button class:list={["btn", ask.tone === "danger" ? "danger" : "primary"]} type="submit">{ask.confirm}</button>
    </div>
  </form>
</dialog>
