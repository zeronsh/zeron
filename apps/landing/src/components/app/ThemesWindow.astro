---
// The same session with its panel closed, in each theme the app was
// captured in (themes.themes.json), with the window's frosted glass kept:
// every surface carries the alpha the app drew, so what is behind the
// window shows through it. Generated by tools/recreate, as SessionWindow.
// The stage's class (t0, t1, …) picks the theme.
import fragment from "./themes.fragment.html?raw";
import "./themes.icons.css";
import "./themes.vars.css";
import "./zw.css";

interface Props {
  id?: string;
  crop?: [number, number, number, number];
  class?: string;
}
const { id, crop = [0, 0, 1320, 840], class: className } = Astro.props;
const [x, y, w, h] = crop;
const label = "Zeron with its frosted glass window: the sidebar's projects and sessions, and a conversation with Claude Code, in the chosen theme.";
---

<div class:list={["zw-fit", className]} style={`--zx:${x};--zy:${y};--zw:${w};--zh:${h}`}>
  <div id={id} class="zw zw-themes t0" role="img" aria-label={label} set:html={fragment} />
</div>
