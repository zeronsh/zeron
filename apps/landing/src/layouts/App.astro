---
// Zeron Plugins: the app's window, in a browser. Two cards set into the
// window 4 apart, as the desktop app's are: its list down the side (the
// Settings list's rows), and the page, which scrolls on its own under a
// slim header (its title, or where it is, at the left; its controls at the
// right). On a phone, a top bar and the list in a drawer.
//
// Public pages are the same for everyone (kept by shared caches), so the
// list's foot (you) and the staff's group are filled in by scripts/app.ts
// after the page has loaded; `session` given (an account or admin page,
// never kept), they are drawn here. (A face is the name's initial: a
// picture from elsewhere would need the pages' CSP opened to it.)
import Glyph from "../components/ui/Glyph.astro";
import Mark from "../components/ui/Mark.astro";
import Head from "../components/site/Head.astro";
import { BROWSE, CATEGORIES, PUBLISH, REVIEW, type NavItem } from "../lib/store/nav.ts";
import { signInUrl } from "../lib/store/urls.ts";
import { store } from "../lib/store/words.ts";
import type { WebSession } from "../lib/store/types.ts";
import "../styles/app.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonical?: string;
  /** The list's row this page is (null: none, a plugin's page say). */
  current?: string | null;
  /** Undefined on a public page (the script fills in who you are); null or a session on a private one. */
  session?: WebSession | null;
}
const { title, description, noindex = false, canonical, current = null, session } = Astro.props;
const isPublic = session === undefined;
const staff = session?.roles.includes("admin") ?? false;
const here = `${Astro.url.pathname}${Astro.url.search}`;
const name = session ? (session.username ? `@${session.username}` : (session.user.name ?? "You")) : "";
const initial = (session?.username ?? session?.user.name ?? "?").replace(/^@/, "").charAt(0).toUpperCase();
const row = (item: NavItem) => ({ ...item, on: item.id === current });
---

<!doctype html>
<html lang="en" class="app">
  <head>
    <Head title={title} description={description} noindex={noindex} canonical={canonical} />
    <slot name="head" />
    <!-- Without the script, the list's foot says "Sign in" plainly. -->
    <noscript><style>.account.is-pending .name{color:inherit}.account.is-pending .name::before{display:none}</style></noscript>
  </head>
  <body>
    <header class="topbar">
      <a class="btn ghost icon" href="#nav" data-drawer-open aria-label="Menu" aria-controls="nav"><Glyph name="list" size={16} /></a>
      <a class="brand" href="/plugins"><Mark /><span>Plugins</span></a>
      <span class="spacer"></span>
      <a class="btn ghost icon" href="/plugins/all#search" data-search-open aria-label={store("plugins.store.search")}><Glyph name="magnifer" size={16} /></a>
    </header>

    <div class="shell">
      <nav class="sidebar" id="nav" aria-label="Plugins">
        <div class="sidebar-scroll">
          <a class="brand" href="/plugins"><Mark /><span>Plugins</span></a>
          <form class="field sm search" role="search" action="/plugins/all" method="get" data-tidy>
            <Glyph name="magnifer" size={14} />
            <input type="search" name="q" placeholder={store("plugins.store.search")} aria-label={store("plugins.store.search")} autocomplete="off" data-search />
            <kbd class="kbd" aria-hidden="true">/</kbd>
          </form>
          <div class="nav">
            <p class="nav-heading">{store("plugins.store.browse")}</p>
            {BROWSE.map(row).map((item) => (
              <a class="nav-row" href={item.href} aria-current={item.on ? "page" : undefined}><Glyph name={item.icon} size={16} /><span>{item.label}</span></a>
            ))}
            {CATEGORIES.map(row).map((item) => (
              <a class="nav-row" href={item.href} aria-current={item.on ? "page" : undefined}><Glyph name={item.icon} size={16} /><span>{item.label}</span></a>
            ))}
            <p class="nav-heading">Publish</p>
            {PUBLISH.map(row).map((item) => (
              <a class="nav-row" href={item.href} aria-current={item.on ? "page" : undefined}><Glyph name={item.icon} size={16} /><span>{item.label}</span></a>
            ))}
            {(staff || isPublic) && (
              <div class="nav" data-staff hidden={isPublic}>
                <p class="nav-heading">Review</p>
                {REVIEW.map(row).map((item) => (
                  <a class="nav-row" href={item.href} aria-current={item.on ? "page" : undefined}><Glyph name={item.icon} size={16} /><span>{item.label}</span></a>
                ))}
              </div>
            )}
          </div>
        </div>
        <div class="sidebar-foot">
          {
            session ? (
              <a class="account" href="/account">
                <span class="avatar" aria-hidden="true">{initial}</span>
                <span class="name">{name}</span>
              </a>
            ) : (
              <a class:list={["account", { "is-pending": isPublic }]} href={signInUrl(here)} data-account>
                <span class="avatar" aria-hidden="true"><Glyph name="user-rounded" size={14} /></span>
                <span class="name">Sign in</span>
              </a>
            )
          }
          <p class="colophon"><a href="/">zeron.sh</a><span aria-hidden="true">·</span><a href="/privacy">Privacy</a><span aria-hidden="true">·</span><a href="/#downloads">Download</a></p>
        </div>
      </nav>

      <main class="page" id="main">
        <header class="page-head">
          <div class="lead"><slot name="title" /></div>
          {Astro.slots.has("tools") && <div class="tools"><slot name="tools" /></div>}
        </header>
        <div class="page-body"><slot /></div>
      </main>
    </div>
    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
