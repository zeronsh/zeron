---
import Footer from "../components/site/Footer.astro";
import Head from "../components/site/Head.astro";
import Nav from "../components/site/Nav.astro";
import { SITE } from "../data/site.ts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Where the nav's Download goes on this page. */
  downloads?: string;
  /** The landing page counts its own views (public/telemetry.js). */
  telemetry?: boolean;
}
const { title = SITE.title, description = SITE.description, downloads, telemetry = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {telemetry && <script is:inline defer src="/telemetry.js"></script>}
  </head>
  <body>
    <Nav downloads={downloads} />
    <main><slot /></main>
    <Footer />
    <script>
      import "../scripts/downloads.ts";

      // Parts marked data-reveal rise in the first time they are reached.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      for (const el of document.querySelectorAll("[data-reveal]")) io.observe(el);
    </script>
  </body>
</html>
