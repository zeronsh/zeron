---
// The plugin store's pages: the site's head, nav and footer, without the
// landing page's inline scripts (these pages allow no inline script; see
// lib/store/security.ts), with the store's stylesheet and its one script.
import Footer from "../components/site/Footer.astro";
import Head from "../components/site/Head.astro";
import Nav from "../components/site/Nav.astro";
import Toast from "../components/ui/Toast.astro";
import "../styles/global.css";
import "../styles/store.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonical?: string;
  /** A page for doing (account, admin): it opens closer under the nav. */
  tool?: boolean;
  /** What just happened (a flash after a form), said once. */
  toast?: { message: string; tone?: "success" | "danger" } | null;
}
const { title, description, noindex = false, canonical, tool = false, toast = null } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} noindex={noindex} canonical={canonical} />
    <slot name="head" />
  </head>
  <body>
    <Nav downloads="/#downloads" stars={false} />
    <main class:list={["store", { tool }]}><slot /></main>
    <Footer />
    <Toast message={toast?.message ?? null} tone={toast?.tone} />
    <!-- Icons a plugin ships are drawn through this: any colour in, the text's ink out. -->
    <svg class="store-defs" aria-hidden="true" focusable="false">
      <filter id="store-ink" color-interpolation-filters="sRGB">
        <feFlood flood-color="currentColor" result="ink"></feFlood>
        <feComposite in="ink" in2="SourceGraphic" operator="in"></feComposite>
      </filter>
    </svg>
    <script>
      import "../scripts/store.ts";
    </script>
  </body>
</html>

<style>
  .store-defs { position: absolute; width: 0; height: 0; overflow: hidden; color: var(--text); }
</style>
