---
// One version of a plugin, its own page (any listed or stopped version can
// be seen; amendment 45): which it is and whether Zeron verified it,
// Install for that very version (the link that names it; the newest's is
// the plain one), its notes set to be read, and its facts. One that takes
// no new installs says why, and can't be installed. A version not in the
// store (never published, taken down or removed) says only that.
import Get from "../../../../components/look/Get.astro";
import Icon from "../../../../components/look/Icon.astro";
import NotHere from "../../../../components/look/NotHere.astro";
import Seal from "../../../../components/look/Seal.astro";
import Tile from "../../../../components/look/Tile.astro";
import Store from "../../../../layouts/Store.astro";
import "../../../../styles/look/plugin.css";
import { bytes, compatibility, date, day } from "../../../../lib/store/format.ts";
import { pluginTag, publicPage } from "../../../../lib/store/http.ts";
import { hueClass } from "../../../../lib/store/hue.ts";
import { isPluginId, isPrerelease, isVersion, versionParam } from "../../../../lib/store/names.ts";
import { drawn, keepable } from "../../../../lib/store/rendered.ts";
import { satisfies } from "../../../../lib/store/semver.ts";
import { stoppedWhy } from "../../../../lib/store/states.ts";
import { fileUrl, pluginUrl } from "../../../../lib/store/urls.ts";
import { statusWords, store } from "../../../../lib/store/words.ts";

export const prerender = false;

const id = Astro.params.id ?? "";
const version = versionParam(Astro.params.version) ?? "";
const edge = Astro.locals.edge;
const [plugin, found, latestZeron] = isPluginId(id) ? await Promise.all([edge.plugin(id), isVersion(version) ? edge.version(id, version) : null, edge.latestRelease()]) : [null, null, null];
const pluginMissing = !plugin || (!plugin.ok && plugin.error === "not_found") || (plugin.ok && !plugin.data.version);
// (A record that names another version is a version not in the store: the page says only what the record names.)
const versionMissing = !pluginMissing && (!found || (!found.ok && found.error === "not_found") || (found.ok && found.data.version !== version));
const down = !pluginMissing && !versionMissing && (!plugin!.ok || !found!.ok);
const p = !pluginMissing && plugin!.ok ? plugin!.data : null;
const v = found?.ok && !versionMissing ? found.data : null;

let notes = "";
if (p && v) {
  // (Drawn once and kept by its text, as the plugin page draws it: rendered.ts.)
  const cf = (Astro.locals as { cfContext?: { waitUntil(p: Promise<unknown>): void } }).cfContext;
  const out = v.notes ? await drawn(Astro.url.origin, id, v.version, "notes", v.notes, { file: (path) => fileUrl(id, v.version, path), demote: true }, { keep: true, waitUntil: cf ? (x) => cf.waitUntil(x) : undefined }) : null;
  notes = out?.html ?? "";
  if (!out || keepable([out])) publicPage(Astro, [pluginTag(id)]);
  else Astro.response.headers.set("cache-control", "no-store");
} else Astro.response.status = down ? 503 : 404;

const now = Date.now();
const newest = p && v ? p.version === v.version : false;
const engines = v?.engines ?? p?.engines ?? null;
const off = v && latestZeron && satisfies(latestZeron, engines?.zeron) === false ? { needs: engines?.zeron, latest: latestZeron } : null;
const base = pluginUrl(id);
---

{
  p && v ? (
    <Store title={`${p.name} ${v.version} · Plugins · Zeron`} description={`${p.name} ${v.version}, a plugin for Zeron${v.verified ? ", verified by Zeron" : ""}.`} canonical={`${base}/versions/${encodeURIComponent(v.version)}`} current="browse" class={hueClass(id)}>
      <div class="wrap">
        <nav class="crumbs" aria-label="Where this is">
          <a href="/plugins">Plugins</a><Icon name="chev" /><a href={base}>{p.name}</a><Icon name="chev" /><a href={`${base}/versions`}>Versions</a>
        </nav>
        <header class="head one">
          <Tile id={p.id} name={p.name} icon={p.icon} version={p.version} size="l" />
          <div class="txt">
            <h1><span class="name">{p.name}</span> <b class="vnum mono">{v.version}</b></h1>
            <p class="by">
              <span>{newest ? "Its newest version" : `Published ${date(v.published_at)}`}</span>
              {newest && <><i aria-hidden="true"></i><span>Published {date(v.published_at)}</span></>}
              {isPrerelease(v.version) && <><i aria-hidden="true"></i><span>Pre-release</span></>}
            </p>
          </div>
          {v.yanked ? (
            <div class="get">
              <span class="btn pri lg" aria-disabled="true">Can't be installed</span>
              <div class="ver"><b class="mono">{v.version}</b><span class="state quiet">{statusWords("yanked")}</span></div>
              <p class="note quiet">{stoppedWhy(v)}</p>
            </div>
          ) : (
            <Get id={p.id} name={p.name} version={v.version} newest={newest} verified={v.verified} verifiedAt={v.verified_at} publishedAt={v.published_at} verifiedVersion={v.verified || p.verified_version === v.version ? null : p.verified_version} off={off} />
          )}
        </header>
        <div class="cols2 after-head">
          <div>
            <h2 class="sec-title">What changed in {v.version}</h2>
            {notes.trim() ? <article class="prose" set:html={notes} /> : <p class="prose t2">Its author wrote no notes for this version.</p>}
            <p class="back"><a class="more" href={`${base}/versions`}><Icon name="left" /><span class="name">Every version of {p.name}</span></a></p>
          </div>
          <aside class="rail" aria-label="About this version">
            <section aria-labelledby="rail-version">
              <h2 class="rail-h" id="rail-version">This version</h2>
              <dl class="facts">
                <dt>Verified</dt>
                <dd>{v.verified ? <span class="okline"><Seal size="s" quiet />{v.verified_at !== null ? `On ${day(v.verified_at, now)}` : store("plugins.store.verified")}</span> : store("plugins.store.review.waiting")}</dd>
                <dt>Published</dt><dd>{date(v.published_at)}</dd>
                <dt>{store("plugins.store.fact.works_with")}</dt><dd>{compatibility(engines?.zeron)}</dd>
                {v.bytes !== undefined && <><dt>Size</dt><dd class="num">{bytes(v.bytes)}</dd></>}
              </dl>
            </section>
            <div class="rule" aria-hidden="true"></div>
            <ul class="links">
              <li><a href={base}><Icon name="arrow" />{p.name}'s page</a></li>
              <li><a href={`${base}/report`}><Icon name="flag" />Report this plugin</a></li>
            </ul>
          </aside>
        </div>
      </div>
    </Store>
  ) : (
    <NotHere state={down ? "down" : "missing"} what={versionMissing ? "version" : "plugin"} retry={Astro.url.pathname} back={versionMissing && p ? { href: base, name: p.name } : undefined} />
  )
}
