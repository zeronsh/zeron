---
// Browse (the prototype's browse page): every listed plugin, a category's,
// a keyword's, a search's, or only the verified, a page at a time by the
// edge's cursor. Beside the list, where you are and how to narrow it: the
// categories with how many each holds, Everything or Verified only, and the
// category's keywords. Every filter, order and page is a link (the whole
// state is the address), so it works without a script and can be shared.
// On a phone the categories stay a row of chips, and the order and the
// filters fold into two disclosures (a details each: no script).
//
// Public and the same for everyone (no cookie read), so the Worker cache
// keeps each address for half a minute and serves it stale for another.
import Icon from "../../components/look/Icon.astro";
import Seal from "../../components/look/Seal.astro";
import Tile from "../../components/look/Tile.astro";
import Store from "../../layouts/Store.astro";
import "../../styles/look/browse.css";
import { canonicalSearch, catalogHref, effectiveSort, PAGE_SIZE, pageHref, range, readCatalog, SORT_LABELS, type CatalogState } from "../../lib/store/catalog.ts";
import { count, day } from "../../lib/store/format.ts";
import { hueClass } from "../../lib/store/hue.ts";
import { CATALOG_TAG, publicPage } from "../../lib/store/http.ts";
import { CATEGORIES } from "../../lib/store/nav.ts";
import type { Category, PluginCard, Sort } from "../../lib/store/types.ts";
import { pluginUrl } from "../../lib/store/urls.ts";
import { categoryLine, EMPTY_BODY, store } from "../../lib/store/words.ts";
import { lsb } from "../../lib/store/bearing.ts";

export const prerender = false;

const edge = Astro.locals.edge;
const categoriesResult = await edge.categories();
const categories = categoriesResult.ok ? categoriesResult.data.categories : [];
const state = readCatalog(Astro.url.searchParams, categoriesResult.ok ? categories : null);

// An address that says more than it means is sent to the one that says it plainly.
const canonical = canonicalSearch(Astro.url.searchParams, state);
if (canonical && categoriesResult.ok) return Astro.redirect(canonical, 301);

const sort = effectiveSort(state);
const [page, stats, keywordsResult] = await Promise.all([
  edge.catalog({ q: state.q || undefined, category: state.category ?? undefined, keyword: state.keyword ?? undefined, verified: state.verified || undefined, sort, cursor: state.cursor ?? undefined, limit: PAGE_SIZE }),
  edge.stats(),
  edge.keywords({ category: state.category ?? undefined, limit: 12 }),
]);

// A cursor from another search, or an old one: this search's first page.
if (!page.ok && page.error === "bad_cursor") return Astro.redirect(catalogHref({ ...state, cursor: null }), 303);
if (page.ok) publicPage(Astro, [CATALOG_TAG]);
else Astro.response.status = page.error === "bad_request" ? 400 : 503;

// Categories by the app's names (the fixed list), each with the edge's count; else the site's list alone.
const shelf = (categoriesResult.ok ? categories : CATEGORIES.map((c): Category => ({ id: c.id, name: c.label }))).map((c) => ({ ...c, name: CATEGORIES.find((x) => x.id === c.id)?.label ?? c.name }));
const categoryName = (id: string) => shelf.find((c) => c.id === id)?.name ?? id;
const items = page.ok ? page.data.items : [];
const next = page.ok ? pageHref(state, page.data.next_cursor) : null;
const previous = page.ok ? (page.data.prev_cursor ? pageHref(state, page.data.prev_cursor, -1) : state.cursor ? catalogHref({ ...state, cursor: null, page: null }) : null) : null;
// How many the query matches (amendment 38's total: this page's own), and which of them this page is.
const total = page.ok ? page.data.total : undefined;
const shown = page.ok ? range(state, items.length) : null;
// The category's keywords, most used first; the one chosen kept in the list even when it isn't among them.
const keywords = keywordsResult.ok ? keywordsResult.data.keywords.map((k) => k.keyword) : [];
if (state.keyword && !keywords.includes(state.keyword)) keywords.unshift(state.keyword);

// The orders Browse offers, in the app's words; "Newly verified" (Discover's shelf) only when it's the one asked.
const sorts: Sort[] = [...(["relevance", "popular", "updated", "new"] as const).filter((s) => s !== "relevance" || state.q), ...(sort === "verified" ? (["verified"] as const) : [])];
const sortLabel = (s: Sort) => (s === "verified" ? SORT_LABELS.verified : store(`plugins.store.sort.${s}`));
const at = (change: Partial<CatalogState>) => catalogHref({ ...state, ...change, cursor: null, page: null });

const heading = state.q ? `Results for “${state.q}”` : state.category ? categoryName(state.category) : state.keyword ? `Tagged “${state.keyword}”` : state.verified ? "Verified plugins" : "All plugins";
const lead = state.q
  ? `Plugins whose name, summary, keywords or author match${state.category ? `, in ${categoryName(state.category)}` : ""}.`
  : state.category
    ? (categoryLine(state.category) ?? `Plugins for Zeron in ${categoryName(state.category)}.`)
    : state.keyword
      ? `Plugins whose authors tagged them “${state.keyword}”.`
      : state.verified
        ? "Plugins whose newest version Zeron has verified."
        : "Everything people have published for Zeron, each saying whether Zeron verified it.";
const title = state.q ? `“${state.q}” · Plugins · Zeron` : state.category ? `${categoryName(state.category)} plugins · Zeron` : "All plugins · Zeron";
const description = state.category ? `Plugins for Zeron in ${categoryName(state.category)}, each saying whether Zeron verified it.` : "Every plugin for Zeron: panels, commands, tools for your agents and more, each saying whether Zeron verified it.";
// Search results and later pages stay out of search engines; the list and its categories don't.
const noindex = Boolean(state.q || state.cursor || state.keyword || state.verified);
const here = `${Astro.url.pathname}${Astro.url.search}`;
/** How many filters past the category are on (the phone's Filters says so). */
const filtering = Number(state.verified) + Number(Boolean(state.keyword));
/** A card's foot: what the list is sorted by, said (installs; when updated, first published or verified). */
const when = (p: PluginCard) =>
  sort === "new" && p.listed_at !== null ? `Published ${day(p.listed_at)}` : sort === "verified" && p.verified_at ? `Verified ${day(p.verified_at)}` : `Updated ${day(p.updated_at)}`;
---

<Store title={title} description={description} noindex={noindex} canonical={catalogHref({ category: state.category })} current="browse" query={state.q}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Where this is">
      <a href="/plugins">Plugins</a><Icon name="chev" /><a href="/plugins/all">Browse</a>
      {state.category && <><Icon name="chev" /><a href={catalogHref({ category: state.category })}>{categoryName(state.category)}</a></>}
    </nav>
    <header class="bhead">
      <div>
        <h1 class={lsb(heading)}>{heading}</h1>
        <p class="lead">{lead}</p>
      </div>
    </header>

    <div class="browse">
      <aside class="facets" aria-label="Narrow the list">
        <div>
          <h2 class="facet-h">Category</h2>
          <nav class="catlist" aria-label="Categories">
            <a href={at({ category: null })} aria-current={!state.category ? "page" : undefined}><span>All</span>{stats.ok && <span class="num">{count(stats.data.plugins)}</span>}</a>
            {shelf.map((c) => (
              <a href={at({ category: c.id })} aria-current={state.category === c.id ? "page" : undefined}><span>{c.name}</span>{c.count !== undefined && <span class="num">{count(c.count)}</span>}</a>
            ))}
          </nav>
        </div>
        <div class="wide-facet">
          <h2 class="facet-h">Show</h2>
          <div class="pick">
            <a href={at({ verified: false })} aria-current={!state.verified ? "true" : undefined}><i aria-hidden="true"></i>Everything</a>
            <a href={at({ verified: true })} aria-current={state.verified ? "true" : undefined}><i aria-hidden="true"></i>{store("plugins.store.verified_only")}<Seal size="s" quiet /></a>
          </div>
        </div>
        {keywords.length > 0 && (
          <div class="wide-facet">
            <h2 class="facet-h">Keywords</h2>
            <ul class="tags">
              {keywords.map((k) => <li><a class="tag" href={at({ keyword: state.keyword === k ? null : k })} title={k} aria-current={state.keyword === k ? "true" : undefined}>{k}</a></li>)}
            </ul>
          </div>
        )}
      </aside>

      <section aria-labelledby="results">
        <form class="bfind" role="search" action="/plugins/all" method="get" data-tidy>
          <Icon name="search" />
          <input id="q" type="search" name="q" value={state.q || undefined} placeholder={state.category ? `Search in ${categoryName(state.category)}` : "Search plugins"} aria-label={state.category ? `Search in ${categoryName(state.category)}` : "Search plugins"} autocomplete="off" enterkeyhint="search" data-search data-page-search />
          {state.category && <input type="hidden" name="category" value={state.category} />}
          {state.keyword && <input type="hidden" name="keyword" value={state.keyword} />}
          {state.verified && <input type="hidden" name="verified" value="1" />}
          <kbd class="kbd" aria-hidden="true">/</kbd>
        </form>
        <div class="rhead">
          <p id="results">{total !== undefined ? <><b class="num">{count(total)}</b> {total === 1 ? "plugin" : "plugins"}</> : "Plugins"}</p>
          {/* The phone's: the order and the filters, each a disclosure. */}
          <div class="fbar">
            {items.length > 0 && (<details class="drop">
              <summary>{sortLabel(sort)}<span class="sr-only">: change the order</span><Icon name="chev" /></summary>
              <div class="pop">
                {sorts.map((s) => <a href={at({ sort: s })} aria-current={s === sort ? "page" : undefined}>{sortLabel(s)}</a>)}
              </div>
            </details>)}
            <details class="drop">
              <summary>Filters{filtering > 0 && <span class="n num">{filtering}</span>}<Icon name="chev" /></summary>
              <div class="pop wide">
                <p class="facet-h">Show</p>
                <div class="pick">
                  <a href={at({ verified: false })} aria-current={!state.verified ? "true" : undefined}><i aria-hidden="true"></i>Everything</a>
                  <a href={at({ verified: true })} aria-current={state.verified ? "true" : undefined}><i aria-hidden="true"></i>{store("plugins.store.verified_only")}<Seal size="s" quiet /></a>
                </div>
                {keywords.length > 0 && (
                  <>
                    <p class="facet-h">Keywords</p>
                    <ul class="tags">
                      {keywords.map((k) => <li><a class="tag" href={at({ keyword: state.keyword === k ? null : k })} title={k} aria-current={state.keyword === k ? "true" : undefined}>{k}</a></li>)}
                    </ul>
                  </>
                )}
              </div>
            </details>
          </div>
          {/* (Nothing to order, no order: the count line keeps its place, so the heading doesn't move.) */}
          {items.length > 0 && (
            <nav class="sort" aria-label={store("plugins.store.order_label")}>
              <span aria-hidden="true">Sort</span>
              {sorts.map((s) => <a href={at({ sort: s })} aria-current={s === sort ? "page" : undefined}>{sortLabel(s)}</a>)}
            </nav>
          )}
        </div>

        {
          !page.ok ? (
            <div class="empty" role="status">
              <h2>{store("plugins.store.failed_title")}</h2>
              <p>{store("plugins.store.failed_body")}</p>
              <a class="btn sec" href={here}>{store("plugins.store.try_again")}</a>
            </div>
          ) : items.length === 0 ? (
            <div class="empty">
              {state.q ? (
                <>
                  <h2>{store("plugins.store.nothing_matches", { query: state.q })}</h2>
                  <p>{store("plugins.store.try_another")}</p>
                  <a class="btn sec" href={catalogHref({ category: state.category, keyword: state.keyword })}>{store("plugins.store.clear")}</a>
                </>
              ) : state.verified ? (
                <>
                  <h2>{store("plugins.store.nothing_here")}</h2>
                  <p>No plugin here has a verified newest version yet.</p>
                  <a class="btn sec" href={at({ verified: false })}>Show them all</a>
                </>
              ) : state.category || state.keyword ? (
                <>
                  <h2>{store("plugins.store.nothing_here")}</h2>
                  <p>{EMPTY_BODY}</p>
                  <a class="btn sec" href={catalogHref({})}>All plugins</a>
                </>
              ) : (
                <>
                  <h2>{store("plugins.store.empty_title")}</h2>
                  <p>{EMPTY_BODY}</p>
                  <a class="btn sec" href="/plugins/publishing">Publishing guide<Icon name="arrow" /></a>
                </>
              )}
            </div>
          ) : (
            <>
              <ul class="results" aria-labelledby="results">
                {items.map((p) => (
                  <li>
                    <a class:list={["card res", hueClass(p.id)]} href={pluginUrl(p.id)}>
                      <Tile id={p.id} name={p.name} icon={p.icon} version={p.version} size="l" />
                      <div class="txt">
                        <div class="nm"><span class="name">{p.name}</span>{p.verified && <Seal size="s" />}</div>
                        <div class="by">by {p.author.username ? `@${p.author.username}` : "a former account"}</div>
                        <p>{p.summary}</p>
                        <div class="ft">
                          {p.verified ? <span class="count">{when(p)}</span> : <span class="state no">{p.version} not verified yet</span>}
                          <span class="count num">{count(p.installs)} {p.installs === 1 ? "install" : "installs"}</span>
                        </div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
              {(previous || next) && (
                <nav class="pager" aria-label="Pages">
                  {previous ? <a class="btn sec sm" href={previous} rel="prev"><Icon name="left" />Previous</a> : <span class="btn sec sm" aria-disabled="true"><Icon name="left" />Previous</span>}
                  <span class="num">{shown ? `${count(shown.from)}–${count(shown.to)}` : ""}{shown && total !== undefined ? " of " : ""}{total !== undefined ? count(total) : ""}</span>
                  {next ? <a class="btn sec sm" href={next} rel="next">Next<Icon name="arrow" /></a> : <span class="btn sec sm" aria-disabled="true">Next<Icon name="arrow" /></span>}
                </nav>
              )}
            </>
          )
        }
      </section>
    </div>
  </div>
</Store>
