---
// A plugin's page: who made it, what it does (its README, as reviewed),
// what it asks for, its versions, and Install in Zeron. The same for
// everyone, so kept by the Worker cache for at most a minute.
import { statusWords, store } from "../../lib/store/words.ts";
import Asks from "../../components/kit/Asks.astro";
import Install from "../../components/kit/Install.astro";
import Strip from "../../components/kit/Strip.astro";
import PluginTile from "../../components/store/PluginTile.astro";
import Glyph from "../../components/ui/Glyph.astro";
import App from "../../layouts/App.astro";
import { catalogHref } from "../../lib/store/catalog.ts";
import { bytes, compatibility, count, day } from "../../lib/store/format.ts";
import { firstLine } from "../../lib/store/markdown.ts";
import { lines } from "../../lib/store/permissions.ts";
import { CATEGORIES } from "../../lib/store/nav.ts";
import { satisfies } from "../../lib/store/semver.ts";
import { pluginTag, publicPage } from "../../lib/store/http.ts";
import { renderedOnce } from "../../lib/store/rendered.ts";
import { isPluginId, isPrerelease } from "../../lib/store/names.ts";
import { fileUrl, httpsUrl, memberUrl, pictureUrl, pluginUrl } from "../../lib/store/urls.ts";
import type { VersionInfo } from "../../lib/store/types.ts";

export const prerender = false;

// An id no plugin is listed under (unknown, in review, taken down, or not
// an id at all) is one page, the same for each: the shell's own 404, which
// says nothing of why. (A malformed id never reaches the edge.)
const asked = Astro.params.id ?? "";
const valid = isPluginId(asked);
const id = valid ? asked : "";
// One address per plugin: a query can't make the page (or its README) be
// made again, and can't split its cache.
if (valid && Astro.url.search) return Astro.redirect(pluginUrl(id), 301);

const edge = Astro.locals.edge;
const [result, versionsResult, categoriesResult, latestZeron] = valid
  ? await Promise.all([edge.plugin(id), edge.versions(id), edge.categories(), edge.latestRelease()])
  : [null, null, await edge.categories(), null];
// (A listed plugin always has a version; one without is not the public's.)
const missing = !result || (!result.ok && result.error === "not_found") || (result.ok && !result.data.version);
if (missing) Astro.response.status = 404;
else if (!result.ok) Astro.response.status = 503;
const plugin = result?.ok && result.data.version ? { ...result.data, version: result.data.version } : null;

/** Versions whose notes the page shows (each is rendered once, then kept). */
const NOTED = 8;
let readme = "";
let versions: (VersionInfo & { html: string | null })[] = [];
if (plugin) {
  publicPage(Astro, [pluginTag(plugin.id)]);
  const file = (version: string) => (path: string) => fileUrl(plugin.id, version, path);
  const origin = Astro.url.origin;
  // (A first heading that only says its name again isn't drawn: the page says it.)
  readme = await renderedOnce(origin, plugin.id, plugin.version, "readme", plugin.readme, { file: file(plugin.version), demote: true, title: plugin.name });
  // The notes of the latest few versions are shown; older versions are listed by number and date.
  const all = (versionsResult?.ok ? versionsResult.data.versions : plugin.versions).slice(0, NOTED + 20);
  versions = await Promise.all(all.map(async (v, i) => ({ ...v, html: v.notes && i < NOTED ? await renderedOnce(origin, plugin.id, v.version, "notes", v.notes, { file: file(v.version), demote: true }) : null })));
}
// An author's links, parsed: https only, never the text as given.
const homepage = httpsUrl(plugin?.homepage);
const repository = httpsUrl(plugin?.repository);
const categories = categoriesResult.ok ? new Map(categoriesResult.data.categories.map((c) => [c.id, c.name])) : new Map<string, string>();
// Categories by the app's names (the fixed list), else the edge's.
const categoryName = (c: string) => CATEGORIES.find((x) => x.id === c)?.label ?? categories.get(c) ?? c;
const first = plugin?.categories[0] ?? null;
// The latest version (its notes shown, to a clamp), and the ones before it (a row each).
const latest = plugin ? (versions.find((v) => v.version === plugin.version) ?? null) : null;
const older = plugin ? versions.filter((v) => v !== latest) : [];
const asks = plugin ? lines(plugin.permissions).length : 0;
const when = (v: VersionInfo) => v.published_at ?? v.submitted_at;
// Install is off when the plugin's range leaves out the latest Zeron: the
// web can't know your Zeron, but it knows none released can install this.
// (A range it can't read: nothing said, Install left on.)
const off = plugin && latestZeron ? satisfies(latestZeron, plugin.engines?.zeron) === false : false;
/** The older versions shown before "Show all": the latest three in all. */
const SHOWN = 2;

// The page as a search engine reads it (a data block; nothing runs).
const structured = plugin
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: plugin.name,
      description: plugin.summary,
      applicationCategory: "Plugin",
      operatingSystem: "macOS, Windows, Linux",
      softwareVersion: plugin.version,
      dateModified: new Date(plugin.updated_at).toISOString(),
      ...(plugin.author.username ? { author: { "@type": "Person", name: `@${plugin.author.username}`, url: new URL(memberUrl(plugin.author.username), Astro.site).href } } : {}),
      url: new URL(pluginUrl(plugin.id), Astro.site).href,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    }).replace(/</g, "\\u003c")
  : null;
---

<App title={plugin ? `${plugin.name}, a plugin for Zeron` : missing ? "Not found · Plugins · Zeron" : "Plugins · Zeron"} description={plugin?.summary ?? "A plugin for Zeron."} noindex={!plugin} current={null}>
  {structured && <script slot="head" type="application/ld+json" set:html={structured} />}
  <nav slot="title" class="crumbs" aria-label="Where this is">
    <a href={catalogHref({})}>All plugins</a>
    {first && <><Glyph name="alt-arrow-right" size={12} /><a href={catalogHref({ category: first })}>{categoryName(first)}</a></>}
    {plugin && <><Glyph name="alt-arrow-right" size={12} /><span aria-current="page">{plugin.name}</span></>}
  </nav>
  {plugin && <a slot="tools" class="btn ghost sm" href={`${pluginUrl(plugin.id)}/report`}><Glyph name="flag" size={14} />Report</a>}

  {
    missing ? (
      <div class="panel">
        <div class="empty">
          <span class="tile"><Glyph name="magnifer" size={20} /></span>
          <div class="words"><h1 class="t-heading">No plugin is listed here</h1><p>It may have a different id, or it isn't in the store now.</p></div>
          <div class="actions"><a class="btn secondary sm" href={catalogHref({})}>All plugins</a></div>
        </div>
      </div>
    ) : !plugin ? (
      <div class="panel">
        <div class="empty" role="status">
          <span class="tile"><Glyph name="wifi-off" size={20} /></span>
          <div class="words"><h1 class="t-heading">{store("plugins.store.failed_title")}</h1><p>{store("plugins.store.failed_body")}</p></div>
          <div class="actions"><a class="btn secondary sm" href={pluginUrl(id)}>{store("plugins.store.try_again")}</a></div>
        </div>
      </div>
    ) : (
      <div class="plugin">
        <header class="plugin-head">
          <PluginTile id={plugin.id} name={plugin.name} icon={plugin.icon} version={plugin.version} size={56} class="plugin-tile" />
          <div class="who">
            <h1 class="t-title">{plugin.name}</h1>
            <p class="meta">
              {plugin.author.username ? <span>by <a href={memberUrl(plugin.author.username)}>@{plugin.author.username}</a></span> : <span>by an author without a username</span>}
              {plugin.author.badges.map((b) => <span class="badge sm" title={b.description}>{b.name}</span>)}
              <span class="dot" aria-hidden="true">·</span>
              <span class="num">{plugin.version}</span>
              <span class="dot" aria-hidden="true">·</span>
              <span class="num">{count(plugin.installs)} {plugin.installs === 1 ? "install" : "installs"}</span>
              <span class="dot updated" aria-hidden="true">·</span>
              <span class="updated">Updated <time datetime={new Date(plugin.updated_at).toISOString()}>{day(plugin.updated_at)}</time></span>
            </p>
          </div>
          <Install id={plugin.id} name={plugin.name} off={off} />
        </header>
        {off && (
          <p class="notice warn" role="note">
            <Glyph name="danger-triangle" size={16} />
            <span><b>{store("plugins.store.needs_other_zeron")}</b> It needs {compatibility(plugin.engines?.zeron)}; the latest Zeron is {latestZeron}.</span>
          </p>
        )}

        <div class="plugin-body">
          <div class="plugin-strip">
            <Strip name={plugin.name} pictures={plugin.screenshots.map((s) => pictureUrl(plugin.id, plugin.version, s)).filter((s): s is string => s !== null)} />
          </div>
          <div class="plugin-main">
            <nav class="tabs" aria-label="About this plugin" data-tabs>
              <a href="#overview" aria-current="page">Overview</a>
              <a href="#changelog">Changelog <span class="count">{versions.length}</span></a>
              <a href="#permissions">Permissions <span class="count">{asks}</span></a>
            </nav>
            <div class="tab-panels">
              <section class="tab-panel" id="overview" aria-label="Overview">
                {readme.trim() ? <div class="prose" set:html={readme} /> : <p class="lead">{plugin.summary}</p>}
              </section>
              <section class="tab-panel" id="changelog" aria-label="Changelog">
                <div class="versions">
                  {latest && (
                    <article class="version-latest">
                      <div class="version-head">
                        <h2 class="num">{latest.version}</h2>
                        <span class="badge sm ok">Latest</span>
                        {isPrerelease(latest.version) && <span class="badge sm info">Pre-release</span>}
                        {latest.yanked && <span class="badge sm warn" title="Its author stopped new installs. Those who have it keep it working.">{statusWords("yanked")}</span>}
                        <time datetime={new Date(when(latest)).toISOString()}>{day(when(latest))}</time>
                      </div>
                      {latest.html ? <div class="prose notes" set:html={latest.html} data-clamp /> : <p class="t-text t-3">No notes for this version.</p>}
                    </article>
                  )}
                  {older.length > 0 && (
                    <div class="panel older" data-versions>
                      {older.map((v, i) => (
                        <details class:list={{ "more-version": i >= SHOWN }}>
                          <summary>
                            <span class="num">{v.version}</span>
                            <span class="first">{firstLine(v.notes) || "No notes"}</span>
                            <time datetime={new Date(when(v)).toISOString()}>{day(when(v))}</time>
                            <Glyph name="alt-arrow-down" size={14} />
                          </summary>
                          <div class="notes">
                            {v.yanked && <p><span class="badge sm warn">{statusWords("yanked")}</span></p>}
                            {v.html ? <div class="prose" set:html={v.html} /> : v.notes ? <p class="t-text t-2">{v.notes}</p> : <p class="t-text t-3">No notes for this version.</p>}
                          </div>
                        </details>
                      ))}
                    </div>
                  )}
                  {older.length > SHOWN && (
                    <button type="button" class="btn ghost sm show-all" data-show-all aria-expanded="false" data-less={store("plugins.store.show_less")}>
                      {store("plugins.store.all_versions", { n: versions.length })}
                    </button>
                  )}
                </div>
              </section>
              <section class="tab-panel" id="permissions" aria-label="Permissions">
                <Asks permissions={plugin.permissions} author={plugin.author.username ?? undefined} mode="full" />
                <p class="t-caption t-3 asked">Zeron asks you to allow these when you install it, and again if an update asks for more.</p>
              </section>
            </div>
          </div>

          <aside class="rail" aria-label="About this plugin">
            <section class="rail-part rail-asks" aria-labelledby="asks-heading">
              <h2 id="asks-heading">{store("plugins.store.asks")}</h2>
              <Asks permissions={plugin.permissions} author={plugin.author.username ?? undefined} mode="short" />
              <a class="more" href="#permissions" data-tab-link>All of what it asks for</a>
            </section>
            <section class="rail-part" aria-label="Facts">
              <dl class="facts">
                <div><dt>{store("plugins.store.fact.works_with")}</dt><dd>{compatibility(plugin.engines?.zeron)}</dd></div>
                <div><dt>Size</dt><dd class="num">{bytes(plugin.package.bytes)}</dd></div>
                {plugin.license && <div><dt>{store("plugins.store.fact.license")}</dt><dd>{plugin.license}</dd></div>}
                {plugin.categories.length > 0 && (
                  <div><dt>{store("plugins.store.fact.category")}</dt><dd>{plugin.categories.map((c, i) => <>{i > 0 && ", "}<a href={catalogHref({ category: c })}>{categoryName(c)}</a></>)}</dd></div>
                )}
              </dl>
              {plugin.keywords.length > 0 && (
                <ul class="tags" role="list" aria-label="Tags">
                  {plugin.keywords.map((k) => <li><a class="tag" href={catalogHref({ keyword: k })}>{k}</a></li>)}
                </ul>
              )}
            </section>
            {(homepage || repository) && (
              <section class="rail-part" aria-label="Elsewhere">
                <ul class="out" role="list">
                  {homepage && <li><a href={homepage} rel="nofollow noopener ugc"><Glyph name="global" size={16} />{store("plugins.store.fact.homepage")}<Glyph name="arrow-up-right" size={14} class="end" /></a></li>}
                  {repository && <li><a href={repository} rel="nofollow noopener ugc"><Glyph name="file-code" size={16} />{store("plugins.store.fact.repository")}<Glyph name="arrow-up-right" size={14} class="end" /></a></li>}
                </ul>
              </section>
            )}
          </aside>
        </div>
      </div>
    )
  }
</App>
