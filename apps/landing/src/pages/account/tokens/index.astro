---
// Your deploy tokens (contract a315eef5a; the prototype's keys page, its
// row for many plugins redrawn): each live token by name and short id,
// with what it can publish (up to three plugins named; past that a count,
// three tiles and "+n", and the whole list opened in place under it, a
// details: no script), when it was last used and for which plugin, when it
// ends (soon, in the warning's colour), and Revoke; then the revoked and
// ended. New token opens its form in a dialog (with no script, its page);
// the token is shown once, by the page that makes it, and never here: a
// lost one is revoked and made again. Signed out, it says so and offers
// sign-in, here. A name with no spaces in it breaks into even halves
// (Words), and "on" stays with the plugin it names.
import AccountHead from "../../../components/look/AccountHead.astro";
import Flash from "../../../components/look/Flash.astro";
import Icon from "../../../components/look/Icon.astro";
import SignInPlease from "../../../components/look/SignInPlease.astro";
import Tile from "../../../components/look/Tile.astro";
import TokenForm from "../../../components/look/TokenForm.astro";
import Words from "../../../components/look/Words.astro";
import Store from "../../../layouts/Store.astro";
import "../../../styles/look/account.css";
import { takeFlash } from "../../../lib/store/flash.ts";
import { count, date, day, since } from "../../../lib/store/format.ts";
import { privatePage } from "../../../lib/store/http.ts";
import { NO_FIELDS } from "../../../lib/store/tokens.ts";
import type { DeployToken, MyPlugin } from "../../../lib/store/types.ts";
import { store } from "../../../lib/store/words.ts";

export const prerender = false;

const edge = Astro.locals.edge;
// (Signed in, signed out, or not known: an edge that doesn't answer is never "signed out".)
const who = await edge.who();
const session = who.state === "in" ? who.session : null;
privatePage(Astro);
if (who.state === "down") Astro.response.status = 503;
const flash = takeFlash(Astro.cookies);
const [tokensResult, mine] = session ? await Promise.all([edge.tokens(), edge.myPlugins()]) : [null, null];
const now = Date.now();
const tokens = tokensResult?.ok ? tokensResult.data.tokens : null;
const working = (k: DeployToken) => !k.revoked_at && !(k.expires_at !== null && k.expires_at < now);
const live = tokens?.filter(working) ?? [];
const gone = tokens?.filter((k) => !working(k)) ?? [];
/** Your plugins by id: a scope reads as their names and tiles (one no longer yours, by its id). */
const yours = new Map((mine?.ok ? mine.data.plugins : []).map((p) => [p.id, p]));
const plugin = (id: string): Pick<MyPlugin, "id" | "name" | "icon" | "version"> => yours.get(id) ?? { id, name: id, icon: null, version: null };
/** Ending within 14 days: said in the warning's colour, in days. */
const soon = (k: DeployToken) => k.expires_at !== null && k.expires_at - now < 14 * 86_400_000;
const endsIn = (k: DeployToken) => {
  const days = Math.max(0, Math.ceil((k.expires_at! - now) / 86_400_000));
  return days === 0 ? store("plugins.store.key.ends_today") : days === 1 ? store("plugins.store.key.ends_tomorrow") : store("plugins.store.key.ends_in", { n: days });
};
/** A short name kept whole on its line, so names break between one another, never inside one ("Quick / links"). */
const whole = (name: string) => (name.length <= 24 ? name.replace(/ /g, "\u00a0") : name);
/** Up to three plugins are named; past three, counted. */
const named = (ids: string[]) =>
  ids.length === 2 ? store("plugins.store.key.scope.two", { a: whole(plugin(ids[0]!).name), b: whole(plugin(ids[1]!).name) }) : ids.map((id) => whole(plugin(id).name)).join(", ");
const published = mine?.ok ? mine.data.plugins.filter((p) => p.versions.length > 0).length : 0;
---

<Store title="Deploy tokens · Zeron" description="Your account's deploy tokens." noindex current="publish" session={session}>
  <div class="wrap acct">
    <AccountHead
      title="Deploy tokens"
      lead="A token lets a CI job publish new versions without your sign-in. It belongs to your account and publishes only the plugins you choose."
      current="tokens"
      plugins={mine?.ok ? mine.data.plugins.length : null}
      tokens={tokens ? live.length : null}
      action={session ? { label: "New token", icon: "plus", href: "/account/tokens/new", dialog: "new-token" } : null}
    >
      <Flash flash={flash} />
      {
        who.state === "down" ? (
          <div class="empty" role="status">
            <h2>{store("plugins.store.failed_title")}</h2>
            <p>{store("plugins.store.failed_body")}</p>
            <a class="btn sec" href={Astro.url.pathname}>{store("plugins.store.try_again")}</a>
          </div>
        ) : !session ? (
          <SignInPlease what="your deploy tokens" />
        ) : tokens === null ? (
          <div class="empty" role="status">
            <h2>{store("plugins.store.keys_failed")}</h2>
            <p>{store("plugins.store.failed_body")}</p>
            <a class="btn sec" href="/account/tokens">{store("plugins.store.try_again")}</a>
          </div>
        ) : live.length === 0 ? (
          <div class="empty">
            <h2>{store("plugins.store.keys_none")}</h2>
            <p>{published > 0 ? "New token makes one: name it, choose what it can publish, and put it in your CI's secrets." : "Publish a plugin's first version from your computer; a token can send the ones after it."}</p>
          </div>
        ) : (
          <div class="card keys">
            <div class="key h" aria-hidden="true"><span>Token</span><span class="sc">{store("plugins.store.key.scope.label")}</span><span>Last used</span><span>{store("plugins.store.key.expiry_label")}</span><span></span></div>
            <ul aria-label="Your live deploy tokens">
              {live.map((k) => {
                const ids = "all" in k.scope ? [] : k.scope.plugins;
                return (
                  <li class="key">
                    <div class="kname"><div class="nm"><Words text={k.name} /></div><div class="id">{k.short}</div></div>
                    <div class:list={["scope", { many: ids.length > 3 }]}>
                      {"all" in k.scope ? (
                        <>
                          <span class="all" aria-hidden="true"><Icon name="grid" /></span>
                          <div class="w"><div>{store("plugins.store.key.scope.all")}</div><small>{count(yours.size)} today, and any you publish later</small></div>
                        </>
                      ) : (
                        <>
                          <div class="tiles" aria-hidden="true">
                            {ids.slice(0, 3).map((id) => { const p = plugin(id); return <Tile id={p.id} name={p.name} icon={p.icon} version={p.version} size="s" />; })}
                            {ids.length > 3 && <span class="tile s more">+{ids.length - 3}</span>}
                          </div>
                          <div class="w">
                            {ids.length <= 3 ? (
                              <>
                                <div class="names"><Words text={named(ids)} /></div>
                                <small>{ids.length === 1 ? "1 plugin" : `${ids.length} plugins`}</small>
                              </>
                            ) : (
                              <>
                                <div class="count">{ids.length} plugins</div>
                                {/* Under the count, the whole list on request; it opens under the row, from its scope to its end (a details: no script). */}
                                <details class="every">
                                  <summary>Show all {ids.length}<span class="sr-only"> plugins {k.name} can publish</span><Icon name="chev" /></summary>
                                  <ul class="plist" aria-label={`What ${k.name} can publish`}>
                                    {ids.map((id) => { const p = plugin(id); return <li class="pl"><Tile id={p.id} name={p.name} icon={p.icon} version={p.version} size="xs" /><span><Words text={p.name} /></span></li>; })}
                                  </ul>
                                </details>
                              </>
                            )}
                          </div>
                        </>
                      )}
                    </div>
                    <div class="used">
                      {k.last_used_at ? (
                        <>
                          <div><time datetime={new Date(k.last_used_at).toISOString()}>{since(k.last_used_at, now, true)}</time></div>
                          {k.last_used_plugin && <small>on{"\u00a0"}<Words text={plugin(k.last_used_plugin).name} /></small>}
                        </>
                      ) : (
                        <>
                          <div class="t3">{store("plugins.store.key.not_used")}</div>
                          <small>Made {day(k.created_at, now)}</small>
                        </>
                      )}
                    </div>
                    <div class="ends">{k.expires_at === null ? store("plugins.store.key.no_end") : soon(k) ? <span class="state no">{endsIn(k)}</span> : date(k.expires_at)}</div>
                    <a class="btn ghost sm" href={`/account/tokens/${encodeURIComponent(k.id)}`}>{store("plugins.store.key.revoke")}<span class="sr-only"> {k.name}</span></a>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }
      {
        gone.length > 0 && (
          <details class="gone">
            <summary>Revoked and ended tokens · {gone.length}<Icon name="chev" /></summary>
            <div class="card keys">
              <ul aria-label="Revoked and ended tokens">
                {gone.map((k) => (
                  <li class="key was">
                    <div class="kname"><div class="nm"><Words text={k.name} /></div><div class="id">{k.short}</div></div>
                    <div class="scope"><div class="w"><div class="names"><Words text={"all" in k.scope ? store("plugins.store.key.scope.all") : k.scope.plugins.length <= 3 ? named(k.scope.plugins) : `${k.scope.plugins.length} plugins`} /></div></div></div>
                    <div class="used"><div>{k.last_used_at ? since(k.last_used_at, now) : store("plugins.store.key.not_used")}</div><small>Made {day(k.created_at, now)}</small></div>
                    <div class="ends"><span class="state quiet">{k.revoked_at ? `Revoked ${day(k.revoked_at, now)}` : `Ended ${day(k.expires_at!, now)}`}</span></div>
                    <span></span>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )
      }

      <section class="how" aria-label="How deploy tokens work">
        <div><h3><b>1</b>Make it here</h3><p>New token makes one after you sign in again. Zeron shows it once, as it's made, and never again: a lost token is revoked and made anew.</p></div>
        <div><h3><b>2</b>Give it to your CI</h3><p>Store it as <code>ZERON_DEPLOY_TOKEN</code> in your CI's secrets; the publish action reads it from there.</p></div>
        <div><h3><b>3</b>It can do one thing</h3><p>Publish new versions of the plugins in its scope. It can't claim a new id, publish a plugin's first version, or read your account.</p></div>
      </section>
    </AccountHead>
  </div>

  {
    session && (
      <dialog class="question" id="new-token" aria-labelledby="new-token-title" closedby="any">
        <h2 id="new-token-title">{store("plugins.store.key.new_title")}</h2>
        <TokenForm id="new-token" csrf={session.csrf} fields={NO_FIELDS} plugins={[...yours.values()]} fresh={session.fresh_sign_in === true} dialog back="/account/tokens" />
      </dialog>
    )
  }
</Store>
