---
// Your plugins (the prototype's yours page): each plugin you publish, its
// newest version and where it stands (verified, not yet, the reviewer's
// note when Zeron didn't verify it, taken down or removed and why), when it
// was published and from where (one of your devices, or a deploy key by its
// name), and how many have it. One person's page: never cached, never
// indexed. Signed out, it says so and offers sign-in, here.
import AccountHead from "../../components/look/AccountHead.astro";
import Flash from "../../components/look/Flash.astro";
import Icon from "../../components/look/Icon.astro";
import Seal from "../../components/look/Seal.astro";
import SignInPlease from "../../components/look/SignInPlease.astro";
import Tile from "../../components/look/Tile.astro";
import Store from "../../layouts/Store.astro";
import "../../styles/look/account.css";
import { count, day, since } from "../../lib/store/format.ts";
import { hueClass } from "../../lib/store/hue.ts";
import { takeFlash } from "../../lib/store/flash.ts";
import { privatePage } from "../../lib/store/http.ts";
import type { MyPlugin } from "../../lib/store/types.ts";
import { statusWords, store } from "../../lib/store/words.ts";

export const prerender = false;

const edge = Astro.locals.edge;
// (Signed in, signed out, or not known: an edge that doesn't answer is never "signed out".)
const who = await edge.who();
const session = who.state === "in" ? who.session : null;
privatePage(Astro);
if (who.state === "down") Astro.response.status = 503;
const flash = takeFlash(Astro.cookies);
const [result, keysResult] = session ? await Promise.all([edge.myPlugins(), edge.keys()]) : [null, null];
const plugins = result?.ok ? result.data.plugins : [];
const now = Date.now();
const liveKeys = keysResult?.ok ? keysResult.data.keys.filter((k) => !k.revoked_at && !(k.expires_at !== null && k.expires_at < now)).length : null;

/** Where a plugin's newest version stands: its pill, and the lines under it. */
function standing(p: MyPlugin) {
  const v = p.versions[0];
  const verifiedOne = p.verified_version ? p.versions.find((x) => x.version === p.verified_version) : undefined;
  const newestVerified = verifiedOne
    ? `${store("plugins.store.summary.newest_verified", { version: verifiedOne.version })}${verifiedOne.verified_at ? `, since ${day(verifiedOne.verified_at, now)}` : ""}`
    : null;
  const none = `${store("plugins.store.summary.none_verified").replace(/^./, (c) => c.toUpperCase())}: agents can't install it until one is.`;
  if (!v) return { tone: "quiet", label: "Nothing published", why: null, line: null, seal: false };
  if (p.listing === "suspended") return { tone: "bad", label: "Suspended", why: "Zeron took it out of the store. Those who have it keep it.", line: null, seal: false };
  if (v.status === "taken_down" || v.status === "removed") {
    const reason = v.removal?.reason ?? v.review?.message ?? null;
    const off = v.status === "taken_down" && v.removal ? ` Off since ${day(v.removal.at, now)}.` : "";
    return { tone: "bad", label: statusWords(v.status), why: reason ? `“${reason}”${off}` : off.trim() || null, line: newestVerified, seal: Boolean(verifiedOne) };
  }
  if (v.yanked) return { tone: "quiet", label: statusWords("yanked"), why: null, line: newestVerified, seal: Boolean(verifiedOne) };
  if (v.verified) return { tone: "ok", label: store("plugins.store.verified"), why: null, line: v.verified_at ? store("plugins.store.verified_on", { date: day(v.verified_at, now) }) : null, seal: false };
  if (v.review?.decision === "declined")
    return { tone: "bad", label: store("plugins.store.review.declined"), why: v.review.message ? store("plugins.store.review.declined_said", { words: v.review.message }) : null, line: newestVerified ?? none, seal: Boolean(verifiedOne) };
  return { tone: "no", label: store("plugins.store.review.waiting"), why: null, line: newestVerified ?? none, seal: Boolean(verifiedOne) };
}
const gone = (p: MyPlugin) => p.listing === "suspended" || ["taken_down", "removed"].includes(p.versions[0]?.status ?? "");
---

<Store title="Your plugins · Zeron" description="The plugins you publish." noindex current="publish" session={session}>
  <div class="wrap acct">
    <AccountHead
      title="Your plugins"
      lead="What you have published, and where each version stands. A new version is live the moment you send it; the check arrives when Zeron has verified it."
      current="plugins"
      plugins={result?.ok ? plugins.length : null}
      keys={liveKeys}
      action={session ? { label: "Publish a plugin", icon: "plus", href: "/plugins/publishing#send" } : null}
    >
      <Flash flash={flash} />
      {
        who.state === "down" ? (
          <div class="empty" role="status">
            <h2>{store("plugins.store.failed_title")}</h2>
            <p>{store("plugins.store.failed_body")}</p>
            <a class="btn sec" href={Astro.url.pathname}>{store("plugins.store.try_again")}</a>
          </div>
        ) : !session ? (
          <SignInPlease what="the plugins you publish" />
        ) : (
          <>
            {!session.username && (
              <p class="flash info">Claim a username first: Zeron asks for one right after you sign in, and your plugins read “by @username”. Then you can publish.</p>
            )}
            {!result?.ok ? (
              <div class="empty" role="status">
                <h2>{store("plugins.store.failed_title")}</h2>
                <p>{store("plugins.store.failed_body")}</p>
                <a class="btn sec" href="/account">{store("plugins.store.try_again")}</a>
              </div>
            ) : plugins.length === 0 ? (
              <div class="empty">
                <h2>Nothing published yet</h2>
                <p>Publish a plugin from its folder, or from Zeron's Settings, under Plugins. It's live in the store the moment you send it.</p>
                <span class="cmd"><code><em aria-hidden="true">$</em> zeron plugin publish</code><button type="button" data-copy="zeron plugin publish" aria-label="Copy the command"><Icon name="copy" /></button></span>
              </div>
            ) : (
              <div class="card mine">
                <div class="row h" aria-hidden="true"><span>Plugin</span><span>Newest version</span><span>Published</span><span class="r">Installs</span><span></span></div>
                <ul aria-label="Your plugins">
                  {plugins.map((p) => {
                    const s = standing(p);
                    const v = p.versions[0];
                    return (
                      <li>
                        <a class:list={["row", hueClass(p.id), { off: gone(p) }]} href={`/account/plugins/${encodeURIComponent(p.id)}`}>
                          <div class="who">
                            <Tile id={p.id} name={p.name} icon={p.icon} version={v?.version ?? null} />
                            <div><div class="nm name">{p.name}</div><div class="id">{p.id}</div></div>
                          </div>
                          <div class="ver">
                            <div class="top1">
                              {v && <b>{v.version}</b>}
                              <span class:list={["state", s.tone]}>{s.tone === "ok" && <Seal quiet />}{s.label}</span>
                            </div>
                            {s.why && <small class="why">{s.why}</small>}
                            {s.line && <small>{s.seal && <Seal size="s" quiet />}{s.line}</small>}
                          </div>
                          <div class="pub">
                            {v && <div><span class="sr-only">Published </span><time datetime={new Date(v.published_at).toISOString()}>{since(v.published_at, now, true)}</time></div>}
                            {v?.via === "deploy_key" && <small><Icon name="key" />{v.deploy_key?.name ?? "A deploy key"}</small>}
                            {v?.via === "device" && <small><Icon name="laptop" />One of your devices</small>}
                          </div>
                          <div class="n num">{count(p.installs)}<span class="sr-only"> installs</span></div>
                          <Icon name="chev" />
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </>
        )
      }

      <section class="how" aria-label="How publishing works">
        <div><h3><b>1</b>Send it from its folder</h3><p>Run <code>zeron plugin publish</code> in the plugin's folder, or use Publish in Zeron's Settings, under Plugins. The first version claims its id.</p></div>
        <div><h3><b>2</b>It is live at once</h3><p>People can install the new version straight away. It says “Not verified yet”, and Zeron asks them before it installs.</p></div>
        <div><h3><b>3</b>Zeron verifies it</h3><p>When a reviewer at Zeron has read the version, it gets the check. If they find a problem, you get their note saying what to change.</p></div>
      </section>
    </AccountHead>
  </div>
</Store>
