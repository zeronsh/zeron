---
// Published: your plugins, as Vercel's dashboard lists projects: a row a plugin, one
// line, the whole row its link. Its tile and name; its newest version and
// where that stands (a pill); when it was published (and "via token" when a
// deploy token sent it, its name on hover: one of your devices is the usual,
// said by nothing); how many have it. A second line only for what's
// unusual: the newest verified when the newest isn't, the reviewer's note,
// why it was taken down. One person's page: never cached, never indexed.
// Your templates are a table of their own under them, when you have any.
// None of either yet: the guide's steps to the first, and nothing else.
// Signed out, it says so and offers sign-in, here.
import AccountHead from "../../components/look/AccountHead.astro";
import Failed from "../../components/look/Failed.astro";
import Flash from "../../components/look/Flash.astro";
import Icon from "../../components/look/Icon.astro";
import PublishSteps from "../../components/look/PublishSteps.astro";
import Seal from "../../components/look/Seal.astro";
import SignInPlease from "../../components/look/SignInPlease.astro";
import Thumb from "../../components/look/Thumb.astro";
import Store from "../../layouts/Store.astro";
import "../../styles/look/account.css";
import { count, day, since } from "../../lib/store/format.ts";
import { KIND_WORDS } from "../../lib/store/kind.ts";
import { hueClass } from "../../lib/store/hue.ts";
import { takeFlash } from "../../lib/store/flash.ts";
import { privatePage } from "../../lib/store/http.ts";
import type { MyPlugin } from "../../lib/store/types.ts";
import { pluginUrl } from "../../lib/store/urls.ts";
import { statusWords, store } from "../../lib/store/words.ts";

export const prerender = false;

const edge = Astro.locals.edge;
// (Signed in, signed out, or not known: an edge that doesn't answer is never "signed out".)
const who = await edge.who();
const session = who.state === "in" ? who.session : null;
privatePage(Astro);
if (who.state === "down") Astro.response.status = 503;
const flash = takeFlash(Astro.cookies);
const [result, templatesResult, tokensResult] = session ? await Promise.all([edge.mine("plugin"), edge.mine("template"), edge.tokens()]) : [null, null, null];
const plugins = result?.ok ? result.data : [];
const templates = templatesResult?.ok ? templatesResult.data : [];
/** The page's tables: your plugins, and your templates under them when you have any (named then; plugins alone need no name). */
const tables = ([["plugin", plugins], ["template", templates]] as const).filter(([, items]) => items.length > 0);
const now = Date.now();
const liveTokens = tokensResult?.ok ? tokensResult.data.tokens.filter((k) => !k.revoked_at && !(k.expires_at !== null && k.expires_at < now)).length : null;

/** Where a plugin's newest version stands: its pill, and what's unusual about it, said on a line under the row. */
function standing(p: MyPlugin): { tone: string; label: string; notes: string[] } {
  const v = p.versions[0];
  const verifiedOne = p.verified_version ? p.versions.find((x) => x.version === p.verified_version) : undefined;
  // (Said only when the newest isn't the verified one.)
  const newestVerified = verifiedOne && verifiedOne !== v ? store("plugins.store.summary.newest_verified", { version: verifiedOne.version }) : null;
  const notes = (...xs: (string | null | undefined)[]) => xs.filter((x): x is string => Boolean(x));
  if (!v) return { tone: "quiet", label: "Nothing published", notes: [] };
  if (p.listing === "suspended") return { tone: "bad", label: "Suspended", notes: ["Zeron took it out of the store. Those who have it keep it."] };
  if (v.status === "taken_down" || v.status === "removed") {
    const reason = v.removal?.reason ?? v.review?.message ?? null;
    const off = v.status === "taken_down" && v.removal ? `Off since ${day(v.removal.at, now)}.` : null;
    return { tone: "bad", label: statusWords(v.status), notes: notes(reason ? `“${reason}”` : null, off, newestVerified) };
  }
  if (v.yanked) return { tone: "quiet", label: statusWords("yanked"), notes: notes(newestVerified) };
  if (v.verified) return { tone: "ok", label: store("plugins.store.verified"), notes: [] };
  if (v.review?.decision === "declined")
    return { tone: "bad", label: store("plugins.store.review.declined"), notes: notes(v.review.message ? store("plugins.store.review.declined_said", { words: v.review.message }) : null, newestVerified) };
  return { tone: "no", label: store("plugins.store.review.waiting"), notes: notes(newestVerified) };
}
const gone = (p: MyPlugin) => p.listing === "suspended" || ["taken_down", "removed"].includes(p.versions[0]?.status ?? "");
---

<Store title="Published · Zeron" description="Everything you've published." noindex current="publish" session={session}>
  <div class="wrap acct">
    <AccountHead
      title="Published"
      lead="Everything you've published, and where each version stands."
      current="plugins"
      plugins={result?.ok ? plugins.length + templates.length : null}
      tokens={liveTokens}
      action={session ? { label: "Publish", icon: "plus", href: "/plugins/publishing#send" } : null}
    >
      <Flash flash={flash} />
      {
        who.state === "down" ? (
          <Failed />
        ) : !session ? (
          <SignInPlease what="what you've published" />
        ) : (
          <>
            {!session.username && (
              <p class="flash info">Claim a username first: Zeron asks for one right after you sign in, and your plugins read “by @username”. Then you can publish.</p>
            )}
            {!result?.ok || (tables.length === 0 && !templatesResult?.ok) ? (
              <Failed href="/account" />
            ) : tables.length === 0 ? (
              <section class="howto" aria-labelledby="first">
                <h2 id="first">Publish your first plugin</h2>
                <PublishSteps />
              </section>
            ) : (
              <>
                {tables.map(([kind, items]) => (
                  <section class:list={{ yours: templates.length > 0 }} aria-labelledby={templates.length > 0 ? `your-${kind}s` : undefined}>
                    {templates.length > 0 && <h2 id={`your-${kind}s`}>{KIND_WORDS[kind].Many}<span class="num">{count(items.length)}</span></h2>}
                    <div class="tbl mine">
                      <div class="trow th" aria-hidden="true"><span>{KIND_WORDS[kind].One}</span><span>Newest version</span><span>Published</span><span class="r">Installs</span><span></span></div>
                      <ul aria-label={`Your ${KIND_WORDS[kind].many}`}>
                        {items.map((p) => {
                          const s = standing(p);
                          const v = p.versions[0];
                          return (
                            <li>
                              <a class:list={["trow", hueClass(p.id), { off: gone(p), two: s.notes.length > 0 }]} href={`/account${pluginUrl(p.id, kind)}`}>
                                <span class="c-name">
                                  <Thumb item={p} version={v?.version ?? null} size="s" />
                                  <span class="nm" title={p.name}>{p.name}</span>
                                </span>
                                <span class="c-ver pills">
                                  {v && <b class="mono">{v.version}</b>}
                                  <span class:list={["state", s.tone]}>{s.tone === "ok" && <Seal quiet />}{s.label}</span>
                                </span>
                                <span class="c-pub">
                                  {v && <><span class="sr-only">Published </span><time datetime={new Date(v.published_at).toISOString()}>{since(v.published_at, now, true)}</time></>}
                                  {v?.via === "deploy_token" && <span class="via" title={v.deploy_token?.name ? `Sent by the deploy token “${v.deploy_token.name}”` : "Sent by a deploy token"}><Icon name="key" />via token<span class="sr-only">: {v.deploy_token?.name ?? "a deploy token"}</span></span>}
                                </span>
                                <span class="c-n num">{count(p.installs)}<span class="sr-only unit"> {p.installs === 1 ? "install" : "installs"}</span></span>
                                <Icon name="chev" />
                                {s.notes.length > 0 && <span class="c-note">{s.notes.join(" · ")}</span>}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </section>
                ))}
                {templatesResult && !templatesResult.ok && <p class="mkeys">Your templates can't be loaded right now. Try again in a moment.</p>}
              </>
            )}
          </>
        )
      }

      {tables.length > 0 && (
        <section class="how" aria-label="How publishing works">
          <div><h3><b>1</b>Send it from its folder</h3><p>Run <code>zeron plugin publish</code> in the plugin's folder{templates.length > 0 && <> (<code>zeron template publish</code> in a template's)</>}, or use Publish in Zeron's Settings, under Plugins. The first version claims its id.</p></div>
          <div><h3><b>2</b>It is live at once</h3><p>People can install the new version straight away. It says “Not verified yet”, and Zeron asks them before it installs.</p></div>
          <div><h3><b>3</b>Zeron verifies it</h3><p>When a reviewer at Zeron has read the version, it gets the check. If they find a problem, you get their note saying what to change.</p></div>
        </section>
      )}
    </AccountHead>
  </div>
</Store>
