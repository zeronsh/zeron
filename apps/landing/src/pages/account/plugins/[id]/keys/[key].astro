---
// Revoke one of your plugin's deploy keys. A post does it; a visit asks first.
import Confirm from "../../../../../components/kit/Confirm.astro";
import Glyph from "../../../../../components/ui/Glyph.astro";
import App from "../../../../../layouts/App.astro";
import { isKey, revokeAsk } from "../../../../../lib/store/actions.ts";
import { done, flashFor, formOf, tokenMatches } from "../../../../../lib/store/forms.ts";
import { privatePage } from "../../../../../lib/store/http.ts";
import { isPluginId } from "../../../../../lib/store/names.ts";
import { requireSession } from "../../../../../lib/store/session.ts";

export const prerender = false;

const { id, key } = Astro.params;
if (!isPluginId(id) || !isKey(key)) return new Response(null, { status: 404 });
const session = await requireSession(Astro);
if (session instanceof Response) return session;
const back = `/account/plugins/${id}`;

if (Astro.request.method === "POST") {
  const form = await formOf(Astro.request);
  if (!form || !tokenMatches(form, session)) return done(Astro, "expired", back);
  const result = await Astro.locals.edge.revokeKey(id, key, session.csrf);
  return done(Astro, flashFor(result, "key_revoked"), back);
}
if (Astro.request.method !== "GET") return new Response(null, { status: 405, headers: { allow: "GET, POST" } });

const keys = await Astro.locals.edge.keys(id);
const found = keys.ok ? keys.data.keys.find((k) => k.key === key && !k.revoked_at) : undefined;
if (!found) return new Response(null, { status: 404 });
privatePage(Astro);
const ask = revokeAsk(found.name);
---

<App title={`${ask.title} · Zeron`} description={ask.title} noindex current="mine" session={session}>
  <nav slot="title" class="crumbs" aria-label="Where this is">
    <a href="/account">Your plugins</a><Glyph name="alt-arrow-right" size={12} /><a href={`${back}#keys`}>{id}</a><Glyph name="alt-arrow-right" size={12} /><span aria-current="page">Revoke a key</span>
  </nav>
  <Confirm ask={ask} action={Astro.url.pathname} csrf={session.csrf} back={`${back}#keys`} />
</App>
