---
// Everything done to the store's plugins, by reviewers and by their
// authors, newest first, as a table; or one plugin's, from its page.
// Admins only.
import Glyph from "../../components/ui/Glyph.astro";
import App from "../../layouts/App.astro";
import { reasonLabel } from "../../lib/store/admin.ts";
import { count, dateTime, day } from "../../lib/store/format.ts";
import { privatePage } from "../../lib/store/http.ts";
import { isPluginId } from "../../lib/store/names.ts";
import { pagerOf, placeOf } from "../../lib/store/paging.ts";
import { adminSession } from "../../lib/store/session.ts";

export const prerender = false;

const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });
privatePage(Astro);
const place = placeOf(Astro.url);
const asked = Astro.url.searchParams.get("plugin");
const pluginFilter = isPluginId(asked) ? asked : null;
const result = await Astro.locals.edge.audit(place.cursor, pluginFilter ?? undefined);
if (!result.ok && result.error === "bad_cursor") return Astro.redirect(pluginFilter ? `/admin/audit?plugin=${pluginFilter}` : "/admin/audit", 303);
const entries = result.ok ? result.data.entries : [];
const pager = result.ok ? pagerOf("/admin/audit", pluginFilter ? { plugin: pluginFilter } : {}, place, result.data, entries.length) : null;

/** The edge's words for what was done, as a person says them. */
const ACTIONS: Record<string, string> = {
  "version.approve": "Approved",
  "version.reject": "Didn't approve",
  "version.remove": "Took down",
  "version.withdraw": "Withdrew",
  "version.yank": "Stopped new installs of",
  "version.unyank": "Allowed installs again of",
  "plugin.suspend": "Suspended",
  "plugin.restore": "Restored",
  "plugin.feature": "Featured",
  "plugin.unfeature": "Stopped featuring",
  "plugin.transfer": "Moved",
  "plugin.release": "Released the id of",
  "report.dismissed": "Dismissed a report on",
  "report.actioned": "Acted on a report on",
  "reservation.set": "Reserved",
  "reservation.release": "Freed",
};

/** What else an entry recorded, said plainly: "reason: …, block: yes". */
function detailText(detail: unknown): string {
  if (detail === null || detail === undefined) return "";
  if (typeof detail !== "object") return String(detail);
  return Object.entries(detail as Record<string, unknown>)
    .filter(([, v]) => v !== null && v !== undefined && v !== "")
    .map(([k, v]) => `${k.replace(/_/g, " ")}: ${k === "reason" && typeof v === "string" ? reasonLabel(v) : typeof v === "boolean" ? (v ? "yes" : "no") : typeof v === "object" ? JSON.stringify(v) : String(v)}`)
    .join(" · ");
}
const CLOCK = new Intl.DateTimeFormat("en", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "UTC" });
---

<App title="Audit log · Review · Zeron" description="What was done to the store's plugins." noindex current="audit" session={session}>
  <h1 slot="title" class="t-title">Audit log{result.ok && <span class="title-count"> · {count(result.data.total)}</span>}</h1>
  {
    pluginFilter && (
      <div slot="tools" class="tools-row">
        <span class="t-text t-2">For <code>{pluginFilter}</code></span>
        <a class="btn ghost sm" href="/admin/audit">The whole log</a>
      </div>
    )
  }

  {
    !result.ok ? (
      <div class="panel">
        <div class="empty" role="status">
          <span class="tile"><Glyph name="wifi-off" size={20} /></span>
          <div class="words"><h2>The log can't be loaded right now</h2><p>Try again in a moment.</p></div>
          <div class="actions"><a class="btn secondary sm" href={Astro.url.pathname + Astro.url.search}>Try again</a></div>
        </div>
      </div>
    ) : entries.length === 0 ? (
      <div class="panel">
        <div class="empty">
          <span class="tile"><Glyph name="clock-circle" size={20} /></span>
          <div class="words"><h2>Nothing yet</h2><p>What reviewers and authors do to a plugin is written here as it's done.</p></div>
        </div>
      </div>
    ) : (
      <>
        <div class="panel">
          <table class="table wrapping audit-table">
            <caption class="sr-only">The audit log{pluginFilter ? ` for ${pluginFilter}` : ""}, the newest first</caption>
            <colgroup><col class="when" /><col class="who" /><col class="what" /><col /></colgroup>
            <thead><tr><th scope="col">When</th><th scope="col">Who</th><th scope="col">What</th><th scope="col">Detail</th></tr></thead>
            <tbody>
              {entries.map((e) => (
                <tr>
                  <td><span class="line when-line"><time datetime={new Date(e.at).toISOString()} title={dateTime(e.at)}>{day(e.at)}, {CLOCK.format(e.at)}</time></span></td>
                  <td><span class="line">{e.actor.username ? `@${e.actor.username}` : <span class="t-mono t-3">{e.actor.user_id}</span>}</span></td>
                  <td class="what">
                    <span class="line">
                      <span>
                        {Object.hasOwn(ACTIONS, e.action) ? ACTIONS[e.action] : e.action}{" "}
                        {e.plugin_id && e.action.startsWith("reservation.") && <a href="/admin/reservations"><code class="t-mono">{e.plugin_id}</code></a>}
                        {e.plugin_id && !e.action.startsWith("reservation.") && (
                          <a href={e.version ? `/admin/plugins/${encodeURIComponent(e.plugin_id)}/${encodeURIComponent(e.version)}` : `/admin/plugins/${encodeURIComponent(e.plugin_id)}`}>
                            <code class="t-mono">{e.plugin_id}</code>
                            {e.version && <span class="t-mono t-2"> {e.version}</span>}
                          </a>
                        )}
                      </span>
                    </span>
                  </td>
                  <td class="words detail">{detailText(e.detail)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {pager && (pager.previous || pager.next) && (
          <nav class="pager" aria-label="Pages">
            {pager.previous ? <a class="btn secondary sm" href={pager.previous} rel="prev"><Glyph name="alt-arrow-left" size={14} />Previous</a> : <span class="btn secondary sm" aria-disabled="true"><Glyph name="alt-arrow-left" size={14} />Previous</span>}
            <span class="where">{pager.where}</span>
            {pager.next ? <a class="btn secondary sm" href={pager.next} rel="next">Next<Glyph name="alt-arrow-right" size={14} /></a> : <span class="btn secondary sm" aria-disabled="true">Next<Glyph name="alt-arrow-right" size={14} /></span>}
          </nav>
        )}
      </>
    )
  }
</App>
