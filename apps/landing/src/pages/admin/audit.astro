---
// Everything done to the store's plugins, by reviewers and by their
// authors, newest first, as a table; or one plugin's, from its page.
// Admins only.
import Icon from "../../components/look/Icon.astro";
import StaffHead from "../../components/look/StaffHead.astro";
import Store from "../../layouts/Store.astro";
import "../../styles/look/account.css";
import "../../styles/look/staff.css";
import { reasonLabel } from "../../lib/store/admin.ts";
import { dateTime, day } from "../../lib/store/format.ts";
import { privatePage } from "../../lib/store/http.ts";
import { isPluginId } from "../../lib/store/names.ts";
import { pagerOf, placeOf } from "../../lib/store/paging.ts";
import { adminSession } from "../../lib/store/session.ts";
import { staffCounts, staffTabs } from "../../lib/store/staff.ts";

export const prerender = false;

const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });
privatePage(Astro);
const place = placeOf(Astro.url);
const asked = Astro.url.searchParams.get("plugin");
const pluginFilter = isPluginId(asked) ? asked : null;
const [result, counts] = await Promise.all([Astro.locals.edge.audit(place.cursor, pluginFilter ?? undefined), staffCounts(Astro.locals.edge)]);
if (!result.ok && result.error === "bad_cursor") return Astro.redirect(pluginFilter ? `/admin/audit?plugin=${pluginFilter}` : "/admin/audit", 303);
const entries = result.ok ? result.data.entries : [];
const pager = result.ok ? pagerOf("/admin/audit", pluginFilter ? { plugin: pluginFilter } : {}, place, result.data, entries.length) : null;

/** The edge's words for what was done, as a person says them. */
const ACTIONS: Record<string, string> = {
  // (Amendment 45's words; the ones before them stay, for the entries made then.)
  "version.publish": "Published",
  "version.verify": "Verified",
  "version.decline": "Didn't verify",
  "version.take_down": "Took down",
  "version.remove": "Removed",
  "version.approve": "Approved",
  "version.reject": "Didn't approve",
  "version.withdraw": "Withdrew",
  "version.yank": "Stopped new installs of",
  "version.unyank": "Allowed installs again of",
  "plugin.suspend": "Suspended",
  "plugin.restore": "Restored",
  "plugin.feature": "Featured",
  "plugin.unfeature": "Stopped featuring",
  "plugin.transfer": "Moved",
  "plugin.release": "Released the id of",
  "report.dismissed": "Dismissed a report on",
  "report.actioned": "Acted on a report on",
  "reservation.set": "Reserved",
  "reservation.release": "Freed",
};

/** What else an entry recorded, said plainly: "reason: …, block: yes". */
function detailText(detail: unknown): string {
  if (detail === null || detail === undefined) return "";
  if (typeof detail !== "object") return String(detail);
  return Object.entries(detail as Record<string, unknown>)
    .filter(([, v]) => v !== null && v !== undefined && v !== "")
    .map(([k, v]) => `${k.replace(/_/g, " ")}: ${k === "reason" && typeof v === "string" ? reasonLabel(v) : typeof v === "boolean" ? (v ? "yes" : "no") : typeof v === "object" ? JSON.stringify(v) : String(v)}`)
    .join(" · ");
}
const CLOCK = new Intl.DateTimeFormat("en", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "UTC" });
---

<Store title="Audit log · Review · Zeron" description="What was done to the store's plugins." noindex current="review" session={session}>
  <div class="wrap acct">
    <StaffHead title="Audit log" count={result.ok ? result.data.total : null} tabs={staffTabs("audit", counts)}>
      {
        pluginFilter && (
          <p class="tools-line">
            <span>For <code class="id">{pluginFilter}</code></span>
            <a class="more" href="/admin/audit">The whole log<Icon name="chev" /></a>
          </p>
        )
      }
      {
        !result.ok ? (
          <div class="empty" role="status">
            <h2>The log can't be loaded right now</h2>
            <p>Try again in a moment.</p>
            <a class="btn sec" href={Astro.url.pathname + Astro.url.search}>Try again</a>
          </div>
        ) : entries.length === 0 ? (
          <div class="empty">
            <h2>Nothing yet</h2>
            <p>What reviewers and authors do to a plugin is written here as it's done.</p>
          </div>
        ) : (
          <>
            <div class="card srows log">
              <div class="sr h" aria-hidden="true"><span>When</span><span>Who</span><span>What</span><span>Detail</span></div>
              <ul aria-label={`The audit log${pluginFilter ? ` for ${pluginFilter}` : ""}, the newest first`}>
                {entries.map((e) => (
                  <li class="sr">
                    <span class="t2"><time datetime={new Date(e.at).toISOString()} title={dateTime(e.at)}>{day(e.at)}, {CLOCK.format(e.at)}</time></span>
                    <span>{e.actor.username ? `@${e.actor.username}` : <span class="id t3">{e.actor.user_id}</span>}</span>
                    <span>
                      {Object.hasOwn(ACTIONS, e.action) ? ACTIONS[e.action] : e.action}{" "}
                      {e.plugin_id && e.action.startsWith("reservation.") && <a href="/admin/reservations" class="pname"><code class="id">{e.plugin_id}</code></a>}
                      {e.plugin_id && !e.action.startsWith("reservation.") && (
                        <a href={e.version ? `/admin/plugins/${encodeURIComponent(e.plugin_id)}/${encodeURIComponent(e.version)}` : `/admin/plugins/${encodeURIComponent(e.plugin_id)}`} class="pname">
                          <code class="id">{e.plugin_id}</code>
                          {e.version && <span class="id t2"> {e.version}</span>}
                        </a>
                      )}
                    </span>
                    <span class="why">{detailText(e.detail)}</span>
                  </li>
                ))}
              </ul>
            </div>
            {pager && (pager.previous || pager.next) && (
              <nav class="pager" aria-label="Pages">
                {pager.previous ? <a class="btn sec sm" href={pager.previous} rel="prev"><Icon name="left" />Previous</a> : <span class="btn sec sm" aria-disabled="true"><Icon name="left" />Previous</span>}
                <span class="num">{pager.where}</span>
                {pager.next ? <a class="btn sec sm" href={pager.next} rel="next">Next<Icon name="arrow" /></a> : <span class="btn sec sm" aria-disabled="true">Next<Icon name="arrow" /></span>}
              </nav>
            )}
          </>
        )
      }
    </StaffHead>
  </div>
</Store>
