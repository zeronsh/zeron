---
// Everything an admin did, newest first. Admins only.
import AccountBar from "../../components/store/AccountBar.astro";
import Pagination from "../../components/ui/Pagination.astro";
import Store from "../../layouts/Store.astro";
import { dateTime } from "../../lib/store/format.ts";
import { privatePage } from "../../lib/store/http.ts";
import { adminSession } from "../../lib/store/session.ts";

export const prerender = false;

const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });
privatePage(Astro);
const cursor = Astro.url.searchParams.get("cursor");
const result = await Astro.locals.edge.audit(cursor && /^[A-Za-z0-9_-]{1,512}$/.test(cursor) ? cursor : undefined);
const entries = result.ok ? result.data.entries : [];

const ACTIONS: Record<string, string> = {
  approve: "Approved",
  reject: "Rejected",
  remove: "Took down",
  remove_block: "Took down and turned off",
  suspend: "Suspended",
  restore: "Restored",
  feature: "Featured",
  unfeature: "Stopped featuring",
  transfer: "Moved",
  report_dismissed: "Dismissed a report on",
  report_actioned: "Acted on a report on",
  "reservation.set": "Reserved",
  "reservation.release": "Freed",
};
---

<Store title="Audit log · Zeron" description="What admins did." noindex tool>
  <div class="wrap audit">
    <AccountBar session={session} current="audit">
      <h1>Audit log</h1>
      <p class="lead">Everything an admin did to the store, newest first.</p>
    </AccountBar>
    {
      !result.ok ? (
        <p class="quiet">The log can't be loaded right now. Try again in a minute.</p>
      ) : entries.length === 0 ? (
        <p class="quiet">Nothing yet.</p>
      ) : (
        <div class="table-wrap">
          <table class="stack-table">
            <thead>
              <tr>
                <th scope="col">When</th>
                <th scope="col">Who</th>
                <th scope="col">What</th>
                <th scope="col">Detail</th>
              </tr>
            </thead>
            <tbody>
              {entries.map((e) => (
                <tr>
                  <td class="when"><time datetime={new Date(e.at).toISOString()}>{dateTime(e.at)}</time></td>
                  <td data-label="By">{e.actor.username ? `@${e.actor.username}` : e.actor.user_id}</td>
                  <td>
                    {Object.hasOwn(ACTIONS, e.action) ? ACTIONS[e.action] : e.action}{" "}
                    {e.plugin_id && e.action.startsWith("reservation.") && <a href="/admin/reservations"><code>{e.plugin_id}</code></a>}
                    {e.plugin_id && !e.action.startsWith("reservation.") && (
                      <a href={e.version ? `/admin/plugins/${encodeURIComponent(e.plugin_id)}/${encodeURIComponent(e.version)}` : `/admin/plugins/${encodeURIComponent(e.plugin_id)}`}>
                        <code>{e.plugin_id}</code>
                        {e.version && <span class="num"> {e.version}</span>}
                      </a>
                    )}
                  </td>
                  <td class="detail">{e.detail ?? ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    {result.ok && <Pagination label="More of the log" next={result.data.next_cursor ? `/admin/audit?cursor=${encodeURIComponent(result.data.next_cursor)}` : null} previous={result.data.prev_cursor ? `/admin/audit?cursor=${encodeURIComponent(result.data.prev_cursor)}` : cursor ? "/admin/audit" : null} />}
  </div>
</Store>

<style>
  .audit { display: grid; gap: 24px; }
  .lead { max-width: 36em; font-size: 16px; }
  .quiet { color: var(--text-3); }
  .table-wrap { overflow-x: auto; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.5; }
  th, td { padding: 12px 16px; text-align: left; vertical-align: top; }
  thead th { padding-block: 10px; font-size: 12.5px; font-weight: 500; color: var(--text-3); border-bottom: 1px solid var(--line); }
  tbody tr + tr > * { border-top: 1px solid var(--line); }
  .when { color: var(--text-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  td a { color: var(--text); }
  td a:hover { color: var(--accent-soft); }
  .detail { color: var(--text-2); overflow-wrap: anywhere; }
</style>
