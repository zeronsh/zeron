---
// What people reported about listed plugins, as a table: the open ones,
// each closed (dismissed, or acted on, with a note) from its row's one
// action; those closed, a segment each. Admins only.
import Empty from "../../../components/look/Empty.astro";
import Failed from "../../../components/look/Failed.astro";
import Flash from "../../../components/look/Flash.astro";
import Icon from "../../../components/look/Icon.astro";
import StaffHead from "../../../components/look/StaffHead.astro";
import Store from "../../../layouts/Store.astro";
import "../../../styles/look/account.css";
import "../../../styles/look/staff.css";
import { takeFlash } from "../../../lib/store/flash.ts";
import { dateTime, day, unbidi } from "../../../lib/store/format.ts";
import { privatePage } from "../../../lib/store/http.ts";
import { pagerOf, placeOf } from "../../../lib/store/paging.ts";
import { resumed } from "../../../lib/store/resume.ts";
import { adminSession } from "../../../lib/store/session.ts";
import { staffCounts, staffTabs } from "../../../lib/store/staff.ts";
import { reasonWords } from "../../../lib/store/states.ts";
import { REPORT_REASONS, type Report, type ReportReason } from "../../../lib/store/types.ts";
import { reportReasonWords } from "../../../lib/store/words.ts";

export const prerender = false;

const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });
privatePage(Astro);
const flash = takeFlash(Astro.cookies);
// The edge's own states, a segment each, so each page is the edge's page.
const STATES = { open: "Open", actioned: "Acted on", dismissed: "Dismissed" } as const;
type State = keyof typeof STATES;
const asked = Astro.url.searchParams.get("status");
const status: State = asked && Object.hasOwn(STATES, asked) ? (asked as State) : "open";
const open = status === "open";
const place = placeOf(Astro.url);
const result = await Astro.locals.edge.reports(status, place.cursor);
// (The tabs' counts: how many wait, and how many reports are open, this list's own total when it's the open one.)
const counts = await staffCounts(Astro.locals.edge, open && result.ok ? { reports: result.data.total } : {});
// A cursor from another list (or an old one): back to the first page.
if (!result.ok && result.error === "bad_cursor") return Astro.redirect(open ? "/admin/reports" : `/admin/reports?status=${status}`, 303);
const reports = result.ok ? result.data.reports : [];
const pager = result.ok ? pagerOf("/admin/reports", open ? {} : { status }, place, result.data, reports.length) : null;
const stateHref = (s: State) => (s === "open" ? "/admin/reports" : `/admin/reports?status=${s}`);
// A note typed before signing in again comes back to its report, its question open.
const resumedReport = resumed(Astro.url, "report", 64);
const resumedNote = resumed(Astro.url, "note", 500);
const reasonOf = (r: Report) => ((REPORT_REASONS as readonly string[]).includes(r.reason) ? reportReasonWords(r.reason as ReportReason) : reasonWords(r.reason));
const pluginName = (r: Report) => unbidi(r.plugin.name ?? r.plugin.id);
---

<Store title="Reports · Review · Zeron" description="Reports about plugins." noindex current="review" session={session}>
  <div class="wrap acct">
    <StaffHead title="Review" lead="What people reported about listed plugins, the newest first." tabs={staffTabs("reports", counts)}>
      <nav class="chips" aria-label="Reports by state">
        {(Object.keys(STATES) as State[]).map((s) => <a class="chip" href={stateHref(s)} aria-current={s === status ? "page" : undefined}>{STATES[s]}</a>)}
      </nav>
      <Flash flash={flash} />
      {
        !result.ok ? (
          <Failed title="Reports can't be loaded right now" line="Try again in a moment." href={stateHref(status)} />
        ) : reports.length === 0 ? (
          <Empty icon="flag" title={open ? "No open reports" : "Nothing here yet"} line={open ? "What people report about a plugin shows here, the newest first." : `Reports ${status === "actioned" ? "acted on" : "dismissed"} show here, with what was done.`} />
        ) : (
          <>
            <div class="tbl reps">
              <div class="trow th" aria-hidden="true"><span>Plugin</span><span>Reason</span><span>What they said</span><span>From</span><span>Sent</span><span>{open ? "" : "Closed"}</span><span></span></div>
              <ul aria-label={`${STATES[status]} reports, the newest first`}>
                {reports.map((r) => (
                  /* (The row opens the plugin's staff page: its name's link, stretched over the row; Close it is its own.) */
                  <li class="trow">
                    <span class="c-name">
                      <a class="nm stretch" href={`/admin/plugins/${encodeURIComponent(r.plugin.id)}`} title={pluginName(r)}>{pluginName(r)}</a>
                      {r.version && <b class="vno mono">{r.version}</b>}
                    </span>
                    <span class="c-reason">{r.reason === "malware" ? <span class="state bad">{reasonOf(r)}</span> : <span class="t2">{reasonOf(r)}</span>}</span>
                    <span class="c-said">
                      <span class="c-line">{r.text ? <span class="said" title={r.text}>{r.text}</span> : <span class="t3">No words given.</span>}</span>
                      {!open && (r.note || r.resolved_by?.username) && <span class="c-sub">{[r.note && `Note: ${r.note}`, r.resolved_by?.username && `by @${r.resolved_by.username}`].filter(Boolean).join(" · ")}</span>}
                    </span>
                    <span class="c-from t2"><span class="sr-only">From </span>{r.reporter?.username ? `@${r.reporter.username}` : "someone"}</span>
                    <span class="c-when t2"><span class="sr-only">Sent </span><time datetime={new Date(r.created_at).toISOString()} title={dateTime(r.created_at)}>{day(r.created_at)}</time></span>
                    {open ? (
                      <a class="btn ghost sm over" href={`#close-${r.id}`} data-dialog={`close-${r.id}`}>Close it…<span class="sr-only"> {pluginName(r)}</span></a>
                    ) : (
                      <span class="c-when t2"><span class="sr-only">Closed </span>{r.resolved_at ? <time datetime={new Date(r.resolved_at).toISOString()} title={dateTime(r.resolved_at)}>{day(r.resolved_at)}</time> : "—"}</span>
                    )}
                    <Icon name="chev" />
                  </li>
                ))}
              </ul>
            </div>
            {pager && (pager.previous || pager.next) && (
              <nav class="pager" aria-label="Pages">
                {pager.previous ? <a class="btn sec sm" href={pager.previous} rel="prev"><Icon name="left" />Previous</a> : <span class="btn sec sm" aria-disabled="true"><Icon name="left" />Previous</span>}
                <span class="num">{pager.where}</span>
                {pager.next ? <a class="btn sec sm" href={pager.next} rel="next">Next<Icon name="arrow" /></a> : <span class="btn sec sm" aria-disabled="true">Next<Icon name="arrow" /></span>}
              </nav>
            )}
          </>
        )
      }
    </StaffHead>
  </div>
  {open && reports.map((r) => (
    <dialog class="question sm" id={`close-${r.id}`} aria-labelledby={`close-${r.id}-title`} closedby="any" data-open={String(r.id) === resumedReport ? "" : undefined}>
      <form method="post" action={`/admin/reports/${encodeURIComponent(r.id)}`}>
        <input type="hidden" name="csrf" value={session.csrf} />
        <h2 id={`close-${r.id}-title`}>Close the report on {pluginName(r)}?</h2>
        <p>Dismiss it, or say it was acted on. The note is for the other reviewers.</p>
        <div class="body">
          <div>
            <label class="field-label" for={`note-${r.id}`}>What was done</label>
            <div class="field"><input id={`note-${r.id}`} name="note" maxlength="500" placeholder="Optional" autocomplete="off" value={String(r.id) === resumedReport ? resumedNote || undefined : undefined} /></div>
          </div>
        </div>
        <div class="answers">
          <button class="btn ghost" type="submit" formmethod="dialog" formnovalidate autofocus>Cancel</button>
          <button class="btn sec" type="submit" name="resolution" value="dismissed">Dismiss</button>
          <button class="btn pri" type="submit" name="resolution" value="actioned">Acted on it</button>
        </div>
      </form>
    </dialog>
  ))}
</Store>
