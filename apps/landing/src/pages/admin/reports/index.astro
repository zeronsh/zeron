---
// What people reported about listed plugins, the open ones first, each
// closed with what was done. Admins only.
import AccountBar from "../../../components/store/AccountBar.astro";
import Action from "../../../components/ui/Action.astro";
import Badge from "../../../components/ui/Badge.astro";
import Glyph from "../../../components/ui/Glyph.astro";
import Pagination from "../../../components/ui/Pagination.astro";
import Tabs from "../../../components/ui/Tabs.astro";
import Store from "../../../layouts/Store.astro";
import { takeFlash } from "../../../lib/store/flash.ts";
import { ago, date } from "../../../lib/store/format.ts";
import { privatePage } from "../../../lib/store/http.ts";
import { resumed } from "../../../lib/store/resume.ts";
import { adminSession } from "../../../lib/store/session.ts";
import { reasonWords } from "../../../lib/store/states.ts";
import { REPORT_REASONS, type ReportReason } from "../../../lib/store/types.ts";
import { reportReasonWords } from "../../../lib/store/words.ts";

export const prerender = false;

const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });
privatePage(Astro);
const toast = takeFlash(Astro.cookies);
// The edge's own states, a tab each, so each page is the edge's page.
const STATES = { open: "Open", actioned: "Acted on", dismissed: "Dismissed" } as const;
type State = keyof typeof STATES;
const asked = Astro.url.searchParams.get("status");
const status: State = asked && Object.hasOwn(STATES, asked) ? (asked as State) : "open";
const open = status === "open";
const cursor = Astro.url.searchParams.get("cursor");
const result = await Astro.locals.edge.reports(status, cursor && /^[A-Za-z0-9_-]{1,512}$/.test(cursor) ? cursor : undefined);
// A cursor from another list (or an old one): back to the first page.
if (!result.ok && result.error === "bad_cursor") return Astro.redirect(status === "open" ? "/admin/reports" : `/admin/reports?status=${status}`, 303);
const reports = result.ok ? result.data.reports : [];
const base = open ? "/admin/reports" : `/admin/reports?status=${status}`;
// A note typed before signing in again comes back to its report.
const resumedReport = resumed(Astro.url, "report", 64);
const resumedNote = resumed(Astro.url, "note", 500);
---

<Store title="Reports · Zeron" description="Reports about plugins." noindex tool toast={toast}>
  <div class="wrap reports-page">
    <AccountBar session={session} current="reports">
      <h1>Reports</h1>
      <p class="lead">What people told us about plugins in the store.</p>
    </AccountBar>
    <Tabs label="Reports by state" tabs={(Object.keys(STATES) as State[]).map((s) => ({ href: s === "open" ? "/admin/reports" : `/admin/reports?status=${s}`, label: STATES[s], current: s === status }))} />
    {
      !result.ok ? (
        <p class="empty">Reports can't be loaded right now. Try again in a minute.</p>
      ) : reports.length === 0 ? (
        <div class="empty">
          <Glyph name="check-circle" size={20} />
          <p>{open ? "No open reports." : `None ${STATES[status].toLowerCase()} yet.`}</p>
        </div>
      ) : (
        <ul class="list" role="list">
          {reports.map((r) => (
            <li class="report">
              <div class="head">
                <a class="plugin" href={`/admin/plugins/${encodeURIComponent(r.plugin.id)}`}>
                  <span>{r.plugin.name ?? r.plugin.id}</span>
                  {r.version && <span class="num"> {r.version}</span>}
                </a>
                <Badge tone={r.reason === "malware" ? "danger" : "warning"} size="sm">{(REPORT_REASONS as readonly string[]).includes(r.reason) ? reportReasonWords(r.reason as ReportReason) : reasonWords(r.reason)}</Badge>
                {!open && r.resolved_by?.username && <span class="by">by @{r.resolved_by.username}</span>}
                <span class="from">
                  {r.reporter?.username ? `@${r.reporter.username}` : "Someone"} · <time datetime={new Date(r.created_at).toISOString()} title={date(r.created_at)}>{ago(r.created_at)}</time>
                </span>
              </div>
              {r.text ? <p class="text">{r.text}</p> : <p class="text faint">No words given.</p>}
              {r.note && <p class="note"><b>Note:</b> {r.note}</p>}
              {r.status === "open" && (
                <form class="resolve" method="post" action={`/admin/reports/${encodeURIComponent(r.id)}`}>
                  <input type="hidden" name="csrf" value={session.csrf} />
                  <label class="sr-only" for={`note-${r.id}`}>Note on what was done</label>
                  <input class="note-field" id={`note-${r.id}`} name="note" maxlength="500" placeholder="What was done (optional)" value={String(r.id) === resumedReport ? resumedNote : undefined} />
                  <Action tone="secondary" size="md" name="resolution" value="dismissed">Dismiss</Action>
                  <Action tone="primary" size="md" name="resolution" value="actioned">Acted on it</Action>
                </form>
              )}
            </li>
          ))}
        </ul>
      )
    }
    {result.ok && <Pagination label="More reports" next={result.data.next_cursor ? `${base}${open ? "?" : "&"}cursor=${encodeURIComponent(result.data.next_cursor)}` : null} previous={result.data.prev_cursor ? `${base}${open ? "?" : "&"}cursor=${encodeURIComponent(result.data.prev_cursor)}` : cursor ? base : null} />}
  </div>
</Store>

<style>
  .reports-page { display: grid; gap: 24px; }
  .lead { max-width: 36em; font-size: 16px; }
  .list { display: grid; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); }
  .report { display: grid; gap: 10px; padding: 18px 20px; }
  .report + .report { border-top: 1px solid var(--line); }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 14px; }
  .plugin { font-weight: 600; color: var(--text); overflow-wrap: anywhere; }
  .plugin:hover { color: var(--accent-soft); }
  .by { font-size: 13px; color: var(--text-3); }
  .from { margin-left: auto; font-size: 13px; color: var(--text-3); }
  .text { max-width: 60em; font-size: 14.5px; line-height: 1.6; color: var(--text-2); white-space: pre-line; overflow-wrap: anywhere; }
  .faint { color: var(--text-3); }
  .note { font-size: 13.5px; color: var(--text-2); }
  .note b { font-weight: 500; color: var(--text); }
  .resolve { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .note-field { flex: 1 1 18em; height: 32px; padding: 0 12px; font: inherit; font-size: 14px; color: var(--text); background: var(--field-bg); border: 0; border-radius: var(--radius-lg); box-shadow: inset 0 0 0 1px var(--field-edge); outline: none; transition: box-shadow 0.12s, background-color 0.12s; }
  .note-field:hover { background: var(--field-hover); box-shadow: inset 0 0 0 1px var(--field-edge-hover); }
  .note-field:focus-visible { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 80%, white), 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .note-field::placeholder { color: var(--text-3); }
  .empty { display: grid; justify-items: center; gap: 8px; padding: 56px 24px; color: var(--text-3); text-align: center; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); }
  .empty p { color: var(--text-2); }
</style>
