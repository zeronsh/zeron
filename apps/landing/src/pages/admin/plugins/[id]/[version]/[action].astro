---
// Approve, reject or take down a version. A post does it; a visit (no
// script to open the dialog) is the same question as a page.
import ConfirmPage from "../../../../../components/store/ConfirmPage.astro";
import Deciding from "../../../../../components/store/Deciding.astro";
import Field from "../../../../../components/ui/Field.astro";
import Select from "../../../../../components/ui/Select.astro";
import Store from "../../../../../layouts/Store.astro";
import { isVersionAction, REJECT_REASONS, VERSION_FLASH, versionRequest } from "../../../../../lib/store/admin.ts";
import { done, field, flashFor, formOf, fromElsewhere, tokenMatches } from "../../../../../lib/store/forms.ts";
import { privatePage, purge } from "../../../../../lib/store/http.ts";
import { isPluginId, isVersion } from "../../../../../lib/store/names.ts";
import { adminOrResume, resumed, wasCut } from "../../../../../lib/store/resume.ts";

export const prerender = false;

const { id, version, action } = Astro.params;
if (!isPluginId(id) || !isVersion(version) || !isVersionAction(action)) return new Response(null, { status: 404 });
/** What each action's form has a person type: kept across a sign-in. */
const TYPED = { approve: [], reject: ["reason", "message"], remove: ["reason", "block"] } as const;
// (A session that ended while the form was open: sign in again and come
// back to this question with the answer as typed. Anyone else: the 404.)
const session = await adminOrResume(Astro, { path: Astro.url.pathname, fields: TYPED[action] });
if (session instanceof Response) return session;
const submission = `/admin/plugins/${encodeURIComponent(id)}/${encodeURIComponent(version)}`;
const back = action === "remove" ? `/admin/plugins/${encodeURIComponent(id)}` : submission;

if (Astro.request.method === "POST") {
  const form = await formOf(Astro.request);
  if (!form || !tokenMatches(form, session)) return done(Astro, "expired", back);
  const request = versionRequest(id, version, action, { get: (name) => field(form, name) });
  if (!request) return done(Astro, "bad_input", back);
  const result = await Astro.locals.edge.admin(request.path, request.body, session.csrf);
  if (result.ok && action !== "reject") await purge(Astro, id);
  return done(Astro, flashFor(result, VERSION_FLASH[action]), back);
}
if (Astro.request.method !== "GET") return new Response(null, { status: 405, headers: { allow: "GET, POST" } });
privatePage(Astro);
// What is being decided, so nobody decides it blind.
const record = await Astro.locals.edge.submission(id, version);
if (!record.ok && record.error === "not_found") return new Response(null, { status: 404 });
const s = record.ok ? record.data : null;
const failing = s?.checks.filter((c) => c.level === "fail").length ?? 0;
const warnings = s?.checks.filter((c) => c.level === "warn").length ?? 0;
const facts = s
  ? [
      { label: s.publisher.username ? `by @${s.publisher.username}` : "No username" },
      { label: s.base ? `Update from ${s.base.version}` : "First listing" },
      failing ? { label: `${failing} checks failed`, tone: "danger" as const } : warnings ? { label: `${warnings} checks to look at`, tone: "warning" as const } : { label: "Checks passed", tone: "success" as const },
      ...(s.permissions_diff?.added ?? []).map((a: string) => ({ label: `asks ${a}`, tone: "danger" as const })),
    ]
  : [];

const ASK = {
  approve: { title: `Approve ${id} ${version}?`, words: "It's listed at once, and offered to everyone who has it at their next update check.", confirm: "Approve", tone: "primary" },
  reject: { title: `Reject ${id} ${version}?`, words: "The author reads your reason and your words, in Zeron and on the web. They can publish a new version.", confirm: "Reject", tone: "danger" },
  remove: { title: `Take down ${id} ${version}?`, words: "Nobody can install it from the store again. Choose whether the devices that have it turn it off too.", confirm: "Take down", tone: "danger" },
} as const;
const ask = ASK[action];
---

<Store title={`${ask.title} · Zeron`} description={ask.title} noindex tool>
  <div class="wrap">
    <ConfirmPage title={ask.title} action={Astro.url.pathname} csrf={session.csrf} confirm={ask.confirm} tone={ask.tone} back={back}>
      <Fragment slot="words">
        {s && <Deciding id={id} name={String(s.manifest.name ?? id)} icon={typeof s.manifest.icon === "string" ? s.manifest.icon : null} version={version} lines={facts} read={submission} fromElsewhere={fromElsewhere(Astro.request)} />}
        <p>{ask.words}</p>
        {wasCut(Astro.url) && <p class="cut">You signed in again. What you wrote was longer than could be kept through that, so its end is missing: check it before you send it.</p>}
      </Fragment>
      {
        action === "reject" && (
          <>
            <Select name="reason" label="Reason" options={REJECT_REASONS.map((r) => ({ value: r.value, label: r.label }))} value={resumed(Astro.url, "reason")} field />
            <Field name="message" label="For the author" multiline required maxlength={2000} value={resumed(Astro.url, "message")} hint="Say what to change, plainly. They'll read it as you write it." />
          </>
        )
      }
      {
        action === "remove" && (
          <>
            <Field name="reason" label="Why" multiline required maxlength={2000} value={resumed(Astro.url, "reason")} hint="Its author reads this, and so does anyone whose device turns it off." />
            <label class="check">
              <input type="checkbox" name="block" checked={resumed(Astro.url, "block") === "on"} />
              <span>Also turn it off on the devices that have it. People can turn it back on; it's theirs.</span>
            </label>
          </>
        )
      }
    </ConfirmPage>
  </div>
</Store>

<style>
  .cut { color: var(--tone-warning); }
  .check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.5; color: var(--text-2); cursor: pointer; }
  .check input { margin-top: 3px; accent-color: var(--destructive-bg); }
</style>
