---
// Verify a version, decline to, take it down or remove it (amendment 45). A post does it; a visit
// (no script to open the dialog, or a link from elsewhere) is the same
// question as a page, with what is being decided above it.
import Confirm from "../../../../../components/kit/Confirm.astro";
import Deciding from "../../../../../components/kit/Deciding.astro";
import Decline from "../../../../../components/kit/Decline.astro";
import TakeDown from "../../../../../components/kit/TakeDown.astro";
import Glyph from "../../../../../components/ui/Glyph.astro";
import App from "../../../../../layouts/App.astro";
import { isVersionAction, toWeigh, VERSION_FLASH, versionAsk, versionRequest } from "../../../../../lib/store/admin.ts";
import { unbidi } from "../../../../../lib/store/format.ts";
import { done, field, flashFor, formOf, fromElsewhere, tokenMatches } from "../../../../../lib/store/forms.ts";
import { privatePage, purge } from "../../../../../lib/store/http.ts";
import { isPluginId, isVersion } from "../../../../../lib/store/names.ts";
import { resumed, wasCut } from "../../../../../lib/store/resume.ts";
import { adminSession } from "../../../../../lib/store/session.ts";

export const prerender = false;

const { id, version, action } = Astro.params;
if (!isPluginId(id) || !isVersion(version) || !isVersionAction(action)) return new Response(null, { status: 404 });
// (The middleware's admin gate let only an admin this far.)
const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });
const submission = `/admin/plugins/${encodeURIComponent(id)}/${encodeURIComponent(version)}`;
const back = action === "remove" || action === "take_down" || action === "restore" ? `/admin/plugins/${encodeURIComponent(id)}` : submission;

if (Astro.request.method === "POST") {
  const form = await formOf(Astro.request);
  if (!form || !tokenMatches(form, session)) return done(Astro, "expired", back);
  const request = versionRequest(id, version, action, { get: (name) => field(form, name) });
  if (!request) return done(Astro, "bad_input", back);
  const result = await Astro.locals.edge.admin(request.path, request.body, session.csrf);
  // (Every decision changes what the public sees: verified, or the version gone, or which one is the newest verified.)
  if (result.ok) await purge(Astro, id);
  return done(Astro, flashFor(result, VERSION_FLASH[action]), back);
}
if (Astro.request.method !== "GET") return new Response(null, { status: 405, headers: { allow: "GET, POST" } });
privatePage(Astro);
// What is being decided, so nobody decides it blind.
const record = await Astro.locals.edge.submission(id, version);
if (!record.ok && record.error === "not_found") return new Response(null, { status: 404 });
const s = record.ok ? record.data : null;
const name = s?.plugin.name ?? s?.version.name ?? (typeof s?.manifest.name === "string" ? s.manifest.name : id);
const failing = s?.checks.filter((c) => c.level === "fail").length ?? 0;
const warnings = s?.checks.filter((c) => c.level === "warn").length ?? 0;
const facts = s
  ? [
      s.publisher.username ? `by @${s.publisher.username}` : "No username",
      s.base ? `Against ${s.base.version}, its newest verified version` : "None verified yet",
      failing ? `${failing} checks failed` : warnings ? `${warnings} checks to look at` : "Checks passed",
      ...(s.permissions_diff?.added?.length && s.base ? [`asks for more: ${s.permissions_diff.added.join(", ")}`] : []),
    ]
  : [];
const ask = versionAsk(action, name, version);
const weigh = s && action === "verify" ? toWeigh(s) : null;
---

<App title={`${ask.title} · Zeron`} description={ask.title} noindex current="queue" session={session}>
  <nav slot="title" class="crumbs" aria-label="Where this is">
    <a href="/admin/plugins">Queue</a><Glyph name="alt-arrow-right" size={12} /><a href={submission}>{unbidi(name)} {version}</a><Glyph name="alt-arrow-right" size={12} /><span aria-current="page">{ask.confirm}</span>
  </nav>
  <Confirm ask={ask} action={Astro.url.pathname} csrf={session.csrf} back={submission} size={action === "verify" ? "sm" : "md"}>
    {
      (s || wasCut(Astro.url)) && (
        <div class="body">
          {s && <Deciding id={id} name={name} icon={s.version.icon ?? s.plugin.icon} version={version} facts={facts} read={submission} fromElsewhere={fromElsewhere(Astro.request)} />}
          {weigh && <p class:list={["weigh-line", weigh.tone]}>{weigh.text}</p>}
          {wasCut(Astro.url) && <p class="cut">You signed in again. What you wrote was longer than could be kept through that, so its end is missing: check it before you send it.</p>}
        </div>
      )
    }
    {action === "decline" && <Decline id="reject" version={version} author={s?.publisher.username ?? null} reason={resumed(Astro.url, "reason")} message={resumed(Astro.url, "message")} />}
    {(action === "take_down" || action === "remove" || action === "restore") && <TakeDown id="take-down" harmful={action === "take_down"} reason={resumed(Astro.url, "reason")} />}
  </Confirm>
</App>
