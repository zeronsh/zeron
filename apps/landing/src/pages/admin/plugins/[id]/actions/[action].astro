---
// Suspend, restore, feature or move a plugin to another account. A post
// does it; a visit is the same question as a page, with what is being
// decided above it.
import AskCard from "../../../../../components/look/AskCard.astro";
import Deciding from "../../../../../components/look/Deciding.astro";
import Icon from "../../../../../components/look/Icon.astro";
import Store from "../../../../../layouts/Store.astro";
import "../../../../../styles/look/account.css";
import "../../../../../styles/look/staff.css";
import { isPluginAction, PLUGIN_FLASH, pluginAsk, pluginRequest } from "../../../../../lib/store/admin.ts";
import { unbidi } from "../../../../../lib/store/format.ts";
import { done, field, flashFor, formOf, fromElsewhere, tokenMatches } from "../../../../../lib/store/forms.ts";
import { kindOf } from "../../../../../lib/store/kind.ts";
import { privatePage, purge } from "../../../../../lib/store/http.ts";
import { isPluginId } from "../../../../../lib/store/names.ts";
import { resumed, wasCut } from "../../../../../lib/store/resume.ts";
import { adminSession } from "../../../../../lib/store/session.ts";
import { staffUrl } from "../../../../../lib/store/urls.ts";
import { everListed, listingState } from "../../../../../lib/store/states.ts";

export const prerender = false;

const kind = kindOf(Astro.url);
const { id, action } = Astro.params;
if (!isPluginId(id) || !isPluginAction(action)) return new Response(null, { status: 404 });
// (The middleware's admin gate let only an admin this far.)
const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });
const back = staffUrl(id, kind);

if (Astro.request.method === "POST") {
  const form = await formOf(Astro.request);
  if (!form || !tokenMatches(form, session)) return done(Astro, "expired", back);
  const request = pluginRequest(kind, id, action, { get: (name) => field(form, name) });
  if (!request) return done(Astro, "bad_input", back);
  const result = await Astro.locals.edge.admin(request.path, request.body, session.csrf);
  if (result.ok) await purge(Astro, id);
  return done(Astro, flashFor(result, PLUGIN_FLASH[action]), back);
}
if (Astro.request.method !== "GET") return new Response(null, { status: 405, headers: { allow: "GET, POST" } });
privatePage(Astro);
// What is being decided, so nobody decides it blind.
const record = await Astro.locals.edge.adminPlugin(id, kind);
if (!record.ok && record.error === "not_found") return new Response(null, { status: 404 });
const a = record.ok ? record.data : null;
const name = a?.plugin.name ?? id;
const ask = pluginAsk(action, name);
const open = a?.reports.filter((r) => r.status === "open").length ?? 0;
---

<Store title={`${ask.title} · Zeron`} description={ask.title} noindex current="review" session={session}>
  <div class="wrap rpt">
  <nav class="crumbs" aria-label="Where this is">
    <a href="/admin/plugins">Review</a><Icon name="chev" /><a href={back}>{unbidi(name)}</a><Icon name="chev" /><span aria-current="page">{ask.confirm}</span>
  </nav>
  <AskCard ask={ask} action={Astro.url.pathname} csrf={session.csrf} back={back}>
    {
      (a || wasCut(Astro.url)) && (
        <div class="body">
          {a && (
            <Deciding
              item={{ ...a.plugin, kind }}
              version={a.plugin.version}
              facts={[a.owner.username ? `by @${a.owner.username}` : "No username", listingState(a.status, everListed(a.versions)).label, `${open} open ${open === 1 ? "report" : "reports"}`]}
              read={back}
              fromElsewhere={fromElsewhere(Astro.request)}
            />
          )}
          {wasCut(Astro.url) && <p class="flash info cut">You signed in again. What you wrote was longer than could be kept through that, so its end is missing: check it before you send it.</p>}
        </div>
      )
    }
    {
      action === "suspend" && (
        <div class="body">
          <div>
            <label class="field-label" for="suspend-reason">Why</label>
            <div class="field area"><textarea id="suspend-reason" name="reason" required maxlength="2000" rows="3">{resumed(Astro.url, "reason")}</textarea></div>
            <p class="field-hint">Its author reads this.</p>
          </div>
        </div>
      )
    }
    {
      action === "transfer" && (
        <div class="body">
          <div>
            <label class="field-label" for="transfer-to">New owner's username</label>
            <div class="field"><input class="input" id="transfer-to" name="to_username" required maxlength="21" placeholder="@username" autocomplete="off" value={resumed(Astro.url, "to_username", 21) || undefined} /></div>
          </div>
        </div>
      )
    }
  </AskCard>
  </div>
</Store>
