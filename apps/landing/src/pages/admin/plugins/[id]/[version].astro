---
// One submission, as a reviewer weighs it, in that order: the public page's
// head; what it asks for, marked against the last approved version; what
// changed (its notes, its files); its listing as visitors will see it; the
// raw manifest, folded. Beside it, the decision, which never scrolls away:
// Approve, Don't approve (a reason, words, and the author's view of them),
// or, for an approved version, Take down. Its files and its changes line by
// line are views of their own. Admins only; anyone else gets the site's 404.
import Decline from "../../../../components/kit/Decline.astro";
import Strip from "../../../../components/kit/Strip.astro";
import TakeDown from "../../../../components/kit/TakeDown.astro";
import Toast from "../../../../components/kit/Toast.astro";
import CodeView from "../../../../components/store/CodeView.astro";
import DiffView from "../../../../components/store/DiffView.astro";
import FileTree from "../../../../components/store/FileTree.astro";
import PluginTile from "../../../../components/store/PluginTile.astro";
import Glyph from "../../../../components/ui/Glyph.astro";
import App from "../../../../layouts/App.astro";
import { reasonLabel, toWeigh, versionAsk } from "../../../../lib/store/admin.ts";
import { takeFlash } from "../../../../lib/store/flash.ts";
import { age, bytes, count, dateTime, day, unbidi, waitedFor } from "../../../../lib/store/format.ts";
import { privatePage } from "../../../../lib/store/http.ts";
import { drawingChecks } from "../../../../lib/store/drawing.ts";
import { drawn } from "../../../../lib/store/rendered.ts";
import { HighlightBudget } from "../../../../lib/store/highlight.ts";
import { isPluginId, isVersion } from "../../../../lib/store/names.ts";
import { compared, together } from "../../../../lib/store/permissions.ts";
import { changedFiles, countRows, diffRows, fileTree, languageOf, MANIFEST_FILE, manifestChanges, manifestFile, manifestText, pictureType, readText, type DiffRow } from "../../../../lib/store/review.ts";
import { adminSession } from "../../../../lib/store/session.ts";
import { toneClass, versionState } from "../../../../lib/store/states.ts";
import { fileUrl, memberUrl, pictureUrl, pluginUrl } from "../../../../lib/store/urls.ts";
import type { Check, PackageFile } from "../../../../lib/store/types.ts";

export const prerender = false;

const { id, version } = Astro.params;
if (!isPluginId(id) || !isVersion(version)) return new Response(null, { status: 404 });
const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });

const edge = Astro.locals.edge;
const result = await edge.submission(id, version);
if (!result.ok && result.error === "not_found") return new Response(null, { status: 404 });
privatePage(Astro);
const toast = takeFlash(Astro.cookies);
const s = result.ok ? result.data : null;
/** Its name: the plugin's (a card), else what this version lists. */
const name = s?.plugin.name ?? s?.version.name ?? (typeof s?.manifest.name === "string" ? s.manifest.name : id);

// Its views: the submission, its files, its changes (an update's alone).
// (The README had a view of its own; it's the listing's part now.)
const VIEWS = { overview: "Overview", files: "Files", changes: "Changes" } as const;
type View = keyof typeof VIEWS;
const askedView = Astro.url.searchParams.get("view");
const view: View = askedView && Object.hasOwn(VIEWS, askedView) && (askedView !== "changes" || s?.base) ? (askedView as View) : "overview";
const here = `/admin/plugins/${encodeURIComponent(id)}/${encodeURIComponent(version)}`;
const viewHref = (v: View, extra: Record<string, string> = {}) => `${here}${v === "overview" && !Object.keys(extra).length ? "" : `?${new URLSearchParams({ view: v, ...extra })}`}`;

// Its files, with its manifest among them as the reviewer reads it; against
// the base's, what was added, changed or taken out (from the edge's hashes).
const manifest = s ? manifestText(s.manifest) : "";
const baseManifest = s?.base ? manifestText(s.base.manifest) : "";
const files = s ? [await manifestFile(manifest), ...s.files] : [];
const changes = s?.base ? changedFiles(files, [await manifestFile(baseManifest), ...s.base_files]) : [];
const changeOf = new Map(changes.map((c) => [c.path, c.change]));
const unchanged = s?.base ? files.filter((f) => !changeOf.has(f.path)) : [];
const CHANGE = { added: { label: "New", tone: "ok" }, modified: { label: "Changed", tone: "warn" }, removed: { label: "Removed", tone: "bad" } } as const;

// The file viewer: exactly the file asked for (one of the edge's list, by
// its own path: never another in its place), else the manifest. A picture
// shows as itself; an SVG as itself and as its source, which is what runs.
/** A file's text, from the edge (the manifest from what came with the submission). */
const textOf = async (at: string, path: string, manifestAt: string) => (path === MANIFEST_FILE ? { text: manifestAt } : readText(await edge.file(id, at, path, true)));
type Content = { text: string } | { binary: true } | { tooBig: true } | null;
let viewing: { file: PackageFile | null; path: string; picture: string | null; content: Content | { missing: true } | "picture" } | null = null;
if (s && view === "files") {
  const asked = Astro.url.searchParams.get("path");
  const file = asked === null ? files[0] : files.find((f) => f.path === asked);
  if (!file) viewing = { file: null, path: asked ?? "", picture: null, content: { missing: true } };
  else {
    const type = pictureType(file.path);
    const picture = type ? fileUrl(id, version, file.path) : null;
    viewing = { file, path: file.path, picture, content: type && type !== "image/svg+xml" ? "picture" : file.binary ? { binary: true } : await textOf(version, file.path, manifest) };
  }
}

// The changes: every changed text file's lines, read from both versions
// (at most this many files on one page; the rest are listed).
const DIFF_FILES = 40;
/** The most the page diffs, all files together, in lines before and after. */
// (Counted in lines and bytes, not time: a Worker's clock doesn't move while code runs.)
const PAGE_LINES = 24_000;
const PAGE_BYTES = 2 * 1024 * 1024;
let linesLeft = PAGE_LINES;
let bytesLeft = PAGE_BYTES;
/** What the changes may highlight, all files together (highlight.ts). */
const diffHighlight = new HighlightBudget(64 * 1024);
let diffs: { path: string; change: keyof typeof CHANGE; rows: DiffRow[] | null; note?: string }[] = [];
if (s?.base && view === "changes") {
  const base = s.base.version;
  diffs = await Promise.all(
    changes.map(async (c, i) => {
      const file = c.now ?? c.before!;
      if (i >= DIFF_FILES) return { path: c.path, change: c.change, rows: null, note: "Open it in Files to read it." };
      if (file.binary) return { path: c.path, change: c.change, rows: null, note: "Not text: compare it by its files." };
      const [now, before] = await Promise.all([
        c.now ? textOf(version, c.path, manifest) : Promise.resolve({ text: "" }),
        c.before ? textOf(base, c.path, baseManifest) : Promise.resolve({ text: "" }),
      ]);
      if (!now || !before) return { path: c.path, change: c.change, rows: null, note: "It couldn't be read." };
      if (!("text" in now) || !("text" in before)) return { path: c.path, change: c.change, rows: null, note: "tooBig" in now || "tooBig" in before ? "Too big to show here." : "Not text." };
      // (Each diff is bounded; and once the page has spent its time, the rest are listed to open in Files.)
      const lines = now.text.split("\n").length + before.text.split("\n").length;
      const bytes = now.text.length + before.text.length;
      if (lines > linesLeft || bytes > bytesLeft) return { path: c.path, change: c.change, rows: null, note: "Not compared here: open it in Files." };
      linesLeft -= lines;
      bytesLeft -= bytes;
      const rows = diffRows(before.text, now.text);
      return rows ? { path: c.path, change: c.change, rows } : { path: c.path, change: c.change, rows: null, note: "Too different to show line by line: open it in Files." };
    }),
  );
}

// The overview's parts. (Rendered each time: a version in review is no one's to keep.)
const overview = s && view === "overview";
const file = (p: string) => fileUrl(id, version, p);
const readmeText = s ? (s.version.readme ?? (await (async () => {
  const got = await readText(await edge.file(id, version, "README.md", true));
  return got && "text" in got ? got.text : "";
})())) : "";
// Drawn on every view (linear in their text, markdown.ts), each try recorded
// first (rendered.ts: one that never finished is not tried again while it
// is held), shown on the overview. Nothing is kept: a version in review is
// no one's to keep.
const origin = Astro.url.origin;
const readmeDrawn = readmeText.trim() ? await drawn(origin, id, version, "readme", readmeText, { file, demote: true, title: name }, { keep: false }) : null;
const notesDrawn = s?.version.notes ? await drawn(origin, id, version, "notes", s.version.notes, { file, demote: true }, { keep: false }) : null;
const notes = overview ? (notesDrawn?.html ?? "") : "";
const readme = overview ? (readmeDrawn?.html ?? "") : "";
// Shown as its text, for any cause, the reviewer is told, loudly, on every
// view: a submission that can't be drawn is itself a reason not to approve it.
const drawing: Check[] = drawingChecks(readmeDrawn, notesDrawn, version);
// (Each a path in the package, never anything else: pictureUrl refuses one that climbs out of it.)
const pictures = (s?.version.screenshots ?? []).flatMap((p) => pictureUrl(id, version, p) ?? []);
const weighed = s ? compared(s.permissions, s.base ? s.permissions_diff : null) : { lines: [], dropped: [] };
const moved = weighed.lines.filter((l) => l.change);
const same = weighed.lines.filter((l) => !l.change);
const checks = [...drawing, ...(s?.checks ?? [])];
const toLook = checks.filter((c) => c.level !== "ok");
const failed = checks.filter((c) => c.level === "fail").length;
const passed = checks.length - toLook.length;
const manifestMoved = s?.base ? manifestChanges(s.manifest, s.base.manifest).map((m) => m.key) : [];

const state = s ? versionState(s.version) : null;
const pending = s?.version.status === "pending";
const removable = s?.version.status === "approved" || s?.version.status === "yanked";
const review = s?.version.review;
const decided = review?.decided_at ?? s?.version.published_at ?? null;
const author = s?.publisher.username ?? null;
const approve = versionAsk("approve", name, version);
const weigh = s ? toWeigh({ ...s, checks }) : null;
const reject = versionAsk("reject", name, version);
const remove = versionAsk("remove", name, version);
const plural = (n: number, one: string, many = `${one}s`) => `${count(n)} ${n === 1 ? one : many}`;
---

<App title={`${name} ${version} · Review · Zeron`} description="A submission in review." noindex current="queue" session={session}>
  <nav slot="title" class="crumbs" aria-label="Where this is">
    <a href="/admin/plugins">Queue</a><Glyph name="alt-arrow-right" size={12} />
    {view === "overview" ? <span aria-current="page">{unbidi(name)} {version}</span> : <><a href={here}>{unbidi(name)} {version}</a><Glyph name="alt-arrow-right" size={12} /><span aria-current="page">{VIEWS[view]}</span></>}
  </nav>
  {
    s && (
      <nav slot="tools" class="segmented" aria-label="What to read">
        <a href={viewHref("overview")} aria-current={view === "overview" ? "page" : undefined}>Overview</a>
        <a href={viewHref("files")} aria-current={view === "files" ? "page" : undefined}>Files <span class="t-3">{count(files.length)}</span></a>
        {s.base && <a href={viewHref("changes")} aria-current={view === "changes" ? "page" : undefined}>Changes <span class="t-3">{count(changes.length)}</span></a>}
      </nav>
    )
  }

  {
    !s ? (
      <div class="panel">
        <div class="empty" role="status">
          <span class="tile"><Glyph name="wifi-off" size={20} /></span>
          <div class="words"><h2>This submission can't be loaded right now</h2><p>Try again in a moment.</p></div>
          <div class="actions"><a class="btn secondary sm" href={Astro.url.pathname + Astro.url.search}>Try again</a></div>
        </div>
      </div>
    ) : (
      <div class="review">
        <header class="review-head">
          <PluginTile id={s.plugin.id} name={name} icon={s.version.icon ?? s.plugin.icon} version={version} size={56} class="plugin-tile" />
          <div class="who">
            <h1 class="t-title"><span>{unbidi(name)}</span> <span class="v">{version}</span></h1>
            <p class="meta">
              <span>by {author ? <a href={memberUrl(author)}>@{author}</a> : "an account with no username"}</span>
              <span class="dot" aria-hidden="true">·</span>
              <span>{s.base ? `Update from ${s.base.version}` : "First listing"}</span>
              {s.version.prerelease && <span class="badge sm">Pre-release</span>}
              <span class="dot" aria-hidden="true">·</span>
              <a href={`/admin/plugins/${encodeURIComponent(id)}`}><code>{id}</code></a>
            </p>
          </div>
        </header>

        <aside class="decide panel" aria-label="Decision">
          <p class="state">
            {state && <span class:list={["badge sm", toneClass(state.tone)]}>{state.label}</span>}
            {pending ? (
              <span>waited <time datetime={new Date(s.version.submitted_at).toISOString()} title={dateTime(s.version.submitted_at)}>{waitedFor(s.version.submitted_at)}</time></span>
            ) : (
              decided && <span><time datetime={new Date(decided).toISOString()} title={dateTime(decided)}>{day(decided)}</time></span>
            )}
          </p>
          {review?.message && (
            <p class="said">
              “{review.message}”
              <span class="who">{[review.reason && reasonLabel(review.reason), review.decided_at && `${s.version.status === "removed" ? "taken down" : "reviewed"} ${day(review.decided_at)}`].filter(Boolean).join(" · ")}</span>
            </p>
          )}
          {(pending || removable) && (
            <div class="buttons">
              {pending && (
                <>
                  <a class="btn primary" href={`${here}/approve`} data-dialog="approve">Approve…</a>
                  <a class="btn secondary" href={`${here}/reject`} data-dialog="reject">Don't approve…</a>
                </>
              )}
              {removable && <a class="btn secondary" href={`${here}/remove`} data-dialog="take-down">Take down…</a>}
            </div>
          )}
          <dl class="facts">
            <div><dt>Sent by</dt><dd>{author ? <a href={memberUrl(author)}>@{author}</a> : "No username"}</dd></div>
            <div><dt>Account</dt><dd>{age(s.publisher.created_at) || "Deleted"}</dd></div>
            <div><dt>This author</dt><dd>{count(s.publisher.decisions.approved)} approved · {count(s.publisher.decisions.rejected)} not approved</dd></div>
            <div>
              <dt>Checks</dt>
              <dd>
                <a href={`${viewHref("overview")}#checks`} class:list={{ bad: failed > 0, warn: failed === 0 && toLook.length > 0 }}>
                  {failed > 0 ? `${count(failed)} failed` : toLook.length > 0 ? `${count(toLook.length)} to look at` : "All passed"}
                </a>
              </dd>
            </div>
          </dl>
        </aside>

        <div class="review-main">
          {view !== "overview" && drawing.length > 0 && (
            <ul class="panel checks-list" role="list" aria-label="What the checks found">
              {drawing.map((c) => (
                <li class={c.level}>
                  <Glyph name="close-circle" size={16} />
                  <span>{c.message}<span class="sr-only"> (failed)</span></span>
                </li>
              ))}
            </ul>
          )}
          {view === "overview" && (
            <>
              <section class="section" id="asks" aria-labelledby="asks-heading">
                <div class="section-head">
                  <div class="words">
                    <h2 id="asks-heading">What it asks for</h2>
                    <p>{s.base ? (moved.length || weighed.dropped.length ? `Against ${s.base.version}, the last approved version: ${[moved.filter((l) => l.change === "new").length && `${plural(moved.filter((l) => l.change === "new").length, "new ask")}`, moved.filter((l) => l.change === "changed" && !l.bound).length && `${plural(moved.filter((l) => l.change === "changed" && !l.bound).length, "ask")} changed inside`, weighed.dropped.length && `${plural(weighed.dropped.length, "ask")} dropped`, moved.some((l) => l.bound) && `${together(moved.filter((l) => l.bound).map((l) => l.bound!))} changed`].filter(Boolean).join(", ")}.` : `Nothing new since ${s.base.version}, the last approved version.`) : "Its first version: everything it asks for is new."}</p>
                  </div>
                </div>
                <div class="panel">
                  {weighed.lines.length === 0 ? (
                    <p class="panel-pad t-text t-2">It asks for nothing beyond running in its own space.</p>
                  ) : (
                    <div class="weigh">
                      {s.base && moved.length > 0 && <p class="weigh-group">New or changed since {s.base.version}</p>}
                      {(s.base ? moved : weighed.lines).map((l) => (
                        <div class:list={["weigh-row", { risky: l.risky }]}>
                          <Glyph name={l.icon} size={16} />
                          <p class="title">
                            {l.title}
                            {l.change && <span class="badge sm info">{l.change === "new" ? "New" : "Changed"}</span>}
                            {l.risky && <span class="sr-only"> (gives it a lot of reach)</span>}
                          </p>
                          {l.detail && <p class="detail">{l.detail}</p>}
                          {l.was || l.now ? (
                            <dl class="before-after">
                              <div><dt>Before</dt><dd>{l.was?.map((x) => <span>{x}</span>)}</dd></div>
                              <div><dt>After</dt><dd>{l.now?.map((x) => <span>{x}</span>)}</dd></div>
                            </dl>
                          ) : l.change === "changed" && (l.added || l.altered || l.removed) ? (
                            <ul class="moved" role="list">
                              {l.added?.map((x) => <li><span class="plus" aria-hidden="true">+</span><span>{x}<span class="sr-only"> (new)</span></span></li>)}
                              {l.altered?.map((x) => <li><span class="tilde" aria-hidden="true">~</span><span>{x}<span class="t-3"> tells agents something else</span></span></li>)}
                              {l.removed?.map((x) => <li><span class="minus" aria-hidden="true">−</span><span class="t-3">{x}<span class="sr-only"> (dropped)</span></span></li>)}
                            </ul>
                          ) : (
                            (l.literal || l.items) && (
                              <ul class="named" role="list">
                                {l.literal?.map((x) => <li>{x}</li>)}
                                {l.items?.map((x) => <li>{x.name}{x.description && <span class="t-3"> · {x.description}</span>}</li>)}
                              </ul>
                            )
                          )}
                        </div>
                      ))}
                      {s.base && same.length > 0 && <p class="weigh-group">As in {s.base.version}</p>}
                      {s.base && same.map((l) => (
                        <div class:list={["weigh-row same", { risky: l.risky }]}>
                          <Glyph name={l.icon} size={16} />
                          <p class="title">{l.title}{l.risky && <span class="sr-only"> (gives it a lot of reach)</span>}</p>
                          {(l.literal || l.items) && (
                            <ul class="named" role="list">
                              {l.literal?.map((x) => <li>{x}</li>)}
                              {l.items?.map((x) => <li>{x.name}{x.description && <span class="t-3"> · {x.description}</span>}</li>)}
                            </ul>
                          )}
                        </div>
                      ))}
                      {weighed.dropped.length > 0 && <p class="weigh-group">No longer asks</p>}
                      {weighed.dropped.map((l) => (
                        <div class="weigh-row same">
                          <Glyph name={l.icon} size={16} />
                          <p class="title"><del>{l.title}</del></p>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </section>

              <section class="section" id="checks" aria-labelledby="checks-heading">
                <div class="section-head">
                  <div class="words">
                    <h2 id="checks-heading">What the checks found</h2>
                    <p>{toLook.length === 0 ? `All ${count(checks.length)} passed.` : `${count(passed)} passed; ${failed > 0 ? `${count(failed)} failed` : ""}${failed > 0 && toLook.length > failed ? ", " : ""}${toLook.length > failed ? `${count(toLook.length - failed)} to look at` : ""}.`}</p>
                  </div>
                </div>
                {toLook.length > 0 && (
                  <ul class="panel checks-list" role="list">
                    {toLook.map((c) => (
                      <li class={c.level}>
                        <Glyph name={c.level === "warn" ? "danger-triangle" : "close-circle"} size={16} />
                        <span>{c.message}<span class="sr-only"> ({c.level === "warn" ? "to look at" : "failed"})</span></span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>

              <section class="section" id="changed" aria-labelledby="changed-heading">
                <div class="section-head">
                  <div class="words">
                    <h2 id="changed-heading">What changed</h2>
                    <p>{s.base ? (changes.length === 0 ? `No file changed since ${s.base.version}.` : `Since ${s.base.version}: ${plural(changes.length, "file")} added, changed or taken out.`) : "Its first version: every file is new."}</p>
                  </div>
                  {s.base && changes.length > 0 && <a class="btn secondary sm" href={viewHref("changes")}>Read the changes</a>}
                </div>
                <div class="panel panel-pad notes-panel">
                  <h3 class="t-label">Notes for {version}</h3>
                  {notes ? <div class="prose notes" set:html={notes} /> : <p class="t-text t-3">No notes for this version.</p>}
                </div>
                <div class="panel">
                  <table class="table files-table">
                    <caption class="sr-only">Its files{s.base ? `, against ${s.base.version}` : ""}</caption>
                    <colgroup><col />{s.base && <col class="change" />}<col class="size" /></colgroup>
                    <thead><tr><th scope="col">File</th>{s.base && <th scope="col">Since {s.base.version}</th>}<th scope="col" class="end">Size</th></tr></thead>
                    <tbody>
                      {(s.base ? changes.map((c) => ({ path: c.path, bytes: (c.now ?? c.before)!.bytes, change: c.change as keyof typeof CHANGE | null, binary: (c.now ?? c.before)!.binary })) : files.map((f) => ({ path: f.path, bytes: f.bytes, change: null, binary: f.binary }))).map((f) => (
                        <tr class:list={{ removed: f.change === "removed" }}>
                          <td class="path"><a href={f.change ? `${viewHref("changes")}#change-${encodeURIComponent(f.path)}` : viewHref("files", { path: f.path })}>{f.path}</a>{f.binary && <span class="badge sm warn">Not text</span>}</td>
                          {s.base && <td>{f.change && <span class:list={["badge sm", CHANGE[f.change].tone]}>{CHANGE[f.change].label}</span>}</td>}
                          <td class="end size">{bytes(f.bytes)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  {unchanged.length > 0 && (
                    <details class="unchanged">
                      <summary>{plural(unchanged.length, "file")} as in {s.base!.version}<Glyph name="alt-arrow-down" size={12} /></summary>
                      <table class="table files-table">
                        <caption class="sr-only">Files as in {s.base!.version}</caption>
                        <colgroup><col /><col class="change" /><col class="size" /></colgroup>
                        <tbody>
                          {unchanged.map((f) => (
                            <tr>
                              <td class="path"><a href={viewHref("files", { path: f.path })}>{f.path}</a>{f.binary && <span class="badge sm warn">Not text</span>}</td>
                              <td />
                              <td class="end size">{bytes(f.bytes)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </details>
                  )}
                </div>
              </section>

              <section class="section" id="listing" aria-labelledby="listing-heading">
                <div class="section-head">
                  <div class="words">
                    <h2 id="listing-heading">Its listing</h2>
                    <p>As visitors will see it on its page.</p>
                  </div>
                  {s.plugin.version && <a class="btn ghost sm" href={pluginUrl(id)}>Its page now<Glyph name="arrow-up-right" size={12} /></a>}
                </div>
                <div class="review-listing">
                  {s.version.summary && <p class="summary">{s.version.summary}</p>}
                  <Strip name={name} pictures={pictures} />
                  {readme ? <div class="prose" set:html={readme} /> : <p class="notice warn"><Glyph name="danger-triangle" size={16} /><span>It has no README the store can show.</span></p>}
                </div>
              </section>

              <section class="section" id="manifest" aria-labelledby="manifest-heading">
                <h2 id="manifest-heading" class="sr-only">Its manifest</h2>
                <details class="fold">
                  <summary>
                    <span>{MANIFEST_FILE}</span>
                    <span class="what">As signed · {bytes(files[0]!.bytes)}{manifestMoved.length > 0 && ` · changed since ${s.base!.version}: ${manifestMoved.join(", ")}`}</span>
                    <Glyph name="alt-arrow-down" size={14} />
                  </summary>
                  <CodeView text={manifest} language="json" label={MANIFEST_FILE} />
                </details>
              </section>
            </>
          )}

          {view === "files" && viewing && (
            <div class="files-view">
              <nav class="panel tree-pane" aria-label="Files">
                <FileTree nodes={fileTree(files)} current={viewing.path} href={(p) => viewHref("files", { path: p })} changes={changeOf} />
              </nav>
              <section class="viewer" aria-label={viewing.path || "File"}>
                <p class="file-head">
                  <code>{viewing.path}</code>
                  {viewing.file && <span class="num">{bytes(viewing.file.bytes)}</span>}
                  {changeOf.get(viewing.path) && <a href={`${viewHref("changes")}#change-${encodeURIComponent(viewing.path)}`}>See its changes</a>}
                </p>
                {viewing.picture && <img class="file-picture" src={viewing.picture} alt={viewing.path} />}
                {viewing.content === "picture" ? null : viewing.content === null ? (
                  <p class="t-text t-3">It couldn't be read.</p>
                ) : "missing" in viewing.content ? (
                  <p class="t-text t-3">This version has no file at that path.</p>
                ) : "binary" in viewing.content ? (
                  <p class="notice warn"><Glyph name="danger-triangle" size={16} /><span>Not text, so not shown. Binary files can hold code: ask what it's for.</span></p>
                ) : "tooBig" in viewing.content ? (
                  <p class="t-text t-3">Too big to show here.</p>
                ) : (
                  <CodeView text={viewing.content.text} language={languageOf(viewing.path)} label={viewing.path} />
                )}
              </section>
            </div>
          )}

          {view === "changes" && s.base && (
            <section class="changes-view" aria-label={`Changes since ${s.base.version}`}>
              <p class="t-text t-2">{changes.length === 0 ? `No file changed since ${s.base.version}.` : `${plural(changes.length, "file")} changed since ${s.base.version}.`}</p>
              {diffs.map((d) => {
                const n = d.rows ? countRows(d.rows) : null;
                return (
                  <article class="change-block" id={`change-${encodeURIComponent(d.path)}`}>
                    <header class="change-head">
                      <span class:list={["badge sm", CHANGE[d.change].tone]}>{CHANGE[d.change].label}</span>
                      <a href={viewHref("files", { path: d.path })}>{d.path}</a>
                      {n && (
                        <span class="counts num">
                          <span class="plus">+{n.added}</span> <span class="minus">−{n.removed}</span>
                        </span>
                      )}
                    </header>
                    {d.rows ? d.rows.length > 0 ? <DiffView rows={d.rows} language={languageOf(d.path)} budget={diffHighlight} /> : <p class="t-text t-3">Only its bytes changed.</p> : <p class="t-text t-3">{d.note}</p>}
                  </article>
                );
              })}
            </section>
          )}
        </div>
      </div>
    )
  }

  {
    s && (pending || removable) && (
      <div class="decide-bar">
        {pending && (
          <>
            <a class="btn secondary" href={`${here}/reject`} data-dialog="reject">Don't approve…</a>
            <a class="btn primary" href={`${here}/approve`} data-dialog="approve">Approve…</a>
          </>
        )}
        {removable && <a class="btn secondary" href={`${here}/remove`} data-dialog="take-down">Take down…</a>}
      </div>
    )
  }

  {
    s && pending && (
      <dialog class="dialog sm" id="approve" aria-labelledby="approve-title" closedby="any">
        <form method="post" action={`${here}/approve`}>
          <input type="hidden" name="csrf" value={session.csrf} />
          <div class="head">
            <h2 id="approve-title">{unbidi(approve.title)}</h2>
            {approve.words.map((w) => <p>{w}</p>)}
            {weigh && <p class:list={["weigh-line", weigh.tone]}>{weigh.text}</p>}
          </div>
          <div class="answers">
            <button class="btn secondary" type="submit" formmethod="dialog" formnovalidate>Cancel</button>
            <button class="btn primary" type="submit" autofocus>{approve.confirm}</button>
          </div>
        </form>
      </dialog>
    )
  }
  {
    s && pending && (
      <dialog class="dialog" id="reject" aria-labelledby="reject-title" closedby="any">
        <form method="post" action={`${here}/reject`}>
          <input type="hidden" name="csrf" value={session.csrf} />
          <div class="head">
            <h2 id="reject-title">{unbidi(reject.title)}</h2>
            {reject.words.map((w) => <p>{w}</p>)}
          </div>
          <Decline id="reject" version={version} author={author} />
          <div class="answers">
            <button class="btn secondary" type="submit" formmethod="dialog" formnovalidate autofocus>Cancel</button>
            <button class="btn danger" type="submit">{reject.confirm}</button>
          </div>
        </form>
      </dialog>
    )
  }
  {
    s && removable && (
      <dialog class="dialog" id="take-down" aria-labelledby="take-down-title" closedby="any">
        <form method="post" action={`${here}/remove`}>
          <input type="hidden" name="csrf" value={session.csrf} />
          <div class="head">
            <h2 id="take-down-title">{unbidi(remove.title)}</h2>
            {remove.words.map((w) => <p>{w}</p>)}
          </div>
          <TakeDown id="take-down" />
          <div class="answers">
            <button class="btn secondary" type="submit" formmethod="dialog" formnovalidate autofocus>Cancel</button>
            <button class="btn danger" type="submit">{remove.confirm}</button>
          </div>
        </form>
      </dialog>
    )
  }
  <Toast toast={toast} />
</App>
