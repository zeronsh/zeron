---
// The review queue: every version waiting for a reviewer, the longest
// waiting first. Admins only; to anyone else this address is the site's
// 404, signed in or not.
import AccountBar from "../../../components/store/AccountBar.astro";
import Badge from "../../../components/ui/Badge.astro";
import Glyph from "../../../components/ui/Glyph.astro";
import Pagination from "../../../components/ui/Pagination.astro";
import Tabs from "../../../components/ui/Tabs.astro";
import Store from "../../../layouts/Store.astro";
import { takeFlash } from "../../../lib/store/flash.ts";
import { ago, date } from "../../../lib/store/format.ts";
import { privatePage } from "../../../lib/store/http.ts";
import { adminSession } from "../../../lib/store/session.ts";

export const prerender = false;

const session = await adminSession(Astro);
if (!session) return new Response(null, { status: 404 });
privatePage(Astro);
const toast = takeFlash(Astro.cookies);

const VIEWS = { pending: "Waiting", rejected: "Not approved", withdrawn: "Withdrawn" } as const;
type View = keyof typeof VIEWS;
const asked = Astro.url.searchParams.get("status");
const status: View = asked && Object.hasOwn(VIEWS, asked) ? (asked as View) : "pending";
const cursor = Astro.url.searchParams.get("cursor");
const result = await Astro.locals.edge.queue(status, cursor && /^[A-Za-z0-9_-]{1,512}$/.test(cursor) ? cursor : undefined);
const items = result.ok ? result.data.items : [];
const href = (s: View, c?: string) => `/admin/plugins${s === "pending" && !c ? "" : `?${new URLSearchParams({ ...(s !== "pending" ? { status: s } : {}), ...(c ? { cursor: c } : {}) })}`}`;
---

<Store title="Review · Zeron" description="The plugin review queue." noindex tool toast={toast}>
  <div class="wrap admin">
    <AccountBar session={session} current="queue">
      <h1>Review</h1>
      <p class="lead">Every version is read here before anyone but its author can install it.</p>
    </AccountBar>

    <Tabs label="Versions by state" tabs={(Object.keys(VIEWS) as View[]).map((s) => ({ href: href(s), label: VIEWS[s], current: s === status, count: s === status && result.ok ? items.length : undefined }))} />

    {
      !result.ok ? (
        <p class="empty">The queue can't be loaded right now. Try again in a minute.</p>
      ) : items.length === 0 ? (
        <div class="empty">
          <Glyph name="check-circle" size={20} />
          <p>{status === "pending" ? "Nothing is waiting for review." : "None here."}</p>
        </div>
      ) : (
        <div class="table-wrap">
          <table class="stack-table">
            <thead>
              <tr>
                <th scope="col">Plugin</th>
                <th scope="col">Publisher</th>
                <th scope="col">Submitted</th>
                <th scope="col">Checks</th>
                <th scope="col">Asks for more</th>
              </tr>
            </thead>
            <tbody>
              {items.map((item) => (
                <tr>
                  <th scope="row">
                    <a class="follow" href={`/admin/plugins/${encodeURIComponent(item.id)}/${encodeURIComponent(item.version)}`}>
                      <span class="name">{item.name}</span>
                      <span class="version num">{item.version}</span>
                    </a>
                    <span class="sub">{item.base ? `Update from ${item.base}` : "First listing"} · <code>{item.id}</code></span>
                  </th>
                  <td data-label="By">{item.publisher.username ? `@${item.publisher.username}` : <span class="faint">No username</span>}</td>
                  <td class="when" data-label="Submitted">
                    <time datetime={new Date(item.submitted_at).toISOString()} title={date(item.submitted_at)}>{ago(item.submitted_at)}</time>
                  </td>
                  <td>
                    <span class="checks">
                      {item.checks.fail > 0 && <Badge tone="danger" size="sm" icon="close-circle">{item.checks.fail} failed</Badge>}
                      {item.checks.warn > 0 && <Badge tone="warning" size="sm" icon="danger-triangle">{item.checks.warn} to look at</Badge>}
                      {item.checks.fail === 0 && item.checks.warn === 0 && <Badge tone="success" size="sm" icon="check-circle">Passed</Badge>}
                    </span>
                  </td>
                  <td>
                    {item.new_asks.length === 0 ? (
                      <span class="faint">Nothing new</span>
                    ) : (
                      <span class="asks">
                        {item.new_asks.map((a) => (
                          <Badge tone={["commands", "native", "ui.replace", "messages.send", "accounts.switch", "accounts.pin", "models.set"].includes(a) ? "danger" : "neutral"} size="sm" mono>
                            {a}
                          </Badge>
                        ))}
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    {result.ok && <Pagination label="More of the queue" next={result.data.next_cursor ? href(status, result.data.next_cursor) : null} previous={result.data.prev_cursor ? href(status, result.data.prev_cursor) : cursor ? href(status) : null} />}
  </div>
</Store>

<style>
  .admin { display: grid; gap: 24px; }
  .lead { max-width: 36em; font-size: 16px; }
  .table-wrap { overflow-x: auto; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.5; }
  th, td { padding: 14px 16px; text-align: left; vertical-align: top; }
  thead th { padding-block: 10px; font-size: 12.5px; font-weight: 500; color: var(--text-3); border-bottom: 1px solid var(--line); white-space: nowrap; }
  tbody tr { position: relative; transition: background-color 0.12s; }
  tbody tr:hover { background: var(--hover); }
  tbody tr + tr > * { border-top: 1px solid var(--line); }
  tbody tr:has(.follow:focus-visible) { outline: 2px solid color-mix(in srgb, var(--accent) 80%, white); outline-offset: -2px; }
  tbody th { font-weight: 400; min-width: 16em; }
  .follow { display: inline-flex; align-items: baseline; gap: 8px; }
  .follow::before { content: ""; position: absolute; inset: 0; }
  .follow:focus-visible { outline: none; }
  .name { font-weight: 600; color: var(--text); overflow-wrap: anywhere; }
  .version { font-size: 13px; color: var(--text-2); }
  .sub { display: block; margin-top: 2px; font-size: 12.5px; color: var(--text-3); }
  .sub code { font-size: 12px; }
  .when { color: var(--text-2); white-space: nowrap; }
  .checks, .asks { display: flex; flex-wrap: wrap; gap: 4px; }
  .faint { color: var(--text-3); }
  .empty { display: grid; justify-items: center; gap: 8px; padding: 56px 24px; color: var(--text-3); text-align: center; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); }
  .empty p { color: var(--text-2); }
</style>
