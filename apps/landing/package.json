{
  "name": "zeron-landing",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "astro build && vitest run",
    "deploy": "npm ci && npm run check && npm test && wrangler deploy",
    "deploy:staging": "npm ci && npm run check && CLOUDFLARE_ENV=staging npm test && wrangler deploy",
    "test:edge": "astro build && vitest run -c vitest.edge.config.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "astro": "^7.4.12",
    "decode-named-character-reference": "^1.3.0",
    "diff": "^9.0.0",
    "github-slugger": "^2.0.0",
    "lowlight": "^3.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261117.0-beta",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
