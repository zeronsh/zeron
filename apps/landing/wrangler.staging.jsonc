{
  // The site's staging copy, at https://site-staging.zeron.sh: the same
  // build as wrangler.jsonc deploys, on its own worker
  // (zeron-landing-staging), which holds only that domain and so can never
  // take zeron.sh, and reads the store from the staging edge.
  // Deploy: `npx wrangler deploy -c wrangler.staging.jsonc` (it builds and
  // tests first, as production's does).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeron-landing-staging",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-01",
  "routes": [{ "pattern": "site-staging.zeron.sh", "custom_domain": true }],
  "workers_dev": true,
  "build": { "command": "npm ci && npm run check && npm test" },
  "assets": {
    "directory": "./dist",
    // (An address that is no file goes to the Worker, which answers with
    // the 404 page when it has no route for it either.)
    "binding": "ASSETS"
  },
  "services": [{ "binding": "EDGE", "service": "zeron-edge-staging" }],
  "cache": { "enabled": true }
}
