{
  // Landing page: an Astro site built to static assets, no worker script.
  // `wrangler deploy` builds it first (`build` below): a clean install, the
  // type check, the build into ./dist and the tests, so a deploy from CI
  // (.github/workflows/deploy.yml, on a push to main that touches this
  // folder) or from this directory uploads only a build that passed.
  // The install surface (/install.sh, /releases/*) is served by the edge
  // worker via path routes on the same hostname; path routes beat this
  // custom domain, so this worker only ever sees page traffic. (The worker
  // keeps its historical "comet-landing" name; renaming a worker means a new
  // worker. comet.zeron.sh stays attached for old links.)
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "comet-landing",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "zeron.sh", "custom_domain": true },
    { "pattern": "comet.zeron.sh", "custom_domain": true }
  ],
  "workers_dev": true,
  "build": { "command": "npm ci && npm run check && npm test" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
