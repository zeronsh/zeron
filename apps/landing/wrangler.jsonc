{
  // zeron.sh: an Astro site on a Worker. Every page that can be is
  // prerendered and served as a static asset (./dist/client); the routes
  // that need a server (the plugin store, its account and admin pages) are
  // rendered by the Worker, which reads the store and the sign-in session
  // from the edge worker through the EDGE service binding. The site never
  // holds a WorkOS secret.
  // Deploy with `npm run deploy`: a clean install, the type check, the build
  // into ./dist and the tests, then `wrangler deploy`, so a deploy from CI
  // (.github/workflows/deploy.yml, on a push to main that touches this
  // folder) or from this directory uploads only a build that passed. The
  // build writes the deployable config (dist/server/wrangler.json) and
  // points wrangler at it, so wrangler itself never builds.
  // The install surface (/install.sh, /releases/*), member cards (/@*) and
  // web sign-in (/auth/web/*) are served by the edge worker via path routes
  // on the same hostname; path routes beat this custom domain, so this
  // worker only ever sees the site's own traffic. (The worker keeps its
  // historical "comet-landing" name; renaming a worker means a new worker.
  // comet.zeron.sh stays attached for old links.)
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "comet-landing",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-01",
  // Node's APIs where a dependency reaches for them (as the edge worker has).
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "zeron.sh", "custom_domain": true },
    { "pattern": "comet.zeron.sh", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // (An address that is no file goes to the Worker, which answers with
    // the 404 page when it has no route for it either.)
    "binding": "ASSETS"
  },
  // The store's data and the sign-in session.
  "services": [{ "binding": "EDGE", "service": "comet-native-edge" }],
  // The site's own origin: the store's paths asked for on another name of
  // this Worker (comet.zeron.sh, its workers.dev address) are sent here.
  "vars": { "SITE_ORIGIN": "https://zeron.sh" },
  // The Worker cache in front of the Worker: public store pages say how
  // long they may be kept (Astro's route cache); everything else is no-store.
  "cache": { "enabled": true },
  "env": {
    // The site's staging copy, at https://site-staging.zeron.sh: the same
    // site on its own worker (zeron-landing-staging), which holds only that
    // domain and so can never take zeron.sh, reading the staging edge.
    // Built with CLOUDFLARE_ENV=staging (`npm run deploy:staging`); the
    // build bakes the choice into dist/server/wrangler.json.
    "staging": {
      "name": "zeron-landing-staging",
      "routes": [{ "pattern": "site-staging.zeron.sh", "custom_domain": true }],
      "services": [{ "binding": "EDGE", "service": "zeron-edge-staging" }],
      "vars": { "SITE_ORIGIN": "https://site-staging.zeron.sh" },
      "cache": { "enabled": true }
    }
  }
}
