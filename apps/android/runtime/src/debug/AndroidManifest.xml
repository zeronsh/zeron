<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: a bare runtime console reachable from adb without the
  Compose app (usage in RuntimeDebugActivity.kt). Exported so `am start` can
  reach it; release variants never merge this file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".RuntimeDebugActivity"
            android:exported="true"
            android:label="Zeron runtime (debug)"
            android:launchMode="singleTop" />
    </application>
</manifest>
