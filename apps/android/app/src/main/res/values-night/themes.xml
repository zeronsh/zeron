<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window behind the first frame (ZeronDark.background), so a dark
         launch or any window-level redraw doesn't flash the light #F3F3F5. -->
    <style name="Theme.Zeron" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#060606</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
