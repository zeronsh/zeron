<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for "Zeron Preview.app/Contents/Info.plist": the zgx app
     (apps/zgx) in a bundle of its own, beside Zeron.app (sh.zeron.app), never
     in its place. scripts/package-zgx-preview.sh replaces __VERSION__ (the
     workspace's, which its engine's updater compares with its own: keep it a
     plain X.Y.Z) and __BUILD__ (X.Y.Z.N, the preview's number).
     No CFBundleURLTypes: zgx opens no links, and `zeron://` stays Zeron.app's. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Zeron Preview</string>
    <key>CFBundleExecutable</key>
    <string>zeron-zgx</string>
    <key>CFBundleIconFile</key>
    <string>zeron-preview.icns</string>
    <key>CFBundleIdentifier</key>
    <string>sh.zeron.preview</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Zeron Preview</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD__</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <!-- zgx's frame source uses NSView's display link (macOS 14); Ghostty,
         which draws its terminals, needs 13. -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Zeron Preview uses your microphone for on-device dictation and for voice sessions you start. Voice sessions stream your audio to OpenAI through your ChatGPT-authenticated Codex account.</string>
    <key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
