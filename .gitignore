/target
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
.agents
# Signing material never lives in the repo (see ~/zeron-keys/README.md).
*.jks
*.keystore
keystore.properties
apps/android/.kotlin/
.claude
CLAUDE.md
/scripts/**/__pycache__/
