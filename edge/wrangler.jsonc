{
  // Zeron edge: per-session + per-workspace Loro sync DOs, per-device
  // relay DOs, R2 blobs, the absorbed WorkOS auth routes, and the Cloud
  // control plane (CloudAccount/CloudIndex DOs, per-session lifecycle Workflows,
  // usage metering; docs/design/cloud-device.md) in front of the vault.
  // Design: loro-sessions §2 (topology), §3 (persistence), §6.1 (diff
  // sidecar), §8 (device-room streams), §1.2 (R2 attachments), §3.3 (R2
  // backups); ARCHITECTURE.md §6.
  // NOTE: the worker name and R2 bucket names keep the historical "comet"
  // prefix on purpose — Durable Object storage is bound to the script name,
  // so renaming the worker would orphan every session/registry/chat room.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed by .github/workflows/deploy.yml on pushes to main that touch
  // edge/ (CLOUDFLARE_API_TOKEN repo secret).
  "name": "comet-native-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Node's built-ins for @cloudflare/puppeteer (src/card-image.ts), which
  // imports node:buffer; every environment inherits it.
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "b57dde68ee5964dccc025437b5478a5b",
  "workers_dev": true,
  // Public hostname on the zeron.sh zone, plus the install surface and member
  // card pages carved out of the landing host: path routes beat the landing
  // worker's custom domain, so `curl -fsSL https://zeron.sh/install.sh | sh`
  // installs Zeron and zeron.sh/@wing is a card, while the rest of zeron.sh
  // serves the landing page.
  "routes": [
    { "pattern": "edge.zeron.sh", "custom_domain": true },
    { "pattern": "zeron.sh/install.sh", "zone_name": "zeron.sh" },
    { "pattern": "zeron.sh/releases/*", "zone_name": "zeron.sh" },
    { "pattern": "zeron.sh/@*", "zone_name": "zeron.sh" },
    // The card pages' script, style, fonts and art (public/card, built by
    // scripts/card-assets.mjs from apps/card-web; static assets below).
    { "pattern": "zeron.sh/card/*", "zone_name": "zeron.sh" },
    // Legacy comet hostnames — keep until 0.1.x clients are gone.
    { "pattern": "edge.comet.zeron.sh", "custom_domain": true },
    { "pattern": "comet.zeron.sh/install.sh", "zone_name": "zeron.sh" },
    { "pattern": "comet.zeron.sh/releases/*", "zone_name": "zeron.sh" }
  ],
  // Serve src/install.sh as a string (the /install.sh route).
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  // The member card pages' static files at /card/* (apps/card-web/site and
  // its art), copied into public/ by `npm run card-assets` before a deploy;
  // the folder isn't committed. Paths that aren't files fall through to the
  // worker.
  "assets": { "directory": "public" },
  // Browser Run draws each card's still picture (src/card-image.ts).
  "browser": { "binding": "BROWSER" },
  // loro-crdt's default entry loads its WASM via URL fetch, which workerd
  // cannot do at runtime; the base64 entry inlines the module instead.
  "alias": {
    "loro-crdt": "loro-crdt/base64"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
      { "name": "DEVICE_ROOMS", "class_name": "DeviceRoom" },
      { "name": "PREVIEW_ROOMS", "class_name": "PreviewRoom" },
      { "name": "REGISTRY_ROOMS", "class_name": "RegistryRoom" },
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" },
      // Cloud control plane (docs/design/cloud-device.md):
      // cloud1/{orgId}/{userId} — the account, its projects, and every
      // session's machine (own sandbox, runner key, lifecycle), usage meter.
      { "name": "CLOUD_ACCOUNTS", "class_name": "CloudAccount" },
      // index1 — every user who ever had Cloud (billing walk list).
      { "name": "CLOUD_INDEX", "class_name": "CloudIndex" },
      // users1 — every WorkOS user and organization (user-directory.ts).
      { "name": "USER_DIRECTORY", "class_name": "UserDirectory" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom", "DeviceRoom"]
    },
    {
      // Workspace registry (docs/registry-sync.md) — the row-table sidebar
      // sync that replaces the Loro workspace doc rooms.
      "tag": "v2",
      "new_sqlite_classes": ["RegistryRoom"]
    },
    {
      // chat2 session rooms (docs/chat2-sync.md) — dumb log relays that
      // replace SessionRoom's loro-aware s2 rooms.
      "tag": "v3",
      "new_sqlite_classes": ["ChatRoom"]
    },
    { "tag": "v4", "new_sqlite_classes": ["PreviewRoom"] },
    { "tag": "v5", "new_sqlite_classes": ["CloudAccount", "CloudIndex"] },
    { "tag": "v6", "new_sqlite_classes": ["UserDirectory"] }
  ],
  // Cloud device lifecycle (src/cloud/workflows.ts). Workflow names are
  // account-wide: the dev/test wrangler configs must never reuse them.
  "workflows": [
    { "name": "zeron-cloud-provision", "binding": "CLOUD_PROVISION", "class_name": "ProvisionWorkflow" },
    { "name": "zeron-cloud-wake", "binding": "CLOUD_WAKE", "class_name": "WakeWorkflow" },
    { "name": "zeron-cloud-sleep", "binding": "CLOUD_SLEEP", "class_name": "SleepWorkflow" },
    // Explicit delete: stop → final usage read → DELETE (billing-exact).
    { "name": "zeron-cloud-delete", "binding": "CLOUD_DELETE", "class_name": "DeleteWorkflow" }
  ],
  // The credential vault (edge/vault, deployed by its own job BEFORE this
  // worker: a service binding to a missing worker fails the deploy). It has
  // no routes; this binding is the only way in.
  "services": [{ "binding": "VAULT", "service": "zeron-vault", "entrypoint": "VaultApi" }],
  // Hourly: Cloud usage reconcile backstop + daily orphan scan (00:17 UTC) +
  // closed-month exports to R2 usage/{YYYY-MM}.json (src/cloud/billing.ts).
  "triggers": { "crons": ["17 * * * *"] },
  // Public card reads per client IP a minute, per Cloudflare location
  // (src/card-gate.ts). Namespace ids are account-wide: staging has its own.
  "ratelimits": [{ "name": "CARD_READS", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "comet-native-blobs"
    },
    {
      // Release artifacts for /releases/* (curl-install + dmg downloads).
      "binding": "RELEASES",
      "bucket_name": "comet-native-releases"
    },
    {
      // The member cards' still pictures (src/card-image.ts), keyed by the
      // public card they show.
      "binding": "CARD_IMAGES",
      "bucket_name": "comet-native-card-images"
    }
  ],
  "vars": {
    // WorkOS AuthKit client id — JWTs verified against its JWKS. Placeholder;
    // set the real client id before deploying. Set AUTH_MODE=dev locally to
    // accept bearer==userId. WORKOS_API_KEY is a wrangler secret
    // (`wrangler secret put WORKOS_API_KEY`) powering the /auth/* routes.
    // Session push notifications (registry-room.ts) need two more secrets:
    // `wrangler secret put APNS_KEY_P8` (the AuthKey_XXXX.p8 file's contents)
    // and `wrangler secret put APNS_KEY_ID`. Unset ⇒ decided and logged on
    // /registry/:org/stats, not sent.
    //
    // Cloud device secrets (unset ⇒ /cloud answers `available: false`):
    //   BOAT_API_KEY            Boat provider API key. A scoped key needs:
    //                           sandbox.create, sandbox.read, sandbox.update,
    //                           sandbox.stop, sandbox.resume, sandbox.delete,
    //                           exec, and usage read (GET /sandboxes/{id}/usage,
    //                           also list for the orphan scan); account.read is
    //                           not needed. A missing action surfaces as
    //                           "Cloud isn't configured to … sandboxes".
    //   RUNNER_JWT_PRIVATE_KEY  ES256 private JWK (JSON) that signs runner JWTs
    //   RUNNER_JWT_PUBLIC_KEY   the matching public JWK (JSON); add a "kid" to
    //                           rotate later
    //   CLOUD_ACCESS            who Cloud is offered to: "everyone", or WorkOS
    //                           user/org ids (comma or space separated). Unset ⇒
    //                           nobody. A secret so it changes without a deploy.
    //   ADMIN_TOKEN             operator bearer for GET /admin/cloud/usage and
    //                           GET /admin/users, /admin/organizations (unset ⇒
    //                           those routes 404)
    //   WORKOS_WEBHOOK_SECRET   signing secret of the WorkOS webhook endpoint
    //                           https://<edge>/workos/webhook, subscribed to
    //                           user.created, user.updated, user.deleted,
    //                           organization.created/updated/deleted,
    //                           organization_membership.created/updated/deleted
    //   STRIPE_SECRET_KEY       Stripe API key (billing; src/cloud/stripe.ts)
    //   STRIPE_WEBHOOK_SECRET   signing secret of the webhook endpoint
    //                           https://<edge>/stripe/webhook, subscribed to
    //                           checkout.session.completed,
    //                           checkout.session.async_payment_succeeded,
    //                           customer.subscription.created/updated/deleted,
    //                           invoice.paid
    // Billing vars (Stripe Price ids): STRIPE_PRICE_BASE ($20/mo),
    // STRIPE_PRICE_PRO ($50/mo), STRIPE_PRICE_MAX ($200/mo) — recurring
    // monthly — and STRIPE_PRICE_CREDITS ($10, one-off: one 12,000-credit
    // pack). Enable plan switching and cancellation in the Stripe customer
    // portal settings. Billing reads as unavailable until all are set.
    // CLOUD_CREDIT_SECONDS: provider billable seconds per credit (default
    // 60) — what the provider bills for one minute of CLOUD_MACHINE.
    // Optional var CLOUD_EDGE_URL overrides the origin session engines are
    // pointed at (default: the origin of the request that created the session).
    // Optional CLOUD_TEMPLATE names a provider snapshot (engine pre-installed,
    // no identity) that session sandboxes start from; needs the key's
    // snapshot.read. Unset ⇒ every session installs the engine (~30–60 s).
    "WORKOS_CLIENT_ID": "client_01KWD0EAKZKD50YCQJNYSRE4BY",
    "AUTH_MODE": "workos",
    // Sandbox provider for NEW Cloud devices (src/cloud/providers): "boat".
    // Existing sandboxes keep the provider they were created on.
    "SANDBOX_PROVIDER": "boat",
    // Sandbox auto-stop, seconds. Required while the Boat account is on trial
    // (max 7200; auto-stop cannot be disabled there, so the DO re-extends it
    // while the device is busy). Remove on a paid plan: idle sleep
    // (CLOUD_IDLE_MINUTES) is ours.
    "CLOUD_TTL_SECONDS": "7200",
    "CLOUD_IDLE_MINUTES": "10",
    // Most sessions per user whose machines may run at once; waking another
    // first sleeps the least recently active idle one.
    "CLOUD_MAX_AWAKE": "5",
    // Session machine size: small · default · large.
    "CLOUD_MACHINE": "default",
    "BOAT_API_BASE": "https://boat.dev/api/v1",
    // New accounts start with no free credits (for now).
    "CLOUD_STARTING_CREDITS": "0",
    // Where session engines reach the edge when no request names it (a wake
    // that re-provisions a session whose first provision failed).
    "CLOUD_EDGE_URL": "https://edge.zeron.sh",
    // Live-mode Stripe (USD). Cloud has its own Billing Portal configuration:
    // the account's default portal serves an older product's customers.
    "STRIPE_PRICE_BASE": "price_1UTEAyLcv6c1lAsKCaWynvev",
    "STRIPE_PRICE_PRO": "price_1UTEAzLcv6c1lAsKwK4KUdxY",
    "STRIPE_PRICE_MAX": "price_1UTEB0Lcv6c1lAsKNJngPvEw",
    "STRIPE_PRICE_CREDITS": "price_1UTEB0Lcv6c1lAsKOlv3Zvoy",
    "STRIPE_PORTAL_CONFIGURATION": "bpc_1UTEB0Lcv6c1lAsK2f8WaFig"
  },
  // Staging: the whole stack beside production on this account — its own
  // Workers, Durable Objects, R2 buckets and Workflows (Workflow names are
  // account-wide, hence the prefix), WorkOS's test environment (its own
  // users and orgs), Stripe in test mode and Boat. Deploy: `npx wrangler deploy --env staging` (vault first).
  // Secrets: as production's Cloud list above, set with `--env staging`.
  "env": {
    "staging": {
      "name": "zeron-edge-staging",
      // Both ways in: the worker's own URL (scripts/staging-app.sh and
      // CLOUD_EDGE_URL still use it) and staging.zeron.sh, a custom domain
      // on the zeron.sh zone (its record wins over the zone's *.zeron.sh
      // wildcard for this one name).
      "workers_dev": true,
      "routes": [{ "pattern": "staging.zeron.sh", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
          { "name": "DEVICE_ROOMS", "class_name": "DeviceRoom" },
          { "name": "PREVIEW_ROOMS", "class_name": "PreviewRoom" },
          { "name": "REGISTRY_ROOMS", "class_name": "RegistryRoom" },
          { "name": "CHAT_ROOMS", "class_name": "ChatRoom" },
          { "name": "CLOUD_ACCOUNTS", "class_name": "CloudAccount" },
          { "name": "CLOUD_INDEX", "class_name": "CloudIndex" },
          { "name": "USER_DIRECTORY", "class_name": "UserDirectory" }
        ]
      },
      "workflows": [
        { "name": "zeron-staging-cloud-provision", "binding": "CLOUD_PROVISION", "class_name": "ProvisionWorkflow" },
        { "name": "zeron-staging-cloud-wake", "binding": "CLOUD_WAKE", "class_name": "WakeWorkflow" },
        { "name": "zeron-staging-cloud-sleep", "binding": "CLOUD_SLEEP", "class_name": "SleepWorkflow" },
        { "name": "zeron-staging-cloud-delete", "binding": "CLOUD_DELETE", "class_name": "DeleteWorkflow" }
      ],
      "services": [{ "binding": "VAULT", "service": "zeron-vault-staging", "entrypoint": "VaultApi" }],
      "triggers": { "crons": ["17 * * * *"] },
      "ratelimits": [{ "name": "CARD_READS", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }],
      "r2_buckets": [
        { "binding": "BLOBS", "bucket_name": "zeron-staging-blobs" },
        { "binding": "RELEASES", "bucket_name": "zeron-staging-releases" },
        { "binding": "CARD_IMAGES", "bucket_name": "zeron-staging-card-images" }
      ],
      "browser": { "binding": "BROWSER" },
      "vars": {
        "WORKOS_CLIENT_ID": "client_01KWD0E9SYPV2WE4QN9TP9DP0W",
        "AUTH_MODE": "workos",
        "SANDBOX_PROVIDER": "boat",
        "CLOUD_TTL_SECONDS": "7200",
        "CLOUD_IDLE_MINUTES": "10",
        "CLOUD_MAX_AWAKE": "5",
        "CLOUD_MACHINE": "default",
        "CLOUD_TEMPLATE": "zeron-cloud-dev",
        "CLOUD_STARTING_CREDITS": "600",
        // Staging's Cloud shares production's Boat account: only Wing's
        // staging account (production's list is a secret).
        "CLOUD_ACCESS": "user_01KWD6G6ZPW9HT4SW6D89HB5FB",
        "CLOUD_EDGE_URL": "https://zeron-edge-staging.sylasincorporated.workers.dev",
        "BOAT_API_BASE": "https://boat.dev/api/v1",
        "STRIPE_PRICE_BASE": "price_1URyT5Ld6XnizwPIilL1dIYa",
        "STRIPE_PRICE_PRO": "price_1URyT5Ld6XnizwPIBzZSBN6b",
        "STRIPE_PRICE_MAX": "price_1URyT5Ld6XnizwPILYWMVbKZ",
        "STRIPE_PRICE_CREDITS": "price_1URyT5Ld6XnizwPI2nNPHhkH"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
